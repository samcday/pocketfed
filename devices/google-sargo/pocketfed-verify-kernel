#!/bin/sh
set -eu

fail() {
    printf 'pocketfed kernel verification failed: %s\n' "$*" >&2
    exit 1
}

variant=unknown
if [ -f /usr/lib/pocketfed/kernel-variant ]; then
    variant="$(cat /usr/lib/pocketfed/kernel-variant)"
fi

set -- /usr/lib/modules/*
[ "$#" -eq 1 ] || fail "expected one module directory, found $#"
[ -d "$1" ] || fail "module directory is missing: $1"
module_dir="$1"
kver="${module_dir##*/}"

case "$variant" in
    copr)
        case "$kver" in
            7.1.2-0.pocketfed.sdm670.8.fc*.aarch64) ;;
            *) fail "unexpected release: $kver" ;;
        esac
        ;;
    fedora)
        expected="$(cat /usr/lib/pocketfed/kernel-release 2>/dev/null || true)"
        [ -n "$expected" ] || fail 'kernel-release is missing for the fedora variant'
        [ "$kver" = "$expected" ] ||
            fail "release $kver does not match pinned $expected"
        ;;
    *)
        fail "unknown kernel variant: $variant"
        ;;
esac

rpm_kver="$(rpm -q --qf '%{VERSION}-%{RELEASE}.%{ARCH}\n' kernel-core)" ||
    fail 'kernel-core is not installed'
[ "$rpm_kver" = "$kver" ] ||
    fail "kernel-core release $rpm_kver does not match module directory $kver"

module="$(find "$module_dir/kernel/drivers/mmc/host" \
    -type f -name 'sdhci-msm.ko*' -print -quit 2>/dev/null)"
[ -n "$module" ] || fail 'sdhci_msm module is missing'

vermagic="$(modinfo -F vermagic "$module")" ||
    fail "cannot read vermagic from $module"
uts_release="${vermagic%% *}"
[ "$uts_release" = "$kver" ] ||
    fail "sdhci_msm vermagic $uts_release does not match module directory $kver"

if [ "$variant" = "fedora" ]; then
    # kernel-ark MR 4753 (rawhide since 7.3.0-0.rc4.*.40): the SDM670 pinctrl
    # and interconnect drivers are built in and the Sargo panel is a module.
    for builtin in pinctrl-sdm670 qnoc-sdm670; do
        grep -Eq "/$builtin[.]ko\$" "$module_dir/modules.builtin" ||
            fail "$builtin is not built into the Fedora kernel"
    done
    panel_module="$(find "$module_dir/kernel/drivers/gpu/drm/panel" \
        -type f -name 'panel-samsung-s6e3fa7.ko*' -print -quit 2>/dev/null)"
    [ -n "$panel_module" ] || fail 'panel-samsung-s6e3fa7 module is missing'
    panel_vermagic="$(modinfo -F vermagic "$panel_module")" ||
        fail "cannot read vermagic from $panel_module"
    [ "${panel_vermagic%% *}" = "$kver" ] ||
        fail "panel-samsung-s6e3fa7 vermagic ${panel_vermagic%% *} does not match module directory $kver"
    [ ! -e "$module_dir/updates" ] ||
        fail 'unexpected out-of-tree modules under updates/'

    printf 'fedora variant: rmnet is not built by Fedora, skipping modem checks\n'
    printf 'verified pocketfed fedora kernel release %s\n' "$kver"
    exit 0
fi

rmnet_module="$(find "$module_dir/kernel/drivers/net/ethernet/qualcomm/rmnet" \
    -type f -name 'rmnet.ko*' -print -quit 2>/dev/null)"
[ -n "$rmnet_module" ] || fail 'rmnet module is missing'

rmnet_vermagic="$(modinfo -F vermagic "$rmnet_module")" ||
    fail "cannot read vermagic from $rmnet_module"
rmnet_uts_release="${rmnet_vermagic%% *}"
[ "$rmnet_uts_release" = "$kver" ] ||
    fail "rmnet vermagic $rmnet_uts_release does not match module directory $kver"

grep -Fxq 'CONFIG_SND_SOC_SM8250=m' "$module_dir/config" ||
    fail 'CONFIG_SND_SOC_SM8250 is not modular'
grep -Fxq 'CONFIG_SND_SOC_CS35L36=m' "$module_dir/config" ||
    fail 'CONFIG_SND_SOC_CS35L36 is not modular'

for sound_driver in snd-soc-sm8250 snd-soc-cs35l36; do
    sound_module="$(find "$module_dir/kernel/sound/soc" \
        -type f -name "$sound_driver.ko*" -print -quit 2>/dev/null)"
    [ -n "$sound_module" ] || fail "$sound_driver module is missing"

    sound_vermagic="$(modinfo -F vermagic "$sound_module")" ||
        fail "cannot read vermagic from $sound_module"
    sound_uts_release="${sound_vermagic%% *}"
    [ "$sound_uts_release" = "$kver" ] ||
        fail "$sound_driver vermagic $sound_uts_release does not match module directory $kver"
done

grep -Fxq 'CONFIG_TYPEC_QCOM_PMIC_SMB2=m' "$module_dir/config" ||
    fail 'CONFIG_TYPEC_QCOM_PMIC_SMB2 is not modular'
typec_module="$(find "$module_dir/kernel/drivers/usb/typec/tcpm/qcom" \
    -type f -name 'qcom_pmic_typec_smb2.ko*' -print -quit 2>/dev/null)"
[ -n "$typec_module" ] || fail 'qcom_pmic_typec_smb2 module is missing'
typec_vermagic="$(modinfo -F vermagic "$typec_module")" ||
    fail "cannot read vermagic from $typec_module"
[ "${typec_vermagic%% *}" = "$kver" ] ||
    fail 'qcom_pmic_typec_smb2 vermagic does not match kernel release'

grep -Fxq 'CONFIG_MAC80211_MESH=y' "$module_dir/config" ||
    fail 'CONFIG_MAC80211_MESH is not enabled'
for wifi_config in ATH10K ATH10K_SNOC; do
    grep -Fxq "CONFIG_$wifi_config=m" "$module_dir/config" ||
        fail "CONFIG_$wifi_config is not modular"
done
for wifi_driver in ath10k_core ath10k_snoc; do
    wifi_module="$(find "$module_dir/kernel/drivers/net/wireless/ath/ath10k" \
        -type f -name "$wifi_driver.ko*" -print -quit 2>/dev/null)"
    [ -n "$wifi_module" ] || fail "$wifi_driver module is missing"
    wifi_vermagic="$(modinfo -F vermagic "$wifi_module")" ||
        fail "cannot read vermagic from $wifi_module"
    [ "${wifi_vermagic%% *}" = "$kver" ] ||
        fail "$wifi_driver vermagic does not match kernel release"
done

printf 'verified pocketfed kernel release %s\n' "$kver"
