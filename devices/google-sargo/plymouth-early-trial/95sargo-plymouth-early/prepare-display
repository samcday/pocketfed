#!/bin/sh
# Initialize the existing display nodes before the broad coldplug begins.
# --settle waits only for events generated by this invocation. This optional
# head start must not fail boot health checks: ordinary coldplug is the fallback.
if ! timeout --kill-after=1s 2s udevadm trigger --action=add \
    --subsystem-match=drm --subsystem-match=graphics --settle; then
    echo 'Early display coldplug did not finish; continuing with ordinary coldplug.'
fi
exit 0
