#!/bin/sh
set -eu

fail() {
    printf 'pocketfed Sargo OCI verification failed: %s\n' "$*" >&2
    exit 1
}

rpm -q phosh upower upower-libs
systemctl is-enabled upower.service
rpm -q kernel
rpm -q clatd tayga libqmi-utils
rpm -q --qf '%{VERSION}-%{RELEASE}\n' ModemManager |
    grep -Eq '^1\.24\.2-4\.1\.pocketfed\.fc[0-9]+$'
test "$(rpm -q --qf '%{VERSION}\n' 81voltd)" = 1.2.0
test -x /usr/bin/81voltd
grep -Fxq 'ExecStart=/usr/bin/81voltd' /usr/lib/systemd/system/81voltd.service
grep -Fxq 'Wants=ModemManager.service' \
    /usr/lib/systemd/system/81voltd.service.d/10-pocketfed-sargo.conf
grep -Fxq 'After=ModemManager.service' \
    /usr/lib/systemd/system/81voltd.service.d/10-pocketfed-sargo.conf
grep -Fxq 'StartLimitIntervalSec=0' \
    /usr/lib/systemd/system/81voltd.service.d/10-pocketfed-sargo.conf
grep -Fxq 'Restart=on-failure' \
    /usr/lib/systemd/system/81voltd.service.d/10-pocketfed-sargo.conf
systemctl is-enabled 81voltd.service

test "$(rpm -q --qf '%{VERSION}\n' q6voiced)" = 0.3.1
test -x /usr/bin/q6voiced
grep -Fxq 'q6voice_card=0' /usr/share/q6voiced/q6voiced.conf
grep -Fxq 'q6voice_device=4' /usr/share/q6voiced/q6voiced.conf
test "$(readlink '/usr/share/alsa/ucm2/conf.d/sdm660/Google Pixel 3a.conf')" = \
    '../../Google/sargo/sargo.conf'
grep -Fq 'SectionUseCase."Voice Call"' /usr/share/alsa/ucm2/Google/sargo/sargo.conf
grep -Fq 'SectionUseCase."HiFi"' /usr/share/alsa/ucm2/Google/sargo/sargo.conf
hifi=/usr/share/alsa/ucm2/Google/sargo/HiFi.conf
test -s "$hifi"
grep -Fq 'SectionDevice."Speaker"' "$hifi"
grep -Fq 'SectionDevice."Headphones"' "$hifi"
grep -Fq 'SectionDevice."Headset"' "$hifi"
grep -Fq 'SectionDevice."Mic"' "$hifi"
grep -Fq 'JackControl "Mic Jack"' "$hifi"
systemctl is-enabled q6voiced.service
wireplumber_conf=/usr/share/wireplumber/wireplumber.conf.d/90-pocketfed-sargo-s16.conf
test -s "$wireplumber_conf"
grep -Fq 'alsa.card_name = "Google Pixel 3a"' "$wireplumber_conf"
grep -Fq 'api.alsa.pcm.stream = "playback"' "$wireplumber_conf"
grep -Fq 'api.alsa.path = "hw:G3a,0"' "$wireplumber_conf"
grep -Fq 'api.alsa.pcm.stream = "capture"' "$wireplumber_conf"
grep -Fq 'api.alsa.path = "hw:G3a,3"' "$wireplumber_conf"
grep -Fq 'audio.format = "S16LE"' "$wireplumber_conf"

test -x /usr/lib/NetworkManager/dispatcher.d/50-clatd
grep -Fq 'device-add|device-delete)' /usr/lib/NetworkManager/dispatcher.d/50-clatd
grep -Fq 'qmapmux*|rmnet*)' /usr/lib/NetworkManager/dispatcher.d/50-clatd
grep -Fq 'priority mangle + 1; }' /usr/bin/clatd
systemctl is-enabled clatd.service

test -x /usr/libexec/pocketfed-sargo-uim-select
systemctl is-enabled pocketfed-sargo-uim-select.service
test -L /etc/systemd/system/ModemManager.service.wants/pocketfed-sargo-uim-select.service

rpm -q pocketfed-qmicli-pdc-fixed
test -x /usr/libexec/pocketfed-qmicli-pdc
/usr/libexec/pocketfed-qmicli-pdc --version | grep -Fq 'qmicli 1.36.0'
test -x /usr/libexec/pocketfed-sargo-mcfg
test -s /usr/lib/pocketfed/sargo-mcfg.tsv
grep -Fxq 'ExecStart=/usr/libexec/pocketfed-sargo-mcfg' \
    /usr/lib/systemd/system/pocketfed-sargo-mcfg.service
grep -Fxq 'Before=ModemManager.service' \
    /usr/lib/systemd/system/pocketfed-sargo-mcfg.service
systemctl is-enabled pocketfed-sargo-mcfg.service
test -L /etc/systemd/system/ModemManager.service.wants/pocketfed-sargo-mcfg.service
test -x /usr/libexec/pocketfed-sargo-network-search
grep -Fxq 'After=ModemManager.service pocketfed-sargo-mcfg.service' \
    /usr/lib/systemd/system/pocketfed-sargo-network-search.service
grep -Fxq 'ConditionPathExists=/run/pocketfed-sargo-mcfg-activated' \
    /usr/lib/systemd/system/pocketfed-sargo-network-search.service
systemctl is-enabled pocketfed-sargo-network-search.service
test -L /etc/systemd/system/multi-user.target.wants/pocketfed-sargo-network-search.service
test -s /usr/share/blob-wrangler/configs/google,sargo.toml
grep -Fq 'destination = "qcom/sdm670/sargo/mcfg"' \
    /usr/share/blob-wrangler/configs/google,sargo.toml
grep -Fq 'rename = "telstra-au-commercial.mbn"' \
    /usr/share/blob-wrangler/configs/google,sargo.toml

systemctl is-enabled systemd-boot-check-no-failures.service
systemctl is-enabled qbootctl.service

# PID 1 reapplies presets when bootc initializes an unprovisioned deployment.
# Verify the policy as well as the build-time symlinks so required phone
# services survive that first-boot pass.
for unit in \
    81voltd.service \
    clatd.service \
    pocketfed-sargo-mcfg.service \
    pocketfed-sargo-network-search.service \
    pocketfed-sargo-uim-select.service \
    pocketfed-swclock-offset.service \
    pocketfed-swclock-offset-save.timer \
    q6voiced.service \
    systemd-boot-check-no-failures.service \
    systemd-timesyncd.service \
    usb-signaller.service
do
    [ "$(systemctl is-enabled "$unit")" = enabled ] ||
        fail "$unit is not enabled in the image"
    preset=$(
        systemctl list-unit-files "$unit" --no-legend --no-pager |
            awk 'NR == 1 { print $3 }'
    )
    [ "$preset" = enabled ] ||
        fail "$unit first-boot preset is not enabled: ${preset:-missing}"
done

test -f /usr/lib/ostree-boot/aboot.cfg
grep -Fxq 'POCKETFED_SLOT_SWITCH=qbootctl' /usr/lib/ostree-boot/aboot.cfg
test -x /usr/bin/aboot-deploy
grep -Fq 'finalize_boot_image' /usr/bin/aboot-deploy
grep -Fxq \
    'init_on_alloc=0 sysrq_always_enabled=1 module_blacklist=rpmsg_wwan_ctrl' \
    /usr/lib/ostree-boot/aboot-kargs
test -x /usr/libexec/pocketfed-aboot-finalize
test -x /usr/libexec/abl-exorcist-assembler
rpm -q python3

dracut_policy=/etc/dracut.conf.d/60-google-sargo.conf
grep -Fxq 'hostonly="yes"' "$dracut_policy"
grep -Fxq 'hostonly_mode="strict"' "$dracut_policy"
grep -Fxq 'hostonly_cmdline="no"' "$dracut_policy"
grep -Fxq 'hostonly_default_device="no"' "$dracut_policy"
grep -Fxq 'filesystems+=" ext4 overlay "' "$dracut_policy"

/usr/libexec/pocketfed-verify-kernel

set -- /usr/lib/modules/*
[ "$#" -eq 1 ]
test -f "$1/vmlinuz"
test -f "$1/dtb/qcom/sdm670-google-sargo.dtb"
test -f "$1/initramfs.img"
test -f "$1/aboot.img"
lsinitrd "$1/initramfs.img" |
    grep -Fq '/kernel/fs/overlayfs/overlay.ko' || {
    printf 'Sargo initramfs is missing the OverlayFS kernel module\n' >&2
    exit 1
}

repacked=$(mktemp)
trap 'rm -f -- "$repacked"' EXIT
options='root=LABEL=pfroot rw rootwait rootfstype=ext4 ostree=/ostree/boot.1/pocketfed/verify/0 ath10k_core.rawmode=1'
/usr/libexec/pocketfed-aboot-finalize \
    --options "$options" \
    --append-options-file /usr/lib/ostree-boot/aboot-kargs \
    "$1/aboot.img" "$repacked"
expected_cmdline="<S> $(cat /usr/lib/ostree-boot/aboot-kargs) $options <E>"
cmdline=$(dd if="$repacked" bs=1 skip=64 count=512 status=none | tr '\000' '\n' | sed -n '1p')
[ "$cmdline" = "$expected_cmdline" ]
repacked_size=$(stat -c %s "$repacked")
[ "$repacked_size" -le 67108864 ] || {
    printf 'Sargo boot image exceeds the 64 MiB partition: %s bytes\n' "$repacked_size" >&2
    exit 1
}
