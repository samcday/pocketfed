#!/bin/bash
# Image build only. This does not stage a deployment or access a phone.
set -euo pipefail
test -e /run/.containerenv || test -e /.dockerenv
save=$(mktemp -d /tmp/plymouth-image.XXXXXX)
trap 'rm -rf "$save"' EXIT
# Only the retired theme may be removed. Keep every other package unchanged.
rpm -qa --qf '%{NAME} %{NEVRA}\n' |
    awk '$1 != "plymouth-theme-fedora-mobile" { print $2 }' | sort >"$save/expected"
set -- /usr/lib/modules/*
test "$#" -eq 1 && test -d "$1"
module_dir=$1
kver=${module_dir##*/}
sha256sum "$module_dir/vmlinuz" "$module_dir/dtb/qcom/sdm670-google-sargo.dtb" >"$save/kernel"
rpm -q plymouth-theme-spinner fedora-logos
test -f /usr/share/plymouth/themes/bgrt/bgrt.plymouth
test -f /usr/share/plymouth/themes/spinner/watermark.png
if rpm -q plymouth-theme-fedora-mobile >/dev/null 2>&1; then
    rpm -e plymouth-theme-fedora-mobile
fi
rpm -qa --qf '%{NEVRA}\n' | sort >"$save/after"
cmp "$save/expected" "$save/after"
sed -i 's/,plymouth-theme-fedora-mobile\b//g' /etc/yum.repos.d/samcday-pocketfed.repo
dracut --force --hostonly --hostonly-mode=strict --no-hostonly-cmdline \
    --no-hostonly-default-device "$module_dir/initramfs.img" "$kver"
/usr/libexec/pocketfed-verify-plymouth-initrd "$module_dir/initramfs.img"
/usr/libexec/pocketfed-aboot-finalize \
    --options 'root=LABEL=pfroot rw rootwait rootfstype=ext4 ostree=true' \
    --append-options-file /usr/lib/ostree-boot/aboot-kargs \
    "$module_dir/aboot.img" "$save/aboot.img"
install -m0644 "$save/aboot.img" "$module_dir/aboot.img"
sha256sum -c "$save/kernel"
