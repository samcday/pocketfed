# PocketFed Sargo qcam camera trial.
#
# This is a disposable, manually started trial session. It is NOT a desktop and
# is not pulled in by graphical.target. Edit the repository path below to point
# at the PocketFed checkout on the phone, then start it explicitly:
#
#   systemctl daemon-reload
#   systemctl start pocketfed-camera-qcam.service
#   journalctl -u pocketfed-camera-qcam -f
#
# The ExecStart always runs the readiness gate first. The gate requires a fresh
# Volume Up press/release before it starts the session (and keeps monitoring so
# Volume Down cancels, including while qcam runs). The part after `--` is the
# single authorized command: the standalone Phoc + patched qcam session.
#
# The patched qcam (--output/--after-frames) must already be installed, along
# with the Qt Wayland and Qt JPEG plugins; see qcam-session/README.md. The
# defaults below run Phoc standalone as root on a dedicated VT with
# WLR_BACKENDS=drm,libinput and LIBSEAT_BACKEND=noop. `drm` alone would omit
# the libinput backend and leave touch/keyboard (and therefore focus)
# unavailable. If hardware validation shows root/standalone cannot take the DRM
# seat, run the same session command under greetd with an [initial_session]
# instead.

[Unit]
Description=PocketFed Sargo qcam camera trial (Volume-Up gate + Phoc + qcam)
Conflicts=getty@tty3.service
After=systemd-user-sessions.service

[Service]
Type=simple

# Repository checkout on the phone. The work directory is a bounded, private
# runtime directory created by systemd; the gate opens its capture log beneath it.
Environment=POCKETFED_CAMERA_QCAM_REPO=/path/to/pocketfed
Environment=POCKETFED_CAMERA_QCAM_WORKDIR=/run/pocketfed-camera-qcam
RuntimeDirectory=pocketfed-camera-qcam
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes

# Standalone DRM session on a dedicated VT. libinput must be listed explicitly.
Environment=WLR_BACKENDS=drm,libinput
Environment=WLR_RENDERER=gles2
Environment=LIBSEAT_BACKEND=noop
TTYPath=/dev/tty3
StandardInput=tty
TTYReset=yes
TTYVHangup=yes

# Contain every descendant in the unit cgroup, including any helper that created
# its own session and would escape process-group cleanup on cancellation.
KillMode=control-group
TimeoutStopSec=30

# The gate bound must cover Phoc start-up (20s), the qcam warm-up/save window
# (90s) and both release gates (10s each) with margin.
ExecStart=/usr/bin/python3 ${POCKETFED_CAMERA_QCAM_REPO}/devices/google-sargo/camera-tests/wait-for-ready.py \
    --timeout 120 --settle 2 --capture-timeout 180 \
    --log ${POCKETFED_CAMERA_QCAM_WORKDIR}/capture.log \
    -- /usr/bin/python3 ${POCKETFED_CAMERA_QCAM_REPO}/devices/google-sargo/camera-tests/qcam-session/qcam-session.py \
    --output ${POCKETFED_CAMERA_QCAM_WORKDIR}/session \
    --startup-timeout 20 --timeout 90 --after-frames 300
