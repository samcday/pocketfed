#!/usr/bin/env bash
# Diagnostic only: run cam with its supported system heap in a private namespace.
set -euo pipefail
[[ $EUID == 0 ]] || { echo 'Run as root for the private mount namespace' >&2; exit 1; }
[[ -c /dev/dma_heap/system ]] || { echo 'System DMA heap is unavailable' >&2; exit 1; }
heap_major_hex=$(stat -c %t /dev/dma_heap/system)
heap_minor_hex=$(stat -c %T /dev/dma_heap/system)
exec unshare --mount --propagation private -- sh -ec '
    mount -t tmpfs -o mode=0700 tmpfs /dev/dma_heap
    mknod -m 0600 /dev/dma_heap/system c "$1" "$2"
    shift 2
    exec cam "$@"
' camera-system-heap "$((16#$heap_major_hex))" "$((16#$heap_minor_hex))" "$@"
