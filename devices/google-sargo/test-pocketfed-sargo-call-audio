#!/bin/sh
set -eu

repo_root="$(CDPATH='' cd -- "$(dirname "$0")/../.." && pwd)"
device_dir="$repo_root/devices/google-sargo"
audio_root="$device_dir/audio/root"
ucm_root="$audio_root/usr/share/alsa/ucm2"
q6voiced_conf="$audio_root/usr/share/q6voiced/q6voiced.conf"
containerfile="$device_dir/Containerfile"
verifier="$device_dir/pocketfed-verify-oci"
kernel_verifier="$device_dir/pocketfed-verify-kernel"

check_sha256() {
	expected=$1
	file=$2
	actual="$(sha256sum "$file")"
	actual="${actual%% *}"
	if [ "$actual" != "$expected" ]; then
		printf 'unexpected SHA-256 for %s: %s\n' "$file" "$actual" >&2
		exit 1
	fi
}

check_sha256 \
	bf1b9037b4f0db060d51e97d5155ee22848a2b2524151003cc4e51bbab361b66 \
	"$ucm_root/Google/sargo/sargo.conf"
check_sha256 \
	86f9c7229fc73d12e8d10882252937c24a1b46fcad74b2ddc319450cf25b77ac \
	"$ucm_root/Google/sargo/HiFi.conf"
check_sha256 \
	32c23f1586873cc3955a4c9295ce930232bcfbd02ad627147e84a970e851ffcb \
	"$ucm_root/Google/sargo/VoiceCall.conf"
check_sha256 \
	ebffd84f252e01bbd9887645b7dace140fd28f7d87f5e6e73fd6f539c7dd4733 \
	"$audio_root/usr/share/licenses/pocketfed-sargo-call-audio/LICENSE"

card_link="$ucm_root/conf.d/sdm660/Google Pixel 3a.conf"
test -L "$card_link"
test "$(readlink "$card_link")" = '../../Google/sargo/sargo.conf'
grep -Fq 'SectionUseCase."Voice Call"' "$ucm_root/Google/sargo/sargo.conf"
grep -Fq 'SectionUseCase."HiFi"' "$ucm_root/Google/sargo/sargo.conf"
if grep -Fq 'SectionUseCase."VoiceCall"' "$ucm_root/Google/sargo/sargo.conf"; then
	printf 'Sargo call-audio slice uses the non-canonical VoiceCall verb\n' >&2
	exit 1
fi

hifi="$ucm_root/Google/sargo/HiFi.conf"
voice_call="$ucm_root/Google/sargo/VoiceCall.conf"

grep -Fq 'SectionDevice."Earpiece"' "$voice_call"
for ucm_file in "$hifi" "$voice_call"; do
	grep -Fq 'SectionDevice."Speaker"' "$ucm_file"
	grep -Fq 'SectionDevice."Headphones"' "$ucm_file"
	grep -Fq 'SectionDevice."Headset"' "$ucm_file"
	grep -Fq 'SectionDevice."Mic"' "$ucm_file"
	grep -Fq 'PlaybackPriority 600' "$ucm_file"
	grep -Fq 'JackControl "Headphone Jack"' "$ucm_file"
	grep -Fq 'JackControl "Mic Jack"' "$ucm_file"
	grep -Fq "name='LPI_MI2S_RX_0 Audio Mixer MultiMedia2'" "$ucm_file"
	grep -Fq "name='MultiMedia3 Mixer LPI_MI2S_TX_3'" "$ucm_file"
done

if grep -Fq 'SectionDevice."Speakers"' "$hifi" "$voice_call"; then
	printf 'Sargo UCM uses the non-canonical plural Speakers device\n' >&2
	exit 1
fi
if grep -Fq 'SectionDevice."Microphone"' "$hifi" "$voice_call"; then
	printf 'Sargo UCM uses the non-canonical Microphone device\n' >&2
	exit 1
fi
if grep -Fq 'SectionDevice."Headset Mic"' "$hifi" "$voice_call"; then
	printf 'Sargo UCM uses the non-canonical Headset Mic device\n' >&2
	exit 1
fi
if grep -Fq 'INT0_MI2S_RX' "$hifi" "$voice_call" ||
	grep -Fq 'INT3_MI2S_TX' "$hifi" "$voice_call" ||
	grep -Fq 'Headset Jack' "$hifi" "$voice_call"; then
	printf 'Sargo UCM contains a stale DAI or jack control name\n' >&2
	exit 1
fi

test "$(cat "$q6voiced_conf")" = 'q6voice_card=0
q6voice_device=4'
grep -Fq 'COPY devices/google-sargo/audio/root/ /' "$containerfile"
grep -Fq 'ARG Q6VOICED_NEVRA=q6voiced-0.3.1-1788567722.fc46.aarch64' "$containerfile"
grep -Fq "q6voiced_nevra=\"\$Q6VOICED_NEVRA\"" "$containerfile"
grep -Fq "\"\$q6voiced_nevra\"" "$containerfile"
grep -Fq '319674d425c241f91cfbe1e19a1de6cb1078cee625f44d711fe45cef2a6f1bbc' "$containerfile"
grep -Fq 'q6voiced.service' "$containerfile"
grep -Fq 'systemctl is-enabled q6voiced.service' "$verifier"
grep -Fq 'SectionUseCase."HiFi"' "$verifier"
grep -Fq "test -s \"\$hifi\"" "$verifier"
grep -Fq '7.1.2-0.pocketfed.sdm670.5.fc*.aarch64' "$kernel_verifier"
grep -Fq "CONFIG_SND_SOC_SM8250=m" "$kernel_verifier"
grep -Fq "CONFIG_SND_SOC_CS35L36=m" "$kernel_verifier"
grep -Fq "snd-soc-sm8250" "$kernel_verifier"
grep -Fq "snd-soc-cs35l36" "$kernel_verifier"
if grep -Fq 'test ! -e /usr/share/alsa/ucm2/Google/sargo/HiFi.conf' "$verifier"; then
	printf 'Sargo OCI verifier still rejects the restored HiFi profile\n' >&2
	exit 1
fi

printf '%s\n' 'PocketFed Sargo call-audio tests passed'
