#!/bin/sh
set -eu

: "${QMI_LOG:?QMI_LOG is required}"
: "${QMI_SCENARIO:?QMI_SCENARIO is required}"

printf '%s\n' "$*" >>"$QMI_LOG"

action=
for arg in "$@"; do
	case "$arg" in
		--uim-noop)
			action=noop
			;;
		--uim-get-card-status)
			action=status
			;;
		--uim-get-slot-status)
			action=route-status
			;;
		--uim-switch-slot=*)
			action=route-switch
			;;
		--uim-change-provisioning-session=*)
			action=change
			;;
	esac
done

case "$action" in
	route-status)
		: "${QMI_ROUTE_SCENARIO:?QMI_ROUTE_SCENARIO is required}"
		: "${QMI_STATE:?QMI_STATE is required}"
		if [ "$QMI_ROUTE_SCENARIO" = initial-delay ] && [ ! -f "$QMI_STATE.initial" ]; then
			: >"$QMI_STATE.initial"
			exit 1
		fi
		if [ "$QMI_ROUTE_SCENARIO" = query-failure ]; then
			printf 'error: PRIVATE_IDENTIFIER\n' >&2
			exit 1
		fi
		active=1
		logical=1
		card2=present
		[ ! -f "$QMI_STATE.route" ] || active=2
		case "$QMI_ROUTE_SCENARIO" in
			already|return-tray) active=2 ;;
			no-card) card2=absent ;;
			logical2) logical=2 ;;
		esac
		if [ "$QMI_ROUTE_SCENARIO" = delayed ] && [ -f "$QMI_STATE.route" ] &&
		   [ ! -f "$QMI_STATE.readback" ]; then
			active=1
			: >"$QMI_STATE.readback"
		fi
		if [ "$QMI_ROUTE_SCENARIO" = return-tray ] && [ -f "$QMI_STATE.route" ]; then
			active=1
		fi
		for slot in 1 2; do
			[ "$QMI_ROUTE_SCENARIO" != missing-slot ] || [ "$slot" != 2 ] || break
			printf '  Physical slot %s:\n' "$slot"
			card=present
			[ "$slot" != 2 ] || card="$card2"
			printf '     Card status: %s\n' "$card"
			if [ "$slot" = "$active" ] || [ "$QMI_ROUTE_SCENARIO" = two-active ]; then
				printf '     Slot status: active\n    Logical slot: %s\n' "$logical"
			else
				printf '     Slot status: inactive\n'
			fi
			printf '           ICCID: PRIVATE_IDENTIFIER\n             EID: PRIVATE_IDENTIFIER\n'
		done
		;;
	route-switch)
		: "${QMI_ROUTE_SCENARIO:?QMI_ROUTE_SCENARIO is required}"
		case "$QMI_ROUTE_SCENARIO" in
			switch-failure)
				printf 'error: PRIVATE_IDENTIFIER\n' >&2
				exit 1 ;;
			ack-nochange) ;;
			noack-success)
				: >"$QMI_STATE.route"
				printf 'error: PRIVATE_IDENTIFIER\n' >&2
				exit 1 ;;
			*) : >"$QMI_STATE.route" ;;
		esac
		;;
	noop)
		[ "$QMI_SCENARIO" != absent ]
		;;
	status)
		case "$QMI_SCENARIO" in
			blank)
				cat <<'EOF'
Slot [2]:
  Application type: 'unknown (0)'
  Application ID:
Primary GW:   session doesn't exist
EOF
				;;
			usim)
				cat <<'EOF'
Slot [1]:
  Application type: 'usim (2)'
  Application ID:
    A0:00:00:00:87:10:02
Primary GW:   session doesn't exist
EOF
				;;
			esim-mapped)
				# Synthetic applications for an eUICC mapped to logical slot 1.
				cat <<'EOF'
Slot [1]:
  Card state: 'present'
  Application type: 'isim (5)'
  Application ID:
    A0:00:00:00:87:10:04
  Application type: 'usim (2)'
  Application ID:
    A0:00:00:00:87:10:02
Primary GW: session doesn't exist
EOF
				;;
			dual)
				cat <<'EOF'
Slot [2]:
  Application type: 'usim (2)'
  Application ID:
    E0:00:00:00:87:10:04
Slot [1]:
  Application type: 'usim (2)'
  Application ID:
    A0:00:00:00:87:10:02
Primary GW: session doesn't exist
EOF
				;;
			stale)
				cat <<'EOF'
Slot [1]:
  Application type: 'usim (2)'
  Application ID:

  Application type: 'unknown (0)'
  Application ID:
    A0:00:00:00:87:10:99
Slot [2]:
  Application type: 'unknown (0)'
  Application ID:
    E0:00:00:00:87:10:99
Primary GW: session doesn't exist
EOF
				;;
			delayed)
				: "${QMI_STATE:?QMI_STATE is required for delayed scenario}"
				attempt=0
				if [ -f "$QMI_STATE" ]; then
					attempt="$(cat "$QMI_STATE")"
				fi
				printf '%s\n' "$((attempt + 1))" >"$QMI_STATE"
				if [ "$attempt" -eq 0 ]; then
					cat <<'EOF'
Slot [2]:
  Application type: 'unknown (0)'
  Application ID:
Primary GW: session doesn't exist
EOF
				else
					cat <<'EOF'
Slot [1]:
  Application type: 'usim (2)'
  Application ID:
    A0:00:00:00:87:10:02
Primary GW: session doesn't exist
EOF
				fi
				;;
			existing)
				cat <<'EOF'
Slot [1]:
  Application type: 'usim (2)'
  Application ID:
    A0:00:00:00:87:10:02
Primary GW:   slot 1, application 1
EOF
				;;
			deactivate-failure)
				cat <<'EOF'
Slot [1]:
  Application type: 'usim (2)'
  Application ID:
    A0:00:00:00:87:10:02
Primary GW:   slot 1, application 1
EOF
				;;
			*)
				exit 2
				;;
		esac
		;;
	change)
		if [ "$QMI_SCENARIO" = deactivate-failure ] &&
		   printf '%s\n' "$*" | grep -Fq 'activate=no'; then
			exit 1
		fi
		;;
	*)
		exit 2
		;;
esac
