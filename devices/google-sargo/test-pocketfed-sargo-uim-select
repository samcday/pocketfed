#!/bin/sh
set -eu

repo_root="$(CDPATH='' cd -- "$(dirname "$0")/../.." && pwd)"
helper="$repo_root/devices/google-sargo/pocketfed-sargo-uim-select"
fake_bin="$repo_root/devices/google-sargo/tests/bin"
unit="$repo_root/devices/google-sargo/pocketfed-sargo-uim-select.service"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT HUP INT TERM

log="$tmp/qmi.log"
output="$tmp/output"
state="$tmp/state"

fail() {
	printf 'sargo UIM helper test failed: %s\n' "$*" >&2
	exit 1
}

run_case() {
	scenario=$1
	: >"$log"
	rm -f "$state"
	env \
		PATH="$fake_bin:$PATH" \
		QMI_LOG="$log" \
		QMI_SCENARIO="$scenario" \
		QMI_STATE="$state" \
		MODEM_WAIT_SECONDS=0 \
		SIM_WAIT_SECONDS="${2:-0}" \
		PREFERRED_PHYSICAL_SLOT= \
		sh "$helper" >"$output"
}

assert_no_changes() {
	if grep -Fq -- '--uim-change-provisioning-session=' "$log"; then
		fail "unexpected provisioning change in $1 case"
	fi
}

assert_changes() {
	expected=$1
	actual="$(grep -F -- '--uim-change-provisioning-session=' "$log" || :)"
	if [ "$actual" != "$expected" ]; then
		printf 'expected provisioning changes:\n%s\nactual provisioning changes:\n%s\n' \
			"$expected" "$actual" >&2
		exit 1
	fi
}

run_case absent
assert_no_changes absent
grep -Fq 'UIM service did not appear' "$output" ||
	fail 'absent modem did not fail open'

run_case blank
assert_no_changes blank
grep -Fq 'no usable USIM application detected' "$output" ||
	fail 'blank eUICC did not fail open'

run_case usim
assert_changes "--silent --device=qrtr://0 --uim-change-provisioning-session=slot=1,activate=yes,session-type=primary-gw-provisioning,aid=A0:00:00:00:87:10:02"
grep -Fq 'selecting the USIM application in card-status slot 1' "$output" ||
	fail 'usable USIM was not selected'
if grep -Eq -- '--uim-get-slot-status|--uim-switch-slot' "$log"; then
	fail 'default behavior queried or changed physical routing'
fi

run_case esim-mapped
assert_changes "--silent --device=qrtr://0 --uim-change-provisioning-session=slot=1,activate=yes,session-type=primary-gw-provisioning,aid=A0:00:00:00:87:10:02"
grep -Fq 'selecting the USIM application in card-status slot 1' "$output" ||
	fail 'mapped eUICC USIM was not selected in its logical card-status slot'
if grep -Eq -- '--uim-switch-slot|--uim-set-slot-mapping' "$log"; then
	fail 'application selection must not change physical-slot routing'
fi

run_case dual
assert_changes "--silent --device=qrtr://0 --uim-change-provisioning-session=slot=1,activate=yes,session-type=primary-gw-provisioning,aid=A0:00:00:00:87:10:02"
grep -Fq 'selecting the USIM application in card-status slot 1' "$output" ||
	fail 'preferred card-status slot was not used'

run_case stale
assert_no_changes stale
grep -Fq 'no usable USIM application detected' "$output" ||
	fail 'a stale application ID leaked into card-status selection'

run_case delayed 1
assert_changes "--silent --device=qrtr://0 --uim-change-provisioning-session=slot=1,activate=yes,session-type=primary-gw-provisioning,aid=A0:00:00:00:87:10:02"
grep -Fq 'selecting the USIM application in card-status slot 1' "$output" ||
	fail 'delayed USIM enumeration was not retried'

run_case existing
assert_changes "--silent --device=qrtr://0 --uim-change-provisioning-session=activate=no,session-type=primary-gw-provisioning
--silent --device=qrtr://0 --uim-change-provisioning-session=slot=1,activate=yes,session-type=primary-gw-provisioning,aid=A0:00:00:00:87:10:02"
grep -Fq 'clearing the existing Primary-GW provisioning session' "$output" ||
	fail 'existing Primary-GW session was not cleared'

run_case deactivate-failure
assert_changes "--silent --device=qrtr://0 --uim-change-provisioning-session=activate=no,session-type=primary-gw-provisioning
--silent --device=qrtr://0 --uim-change-provisioning-session=slot=1,activate=yes,session-type=primary-gw-provisioning,aid=A0:00:00:00:87:10:02"
grep -Fq 'existing Primary-GW session disappeared while clearing it' "$output" ||
	fail 'a disappearing provisioning session did not fail open'

: >"$log"
if env \
	PATH="$fake_bin:$PATH" \
	QMI_LOG="$log" \
	QMI_SCENARIO=usim \
	PREFERRED_SLOT=invalid \
	sh "$helper" >"$output" 2>&1; then
	fail 'an invalid preferred slot was accepted'
fi
grep -Fq 'invalid preferred card-status slot' "$output" ||
	fail 'an invalid preferred slot was not diagnosed'

run_route_case() {
	route_scenario=$1
	: >"$log"
	rm -f "$state.route" "$state.readback" "$state.initial"
	env PATH="$fake_bin:$PATH" QMI_LOG="$log" QMI_STATE="$state" \
		QMI_SCENARIO="${5:-esim-mapped}" QMI_ROUTE_SCENARIO="$route_scenario" \
		PREFERRED_PHYSICAL_SLOT="${2:-2}" PREFERRED_SLOT="${3:-1}" \
		MODEM_WAIT_SECONDS=0 SIM_WAIT_SECONDS=0 SLOT_WAIT_SECONDS="${4:-0}" \
		sh "$helper" >"$output" 2>&1
}

assert_private_output() {
	if grep -Fq PRIVATE_IDENTIFIER "$output"; then
		fail "slot query or switch leaked an identifier in $1"
	fi
}

for scenario in switch noack-success initial-delay delayed return-tray; do
	wanted=2
	[ "$scenario" != return-tray ] || wanted=1
	run_route_case "$scenario" "$wanted" 1 1
	[ "$(grep -Fc -- "--uim-switch-slot=$wanted" "$log")" = 1 ] ||
		fail "$scenario did not issue exactly one switch"
	grep -Fq "verified physical slot $wanted mapped to logical slot 1" "$output" ||
		fail "$scenario did not verify mapping"
	assert_changes "--silent --device=qrtr://0 --uim-change-provisioning-session=slot=1,activate=yes,session-type=primary-gw-provisioning,aid=A0:00:00:00:87:10:02"
	assert_private_output "$scenario"
done

run_route_case already
if grep -Fq -- '--uim-switch-slot=' "$log"; then
	fail 'already-selected physical slot was switched again'
fi
grep -Fq 'physical slot 2 is already mapped' "$output" || fail 'no-op mapping not diagnosed'
assert_private_output already

for scenario in query-failure no-card two-active logical2 missing-slot; do
	if run_route_case "$scenario"; then
		fail "unsafe $scenario routing was accepted"
	fi
	assert_no_changes "$scenario"
	if grep -Fq -- '--uim-switch-slot=' "$log"; then
		fail "unsafe $scenario issued a slot switch"
	fi
	assert_private_output "$scenario"
done

for scenario in ack-nochange switch-failure; do
	if run_route_case "$scenario"; then
		fail "$scenario reported success without verified routing"
	fi
	assert_no_changes "$scenario"
	[ "$(grep -Fc -- '--uim-switch-slot=' "$log")" = 1 ] || fail 'switch was retried'
	grep -Fq 'refusing application selection' "$output" || fail 'bad mapping not diagnosed'
	assert_private_output "$scenario"
done

for wanted in 0 3 invalid; do
	if run_route_case already "$wanted"; then fail 'invalid physical slot accepted'; fi
	[ ! -s "$log" ] || fail 'invalid setting reached the modem'
done
if run_route_case already 2 2; then fail 'physical/logical slot confusion accepted'; fi
[ ! -s "$log" ] || fail 'conflicting slot indices reached the modem'
if run_route_case already 2 1 invalid; then fail 'invalid wait accepted'; fi
[ ! -s "$log" ] || fail 'invalid wait reached the modem'
for scenario in blank absent; do
	if run_route_case already 2 1 0 "$scenario"; then
		fail "explicit preference silently succeeded with $scenario modem/card"
	fi
	assert_no_changes "$scenario"
done

for config in /usr/lib/pocketfed/sargo-sim.conf /etc/pocketfed/sargo-sim.conf; do
	grep -Fxq "EnvironmentFile=-$config" "$unit" || fail 'unit does not load SIM preference'
done
grep -Fxq 'Before=ModemManager.service' "$unit" || fail 'UIM must precede MM'

printf 'sargo UIM helper tests passed\n'
