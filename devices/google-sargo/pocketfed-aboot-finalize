#!/usr/bin/python3
"""Finalize a PocketFed ABLX Android boot image for one OSTree deployment."""

from __future__ import annotations

import argparse
import hashlib
import os
from pathlib import Path
import re
import struct
import subprocess
import sys
import tempfile
from typing import BinaryIO


BOOT_MAGIC = b"ANDROID!"
BOOT_HEADER_V2_SIZE = 1660
BOOT_CMDLINE_OFFSET = 64
BOOT_CMDLINE_SIZE = 512
BOOT_ID_OFFSET = 576
BOOT_ID_SIZE = 32
BOOT_EXTRA_CMDLINE_OFFSET = 608
BOOT_EXTRA_CMDLINE_SIZE = 1024


class FinalizeError(Exception):
    pass


def u32(data: bytes | bytearray, offset: int) -> int:
    return struct.unpack_from("<I", data, offset)[0]


def u64(data: bytes | bytearray, offset: int) -> int:
    return struct.unpack_from("<Q", data, offset)[0]


def align_up(value: int, alignment: int) -> int:
    return (value + alignment - 1) & -alignment


def copy_range(source: BinaryIO, output: BinaryIO, offset: int, size: int) -> None:
    source.seek(offset)
    remaining = size
    while remaining:
        chunk = source.read(min(remaining, 1024 * 1024))
        if not chunk:
            raise FinalizeError("template boot image ended inside a payload")
        output.write(chunk)
        remaining -= len(chunk)


def hash_range(digest: object, source: BinaryIO, offset: int, size: int) -> None:
    source.seek(offset)
    remaining = size
    while remaining:
        chunk = source.read(min(remaining, 1024 * 1024))
        if not chunk:
            raise FinalizeError("template boot image ended inside a payload")
        digest.update(chunk)
        remaining -= len(chunk)


def copy_file(source: BinaryIO, output: BinaryIO) -> None:
    while chunk := source.read(1024 * 1024):
        output.write(chunk)


def hash_file(digest: object, source: BinaryIO) -> None:
    source.seek(0)
    while chunk := source.read(1024 * 1024):
        digest.update(chunk)


def pad_file(output: BinaryIO, alignment: int) -> None:
    padding = (-output.tell()) % alignment
    while padding:
        chunk_size = min(padding, 1024 * 1024)
        output.write(b"\0" * chunk_size)
        padding -= chunk_size


def resolve_deployment_artifacts(template: Path) -> tuple[Path, Path]:
    match = re.fullmatch(r"aboot-(.+)\.img", template.name)
    if match:
        kver = match.group(1)
        kernel = template.with_name(f"vmlinuz-{kver}")
        initramfs = template.with_name(f"initramfs-{kver}.img")
    elif template.name == "aboot.img" and template.parent.name:
        kernel = template.with_name("vmlinuz")
        initramfs = template.with_name("initramfs.img")
    else:
        raise FinalizeError(
            "template name must be aboot-KERNEL_VERSION.img or a module-directory aboot.img"
        )

    for description, path in (("kernel", kernel), ("initramfs", initramfs)):
        if not path.is_file():
            raise FinalizeError(f"deployment {description} is missing: {path}")
    return kernel, initramfs


def read_static_options(path: Path) -> str:
    try:
        contents = path.read_text(encoding="utf-8")
    except OSError as error:
        raise FinalizeError(f"cannot read static kernel arguments from {path}: {error}") from error
    if "\0" in contents:
        raise FinalizeError(f"static kernel argument file contains a NUL byte: {path}")
    options = " ".join(contents.split())
    if not options:
        raise FinalizeError(f"static kernel argument file is empty: {path}")
    return options


def encode_cmdline(static_options: str, deployment_options: str) -> bytes:
    deployment_options = deployment_options.strip()
    if not deployment_options:
        raise FinalizeError("deployment kernel arguments are empty")
    if "\0" in deployment_options or "\n" in deployment_options or "\r" in deployment_options:
        raise FinalizeError("deployment kernel arguments contain a forbidden control character")

    cmdline = f"<S> {static_options} {deployment_options} <E>".encode("utf-8")
    capacity = BOOT_CMDLINE_SIZE + BOOT_EXTRA_CMDLINE_SIZE
    if len(cmdline) > capacity:
        raise FinalizeError(
            f"Android boot image command line is too long: {len(cmdline)} > {capacity} bytes"
        )
    return cmdline


def repack_boot_image(
    template_path: Path, ramdisk_path: Path, cmdline: bytes, output_path: Path
) -> None:
    if template_path.resolve() == output_path.resolve():
        raise FinalizeError("output path must differ from the template boot image")

    try:
        template_size = template_path.stat().st_size
        ramdisk_size = ramdisk_path.stat().st_size
    except OSError as error:
        raise FinalizeError(f"cannot stat boot image input: {error}") from error
    if ramdisk_size == 0:
        raise FinalizeError("assembled ABLX ramdisk is empty")
    if ramdisk_size > 0xFFFFFFFF:
        raise FinalizeError(f"assembled ABLX ramdisk is too large: {ramdisk_size} bytes")

    try:
        with template_path.open("rb") as template:
            prefix = template.read(48)
            if len(prefix) != 48 or prefix[:8] != BOOT_MAGIC:
                raise FinalizeError("template is not an Android boot image")

            kernel_size = u32(prefix, 8)
            old_ramdisk_size = u32(prefix, 16)
            second_size = u32(prefix, 24)
            page_size = u32(prefix, 36)
            header_version = u32(prefix, 40)
            if header_version != 2:
                raise FinalizeError(
                    f"unsupported Android boot image header version: {header_version}"
                )
            if page_size < BOOT_HEADER_V2_SIZE or page_size & (page_size - 1):
                raise FinalizeError(f"invalid Android boot image page size: {page_size}")

            template.seek(0)
            header = bytearray(template.read(page_size))
            if len(header) != page_size:
                raise FinalizeError("template is shorter than its Android header page")
            if u32(header, 1644) != BOOT_HEADER_V2_SIZE:
                raise FinalizeError(
                    f"unexpected Android boot header size: {u32(header, 1644)}"
                )

            recovery_size = u32(header, 1632)
            dtb_size = u32(header, 1648)
            if kernel_size == 0 or old_ramdisk_size == 0 or dtb_size == 0:
                raise FinalizeError("template kernel, ramdisk, and DTB must all be non-empty")

            kernel_offset = page_size
            old_ramdisk_offset = align_up(kernel_offset + kernel_size, page_size)
            second_offset = align_up(old_ramdisk_offset + old_ramdisk_size, page_size)
            recovery_offset = align_up(second_offset + second_size, page_size)
            dtb_offset = align_up(recovery_offset + recovery_size, page_size)
            template_end = align_up(dtb_offset + dtb_size, page_size)
            if template_size != template_end:
                raise FinalizeError(
                    "template has unsupported trailing data or truncated payloads: "
                    f"{template_size} != {template_end} bytes"
                )

            if recovery_size and u64(header, 1636) != recovery_offset:
                raise FinalizeError(
                    "template recovery DTBO offset does not match its payload layout"
                )

            with ramdisk_path.open("rb") as ramdisk:
                digest = hashlib.sha1()
                hash_range(digest, template, kernel_offset, kernel_size)
                digest.update(struct.pack("<I", kernel_size))
                hash_file(digest, ramdisk)
                digest.update(struct.pack("<I", ramdisk_size))
                hash_range(digest, template, second_offset, second_size)
                digest.update(struct.pack("<I", second_size))
                hash_range(digest, template, recovery_offset, recovery_size)
                digest.update(struct.pack("<I", recovery_size))
                hash_range(digest, template, dtb_offset, dtb_size)
                digest.update(struct.pack("<I", dtb_size))

                struct.pack_into("<I", header, 16, ramdisk_size)
                header[BOOT_CMDLINE_OFFSET : BOOT_CMDLINE_OFFSET + BOOT_CMDLINE_SIZE] = (
                    cmdline[:BOOT_CMDLINE_SIZE].ljust(BOOT_CMDLINE_SIZE, b"\0")
                )
                header[BOOT_ID_OFFSET : BOOT_ID_OFFSET + BOOT_ID_SIZE] = digest.digest().ljust(
                    BOOT_ID_SIZE, b"\0"
                )
                header[
                    BOOT_EXTRA_CMDLINE_OFFSET : BOOT_EXTRA_CMDLINE_OFFSET
                    + BOOT_EXTRA_CMDLINE_SIZE
                ] = cmdline[BOOT_CMDLINE_SIZE:].ljust(BOOT_EXTRA_CMDLINE_SIZE, b"\0")

                new_ramdisk_offset = align_up(page_size + kernel_size, page_size)
                new_second_offset = align_up(
                    new_ramdisk_offset + ramdisk_size, page_size
                )
                new_recovery_offset = align_up(new_second_offset + second_size, page_size)
                if recovery_size:
                    struct.pack_into("<Q", header, 1636, new_recovery_offset)

                with output_path.open("wb") as output:
                    output.write(header)
                    copy_range(template, output, kernel_offset, kernel_size)
                    pad_file(output, page_size)
                    ramdisk.seek(0)
                    copy_file(ramdisk, output)
                    pad_file(output, page_size)
                    copy_range(template, output, second_offset, second_size)
                    pad_file(output, page_size)
                    copy_range(template, output, recovery_offset, recovery_size)
                    pad_file(output, page_size)
                    copy_range(template, output, dtb_offset, dtb_size)
                    pad_file(output, page_size)
                    output.flush()
                    os.fsync(output.fileno())
    except OSError as error:
        raise FinalizeError(f"cannot repack Android boot image: {error}") from error


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Rebuild the ABLX ramdisk in an Android v2 boot image and bind it to "
            "one OSTree deployment's kernel arguments."
        )
    )
    parser.add_argument("--options", required=True, help="deployment kernel argument string")
    parser.add_argument(
        "--append-options-file",
        required=True,
        type=Path,
        help="device-static kernel arguments placed before deployment arguments",
    )
    parser.add_argument(
        "--assembler",
        type=Path,
        default=Path(__file__).with_name("abl-exorcist-assembler"),
        help=argparse.SUPPRESS,
    )
    parser.add_argument("template", type=Path, help="prebuilt Android boot image template")
    parser.add_argument("output", type=Path, help="finalized Android boot image")
    return parser.parse_args()


def run() -> None:
    args = parse_args()
    if not args.template.is_file():
        raise FinalizeError(f"Android boot image template is missing: {args.template}")
    if not args.assembler.is_file() or not os.access(args.assembler, os.X_OK):
        raise FinalizeError(f"ABLX assembler is missing or not executable: {args.assembler}")

    kernel, initramfs = resolve_deployment_artifacts(args.template)
    static_options = read_static_options(args.append_options_file)
    cmdline = encode_cmdline(static_options, args.options)

    args.output.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="pocketfed-aboot.", dir=args.output.parent) as tmp:
        ramdisk = Path(tmp) / "ablx-ramdisk.img"
        try:
            with ramdisk.open("wb") as output:
                subprocess.run(
                    [str(args.assembler), "--ramdisk", str(kernel), str(initramfs)],
                    check=True,
                    stdout=output,
                )
        except (OSError, subprocess.CalledProcessError) as error:
            raise FinalizeError(f"cannot assemble deployment ABLX ramdisk: {error}") from error
        repack_boot_image(args.template, ramdisk, cmdline, args.output)

    print(
        "pocketfed-aboot-finalize: "
        f"finalized {args.output} from {kernel.name} and {initramfs.name}",
        file=sys.stderr,
    )


def main() -> int:
    try:
        run()
    except FinalizeError as error:
        print(f"pocketfed-aboot-finalize: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
