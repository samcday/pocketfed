#!/usr/bin/env bash
set -euo pipefail

rootdir=/
options=
config_path=
verbose=0
ostree_root=
slot_switch_policy=qbootctl
generated_boot_image=
by_partlabel_dir=${POCKETFED_BY_PARTLABEL_DIR:-/dev/disk/by-partlabel}
allow_regular_boot_partition=${POCKETFED_ALLOW_REGULAR_BOOT_PARTITION:-0}
by_partlabel_overridden=0
allow_regular_overridden=0
[[ -v POCKETFED_BY_PARTLABEL_DIR ]] && by_partlabel_overridden=1
[[ -v POCKETFED_ALLOW_REGULAR_BOOT_PARTITION ]] && allow_regular_overridden=1

usage() {
    cat >&2 <<'EOF'
Usage: aboot-deploy [OPTIONS] aboot_img

Finalize when supported, then deploy an Android boot image for an OSTree
Android A/B sysroot.

Options:
  -c, --config PATH      Device policy config supplied by OSTree
  -o, --options CMDLINE  Kernel options for the deployment being staged
  -r, --root PATH        OSTree sysroot root (default: /)
  -v, --verbose          Show progress
  -h, --help             Show this help
EOF
}

die() {
    printf 'aboot-deploy: %s\n' "$*" >&2
    exit 1
}

log() {
    (( verbose )) || return 0
    printf 'aboot-deploy: %s\n' "$*" >&2
}

require_cmd() {
    command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

cleanup() {
    [[ -z "$generated_boot_image" ]] || rm -f -- "$generated_boot_image"
}

trap cleanup EXIT

cmdline_key() {
    local cmdline=$1 key=$2 token

    for token in $cmdline; do
        if [[ "$token" == "$key="* ]]; then
            printf '%s' "${token#"$key="}"
            return 0
        fi
    done

    return 1
}

root_path() {
    local path=$1
    if [[ "$rootdir" == / ]]; then
        printf '/%s' "${path#/}"
    else
        printf '%s/%s' "$rootdir" "${path#/}"
    fi
}

validate_partition_test_overrides() {
    local resolved_dir

    case "$allow_regular_boot_partition" in
        0 | 1) ;;
        *) die 'POCKETFED_ALLOW_REGULAR_BOOT_PARTITION must be exactly 0 or 1' ;;
    esac
    if (( ! by_partlabel_overridden && ! allow_regular_overridden )); then
        return 0
    fi

    [[ "$rootdir" != / ]] ||
        die 'boot-partition test overrides are forbidden for the production root'
    resolved_dir=$(realpath -e -- "$by_partlabel_dir") ||
        die "cannot resolve test by-partlabel directory: $by_partlabel_dir"
    [[ -d "$resolved_dir" ]] ||
        die "test by-partlabel path is not a directory: $by_partlabel_dir"
    case "$resolved_dir" in
        "$rootdir"/*) ;;
        *) die 'test by-partlabel directory escapes the alternate sysroot' ;;
    esac
    by_partlabel_dir=$resolved_dir
}

validate_test_target_partition() {
    local resolved_target

    (( by_partlabel_overridden || allow_regular_overridden )) || return 0
    resolved_target=$(realpath -e -- "$target_partition") ||
        die "cannot resolve test target boot partition: $target_partition"
    case "$resolved_target" in
        "$rootdir"/*) ;;
        *) die 'test target boot partition escapes the alternate sysroot' ;;
    esac
    target_partition=$resolved_target
}

load_config() {
    local path line
    local policy_re='^[[:space:]]*POCKETFED_SLOT_SWITCH[[:space:]]*=[[:space:]]*(qbootctl|disabled)[[:space:]]*$'
    local key_re='^[[:space:]]*POCKETFED_SLOT_SWITCH([[:space:]]|=|$)'
    local policy_seen=0

    [[ -n "$config_path" ]] || return 0

    path=$(root_path "$config_path")
    if [[ ! -e "$path" && ! -L "$path" ]]; then
        log "device policy config is absent; using legacy qbootctl slot switching"
        return 0
    fi
    [[ -f "$path" ]] || die "device policy config is not a regular file: $config_path"

    while IFS= read -r line || [[ -n "$line" ]]; do
        line=${line%$'\r'}
        line=${line%%#*}
        if [[ "$line" =~ $key_re ]]; then
            [[ "$line" =~ $policy_re ]] \
                || die "invalid POCKETFED_SLOT_SWITCH policy in $config_path"
            (( policy_seen == 0 )) \
                || die "duplicate POCKETFED_SLOT_SWITCH policy in $config_path"
            slot_switch_policy=${BASH_REMATCH[1]}
            policy_seen=1
        fi
    done <"$path"

    (( policy_seen == 1 )) \
        || die "missing POCKETFED_SLOT_SWITCH policy in $config_path"

    log "slot switch policy: $slot_switch_policy"
}

resolve_boot_image() {
    local image=$1

    if [[ "$image" == /* ]]; then
        root_path "/boot/${image#/}"
    else
        root_path "/boot/$image"
    fi
}

finalize_boot_image() {
    local finalizer static_options_file

    finalizer=$(root_path /usr/libexec/pocketfed-aboot-finalize)
    [[ -e "$finalizer" || -L "$finalizer" ]] || return 0
    [[ -x "$finalizer" ]] || die "Android boot image finalizer is not executable: $finalizer"

    static_options_file=$(
        root_path "/ostree/$deployment_rel/usr/lib/ostree-boot/aboot-kargs"
    )
    [[ -f "$static_options_file" ]] \
        || die 'Android boot image finalizer is installed but the staged deployment has no aboot-kargs'

    generated_boot_image=$(mktemp "${TMPDIR:-/var/tmp}/pocketfed-aboot.XXXXXX.img") \
        || die 'cannot create temporary Android boot image'
    "$finalizer" \
        --options "$options" \
        --append-options-file "$static_options_file" \
        "$boot_image" "$generated_boot_image" \
        || die 'failed to finalize Android boot image'
    [[ -s "$generated_boot_image" ]] \
        || die 'Android boot image finalizer produced an empty image'

    boot_image=$generated_boot_image
    log 'finalized Android boot image with deployment kernel, initramfs, and arguments'
}

resolve_ostree_deployment() {
    local ostree_arg target resolved

    ostree_arg=$(cmdline_key "$options" ostree) \
        || die 'missing ostree= in kernel options passed by OSTree'
    [[ "$ostree_arg" == /ostree/* ]] \
        || die "unsupported ostree target outside /ostree: $ostree_arg"

    target=$(root_path "$ostree_arg")
    [[ -e "$target" || -L "$target" ]] \
        || die "OSTree target does not exist in sysroot: $ostree_arg"

    resolved=$(realpath "$target")
    case "$resolved" in
        "$ostree_root"/*) ;;
        *) die "resolved OSTree target escapes /ostree: $resolved" ;;
    esac

    deployment_rel=${resolved#"$ostree_root"/}
    log "resolved staged deployment: /ostree/$deployment_rel"
}

root_link_path() {
    local slot=$1
    printf '%s/root.%s' "$ostree_root" "$slot"
}

has_root_links() {
    local root_a root_b
    root_a=$(root_link_path a)
    root_b=$(root_link_path b)
    [[ -e "$root_a" || -L "$root_a" || -e "$root_b" || -L "$root_b" ]]
}

create_root_link() {
    local slot=$1 target=$2 link tmp

    link=$(root_link_path "$slot")
    install -d "$(dirname "$link")"
    tmp="$link.tmp.$$"
    rm -f "$tmp"
    ln -s "$target" "$tmp"
    mv -Tf "$tmp" "$link"
    log "linked $link -> $target"
}

current_slot_suffix() {
    local suffix

    suffix=$(qbootctl -x)
    suffix=${suffix//$'\n'/}
    suffix=${suffix//$'\r'/}
    printf '%s' "$suffix"
}

select_target_slot() {
    local suffix=$1

    case "$suffix" in
        _a | a)
            current_slot=a
            target_slot=b
            target_slot_num=1
            ;;
        _b | b)
            current_slot=b
            target_slot=a
            target_slot_num=0
            ;;
        *)
            die "unsupported current slot suffix from qbootctl: $suffix"
            ;;
    esac

    target_partition="$by_partlabel_dir/boot_$target_slot"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h | --help)
            usage
            exit 0
            ;;
        -c | --config)
            [[ $# -ge 2 ]] || die "$1 requires an argument"
            config_path=$2
            shift 2
            ;;
        -o | --options)
            [[ $# -ge 2 ]] || die "$1 requires an argument"
            options=$2
            shift 2
            ;;
        -r | --root)
            [[ $# -ge 2 ]] || die "$1 requires an argument"
            rootdir=$2
            shift 2
            ;;
        -v | --verbose)
            verbose=1
            shift
            ;;
        -l | --local)
            die '--local kernel-install mode is not supported by PocketFed aboot-deploy'
            ;;
        --)
            shift
            break
            ;;
        -* )
            die "unknown option: $1"
            ;;
        *)
            break
            ;;
    esac
done

[[ $# -eq 1 ]] || die 'exactly one aboot image argument is required'
[[ -n "$options" ]] || die '--options is required'

aboot_arg=$1
rootdir_input=$rootdir
rootdir=$(realpath -e -- "$rootdir_input") ||
    die "cannot resolve OSTree sysroot: $rootdir_input"
[[ -d "$rootdir" ]] || die "OSTree sysroot is not a directory: $rootdir_input"
validate_partition_test_overrides
ostree_root=$(realpath "$(root_path /ostree)") \
    || die "cannot resolve OSTree root: $(root_path /ostree)"
deployment_rel=

load_config
resolve_ostree_deployment

if ! has_root_links; then
    create_root_link a "$deployment_rel"
    create_root_link b "$deployment_rel"
    log 'initialized /ostree/root.a and /ostree/root.b; not flashing during first install'
    exit 0
fi

[[ "$slot_switch_policy" == qbootctl ]] \
    || die 'slot switching is disabled for this device; refusing to flash or activate the staged deployment'

require_cmd qbootctl
require_cmd blockdev
require_cmd cmp
require_cmd dd

boot_image=$(resolve_boot_image "$aboot_arg")
[[ -s "$boot_image" ]] || die "missing or empty boot image: $boot_image"
finalize_boot_image
[[ -s "$boot_image" ]] || die 'selected boot image is empty after finalization'

select_target_slot "$(current_slot_suffix)"
validate_test_target_partition
if [[ "$allow_regular_boot_partition" == 1 ]]; then
    [[ -f "$target_partition" && ! -L "$target_partition" ]] \
        || die "test target boot partition is not a regular file: $target_partition"
else
    [[ -b "$target_partition" ]] \
        || die "target boot partition is not a block device: $target_partition"
fi

image_size=$(stat -c %s "$boot_image")
partition_size=$(blockdev --getsize64 "$target_partition")
(( image_size <= partition_size )) \
    || die "boot image is too large for $target_partition: $image_size > $partition_size"

log "writing $boot_image to inactive slot $target_slot ($target_partition); current slot is $current_slot"
dd if="$boot_image" of="$target_partition" bs=4M conv=fsync status=none
cmp --silent --bytes="$image_size" "$boot_image" "$target_partition" \
    || die "inactive boot image readback did not match: $target_partition"
log "verified inactive boot image readback on $target_partition"
create_root_link "$target_slot" "$deployment_rel"
sync
qbootctl -s "$target_slot_num" >/dev/null
log "set active slot to $target_slot"
