From: Sam Day <me@samcday.com>
Subject: [PATCH] pipeline: match sensor flips to the requested Bayer order

The IMX363 starts with both flips set, exposing BGGR10. The Pixel 3a config
requests RGGB10; rejecting the TRY format leaves mismatched pads and causes
STREAMON EPIPE. A preceding libcamera run hid this by clearing both flips.

Match the requested Bayer phase through supported layout controls on the
sensor before setting formats downstream. Preserve a matching layout, ignore
unsupported formats and bit-depth changes, and restore partial writes on
failure. No public ABI or configuration extension is needed.

--- a/src/pipeline.c
+++ b/src/pipeline.c
@@ -243,6 +243,64 @@
 	}
 }
 
+/* Red-pixel coordinates within each uncompressed Bayer sample group.
+ * A horizontal/vertical flip toggles bit 0/1 respectively. */
+static int
+bayer_phase(uint32_t code)
+{
+#define BAYER_GROUP(bits) \
+	case MEDIA_BUS_FMT_SRGGB##bits##_1X##bits: return (bits << 2) | 0; \
+	case MEDIA_BUS_FMT_SGRBG##bits##_1X##bits: return (bits << 2) | 1; \
+	case MEDIA_BUS_FMT_SGBRG##bits##_1X##bits: return (bits << 2) | 2; \
+	case MEDIA_BUS_FMT_SBGGR##bits##_1X##bits: return (bits << 2) | 3;
+	switch (code) {
+		BAYER_GROUP(8)
+		BAYER_GROUP(10)
+		BAYER_GROUP(12)
+		BAYER_GROUP(14)
+		BAYER_GROUP(16)
+		default: return -1;
+	}
+#undef BAYER_GROUP
+}
+
+/* Set layout controls only when the requested Bayer order requires it.
+ * No public structures or config syntax change, and non-sensor pads do not
+ * call this helper. Restore earlier writes if a later control is unavailable. */
+static int
+match_bayer_order(int fd, uint32_t actual, uint32_t requested)
+{
+	int before = bayer_phase(actual), after = bayer_phase(requested);
+	if (before < 0 || after < 0 || (before >> 2) != (after >> 2))
+		return 0;
+	unsigned changed = 0;
+	struct v4l2_control controls[2] = {
+		{ .id = V4L2_CID_HFLIP }, { .id = V4L2_CID_VFLIP }
+	};
+	int original[2] = {0};
+	for (unsigned axis = 0; axis < 2; axis++) {
+		if (!((before ^ after) & (1U << axis)))
+			continue;
+		if (xioctl(fd, VIDIOC_G_CTRL, &controls[axis]) == -1)
+			goto restore;
+		original[axis] = controls[axis].value;
+		controls[axis].value = !original[axis];
+		if (xioctl(fd, VIDIOC_S_CTRL, &controls[axis]) == -1)
+			goto restore;
+		changed |= 1U << axis;
+	}
+	return 1;
+restore:
+	for (unsigned axis = 0; axis < 2; axis++) {
+		if (changed & (1U << axis)) {
+			controls[axis].value = original[axis];
+			if (xioctl(fd, VIDIOC_S_CTRL, &controls[axis]) == -1)
+				log_error("Could not restore sensor flip: %s\n", strerror(errno));
+		}
+	}
+	return 0;
+}
+
 unsigned int
 libmegapixels_select_mode(libmegapixels_camera *camera, libmegapixels_mode *mode, struct v4l2_format *format)
 {
@@ -306,6 +364,22 @@
 					}
 				}
 
+				/* Sensor flips can determine the Bayer code returned by TRY.
+				 * Apply the layout needed by this configured mode, then retry
+				 * before propagating the format to the rest of the graph. */
+				uint32_t requested_code = libmegapixels_format_to_media_busfmt(cmd->format);
+				if (camera->sensor_path && !strcmp(sd->path, camera->sensor_path) &&
+				    subdev_fmt.format.code != requested_code &&
+				    match_bayer_order(sd->fd, subdev_fmt.format.code, requested_code)) {
+					subdev_fmt.format.code = requested_code;
+					subdev_fmt.format.width = cmd->width;
+					subdev_fmt.format.height = cmd->height;
+					if (xioctl(sd->fd, VIDIOC_SUBDEV_S_FMT, &subdev_fmt) == -1) {
+						log_error("Could not retry sensor mode after flips: %s\n", strerror(errno));
+						return 0;
+					}
+				}
+
 				if (subdev_fmt.format.width != cmd->width || subdev_fmt.format.height != cmd->height) {
 					log_error("Driver rejected resolution try: %dx%d, changed to %dx%d\n", cmd->width, cmd->height,
 						subdev_fmt.format.width, subdev_fmt.format.height);
