From: Sam Day <me@samcday.com>
Subject: [PATCH] config: prefer the Pixel 3a rear camera

Libmegapixels enumerates camera sections in file order and Megapixels
opens the first camera at startup. Put the rear camera first for normal
photography without changing either camera's mode or media pipeline.

--- a/config/google,b4s4-sdm670.conf
+++ b/config/google,b4s4-sdm670.conf
@@ -1,6 +1,28 @@
 Version = 1;
 Make: "Google";
 Model: "Pixel 3a";
+
+Rear: {
+  SensorDriver: "imx363";
+  BridgeDriver: "qcom-camss";
+  Modes: (
+  {
+    Width: 4032;
+    Height: 3024;
+    Rate: 30;
+    Rotate: 90;
+    Format: "RGGB10P";
+    Pipeline: (
+      {Type: "Link", From: "msm_csiphy0", FromPad: 1, To: "msm_csid0", ToPad: 0},
+      {Type: "Link", From: "msm_csid0", FromPad: 1, To: "msm_vfe0_rdi0", ToPad: 0},
+      {Type: "Mode", Entity: "imx363"},
+      {Type: "Mode", Entity: "msm_csiphy0"},
+      {Type: "Mode", Entity: "msm_csid0"},
+      {Type: "Mode", Entity: "msm_vfe0_rdi0"}
+    );
+  }
+  );
+};
 
 Front: {
   SensorDriver: "imx355";
@@ -24,27 +46,3 @@
   }
   );
 };
-
-Rear: {
-  SensorDriver: "imx363";
-  BridgeDriver: "qcom-camss";
-  Modes: (
-  {
-    Width: 4032;
-    Height: 3024;
-    Rate: 30;
-    Rotate: 90;
-    Format: "RGGB10P";
-    Pipeline: (
-      {Type: "Link", From: "msm_csiphy0", FromPad: 1, To: "msm_csid0", ToPad: 0},
-      {Type: "Link", From: "msm_csid0", FromPad: 1, To: "msm_vfe0_rdi0", ToPad: 0},
-      {Type: "Mode", Entity: "imx363"},
-      {Type: "Mode", Entity: "msm_csiphy0"},
-      {Type: "Mode", Entity: "msm_csid0"},
-      {Type: "Mode", Entity: "msm_vfe0_rdi0"}
-    );
-  }
-  );
-};
-
-
