diff --git a/packaging/qsee-shared-loader@.service b/packaging/qsee-shared-loader@.service
new file mode 100644
index 0000000..a71e053
--- /dev/null
+++ b/packaging/qsee-shared-loader@.service
@@ -0,0 +1,29 @@
+[Unit]
+Description=Load Qualcomm QSEE shared library %i
+Documentation=file:///usr/share/doc/qsee-supplicant/README.md
+Requires=qsee-supplicant.service
+After=qsee-supplicant.service
+
+[Service]
+Type=notify
+NotifyAccess=main
+ExecStart=/usr/sbin/qsee-app-loader --shared %i
+Restart=on-failure
+RestartSec=2s
+CapabilityBoundingSet=CAP_SYS_ADMIN
+NoNewPrivileges=yes
+PrivateDevices=no
+PrivateTmp=yes
+ProtectSystem=strict
+ProtectHome=yes
+ProtectKernelTunables=yes
+ProtectKernelModules=yes
+ProtectControlGroups=yes
+RestrictAddressFamilies=AF_UNIX
+RestrictRealtime=yes
+LockPersonality=yes
+MemoryDenyWriteExecute=yes
+SystemCallArchitectures=native
+
+[Install]
+WantedBy=multi-user.target
diff --git a/tests/test_loader_session.c b/tests/test_loader_session.c
new file mode 100644
index 0000000..8a2a9ed
--- /dev/null
+++ b/tests/test_loader_session.c
@@ -0,0 +1,81 @@
+// SPDX-License-Identifier: BSD-2-Clause
+#define main loader_program_main
+#include "../src/app_loader.c"
+#undef main
+#include <assert.h>
+#include <stdarg.h>
+
+static unsigned char name_buffer[APP_NAME_MAX];
+static bool expect_shared, fail_mapping, return_error;
+static unsigned int closed, unmapped;
+
+int __wrap_ioctl(int fd, unsigned long operation, ...)
+{
+	va_list args;
+	va_start(args, operation);
+	void *arg = va_arg(args, void *);
+	va_end(args);
+	assert(fd == 7);
+	if (operation == TEE_IOC_SHM_ALLOC) {
+		struct tee_ioctl_shm_alloc_data *allocation = arg;
+		assert(allocation->size == APP_NAME_MAX);
+		allocation->id = 42;
+		return 8;
+	}
+	assert(operation == TEE_IOC_OPEN_SESSION);
+	struct tee_ioctl_buf_data *buffer = arg;
+	struct tee_ioctl_open_session_arg *session = (void *)(uintptr_t)buffer->buf_ptr;
+	assert(session->num_params == (expect_shared ? 2 : 1));
+	assert(buffer->buf_len == sizeof(*session) + session->num_params * sizeof(struct tee_ioctl_param));
+	assert(session->params[0].attr == TEE_IOCTL_PARAM_ATTR_TYPE_MEMREF_INPUT);
+	assert(session->params[0].b == strlen((char *)name_buffer) + 1);
+	assert(session->params[0].c == 42);
+	if (expect_shared) {
+		assert(!strcmp((char *)name_buffer, "cmnlib64"));
+		assert(session->params[1].attr == TEE_IOCTL_PARAM_ATTR_TYPE_VALUE_INPUT);
+		assert(session->params[1].a == 1 && !session->params[1].b && !session->params[1].c);
+	} else {
+		assert(!strcmp((char *)name_buffer, "fpctzappfingerprint"));
+	}
+	session->ret = return_error ? 0xffff0000u : 0;
+	session->session = 43;
+	return 0;
+}
+void *__wrap_mmap(void *address, size_t length, int protection, int flags, int fd, off_t offset)
+{
+	(void)address;
+	assert(length == APP_NAME_MAX && fd == 8 && !offset);
+	assert(protection == (PROT_READ | PROT_WRITE) && flags == MAP_SHARED);
+	if (fail_mapping) { errno = ENOMEM; return MAP_FAILED; }
+	return name_buffer;
+}
+int __wrap_munmap(void *address, size_t length)
+{
+	assert(address == name_buffer && length == APP_NAME_MAX);
+	unmapped++;
+	return 0;
+}
+int __wrap_close(int fd)
+{
+	assert(fd == 8);
+	closed++;
+	return 0;
+}
+int main(void)
+{
+	uint32_t session = 99;
+	assert(!open_named_session(7, "fpctzappfingerprint", false, &session));
+	assert(session == 43);
+	expect_shared = true;
+	assert(!open_named_session(7, "cmnlib64", true, &session));
+	assert(closed == 2 && unmapped == 2);
+	return_error = true;
+	session = 99;
+	assert(open_named_session(7, "cmnlib64", true, &session) == -EREMOTEIO);
+	assert(session == 99 && closed == 3 && unmapped == 3);
+	fail_mapping = true;
+	assert(open_named_session(7, "cmnlib64", true, &session) == -ENOMEM);
+	assert(closed == 4 && unmapped == 3);
+	puts("shared/app loader request and failure tests: OK");
+	return 0;
+}
