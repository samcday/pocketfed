#!/usr/bin/python3
"""Archive the exact tested Rust crate, including author-confirmed license metadata."""
import argparse
import gzip
import hashlib
import io
from pathlib import Path
import subprocess
import tarfile
import tempfile

COMMIT = "c76e17ae04aa563fc683d03e61bd673b20ab863e"
UPSTREAM = "552c652c75c4d32640e90d702862b93f7e275f2b"
URL = "https://github.com/samcday/android-patricia-dict.git"
FILES = ["Cargo.toml", "Cargo.lock", "README.md", "src", "COPYING", "LICENSE-PROVENANCE.md"]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--checkout", type=Path, help="Existing Git repository containing the pinned licensed commit")
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    with tempfile.TemporaryDirectory(prefix="patricia-source-") as temp:
        checkout = args.checkout.resolve() if args.checkout else Path(temp) / "source"
        if not args.checkout:
            subprocess.run(["git", "init", "--quiet", str(checkout)], check=True)
            subprocess.run(["git", "-C", str(checkout), "fetch", "--depth=1", URL, COMMIT], check=True)
        actual = subprocess.check_output(["git", "-C", str(checkout), "rev-parse", COMMIT + "^{commit}"], text=True).strip()
        if actual != COMMIT:
            raise SystemExit("Source revision mismatch")
        raw = subprocess.check_output(["git", "-C", str(checkout), "archive", COMMIT, *FILES])
        files = {}
        with tarfile.open(fileobj=io.BytesIO(raw)) as archive:
            for member in archive:
                if member.isfile():
                    files[member.name] = archive.extractfile(member).read()
        if b'license = "GPL-3.0-only"' not in files["Cargo.toml"]:
            raise SystemExit("Expected author-confirmed license metadata")
        args.output.parent.mkdir(parents=True, exist_ok=True)
        with args.output.open("wb") as output:
            with gzip.GzipFile(filename="", mode="wb", fileobj=output, mtime=0) as zipped:
                with tarfile.open(fileobj=zipped, mode="w", format=tarfile.GNU_FORMAT) as archive:
                    for name, content in sorted(files.items()):
                        entry = tarfile.TarInfo("patricia_dict/" + name)
                        entry.size = len(content)
                        entry.mode = 0o644
                        archive.addfile(entry, io.BytesIO(content))
    print(hashlib.sha256(args.output.read_bytes()).hexdigest(), args.output)


if __name__ == "__main__":
    main()
