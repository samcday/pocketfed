[Plymouth Theme]
Name=Fedora Mobile
Description=A calm, readable boot splash for portrait phones and tablets.
ModuleName=two-step

[two-step]
Font=Cantarell 16
TitleFont=Cantarell 22
ImageDir=/usr/share/plymouth/themes/fedora-mobile
HorizontalAlignment=.5
VerticalAlignment=.43
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.43
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.34
ProgressBarHorizontalAlignment=.5
ProgressBarVerticalAlignment=.61
ProgressBarWidth=240
ProgressBarHeight=5
ProgressBarBackgroundColor=0x253041
ProgressBarForegroundColor=0x51a2da
BackgroundStartColor=0x000000
BackgroundEndColor=0x000000
Transition=none
TransitionDuration=0.0
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=false

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false

[updates]
UseEndAnimation=false
UseProgressBar=true
ProgressBarShowPercentComplete=true
Title=Installing Updates...
SubTitle=Do not turn off your computer

[system-upgrade]
UseEndAnimation=false
UseProgressBar=true
ProgressBarShowPercentComplete=true
Title=Upgrading System...
SubTitle=Do not turn off your computer

[firmware-upgrade]
UseEndAnimation=false
UseProgressBar=true
ProgressBarShowPercentComplete=true
Title=Upgrading Firmware...
SubTitle=Do not turn off your computer

[system-reset]
UseEndAnimation=false
UseProgressBar=true
ProgressBarShowPercentComplete=true
Title=Resetting System...
SubTitle=Do not turn off your computer
