     pub fn output_dir(&self) -> PathBuf {
         PathBuf::from(config::OUTPUTDIR)
     }
+
+    // Save the new user's settings before creating their account. If setup is
+    // interrupted after CreateHome succeeds, the importer can still recover
+    // these settings when the user logs in.
+    pub fn export_settings(&self) -> std::io::Result<()> {
+        let dir = self.output_dir();
+        for item in DCONF_EXPORTS {
+            item.export(&dir)?;
+        }
+        std::fs::File::open(dir)?.sync_all()?;
+        Ok(())
+    }
 }
