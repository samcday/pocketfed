diff --git a/src/pfb/timezone_page.rs b/src/pfb/timezone_page.rs
new file mode 100644
index 0000000..8cd9257
--- /dev/null
+++ b/src/pfb/timezone_page.rs
@@ -0,0 +1,224 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+use adw::prelude::*;
+use adw::subclass::prelude::*;
+use glib::Object;
+use gtk::glib;
+use log::{debug, warn};
+use std::cell::{Cell, RefCell};
+use zbus::{proxy, Connection};
+
+use crate::pfb::{Page, PageImpl};
+
+#[proxy(
+    interface = "org.freedesktop.timedate1",
+    default_service = "org.freedesktop.timedate1",
+    default_path = "/org/freedesktop/timedate1"
+)]
+trait Timedate1 {
+    async fn list_timezones(&self) -> zbus::Result<Vec<String>>;
+
+    #[zbus(property)]
+    fn timezone(&self) -> zbus::Result<String>;
+
+    #[zbus(allow_interactive_auth)]
+    async fn set_timezone(&self, timezone: &str, interactive: bool) -> zbus::Result<()>;
+}
+
+mod imp {
+    use glib::subclass::InitializingObject;
+    use gtk::CompositeTemplate;
+
+    use super::*;
+
+    #[derive(CompositeTemplate, Default)]
+    #[template(resource = "/mobi/phosh/FirstBoot/pages/timezone_page.ui")]
+    pub struct PfbTimezonePage {
+        #[template_child]
+        pub timezone_row: TemplateChild<adw::ComboRow>,
+        #[template_child]
+        pub error_banner: TemplateChild<adw::Banner>,
+
+        pub zones: RefCell<Vec<String>>,
+        pub loaded: Cell<bool>,
+        pub active: Cell<bool>,
+        pub(super) timedate1: RefCell<Option<Timedate1Proxy<'static>>>,
+    }
+
+    #[glib::object_subclass]
+    impl ObjectSubclass for PfbTimezonePage {
+        const NAME: &'static str = "PfbTimezonePage";
+        type Type = super::TimezonePage;
+        type ParentType = Page;
+
+        fn class_init(klass: &mut Self::Class) {
+            klass.bind_template();
+            klass.bind_template_instance_callbacks();
+        }
+
+        fn instance_init(obj: &InitializingObject<Self>) {
+            obj.init_template();
+        }
+    }
+
+    impl ObjectImpl for PfbTimezonePage {
+        fn constructed(&self) {
+            self.parent_constructed();
+            self.obj().load_timezones();
+        }
+    }
+
+    impl WidgetImpl for PfbTimezonePage {}
+    impl NavigationPageImpl for PfbTimezonePage {}
+    impl PageImpl for PfbTimezonePage {}
+}
+
+glib::wrapper! {
+    pub struct TimezonePage(ObjectSubclass<imp::PfbTimezonePage>)
+    @extends Page, adw::NavigationPage, gtk::Widget,
+    @implements gtk::Accessible, gtk::Buildable, gtk::ConstraintTarget;
+}
+
+#[gtk::template_callbacks]
+impl TimezonePage {
+    #[allow(clippy::new_without_default)]
+    pub fn new() -> Self {
+        Object::builder().build()
+    }
+
+    async fn ensure_timedate1(&self) -> zbus::Result<Timedate1Proxy<'static>> {
+        if let Some(proxy) = self.imp().timedate1.borrow().as_ref() {
+            return Ok(proxy.clone());
+        }
+
+        let connection = Connection::system().await?;
+        let proxy = Timedate1Proxy::new(&connection).await?;
+        self.imp().timedate1.replace(Some(proxy.clone()));
+        Ok(proxy)
+    }
+
+    fn set_busy(&self, busy: bool) {
+        self.imp().active.set(busy);
+        self.imp().timezone_row.set_sensitive(!busy);
+        self.imp().error_banner.set_sensitive(!busy);
+        if busy {
+            self.upcast_ref::<Page>().set_can_go_next(false);
+            self.imp().error_banner.set_revealed(false);
+        }
+    }
+
+    fn show_error(&self, message: &str, error: &dyn std::fmt::Display) {
+        warn!("{message}: {error}");
+        self.imp().error_banner.set_title(message);
+        self.imp().error_banner.set_revealed(true);
+        self.upcast_ref::<Page>().set_can_go_next(false);
+    }
+
+    fn load_timezones(&self) {
+        self.set_busy(true);
+        glib::MainContext::default().spawn_local(glib::clone!(
+            #[weak(rename_to = this)]
+            self,
+            async move {
+                let result = async {
+                    let proxy = this.ensure_timedate1().await?;
+                    // timedated reads the installed tzdata; no network or location
+                    // service is needed to configure the clock on first boot.
+                    let zones = proxy.list_timezones().await?;
+                    let current = proxy.timezone().await?;
+                    Ok::<_, zbus::Error>((zones, current))
+                }
+                .await;
+
+                match result {
+                    Ok((mut zones, current)) => {
+                        zones.push("UTC".into());
+                        if !current.is_empty() {
+                            zones.push(current.clone());
+                        }
+                        zones.sort();
+                        zones.dedup();
+                        let selected = zones
+                            .iter()
+                            .position(|zone| zone == &current)
+                            .unwrap_or_else(|| {
+                                zones.iter().position(|zone| zone == "UTC").unwrap()
+                            });
+                        let labels: Vec<_> =
+                            zones.iter().map(|zone| zone.replace('_', " ")).collect();
+                        let labels: Vec<_> = labels.iter().map(String::as_str).collect();
+                        let model = gtk::StringList::new(&labels);
+                        this.imp().zones.replace(zones);
+                        this.imp().timezone_row.set_model(Some(&model));
+                        this.imp().timezone_row.set_selected(selected as u32);
+                        this.imp().loaded.set(true);
+                        this.set_busy(false);
+                        if current.is_empty() {
+                            this.apply_timezone();
+                        } else {
+                            this.upcast_ref::<Page>().set_can_go_next(true);
+                        }
+                    }
+                    Err(error) => {
+                        this.set_busy(false);
+                        this.imp().timezone_row.set_sensitive(false);
+                        this.show_error(&gettextrs::gettext("Failed to load time zones"), &error);
+                    }
+                }
+            }
+        ));
+    }
+
+    fn apply_timezone(&self) {
+        let Some(timezone) = self
+            .imp()
+            .zones
+            .borrow()
+            .get(self.imp().timezone_row.selected() as usize)
+            .cloned()
+        else {
+            return;
+        };
+
+        self.set_busy(true);
+        glib::MainContext::default().spawn_local(glib::clone!(
+            #[weak(rename_to = this)]
+            self,
+            async move {
+                let result = async {
+                    let proxy = this.ensure_timedate1().await?;
+                    debug!("Setting time zone to {timezone}");
+                    proxy.set_timezone(&timezone, true).await
+                }
+                .await;
+
+                this.set_busy(false);
+                match result {
+                    Ok(()) => this.upcast_ref::<Page>().set_can_go_next(true),
+                    Err(error) => {
+                        this.show_error(&gettextrs::gettext("Failed to set time zone"), &error);
+                    }
+                }
+            }
+        ));
+    }
+
+    #[template_callback]
+    fn on_timezone_selected(&self) {
+        if self.imp().loaded.get() && !self.imp().active.get() {
+            self.apply_timezone();
+        }
+    }
+
+    #[template_callback]
+    fn on_retry_clicked(&self) {
+        if self.imp().active.get() {
+            return;
+        }
+        if self.imp().loaded.get() {
+            self.apply_timezone();
+        } else {
+            self.load_timezones();
+        }
+    }
+}
