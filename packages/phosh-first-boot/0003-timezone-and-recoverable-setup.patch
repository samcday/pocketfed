+
+    async fn cache_user(&self, user_name: &str) -> zbus::Result<()> {
+        let connection = self.imp().connection.borrow().as_ref().unwrap().clone();
+        let proxy = AccountsProxy::new(&connection).await?;
+        // Phrog discovers users through AccountsService, which does not enumerate
+        // systemd-homed accounts from /etc/passwd.
+        proxy.cache_user(user_name).await?;
         Ok(())
     }
 
