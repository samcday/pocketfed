#!/usr/bin/env bash
# Exercise the installed DNG/JPEG tools without opening a camera.
set -euo pipefail

if [[ $# != 1 ]]; then
    echo "Usage: $0 OUTPUT-DIRECTORY" >&2
    exit 2
fi

mkdir -p -- "$1"
output_dir=$(cd -- "$1" && pwd)
postprocessor=${MEGAPIXELS_POSTPROCESSOR:-/usr/share/megapixels/postprocess.sh}

python3 - "$output_dir/frame.raw" <<'PY'
import sys
from pathlib import Path

# MIPI RAW10 stores four high-eight-bit samples followed by their low bits.
data = bytearray()
for y in range(64):
    for x in range(0, 96, 4):
        pixels = [128 + ((x + i) * 5 + y * 3) % 640 for i in range(4)]
        data.extend(p >> 2 for p in pixels)
        data.append(sum((p & 3) << (i * 2) for i, p in enumerate(pixels)))
Path(sys.argv[1]).write_bytes(data)
PY

# Sargo's rear Rotate:90 setting produces DNG orientation 8 in Megapixels.
# Test both quarter-turn directions through the installed postprocessor.
for orientation in 6 8; do
    burst="$output_dir/burst-$orientation"
    result="$output_dir/result-$orientation"
    if [[ -e "$burst" || -e "$result.jpg" || -e "$result.dng" ]]; then
        echo "Use a fresh output directory: $result already exists" >&2
        exit 1
    fi
    mkdir -p "$burst"
    makedng -w 96 -h 64 -p SRGGB10P -o "$orientation" \
        -m 'Google,Pixel 3a' -n 1,1,1 "$output_dir/frame.raw" "$burst/1.dng"
    "$postprocessor" "$burst" "$result" 1
    test -s "$result.jpg"
    test -s "$result.dng"
    test ! -d "$burst"
    test "$(identify -format '%wx%h' "$result.jpg")" = 64x96
    test "$(exiftool -s -s -s -Make "$result.jpg")" = Google
    test "$(exiftool -s -s -s -Model "$result.jpg")" = 'Pixel 3a'
    orientation_tag=$(exiftool -s -s -s -n -Orientation "$result.jpg")
    test -z "$orientation_tag" || test "$orientation_tag" = 1
    identify "$result.jpg"
    exiftool -ImageWidth -ImageHeight -Orientation -Make -Model "$result.jpg"
done

echo "DNG/JPEG postprocessing and quarter-turn orientation checks passed"
