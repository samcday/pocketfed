+    fn host_mode_is_refused_for_preserved_foreign_gadgets() {
         let config = config("[main]\nforeign_gadgets = \"preserve\"\n");
+        let error = check_host_mode(&config, &bound("udc0", "g1")).unwrap_err();
+        assert_eq!(
+            error.to_string(),
+            "host_mode refused: foreign gadget g1 on UDC udc0 is preserved"
+        );
+        assert!(check_host_mode(&config, &bound("udc0", "usb-signaller-developer")).is_ok());
+        assert!(check_host_mode(&config, &[]).is_ok());
+    }
