+    /* Host role would unbind a preserved gadget, for example one serving the root filesystem */
+    #[test]
+    fn host_mode_is_neither_offered_nor_set_while_a_preserved_foreign_gadget_is_bound() {
+        let s = setup("[main]\nforeign_gadgets = \"preserve\"\n", locked);
+        s.core(|core| core.refresh_adoption());
+        assert!(s.core(|core| core.adopted.is_empty()));
+        assert_eq!(
+            s.core(|core| core.available_modes()),
+            "developer_mode,tethering_mode,charging_only,mtp_ffs_mode"
+        );
+        let error = fdo_message(s.set_mode("host_mode").unwrap_err());
+        assert_eq!(
+            error,
+            "host_mode refused: foreign gadget smoo on UDC udc0 is preserved"
+        );
+        assert_eq!(s.writes(), 0);
+        assert!(s.services.calls().is_empty());
+        assert_eq!(s.fixture.read("sys/class/usb_role/switch0/role"), "device");
+        assert!(s.fs.is_bound("smoo"));
+
+        /* Under replace, host_mode is offered */
+        let s = setup("[main]\nforeign_gadgets = \"replace\"\n", locked);
+        assert!(
+            s.core(|core| core.available_modes())
+                .ends_with(",host_mode")
+        );
+    }
+
