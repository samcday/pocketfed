+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::configuration::testing::TempRoot;
+    use std::collections::BTreeSet;
+
+    /*
+     * A scripted gadget: links, whether bound, and a list of errors to
+     * return for the next calls of each kind.
+     */
+    #[derive(Default)]
+    struct Script {
+        links: BTreeSet<String>,
+        entries: Vec<String>,
+        pins: BTreeSet<String>,
+        bound: bool,
+        udc_present: bool,
+        unbind_error: Option<i32>,
+        bind_errors: Vec<i32>,
+        link_errors: Vec<i32>,
+        not_ready: BTreeSet<String>,
+        /* After this many pauses, the UDC comes back */
+        udc_returns_after: Option<u32>,
+        pauses: u32,
+        calls: Vec<String>,
+    }
+
+    impl WindowIo for Script {
+        fn unbind(&mut self) -> Result<(), i32> {
+            self.calls.push("unbind".into());
+            if let Some(code) = self.unbind_error {
+                return Err(code);
+            }
+            if !self.bound {
+                return Err(libc::ENODEV);
+            }
+            self.bound = false;
+            return Ok(());
+        }
+
+        fn bind(&mut self) -> Result<(), i32> {
+            self.calls.push("bind".into());
+            if !self.bind_errors.is_empty() {
+                return Err(self.bind_errors.remove(0));
+            }
+            if !self.udc_present || self.links.is_empty() {
+                return Err(libc::EBUSY);
+            }
+            self.bound = true;
+            return Ok(());
+        }
+
+        fn unlink(&mut self, entry: usize) -> Result<(), i32> {
+            let name = self.entries[entry].clone();
+            self.calls.push(format!("unlink {name}"));
+            assert!(!self.pins.contains(&name), "unlinked pin {name}");
+            if self.links.remove(&name) {
+                return Ok(());
+            }
+            return Err(libc::ENOENT);
+        }
+
+        fn link(&mut self, entry: usize) -> Result<(), i32> {
+            let name = self.entries[entry].clone();
+            self.calls.push(format!("link {name}"));
+            if !self.link_errors.is_empty() {
+                return Err(self.link_errors.remove(0));
+            }
+            if !self.links.insert(name) {
+                return Err(libc::EEXIST);
+            }
+            return Ok(());
+        }
+
+        fn ready(&mut self, entry: usize) -> Result<Option<bool>, i32> {
+            return Ok(Some(!self.not_ready.contains(&self.entries[entry])));
+        }
+
+        fn udc_set(&mut self) -> bool {
+            return self.bound;
+        }
+
+        fn pause(&mut self, _millis: u64) {
+            self.pauses += 1;
+            if self.udc_returns_after == Some(self.pauses) {
+                self.udc_present = true;
+            }
+            assert!(self.pauses < 100, "the window never bound");
+        }
+
+        fn now_us(&mut self) -> u64 {
+            return 0;
+        }
+    }
+
+    /* ffs.pin (pin, entry 0), ncm.usb0 (entry 1): charging -> developer */
+    fn plan() -> WindowPlan {
+        return WindowPlan {
+            gadget: "g".into(),
+            config: "c.1".into(),
+            udc: "udc0".into(),
+            entries: vec![
+                WindowEntry {
+                    link: "ffs.pin".into(),
+                    function: "ffs.pin".into(),
+                },
+                WindowEntry {
+                    link: "ncm.usb0".into(),
+                    function: "ncm.usb0".into(),
+                },
+            ],
+            target: vec![WindowOp::Link(1)],
+            target_ffs: vec![0],
+            previous: vec![WindowOp::Unlink(1)],
+            previous_ffs: vec![0],
+            pins_only: vec![WindowOp::Unlink(1)],
+            pins_ffs: vec![0],
+        };
+    }
+
+    fn script() -> Script {
+        return Script {
+            links: ["ffs.pin".to_string()].into(),
+            entries: vec!["ffs.pin".into(), "ncm.usb0".into()],
+            pins: ["ffs.pin".to_string()].into(),
+            bound: true,
+            udc_present: true,
+            ..Default::default()
+        };
+    }
+
+    #[test]
+    fn target_is_reached() {
+        let mut io = script();
+        let outcome = run_window(&mut io, &plan());
+        assert_eq!(outcome.rung, Rung::Target);
+        assert_eq!(outcome.failure, None);
+        assert_eq!(io.calls, vec!["unbind", "link ncm.usb0", "bind"]);
+        assert!(io.bound);
+    }
+
+    #[test]
+    fn failed_unbind_leaves_everything_alone() {
+        let mut io = script();
+        io.unbind_error = Some(libc::EIO);
+        let outcome = run_window(&mut io, &plan());
+        assert_eq!(outcome.rung, Rung::Untouched);
+        assert_eq!(io.calls, vec!["unbind"]);
+        assert!(io.bound);
+    }
+
+    #[test]
+    fn enodev_on_unbind_means_already_unbound() {
+        let mut io = script();
+        io.bound = false;
+        let outcome = run_window(&mut io, &plan());
+        assert_eq!(outcome.rung, Rung::Target);
+        assert!(io.bound);
+    }
+
+    #[test]
+    fn failed_bind_goes_back_to_the_previous_composition() {
+        let mut io = script();
+        io.bind_errors = vec![libc::EBUSY];
+        let outcome = run_window(&mut io, &plan());
+        assert_eq!(outcome.rung, Rung::Previous);
+        assert_eq!(outcome.failure, Some((Step::Bind, 0, libc::EBUSY)));
+        assert!(outcome.cause(&plan()).contains("failed to start"));
+        assert_eq!(io.links, ["ffs.pin".to_string()].into());
+        assert!(io.bound);
+    }
+
+    #[test]
+    fn a_non_ready_target_is_never_bound() {
+        let mut io = script();
+        let mut plan = plan();
+        plan.target_ffs = vec![1];
+        io.not_ready.insert("ncm.usb0".into());
+        let outcome = run_window(&mut io, &plan);
+        assert_eq!(outcome.rung, Rung::Previous);
+        assert_eq!(outcome.failure, Some((Step::NotReady, 1, 0)));
+        assert_eq!(io.calls.iter().filter(|c| *c == "bind").count(), 1);
+    }
+
+    #[test]
+    fn missing_udc_is_retried_until_it_returns() {
+        let mut io = script();
+        io.udc_present = false;
+        io.udc_returns_after = Some(4);
+        let outcome = run_window(&mut io, &plan());
+        assert_eq!(outcome.rung, Rung::PinsOnly);
+        assert_eq!(io.pauses, 4);
+        assert_eq!(io.links, ["ffs.pin".to_string()].into());
+        assert!(io.bound);
+    }
+
+    #[test]
+    fn a_concurrent_binder_ends_the_window() {
+        let mut io = script();
+        /* Someone bound the gadget before the link: EINVAL, and it is bound */
+        io.link_errors = vec![libc::EINVAL];
+        io.bound = true;
+        io.unbind_error = None;
+        let mut plan = plan();
+        plan.target = vec![WindowOp::Link(1)];
+        /* The unbind succeeds, then another actor binds */
+        struct Rebinder(Script);
+        impl WindowIo for Rebinder {
+            fn unbind(&mut self) -> Result<(), i32> {
+                let result = self.0.unbind();
+                self.0.bound = true;
+                return result;
+            }
+            fn bind(&mut self) -> Result<(), i32> {
+                return self.0.bind();
+            }
+            fn unlink(&mut self, entry: usize) -> Result<(), i32> {
+                return self.0.unlink(entry);
+            }
+            fn link(&mut self, entry: usize) -> Result<(), i32> {
+                return self.0.link(entry);
+            }
+            fn ready(&mut self, entry: usize) -> Result<Option<bool>, i32> {
+                return self.0.ready(entry);
+            }
+            fn udc_set(&mut self) -> bool {
+                return self.0.udc_set();
+            }
+            fn pause(&mut self, millis: u64) {
+                self.0.pause(millis);
+            }
+            fn now_us(&mut self) -> u64 {
+                return 0;
+            }
+        }
+        let mut rebinder = Rebinder(io);
+        let outcome = run_window(&mut rebinder, &plan);
+        assert_eq!(outcome.rung, Rung::RecoveredByOther);
+        assert_eq!(outcome.failure, Some((Step::Link, 1, libc::EINVAL)));
+    }
+
+    #[test]
+    fn window_thread_runs_windows_one_after_the_other() {
+        let runtime = tokio::runtime::Builder::new_current_thread()
+            .build()
+            .unwrap();
+        let thread = WindowThread::spawn().unwrap();
+        for _ in 0..3 {
+            let (outcome, plan) = runtime
+                .block_on(thread.run(Box::new(script()), plan()))
+                .unwrap();
+            assert_eq!(outcome.rung, Rung::Target);
+            assert_eq!(plan.udc, "udc0");
+        }
+    }
+
+    /* The real syscalls, against a plain directory tree standing in for configfs */
+    #[test]
+    fn raw_window_on_a_directory_tree() {
+        let root = TempRoot::new("raw-window");
+        let gadget = root.path.join("g");
+        root.write("g/UDC", "udc0\n");
+        root.write("g/functions/ffs.pin/ready", "1\n");
+        std::fs::create_dir_all(gadget.join("functions/ncm.usb0")).unwrap();
+        std::fs::create_dir_all(gadget.join("configs/c.1")).unwrap();
+        std::os::unix::fs::symlink(
+            gadget.join("functions/ffs.pin"),
+            gadget.join("configs/c.1/ffs.pin"),
+        )
+        .unwrap();
+
+        let plan = plan();
+        let mut io = RawWindowIo::open(&gadget, &plan).unwrap();
+        assert!(io.udc_set());
+        assert_eq!(io.ready(0), Ok(Some(true)));
+        assert_eq!(io.ready(1), Ok(None));
+
+        io.unbind().unwrap();
+        assert!(
+            std::fs::read_to_string(gadget.join("UDC"))
+                .unwrap()
+                .starts_with('\n')
+        );
+        assert!(!io.udc_set());
+        io.link(1).unwrap();
+        assert_eq!(io.link(1), Err(libc::EEXIST));
+        assert_eq!(
+            std::fs::read_link(gadget.join("configs/c.1/ncm.usb0")).unwrap(),
+            gadget.join("functions/ncm.usb0")
+        );
+        io.bind().unwrap();
+        assert!(
+            std::fs::read_to_string(gadget.join("UDC"))
+                .unwrap()
+                .starts_with("udc0\n")
+        );
+        assert!(io.udc_set());
+        io.unlink(1).unwrap();
+        assert_eq!(io.unlink(1), Err(libc::ENOENT));
+
+        root.write("g/functions/ffs.pin/ready", "0\n");
+        assert_eq!(io.ready(0), Ok(Some(false)));
+        let start = io.now_us();
+        io.pause(1);
+        assert!(io.now_us() >= start + 1000);
+    }
+}
