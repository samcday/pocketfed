+
+/*
+ * The critical window of a mode switch on an adopted gadget: unbind, change
+ * the links, bind again.
+ *
+ * The kernel refuses links while a gadget has a UDC set, so the composition
+ * of a gadget that stays in use (for example one serving the root
+ * filesystem over FunctionFS) can only change while it is unbound. While it
+ * is unbound, the root filesystem may be unreachable: anything that reads a
+ * file, pages in memory, logs, execs or waits for another task could block
+ * forever. The window therefore:
+ *
+ * - runs on a dedicated thread, spawned before mlockall(), in a process
+ *   whose memory stays locked for as long as a gadget is adopted;
+ * - only makes raw syscalls on file descriptors opened and buffers built
+ *   before the unbind: no println!, allocation, exec, await or lock another
+ *   task can hold;
+ * - never returns while the gadget is unbound: target composition, else the
+ *   previous one, else only the pinned functions, retried until it binds.
+ */
+
+/* The adopted-gadget transaction that uses this is not part of this change yet */
+#![allow(dead_code)]
+
+use std::ffi::{CStr, CString};
+use std::fs::OpenOptions;
+use std::io;
+use std::os::fd::{AsRawFd, OwnedFd};
+use std::os::unix::ffi::OsStrExt;
+use std::os::unix::fs::OpenOptionsExt;
+use std::panic::{AssertUnwindSafe, catch_unwind};
+use std::path::Path;
+use std::process;
+use std::sync::mpsc;
+use std::thread;
+
+use tokio::sync::oneshot;
+
+const WINDOW_THREAD_NAME: &str = "usb-signaller-window";
+const WINDOW_THREAD_STACK: usize = 256 * 1024;
+const FIRST_RETRY_MS: u64 = 10;
+const LAST_RETRY_MS: u64 = 1000;
+
+/*
+ * The only operations the window performs besides writing and reading the
+ * UDC attribute and reading 'ready' attributes. Attribute writes that open
+ * files (a mass storage LUN's 'file') can not be expressed here.
+ */
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum WindowOp {
+    /* Remove the entry's link from the configuration; ENOENT counts as done */
+    Unlink(usize),
+    /* Link the entry's function into the configuration; EEXIST counts as done */
+    Link(usize),
+}
+
+/* A function the window links, unlinks or checks, and its link name in the configuration */
+#[derive(Debug, Clone, PartialEq)]
+pub struct WindowEntry {
+    pub link: String,
+    pub function: String,
+}
+
+/* Everything the window does, decided before the unbind */
+#[derive(Debug, Clone, PartialEq)]
+pub struct WindowPlan {
+    pub gadget: String,
+    pub config: String,
+    pub udc: String,
+    pub entries: Vec<WindowEntry>,
+    /* Reach the requested composition */
+    pub target: Vec<WindowOp>,
+    /* FunctionFS entries that must be ready before binding the target */
+    pub target_ffs: Vec<usize>,
+    /* Go back to the composition before the switch */
+    pub previous: Vec<WindowOp>,
+    pub previous_ffs: Vec<usize>,
+    /* Keep only the pinned functions linked */
+    pub pins_only: Vec<WindowOp>,
+    pub pins_ffs: Vec<usize>,
+}
+
+/*
+ * The syscalls of the window. Errors are raw errno values. Every read opens
+ * the attribute again: configfs caches an attribute's value per open file.
+ */
+pub trait WindowIo: Send {
+    /* Write an empty name to the UDC attribute */
+    fn unbind(&mut self) -> Result<(), i32>;
+    /* Write the UDC name to the UDC attribute */
+    fn bind(&mut self) -> Result<(), i32>;
+    fn unlink(&mut self, entry: usize) -> Result<(), i32>;
+    fn link(&mut self, entry: usize) -> Result<(), i32>;
+    /* The entry's 'ready' attribute; None when the kernel has none (before 6.9) */
+    fn ready(&mut self, entry: usize) -> Result<Option<bool>, i32>;
+    /* Whether the UDC attribute names a UDC, read through a new file */
+    fn udc_set(&mut self) -> bool;
+    fn pause(&mut self, millis: u64);
+    fn now_us(&mut self) -> u64;
+}
+
+/* How the window ended. Every rung except Untouched rebound the gadget */
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Rung {
+    /* The requested composition is bound */
+    Target,
+    /* The unbind failed: the gadget is still bound and unchanged */
+    Untouched,
+    /* The target failed; the previous composition is bound */
+    Previous,
+    /* Only the pinned functions are linked and bound */
+    PinsOnly,
+    /* Someone else (the kernel, a guardian) bound the gadget meanwhile */
+    RecoveredByOther,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Step {
+    Unbind,
+    Unlink,
+    Link,
+    Ready,
+    NotReady,
+    Bind,
+}
+
+/* Fixed size, so the window can fill it in without allocating */
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct WindowOutcome {
+    pub rung: Rung,
+    /* The first failure: step, entry index and errno (0 for "not ready") */
+    pub failure: Option<(Step, usize, i32)>,
+    pub binds: u32,
+    pub micros: u64,
+}
+
+impl WindowOutcome {
+    /* Why the target was not reached, for logs and D-Bus errors */
+    pub fn cause(&self, plan: &WindowPlan) -> String {
+        let Some((step, entry, code)) = self.failure else {
+            return "no failure recorded".to_string();
+        };
+        let function = plan
+            .entries
+            .get(entry)
+            .map_or("?", |entry| entry.function.as_str());
+        let error = io::Error::from_raw_os_error(code);
+        return match step {
+            Step::Unbind => format!("unbind: {error}"),
+            Step::Unlink => format!("unlink {function}: {error}"),
+            Step::Link => format!("link {function}: {error}"),
+            Step::Ready => format!("reading {function}/ready: {error}"),
+            Step::NotReady => format!("{function} is not ready"),
+            Step::Bind if code == libc::EBUSY => {
+                format!("bind: {error}; see dmesg 'failed to start'")
+            }
+            Step::Bind => format!("bind: {error}"),
+        };
+    }
+
+    pub fn describe(&self, plan: &WindowPlan) -> String {
+        let mut text = format!(
+            "{} on {}: window ended at {:?} after {} µs, {} bind attempt(s)",
+            plan.gadget, plan.udc, self.rung, self.micros, self.binds
+        );
+        if self.failure.is_some() {
+            text.push_str(&format!("; first failure: {}", self.cause(plan)));
+        }
+        return text;
+    }
+}
+
+fn record(outcome: &mut WindowOutcome, step: Step, entry: usize, code: i32) {
+    if outcome.failure.is_none() {
+        outcome.failure = Some((step, entry, code));
+    }
+}
+
+/* Apply ops in order. With 'stop', give up at the first failure */
+fn apply(io: &mut dyn WindowIo, ops: &[WindowOp], stop: bool, outcome: &mut WindowOutcome) -> bool {
+    let mut ok = true;
+    for op in ops {
+        let result = match *op {
+            WindowOp::Unlink(entry) => match io.unlink(entry) {
+                Err(code) if code != libc::ENOENT => Err((Step::Unlink, entry, code)),
+                _ => Ok(()),
+            },
+            WindowOp::Link(entry) => match io.link(entry) {
+                Err(code) if code != libc::EEXIST => Err((Step::Link, entry, code)),
+                _ => Ok(()),
+            },
+        };
+        if let Err((step, entry, code)) = result {
+            record(outcome, step, entry, code);
+            ok = false;
+            if stop {
+                return false;
+            }
+        }
+    }
+    return ok;
+}
+
+/* Every listed FunctionFS function reads ready (a missing attribute counts as ready) */
+fn all_ready(io: &mut dyn WindowIo, entries: &[usize], outcome: &mut WindowOutcome) -> bool {
+    for &entry in entries {
+        match io.ready(entry) {
+            Ok(Some(true)) | Ok(None) => {}
+            Ok(Some(false)) => {
+                record(outcome, Step::NotReady, entry, 0);
+                return false;
+            }
+            Err(code) => {
+                record(outcome, Step::Ready, entry, code);
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+fn bind(io: &mut dyn WindowIo, outcome: &mut WindowOutcome) -> bool {
+    outcome.binds = outcome.binds.saturating_add(1);
+    if let Err(code) = io.bind() {
+        record(outcome, Step::Bind, 0, code);
+        return false;
+    }
+    return true;
+}
+
+/*
+ * The window itself. Runs on the window thread; see the top of this file
+ * for what it may and may not do.
+ */
+pub fn run_window(io: &mut dyn WindowIo, plan: &WindowPlan) -> WindowOutcome {
+    let start = io.now_us();
+    let mut outcome = WindowOutcome {
+        rung: Rung::Untouched,
+        failure: None,
+        binds: 0,
+        micros: 0,
+    };
+
+    /* ENODEV: nothing was bound (a UDC name was not even set) */
+    match io.unbind() {
+        Ok(()) => {}
+        Err(code) if code == libc::ENODEV => {}
+        Err(code) => {
+            record(&mut outcome, Step::Unbind, 0, code);
+            outcome.micros = io.now_us().saturating_sub(start);
+            return outcome;
+        }
+    }
+
+    outcome.rung = 'ladder: {
+        if apply(io, &plan.target, true, &mut outcome)
+            && all_ready(io, &plan.target_ffs, &mut outcome)
+            && bind(io, &mut outcome)
+        {
+            break 'ladder Rung::Target;
+        }
+        /* A link refused with EINVAL ends up here when someone else bound the gadget */
+        if io.udc_set() {
+            break 'ladder Rung::RecoveredByOther;
+        }
+
+        apply(io, &plan.previous, false, &mut outcome);
+        if all_ready(io, &plan.previous_ffs, &mut outcome) && bind(io, &mut outcome) {
+            break 'ladder Rung::Previous;
+        }
+        if io.udc_set() {
+            break 'ladder Rung::RecoveredByOther;
+        }
+
+        /*
+         * Last resort: the pinned functions alone. The UDC may be gone for a
+         * while (role switch), so retry until it binds.
+         */
+        apply(io, &plan.pins_only, false, &mut outcome);
+        let mut delay = FIRST_RETRY_MS;
+        loop {
+            if all_ready(io, &plan.pins_ffs, &mut outcome) && bind(io, &mut outcome) {
+                break 'ladder Rung::PinsOnly;
+            }
+            if io.udc_set() {
+                break 'ladder Rung::RecoveredByOther;
+            }
+            io.pause(delay);
+            delay = (delay * 2).min(LAST_RETRY_MS);
+        }
+    };
+
+    outcome.micros = io.now_us().saturating_sub(start);
+    return outcome;
+}
+
+fn errno() -> i32 {
+    return io::Error::last_os_error()
+        .raw_os_error()
+        .unwrap_or(libc::EIO);
+}
+
+fn c_path(path: &Path) -> io::Result<CString> {
+    return CString::new(path.as_os_str().as_bytes())
+        .map_err(|err| io::Error::new(io::ErrorKind::InvalidInput, err));
+}
+
+fn open_dir(path: &Path) -> io::Result<OwnedFd> {
+    let file = OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_PATH | libc::O_DIRECTORY)
+        .open(path)?;
+    return Ok(file.into());
+}
+
+/*
+ * The window on the running kernel: directory file descriptors opened and
+ * every path and value encoded before the unbind.
+ */
+pub struct RawWindowIo {
+    gadget: OwnedFd,
+    config: OwnedFd,
+    functions: OwnedFd,
+    udc: OwnedFd,
+    udc_name: Vec<u8>,
+    links: Vec<CString>,
+    /* Absolute: configfs resolves symlink targets itself */
+    targets: Vec<CString>,
+    ready: Vec<CString>,
+}
+
+impl RawWindowIo {
+    pub fn open(gadget_dir: &Path, plan: &WindowPlan) -> io::Result<Self> {
+        let gadget = open_dir(gadget_dir)?;
+        let config = open_dir(&gadget_dir.join("configs").join(&plan.config))?;
+        let functions_dir = gadget_dir.join("functions");
+        let functions = open_dir(&functions_dir)?;
+        let udc: OwnedFd = OpenOptions::new()
+            .read(true)
+            .write(true)
+            .open(gadget_dir.join("UDC"))?
+            .into();
+
+        /* Read once, so configfs allocates the attribute's buffer page now, not in the window */
+        let mut buffer = [0u8; 64];
+        let length =
+            unsafe { libc::pread(udc.as_raw_fd(), buffer.as_mut_ptr().cast(), buffer.len(), 0) };
+        if length < 0 {
+            return Err(io::Error::last_os_error());
+        }
+
+        let mut links = vec![];
+        let mut targets = vec![];
+        let mut ready = vec![];
+        for entry in &plan.entries {
+            links.push(c_path(Path::new(&entry.link))?);
+            targets.push(c_path(&functions_dir.join(&entry.function))?);
+            ready.push(c_path(&Path::new(&entry.function).join("ready"))?);
+        }
+
+        let mut udc_name = plan.udc.as_bytes().to_vec();
+        udc_name.push(b'\n');
+
+        return Ok(Self {
+            gadget,
+            config,
+            functions,
+            udc,
+            udc_name,
+            links,
+            targets,
+            ready,
+        });
+    }
+
+    fn write_udc(udc: &OwnedFd, value: &[u8]) -> Result<(), i32> {
+        let written =
+            unsafe { libc::pwrite(udc.as_raw_fd(), value.as_ptr().cast(), value.len(), 0) };
+        if written < 0 {
+            return Err(errno());
+        }
+        return Ok(());
+    }
+
+    /* Open, read into a stack buffer and close an attribute below 'dirfd' */
+    fn read_fresh(dirfd: &OwnedFd, name: &CStr, buffer: &mut [u8]) -> Result<usize, i32> {
+        let fd = unsafe {
+            libc::openat(
+                dirfd.as_raw_fd(),
+                name.as_ptr(),
+                libc::O_RDONLY | libc::O_CLOEXEC,
+            )
+        };
+        if fd < 0 {
+            return Err(errno());
+        }
+        let length = unsafe { libc::read(fd, buffer.as_mut_ptr().cast(), buffer.len()) };
+        let code = errno();
+        unsafe { libc::close(fd) };
+        if length < 0 {
+            return Err(code);
+        }
+        return Ok(length as usize);
+    }
+}
+
+impl WindowIo for RawWindowIo {
+    fn unbind(&mut self) -> Result<(), i32> {
+        return Self::write_udc(&self.udc, b"\n");
+    }
+
+    fn bind(&mut self) -> Result<(), i32> {
+        return Self::write_udc(&self.udc, &self.udc_name);
+    }
+
+    fn unlink(&mut self, entry: usize) -> Result<(), i32> {
+        let result =
+            unsafe { libc::unlinkat(self.config.as_raw_fd(), self.links[entry].as_ptr(), 0) };
+        if result < 0 {
+            return Err(errno());
+        }
+        return Ok(());
+    }
+
+    fn link(&mut self, entry: usize) -> Result<(), i32> {
+        let result = unsafe {
+            libc::symlinkat(
+                self.targets[entry].as_ptr(),
+                self.config.as_raw_fd(),
+                self.links[entry].as_ptr(),
+            )
+        };
+        if result < 0 {
+            return Err(errno());
+        }
+        return Ok(());
+    }
+
+    fn ready(&mut self, entry: usize) -> Result<Option<bool>, i32> {
+        let mut buffer = [0u8; 8];
+        return match Self::read_fresh(&self.functions, &self.ready[entry], &mut buffer) {
+            Err(code) if code == libc::ENOENT => Ok(None),
+            Err(code) => Err(code),
+            Ok(length) if length > 0 && buffer[0] == b'1' => Ok(Some(true)),
+            Ok(length) if length > 0 && buffer[0] == b'0' => Ok(Some(false)),
+            Ok(_) => Err(libc::EINVAL),
+        };
+    }
+
+    fn udc_set(&mut self) -> bool {
+        let mut buffer = [0u8; 64];
+        return match Self::read_fresh(&self.gadget, c"UDC", &mut buffer) {
+            Ok(length) => length > 0 && buffer[0] != b'\n',
+            Err(_) => false,
+        };
+    }
+
+    fn pause(&mut self, millis: u64) {
+        let delay = libc::timespec {
+            tv_sec: (millis / 1000) as libc::time_t,
+            tv_nsec: ((millis % 1000) * 1_000_000) as libc::c_long,
+        };
+        unsafe { libc::nanosleep(&delay, std::ptr::null_mut()) };
+    }
+
+    fn now_us(&mut self) -> u64 {
+        let mut now = libc::timespec {
+            tv_sec: 0,
+            tv_nsec: 0,
+        };
+        unsafe { libc::clock_gettime(libc::CLOCK_MONOTONIC, &mut now) };
+        return (now.tv_sec as u64) * 1_000_000 + (now.tv_nsec as u64) / 1000;
+    }
+}
+
+type Reply = (WindowOutcome, Box<dyn WindowIo>, WindowPlan);
+
+struct Job {
+    io: Box<dyn WindowIo>,
+    plan: WindowPlan,
+    reply: oneshot::Sender<Reply>,
+}
+
+/*
+ * The thread that runs windows. It is spawned at startup, before memory is
+ * locked, so its stack is already mapped and locked when a window runs.
+ */
+pub struct WindowThread {
+    jobs: mpsc::Sender<Job>,
+}
+
+impl WindowThread {
+    pub fn spawn() -> io::Result<Self> {
+        let (jobs, queue) = mpsc::channel::<Job>();
+        thread::Builder::new()
+            .name(WINDOW_THREAD_NAME.to_string())
+            .stack_size(WINDOW_THREAD_STACK)
+            .spawn(move || {
+                while let Ok(mut job) = queue.recv() {
+                    /*
+                     * A panic inside the window would otherwise end the
+                     * transaction with the gadget possibly unbound and
+                     * the transaction lock released. Abort instead: the
+                     * process is gone, and whoever rebinds the gadget
+                     * (the initramfs' guardian, for example) sees it.
+                     */
+                    let outcome = match catch_unwind(AssertUnwindSafe(|| {
+                        run_window(&mut *job.io, &job.plan)
+                    })) {
+                        Ok(outcome) => outcome,
+                        Err(_) => process::abort(),
+                    };
+                    /* The gadget is bound again: replying, and dropping, is safe now */
+                    let _ = job.reply.send((outcome, job.io, job.plan));
+                }
+            })?;
+        return Ok(Self { jobs });
+    }
+
+    /* A window thread that is already gone, to test that path */
+    #[cfg(test)]
+    pub fn stopped() -> Self {
+        let (jobs, _) = mpsc::channel::<Job>();
+        return Self { jobs };
+    }
+
+    /* Run a window and wait for it; file descriptors are closed afterwards, outside the window */
+    pub async fn run(
+        &self,
+        io: Box<dyn WindowIo>,
+        plan: WindowPlan,
+    ) -> anyhow::Result<(WindowOutcome, WindowPlan)> {
+        let (reply, answer) = oneshot::channel();
+        if self.jobs.send(Job { io, plan, reply }).is_err() {
+            return Err(anyhow::anyhow!("the window thread is gone"));
+        }
+        let Ok((outcome, io, plan)) = answer.await else {
+            return Err(anyhow::anyhow!(
+                "the window thread stopped inside a window; the gadget may be unbound"
+            ));
+        };
+        drop(io);
+        return Ok((outcome, plan));
+    }
+}
+
+/*
+ * Lock every current and future page of the process in memory, for the rest
+ * of its life. Needed before the first window: a page fault while the root
+ * filesystem is unreachable would never complete.
+ */
+pub fn lock_memory() -> io::Result<()> {
+    let result = unsafe { libc::mlockall(libc::MCL_CURRENT | libc::MCL_FUTURE) };
+    if result != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    return Ok(());
+}
