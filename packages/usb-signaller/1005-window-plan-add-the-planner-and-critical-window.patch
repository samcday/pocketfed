+/*
+ * What a mode switch on an adopted gadget changes, decided from a snapshot
+ * of the gadget without touching it. Pure, so every combination can be
+ * tested.
+ *
+ * An adopted gadget keeps its pinned functions linked at all times. The
+ * mode is expressed by which of usb-signaller's own functions are linked
+ * next to them. usb-signaller only ever creates, links, unlinks and removes
+ * its own functions, and refuses to switch while a function it does not
+ * know is linked.
+ */
+
+/* The adopted-gadget transaction that uses this is not part of this change yet */
+#![allow(dead_code)]
+
+use std::collections::{BTreeMap, BTreeSet};
+use std::fmt;
+
+use crate::udc::UDCMode;
+use crate::utils::udcmode_to_string;
+use crate::window::{WindowEntry, WindowOp, WindowPlan};
+
+pub const NCM_FUNCTION: &str = "ncm.usb0";
+pub const MTP_FUNCTION: &str = "ffs.mtp";
+pub const ACCESSORY_FUNCTION: &str = "ffs.accessory";
+pub const MASS_STORAGE_FUNCTION: &str = "mass_storage.0";
+
+/* The function instances usb-signaller creates for its modes */
+pub const MANAGED_FUNCTIONS: [&str; 4] = [
+    NCM_FUNCTION,
+    MTP_FUNCTION,
+    ACCESSORY_FUNCTION,
+    MASS_STORAGE_FUNCTION,
+];
+
+pub const DEVELOPER_SERVICE: &str = "usb-signaller-developer-mode";
+pub const TETHERING_SERVICE: &str = "usb-signaller-tethering-mode";
+pub const MTP_SERVICE: &str = "usb-signaller-mtp-mode";
+pub const MTP_MOUNT: &str = "/dev/mtp";
+
+pub fn is_ffs(function: &str) -> bool {
+    return function.starts_with("ffs.");
+}
+
+/*
+ * Functions a mode links next to the pins, for the modes an adopted gadget
+ * supports so far. None for every other mode.
+ */
+pub fn mode_functions(mode: &UDCMode) -> Option<&'static [&'static str]> {
+    return match mode {
+        UDCMode::Charging => Some(&[]),
+        UDCMode::Developer | UDCMode::Tethering => Some(&[NCM_FUNCTION]),
+        _ => None,
+    };
+}
+
+/* Mode names accepted for an adopted gadget */
+pub fn adopted_mode(mode: &str) -> Option<UDCMode> {
+    return match mode {
+        "charging_only" => Some(UDCMode::Charging),
+        "developer_mode" => Some(UDCMode::Developer),
+        "tethering_mode" => Some(UDCMode::Tethering),
+        _ => None,
+    };
+}
+
+/* The service that runs while a mode is active */
+pub fn mode_service(mode: &UDCMode) -> Option<&'static str> {
+    return match mode {
+        UDCMode::Developer => Some(DEVELOPER_SERVICE),
+        UDCMode::Tethering => Some(TETHERING_SERVICE),
+        _ => None,
+    };
+}
+
+/*
+ * Mode of an adopted gadget from the functions linked next to its pins.
+ * Developer and tethering link the same function: 'tethering' says which,
+ * from the state file written by the last switch.
+ */
+pub fn classify(functions: &BTreeSet<&str>, tethering: bool, cdrom: bool) -> UDCMode {
+    let only = |function: &str| functions.len() == 1 && functions.contains(function);
+    if functions.is_empty() {
+        return UDCMode::Charging;
+    } else if only(NCM_FUNCTION) {
+        if tethering {
+            return UDCMode::Tethering;
+        }
+        return UDCMode::Developer;
+    } else if only(MTP_FUNCTION) {
+        return UDCMode::MTP;
+    } else if only(ACCESSORY_FUNCTION) {
+        return UDCMode::Accessory;
+    } else if only(MASS_STORAGE_FUNCTION) {
+        if cdrom {
+            return UDCMode::CdRom;
+        }
+        return UDCMode::MassStorage;
+    }
+    return UDCMode::Unknown;
+}
+
+/* An adopted gadget as read from configfs, through new handles */
+#[derive(Debug, Clone, PartialEq)]
+pub struct Snapshot {
+    pub gadget: String,
+    pub config: String,
+    /* The UDC attribute; empty when unbound */
+    pub udc: String,
+    /* (link name, function) in link order */
+    pub links: Vec<(String, String)>,
+    pub function_dirs: BTreeSet<String>,
+    /* 'ready' of every linked FunctionFS function; None without the attribute */
+    pub ready: BTreeMap<String, Option<bool>>,
+    pub mode: UDCMode,
+}
+
+impl Snapshot {
+    pub fn linked(&self, function: &str) -> bool {
+        return self.links.iter().any(|(_, f)| f == function);
+    }
+}
+
+/* Services to stop before and start after a switch */
+#[derive(Debug, Clone, Default, PartialEq)]
+pub struct ServicePlan {
+    pub stop: Option<&'static str>,
+    pub start: Option<&'static str>,
+}
+
+impl ServicePlan {
+    /* Developer and tethering share a composition: switching is a service swap */
+    pub fn for_transition(current: &UDCMode, target: &UDCMode) -> Self {
+        let old = mode_service(current);
+        let new = mode_service(target);
+        return Self {
+            stop: if old != new { old } else { None },
+            start: new,
+        };
+    }
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct Plan {
+    pub gadget: String,
+    pub config: String,
+    pub current: UDCMode,
+    pub target: UDCMode,
+    /* (link name, function) to unlink, in link order */
+    pub unlink: Vec<(String, String)>,
+    /* Functions to link, named after themselves, appended after the existing links */
+    pub link: Vec<String>,
+    /* Function directories to create before the unbind */
+    pub create: Vec<String>,
+    /* Function directories to remove after the rebind; only usb-signaller's own */
+    pub destroy: Vec<String>,
+    /* A mass storage LUN leaves: force-eject it before the unbind, while bound */
+    pub forced_eject: bool,
+    /* The MTP function leaves: stop its daemon and unmount after the rebind */
+    pub stop_mtp: bool,
+    pub services: ServicePlan,
+}
+
+impl Plan {
+    /* Whether the composition changes, which needs an unbind and a rebind */
+    pub fn rebind(&self) -> bool {
+        return !self.unlink.is_empty() || !self.link.is_empty();
+    }
+}
+
+impl fmt::Display for Plan {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        let list = |items: Vec<&str>| {
+            if items.is_empty() {
+                return "-".to_string();
+            }
+            return items.join(", ");
+        };
+        writeln!(
+            f,
+            "{}/{}: {} -> {}",
+            self.gadget,
+            self.config,
+            udcmode_to_string(self.current.clone()),
+            udcmode_to_string(self.target.clone())
+        )?;
+        if !self.rebind() {
+            writeln!(f, "  composition unchanged: no configfs write, no rebind")?;
+        } else {
+            writeln!(
+                f,
+                "  prepare (bound): create {}{}",
+                list(self.create.iter().map(String::as_str).collect()),
+                if self.forced_eject {
+                    "; force-eject mass_storage.0"
+                } else {
+                    ""
+                }
+            )?;
+            writeln!(
+                f,
+                "  window (unbound): unlink {}; link {}; bind",
+                list(self.unlink.iter().map(|(link, _)| link.as_str()).collect()),
+                list(self.link.iter().map(String::as_str).collect())
+            )?;
+            writeln!(
+                f,
+                "  finish (bound): remove {}{}",
+                list(self.destroy.iter().map(String::as_str).collect()),
+                if self.stop_mtp {
+                    "; stop the MTP daemon and unmount"
+                } else {
+                    ""
+                }
+            )?;
+        }
+        writeln!(
+            f,
+            "  services: stop {}; start {}",
+            self.services.stop.unwrap_or("-"),
+            self.services.start.unwrap_or("-")
+        )?;
+        return Ok(());
+    }
+}
+
+/*
+ * Decide how to reach 'target' from the snapshot. Refuses modes an adopted
+ * gadget does not support, modes outside allowed_modes, missing or
+ * non-ready pins and unknown linked functions.
+ */
+pub fn plan(
+    snapshot: &Snapshot,
+    pins: &BTreeSet<String>,
+    target: &UDCMode,
+    allowed_modes: Option<&BTreeSet<String>>,
+) -> anyhow::Result<Plan> {
+    let gadget = &snapshot.gadget;
+    let config = &snapshot.config;
+    let name = udcmode_to_string(target.clone());
+
+    let Some(functions) = mode_functions(target) else {
+        return Err(anyhow::anyhow!(
+            "{name} is not supported while gadget {gadget} is adopted"
+        ));
+    };
+    if let Some(allowed) = allowed_modes
+        && !allowed.contains(name)
+    {
+        return Err(anyhow::anyhow!(
+            "{name} is not in allowed_modes for gadget {gadget}"
+        ));
+    }
+    for pin in pins {
+        if !snapshot.linked(pin) {
+            return Err(anyhow::anyhow!(
+                "pinned function {pin} is not linked in {gadget}/{config}"
+            ));
+        }
+        if snapshot.ready.get(pin) == Some(&Some(false)) {
+            return Err(anyhow::anyhow!("pinned function {pin} is not ready"));
+        }
+    }
+    if let Some((_, function)) = snapshot
+        .links
+        .iter()
+        .find(|(_, f)| !pins.contains(f) && !MANAGED_FUNCTIONS.contains(&f.as_str()))
+    {
+        return Err(anyhow::anyhow!(
+            "function {function} linked in {gadget}/{config} is neither pinned nor managed by usb-signaller; pin it or remove it"
+        ));
+    }
+
+    /* A pinned function that a mode needs, for example ncm.usb0, stays as it is */
+    let want: Vec<&str> = functions
+        .iter()
+        .copied()
+        .filter(|f| !pins.contains(*f))
+        .collect();
+    let unlink: Vec<(String, String)> = snapshot
+        .links
+        .iter()
+        .filter(|(_, f)| !pins.contains(f) && !want.contains(&f.as_str()))
+        .cloned()
+        .collect();
+    let link: Vec<String> = want
+        .iter()
+        .filter(|f| !snapshot.linked(f))
+        .map(|f| f.to_string())
+        .collect();
+    let create: Vec<String> = link
+        .iter()
+        .filter(|f| !snapshot.function_dirs.contains(*f))
+        .cloned()
+        .collect();
+    let mut destroy: Vec<String> = vec![];
+    for (_, function) in &unlink {
+        if !destroy.contains(function) {
+            destroy.push(function.clone());
+        }
+    }
+
+    return Ok(Plan {
+        gadget: gadget.clone(),
+        config: config.clone(),
+        current: snapshot.mode.clone(),
+        target: target.clone(),
+        forced_eject: destroy.iter().any(|f| f == MASS_STORAGE_FUNCTION),
+        stop_mtp: destroy.iter().any(|f| f == MTP_FUNCTION),
+        unlink,
+        link,
+        create,
+        destroy,
+        services: ServicePlan::for_transition(&snapshot.mode, target),
+    });
+}
+
+/*
+ * The window's operations for a plan: the target, the way back to the
+ * snapshot's composition, and the pins alone. Pins are never unlinked.
+ */
+pub fn window_plan(
+    snapshot: &Snapshot,
+    plan: &Plan,
+    pins: &BTreeSet<String>,
+    udc: &str,
+) -> WindowPlan {
+    fn index(link: &str, function: &str, entries: &mut Vec<WindowEntry>) -> usize {
+        if let Some(i) = entries.iter().position(|e| e.link == link) {
+            return i;
+        }
+        entries.push(WindowEntry {
+            link: link.to_string(),
+            function: function.to_string(),
+        });
+        return entries.len() - 1;
+    }
+
+    let mut entries: Vec<WindowEntry> = vec![];
+
+    let pin_entries: Vec<usize> = snapshot
+        .links
+        .iter()
+        .filter(|(_, f)| pins.contains(f))
+        .map(|(link, f)| index(link, f, &mut entries))
+        .collect();
+    let unlinked: Vec<usize> = plan
+        .unlink
+        .iter()
+        .map(|(link, f)| index(link, f, &mut entries))
+        .collect();
+    let linked: Vec<usize> = plan
+        .link
+        .iter()
+        .map(|f| index(f, f, &mut entries))
+        .collect();
+    let kept: Vec<usize> = snapshot
+        .links
+        .iter()
+        .filter(|(_, f)| !pins.contains(f))
+        .map(|(link, f)| index(link, f, &mut entries))
+        .collect();
+
+    let ffs = |ids: &[usize], entries: &[WindowEntry]| -> Vec<usize> {
+        let unique: BTreeSet<usize> = ids
+            .iter()
+            .copied()
+            .filter(|&i| is_ffs(&entries[i].function))
+            .collect();
+        return unique.into_iter().collect();
+    };
+
+    let mut target = vec![];
+    target.extend(unlinked.iter().map(|&i| WindowOp::Unlink(i)));
+    target.extend(linked.iter().map(|&i| WindowOp::Link(i)));
+    let mut previous = vec![];
+    previous.extend(linked.iter().map(|&i| WindowOp::Unlink(i)));
+    previous.extend(unlinked.iter().map(|&i| WindowOp::Link(i)));
+    let pins_only: Vec<WindowOp> = (0..entries.len())
+        .filter(|i| !pin_entries.contains(i))
+        .map(WindowOp::Unlink)
+        .collect();
+
+    let target_ids: Vec<usize> = pin_entries
+        .iter()
+        .chain(kept.iter().filter(|i| !unlinked.contains(i)))
+        .chain(linked.iter())
+        .copied()
+        .collect();
+    let previous_ids: Vec<usize> = pin_entries.iter().chain(kept.iter()).copied().collect();
+
+    return WindowPlan {
+        gadget: snapshot.gadget.clone(),
+        config: snapshot.config.clone(),
+        udc: udc.to_string(),
+        target_ffs: ffs(&target_ids, &entries),
+        previous_ffs: ffs(&previous_ids, &entries),
+        pins_ffs: ffs(&pin_entries, &entries),
+        target,
+        previous,
+        pins_only,
+        entries,
+    };
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const PIN_CHOICES: [&str; 3] = ["ffs.pin", "acm.pin", NCM_FUNCTION];
+    const LINK_CHOICES: [&str; 5] = [
+        NCM_FUNCTION,
+        MTP_FUNCTION,
+        ACCESSORY_FUNCTION,
+        MASS_STORAGE_FUNCTION,
+        "acm.unmanaged",
+    ];
+    const TARGETS: [UDCMode; 9] = [
+        UDCMode::Charging,
+        UDCMode::Developer,
+        UDCMode::Tethering,
+        UDCMode::MTP,
+        UDCMode::Accessory,
+        UDCMode::MassStorage,
+        UDCMode::CdRom,
+        UDCMode::Netboot,
+        UDCMode::Unknown,
+    ];
+
+    fn subsets<'a>(items: &[&'a str]) -> Vec<Vec<&'a str>> {
+        let mut out = vec![];
+        for mask in 0..(1u32 << items.len()) {
+            out.push(
+                items
+                    .iter()
+                    .enumerate()
+                    .filter(|(i, _)| mask & (1 << i) != 0)
+                    .map(|(_, item)| *item)
+                    .collect(),
+            );
+        }
+        return out;
+    }
+
+    fn snapshot(pins: &[&str], links: &[&str], extra_dirs: &[&str], mode: UDCMode) -> Snapshot {
+        let mut all: Vec<(String, String)> = vec![];
+        for function in pins.iter().chain(links.iter()) {
+            if !all.iter().any(|(_, f)| f == function) {
+                all.push((function.to_string(), function.to_string()));
+            }
+        }
+        let function_dirs = all
+            .iter()
+            .map(|(_, f)| f.clone())
+            .chain(extra_dirs.iter().map(|f| f.to_string()))
+            .collect();
+        let ready = all
+            .iter()
+            .filter(|(_, f)| is_ffs(f))
+            .map(|(_, f)| (f.clone(), Some(true)))
+            .collect();
+        return Snapshot {
+            gadget: "g".into(),
+            config: "c.1".into(),
+            udc: "udc0".into(),
+            links: all,
+            function_dirs,
+            ready,
+            mode,
+        };
+    }
+
+    fn set(items: &[&str]) -> BTreeSet<String> {
+        return items.iter().map(|s| s.to_string()).collect();
+    }
+
+    /* Links after applying a plan's window ops to the snapshot */
+    fn after(snapshot: &Snapshot, plan: &Plan) -> BTreeSet<String> {
+        let mut links: BTreeSet<String> = snapshot.links.iter().map(|(_, f)| f.clone()).collect();
+        for (_, f) in &plan.unlink {
+            links.remove(f);
+        }
+        links.extend(plan.link.iter().cloned());
+        return links;
+    }
+
+    /*
+     * Every combination of pins, linked functions, existing function
+     * directories and target mode.
+     */
+    #[test]
+    fn planner_properties_hold_for_every_combination() {
+        let mut checked = 0;
+        for pins in subsets(&PIN_CHOICES) {
+            if pins.is_empty() {
+                continue;
+            }
+            let pin_set = set(&pins);
+            for links in subsets(&LINK_CHOICES) {
+                for extra in [vec![], vec![NCM_FUNCTION]] {
+                    let current: BTreeSet<&str> = links
+                        .iter()
+                        .copied()
+                        .filter(|f| !pin_set.contains(*f))
+                        .collect();
+                    let mode = classify(&current, false, false);
+                    let snap = snapshot(&pins, &links, &extra, mode.clone());
+                    for target in TARGETS.iter() {
+                        check(&snap, &pin_set, target, &links);
+                        checked += 1;
+                    }
+                }
+            }
+        }
+        assert_eq!(checked, 7 * 32 * 2 * 9);
+    }
+
+    fn check(snap: &Snapshot, pins: &BTreeSet<String>, target: &UDCMode, links: &[&str]) {
+        let result = plan(snap, pins, target, None);
+        let context = format!("pins {pins:?} links {links:?} target {target:?}");
+
+        /* Host, accessory, MTP and mass storage are refused under adoption */
+        let Some(functions) = mode_functions(target) else {
+            let error = result.expect_err(&context).to_string();
+            assert!(
+                error.contains("is not supported while gadget g is adopted"),
+                "{context}"
+            );
+            return;
+        };
+
+        /* A linked function nobody owns makes every switch fail */
+        let unmanaged = links
+            .iter()
+            .any(|f| !pins.contains(*f) && !MANAGED_FUNCTIONS.contains(f));
+        if unmanaged {
+            let error = result.expect_err(&context).to_string();
+            assert!(error.contains("is neither pinned nor managed"), "{context}");
+            return;
+        }
+
+        let plan = result.expect(&context);
+        /* I1, I2: pins are never unlinked or removed */
+        for pin in pins {
+            assert!(!plan.unlink.iter().any(|(_, f)| f == pin), "{context}");
+            assert!(!plan.destroy.contains(pin), "{context}");
+        }
+        /* I4: only usb-signaller's own functions are removed */
+        for function in &plan.destroy {
+            assert!(MANAGED_FUNCTIONS.contains(&function.as_str()), "{context}");
+        }
+        /* I11: a leaving mass storage LUN is force-ejected first */
+        assert_eq!(
+            plan.forced_eject,
+            plan.unlink.iter().any(|(_, f)| f == MASS_STORAGE_FUNCTION),
+            "{context}"
+        );
+        assert_eq!(
+            plan.stop_mtp,
+            plan.unlink.iter().any(|(_, f)| f == MTP_FUNCTION),
+            "{context}"
+        );
+        /* Directories are only created for functions being linked, and only when missing */
+        for function in &plan.create {
+            assert!(plan.link.contains(function), "{context}");
+            assert!(!snap.function_dirs.contains(function), "{context}");
+        }
+        /* The result is exactly the pins plus the mode's functions */
+        let mut expected = pins.clone();
+        expected.extend(functions.iter().map(|f| f.to_string()));
+        assert_eq!(after(snap, &plan), expected, "{context}");
+        /* I5: no rebind when nothing changes, in particular when the mode's functions are pinned */
+        let current: BTreeSet<String> = snap.links.iter().map(|(_, f)| f.clone()).collect();
+        assert_eq!(plan.rebind(), current != expected, "{context}");
+        if functions.iter().all(|f| pins.contains(*f)) && current == *pins {
+            assert!(!plan.rebind(), "{context}");
+        }
+
+        /* The window never unlinks a pin, and binds only with ready FunctionFS functions */
+        let window = window_plan(snap, &plan, pins, "udc0");
+        for op in window
+            .target
+            .iter()
+            .chain(&window.previous)
+            .chain(&window.pins_only)
+        {
+            if let WindowOp::Unlink(i) = op {
+                assert!(!pins.contains(&window.entries[*i].function), "{context}");
+            }
+        }
+        for pin in pins.iter().filter(|p| is_ffs(p)) {
+            let i = window
+                .entries
+                .iter()
+                .position(|e| &e.function == pin)
+                .unwrap();
+            assert!(window.target_ffs.contains(&i), "{context}");
+            assert!(window.previous_ffs.contains(&i), "{context}");
+            assert!(window.pins_ffs.contains(&i), "{context}");
+        }
+        assert_eq!(window.target.is_empty(), !plan.rebind(), "{context}");
+    }
+
+    #[test]
+    fn developer_and_tethering_swap_services_without_a_rebind() {
+        let pins = set(&["ffs.smoo"]);
+        let snap = snapshot(&["ffs.smoo"], &[NCM_FUNCTION], &[], UDCMode::Developer);
+        let swap = plan(&snap, &pins, &UDCMode::Tethering, None).unwrap();
+        assert!(!swap.rebind());
+        assert_eq!(swap.services.stop, Some(DEVELOPER_SERVICE));
+        assert_eq!(swap.services.start, Some(TETHERING_SERVICE));
+
+        let snap = snapshot(&["ffs.smoo"], &[NCM_FUNCTION], &[], UDCMode::Tethering);
+        let swap = plan(&snap, &pins, &UDCMode::Developer, None).unwrap();
+        assert!(!swap.rebind());
+        assert_eq!(swap.services.stop, Some(TETHERING_SERVICE));
+        assert_eq!(swap.services.start, Some(DEVELOPER_SERVICE));
+    }
+
+    #[test]
+    fn same_mode_only_makes_sure_its_service_runs() {
+        let pins = set(&["ffs.smoo"]);
+        let snap = snapshot(&["ffs.smoo"], &[NCM_FUNCTION], &[], UDCMode::Developer);
+        let plan = plan(&snap, &pins, &UDCMode::Developer, None).unwrap();
+        assert!(!plan.rebind());
+        assert_eq!(plan.services.stop, None);
+        assert_eq!(plan.services.start, Some(DEVELOPER_SERVICE));
+    }
+
+    #[test]
+    fn charging_to_developer_creates_and_links_ncm() {
+        let pins = set(&["ffs.smoo"]);
+        let snap = snapshot(&["ffs.smoo"], &[], &[], UDCMode::Charging);
+        let plan = plan(&snap, &pins, &UDCMode::Developer, None).unwrap();
+        assert_eq!(plan.create, vec![NCM_FUNCTION.to_string()]);
+        assert_eq!(plan.link, vec![NCM_FUNCTION.to_string()]);
+        assert!(plan.unlink.is_empty());
+        assert!(plan.destroy.is_empty());
+        assert_eq!(plan.services.start, Some(DEVELOPER_SERVICE));
+        let text = plan.to_string();
+        assert!(text.contains("g/c.1: charging_only -> developer_mode"));
+        assert!(text.contains("window (unbound): unlink -; link ncm.usb0; bind"));
+    }
+
+    #[test]
+    fn allowed_modes_restrict_the_targets() {
+        let pins = set(&["ffs.smoo"]);
+        let snap = snapshot(&["ffs.smoo"], &[], &[], UDCMode::Charging);
+        let allowed = set(&["charging_only", "developer_mode"]);
+        assert!(plan(&snap, &pins, &UDCMode::Developer, Some(&allowed)).is_ok());
+        let error = plan(&snap, &pins, &UDCMode::Tethering, Some(&allowed)).unwrap_err();
+        assert_eq!(
+            error.to_string(),
+            "tethering_mode is not in allowed_modes for gadget g"
+        );
+    }
+
+    #[test]
+    fn missing_or_non_ready_pins_are_refused() {
+        let pins = set(&["ffs.smoo"]);
+        let snap = snapshot(&[], &[], &[], UDCMode::Charging);
+        assert_eq!(
+            plan(&snap, &pins, &UDCMode::Developer, None)
+                .unwrap_err()
+                .to_string(),
+            "pinned function ffs.smoo is not linked in g/c.1"
+        );
+        let mut snap = snapshot(&["ffs.smoo"], &[], &[], UDCMode::Charging);
+        snap.ready.insert("ffs.smoo".into(), Some(false));
+        assert_eq!(
+            plan(&snap, &pins, &UDCMode::Developer, None)
+                .unwrap_err()
+                .to_string(),
+            "pinned function ffs.smoo is not ready"
+        );
+        /* Without a 'ready' attribute a bound pin counts as ready */
+        snap.ready.insert("ffs.smoo".into(), None);
+        assert!(plan(&snap, &pins, &UDCMode::Developer, None).is_ok());
+    }
+
+    #[test]
+    fn unmanaged_functions_are_refused_with_a_hint() {
+        let pins = set(&["ffs.smoo"]);
+        let snap = snapshot(&["ffs.smoo"], &["acm.GS0"], &[], UDCMode::Unknown);
+        assert_eq!(
+            plan(&snap, &pins, &UDCMode::Charging, None)
+                .unwrap_err()
+                .to_string(),
+            "function acm.GS0 linked in g/c.1 is neither pinned nor managed by usb-signaller; pin it or remove it"
+        );
+    }
+
+    #[test]
+    fn link_names_may_differ_from_function_names() {
+        let pins = set(&["ffs.smoo"]);
+        let mut snap = snapshot(&["ffs.smoo"], &[], &[], UDCMode::Developer);
+        snap.links.push(("net".into(), NCM_FUNCTION.into()));
+        let plan = plan(&snap, &pins, &UDCMode::Charging, None).unwrap();
+        assert_eq!(
+            plan.unlink,
+            vec![("net".to_string(), NCM_FUNCTION.to_string())]
+        );
+        let window = window_plan(&snap, &plan, &pins, "udc0");
+        let WindowOp::Unlink(i) = window.target[0] else {
+            panic!("expected an unlink");
+        };
+        assert_eq!(window.entries[i].link, "net");
+        assert_eq!(window.previous, vec![WindowOp::Link(i)]);
+    }
+
+    #[test]
+    fn classification() {
+        let set = |items: &[&'static str]| -> BTreeSet<&'static str> {
+            return items.iter().copied().collect();
+        };
+        assert_eq!(classify(&set(&[]), true, true), UDCMode::Charging);
+        assert_eq!(
+            classify(&set(&[NCM_FUNCTION]), false, false),
+            UDCMode::Developer
+        );
+        assert_eq!(
+            classify(&set(&[NCM_FUNCTION]), true, false),
+            UDCMode::Tethering
+        );
+        assert_eq!(classify(&set(&[MTP_FUNCTION]), false, false), UDCMode::MTP);
+        assert_eq!(
+            classify(&set(&[MASS_STORAGE_FUNCTION]), false, true),
+            UDCMode::CdRom
+        );
+        assert_eq!(
+            classify(&set(&[MASS_STORAGE_FUNCTION]), false, false),
+            UDCMode::MassStorage
+        );
+        assert_eq!(
+            classify(&set(&[NCM_FUNCTION, MTP_FUNCTION]), false, false),
+            UDCMode::Unknown
+        );
+        assert_eq!(classify(&set(&["acm.GS0"]), false, false), UDCMode::Unknown);
+    }
+}
