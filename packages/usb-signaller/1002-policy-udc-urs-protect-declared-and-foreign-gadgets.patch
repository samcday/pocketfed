+/* A single configfs directory name: no path separator, NUL or whitespace */
+fn is_plain_name(name: &str) -> bool {
+    return !name.is_empty()
+        && name != "."
+        && name != ".."
+        && !name.contains('/')
+        && !name.contains('\0')
+        && !name.chars().any(char::is_whitespace);
+}
+
+/* A function instance as named in configfs: <driver>.<instance> */
+pub fn is_function_name(name: &str) -> bool {
+    return is_plain_name(name)
+        && name
+            .split_once('.')
+            .is_some_and(|(driver, instance)| !driver.is_empty() && !instance.is_empty());
+}
