+
+/*
+ * Which gadgets usb-signaller may replace.
+ *
+ * - Owned: the gadget directory starts with "usb-signaller-". usb-signaller
+ *   created it and manages it as before.
+ * - Declared: named in a [gadget.<dir>] table, for example a gadget built by
+ *   the initramfs that serves the root filesystem. Never disabled, removed or
+ *   replaced.
+ * - Foreign: anything else. [main] foreign_gadgets decides: "replace" (the
+ *   default) keeps the historical behaviour, "preserve" never touches it.
+ *
+ * A broken configuration declares nothing and preserves every gadget
+ * usb-signaller does not own.
+ */
+
+use std::collections::BTreeSet;
+
+use crate::configuration::{Configuration, ForeignGadgets, is_owned_gadget};
+
+#[derive(Debug, Clone, PartialEq)]
+pub enum GadgetClass {
+    Owned,
+    Declared { pins: BTreeSet<String> },
+    Foreign { policy: ForeignGadgets },
+}
+
+impl GadgetClass {
+    pub fn classify(config: &Configuration, gadget: &str) -> Self {
+        if is_owned_gadget(gadget) {
+            return GadgetClass::Owned;
+        }
+        if let Some(declaration) = config.gadget(gadget) {
+            return GadgetClass::Declared {
+                pins: declaration.pins(),
+            };
+        }
+        return GadgetClass::Foreign {
+            policy: config.foreign_gadgets(),
+        };
+    }
+
+    /* usb-signaller must not disable, remove or replace this gadget */
+    pub fn is_protected(&self) -> bool {
+        return match self {
+            GadgetClass::Owned => false,
+            GadgetClass::Declared { .. } => true,
+            GadgetClass::Foreign { policy } => *policy == ForeignGadgets::Preserve,
+        };
+    }
+
+    pub fn describe(&self) -> &'static str {
+        return match self {
+            GadgetClass::Owned => "owned",
+            GadgetClass::Declared { .. } => "declared",
+            GadgetClass::Foreign { .. } => "foreign",
+        };
+    }
+}
+
+/* Refuse to replace a protected gadget that holds a UDC */
+pub fn check_replaceable(config: &Configuration, udc: &str, gadget: &str) -> anyhow::Result<()> {
+    let class = GadgetClass::classify(config, gadget);
+    if class.is_protected() {
+        return Err(anyhow::anyhow!(
+            "UDC {udc} is held by {} gadget {gadget}; not replacing it",
+            class.describe()
+        ));
+    }
+
+    return Ok(());
+}
+
+/*
+ * Host role removes the UDC, which unbinds every gadget on it. Refuse it,
+ * before any role is written, while a declared gadget with pinned functions
+ * is bound, or while the configuration is broken and a gadget usb-signaller
+ * does not own is bound. 'bound' lists (UDC, gadget) pairs.
+ */
+pub fn check_host_mode(config: &Configuration, bound: &[(String, String)]) -> anyhow::Result<()> {
+    for (udc, gadget) in bound {
+        match GadgetClass::classify(config, gadget) {
+            GadgetClass::Owned => {}
+            GadgetClass::Declared { pins } if !pins.is_empty() => {
+                return Err(anyhow::anyhow!(
+                    "host_mode refused: declared gadget {gadget} on UDC {udc} has pinned functions {}",
+                    pins.into_iter().collect::<Vec<String>>().join(", ")
+                ));
+            }
+            _ if config.is_broken() => {
+                return Err(anyhow::anyhow!(
+                    "host_mode refused: the configuration is broken and gadget {gadget}, which usb-signaller does not own, is bound to UDC {udc}"
+                ));
+            }
+            _ => {}
+        }
+    }
+
+    return Ok(());
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::configuration::testing::TempRoot;
+
+    const DROPIN: &str = "run/usb-signaller/usb-signaller.toml.d/50-test.toml";
+
+    fn config(contents: &str) -> Configuration {
+        let root = TempRoot::new("policy");
+        root.write(DROPIN, contents);
+        return Configuration::load_with_root(Some(&root.path));
+    }
+
+    fn bound(udc: &str, gadget: &str) -> Vec<(String, String)> {
+        return vec![(udc.to_string(), gadget.to_string())];
+    }
+
+    #[test]
+    fn owned_gadgets_are_never_protected() {
+        let config = config("[main]\nforeign_gadgets = \"preserve\"\n");
+        let class = GadgetClass::classify(&config, "usb-signaller-developer");
+        assert_eq!(class, GadgetClass::Owned);
+        assert!(!class.is_protected());
+        assert!(check_replaceable(&config, "udc0", "usb-signaller-developer").is_ok());
+    }
+
+    #[test]
+    fn foreign_gadgets_are_replaced_by_default() {
+        let config = config("");
+        let class = GadgetClass::classify(&config, "g1");
+        assert_eq!(
+            class,
+            GadgetClass::Foreign {
+                policy: ForeignGadgets::Replace
+            }
+        );
+        assert!(check_replaceable(&config, "udc0", "g1").is_ok());
+    }
+
+    #[test]
+    fn foreign_gadgets_can_be_preserved() {
+        let config = config("[main]\nforeign_gadgets = \"preserve\"\n");
+        let error = check_replaceable(&config, "udc0", "g1").unwrap_err();
+        assert_eq!(
+            error.to_string(),
+            "UDC udc0 is held by foreign gadget g1; not replacing it"
+        );
+    }
+
+    #[test]
+    fn declared_gadgets_are_protected_even_under_replace() {
+        let config = config("[gadget.smoo]\npinned_functions = [\"ffs.smoo\"]\n");
+        let class = GadgetClass::classify(&config, "smoo");
+        assert!(class.is_protected());
+        let error = check_replaceable(&config, "udc0", "smoo").unwrap_err();
+        assert_eq!(
+            error.to_string(),
+            "UDC udc0 is held by declared gadget smoo; not replacing it"
+        );
+        /* Other gadgets still follow foreign_gadgets */
+        assert!(check_replaceable(&config, "udc0", "g1").is_ok());
+    }
+
+    #[test]
+    fn broken_configuration_preserves_every_non_owned_gadget() {
+        let config = config("[gadget.smoo]\npinned_function = [\"ffs.smoo\"]\n");
+        assert!(config.is_broken());
+        assert_eq!(
+            GadgetClass::classify(&config, "smoo"),
+            GadgetClass::Foreign {
+                policy: ForeignGadgets::Preserve
+            }
+        );
+        assert!(check_replaceable(&config, "udc0", "smoo").is_err());
+        assert!(check_replaceable(&config, "udc0", "usb-signaller-developer").is_ok());
+    }
+
+    #[test]
+    fn host_mode_is_refused_while_pins_are_bound() {
+        let config = config("[gadget.smoo]\npinned_functions = [\"ffs.smoo\"]\n");
+        let error = check_host_mode(&config, &bound("udc0", "smoo")).unwrap_err();
+        assert!(error.to_string().contains("pinned functions ffs.smoo"));
+        assert!(check_host_mode(&config, &[]).is_ok());
+    }
+
+    #[test]
+    fn host_mode_is_allowed_for_declared_gadgets_without_pins() {
+        let config = config("[gadget.g1]\n");
+        assert!(check_host_mode(&config, &bound("udc0", "g1")).is_ok());
+    }
+
+    #[test]
+    fn host_mode_is_refused_with_a_broken_configuration() {
+        let config = config("[main\n");
+        assert!(check_host_mode(&config, &bound("udc0", "g1")).is_err());
+        assert!(check_host_mode(&config, &bound("udc0", "usb-signaller-developer")).is_ok());
+    }
+
+    #[test]
+    fn host_mode_is_allowed_for_preserved_foreign_gadgets() {
+        /* Host role cleanup never removes gadgets usb-signaller does not own */
+        let config = config("[main]\nforeign_gadgets = \"preserve\"\n");
+        assert!(check_host_mode(&config, &bound("udc0", "g1")).is_ok());
+    }
+}
