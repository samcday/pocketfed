+/* What to do with a bound gadget that usb-signaller neither owns nor has declared */
+#[derive(Debug, Clone, Copy, Default, PartialEq)]
+pub enum ForeignGadgets {
+    /* Disable and remove it when switching modes (the historical behaviour) */
+    #[default]
+    Replace,
+    /* Never touch it: refuse mode switches while it holds the UDC */
+    Preserve,
+}
+
+impl ForeignGadgets {
+    pub fn as_str(&self) -> &'static str {
+        return match self {
+            ForeignGadgets::Replace => "replace",
+            ForeignGadgets::Preserve => "preserve",
+        };
+    }
+}
+
+/*
+ * A gadget declared in a [gadget.<dir>] table. usb-signaller never disables,
+ * removes or replaces a declared gadget.
+ */
+#[derive(Debug, Clone, Default, PartialEq)]
+pub struct GadgetDeclaration {
+    /* Manage the gadget in place while it stays bound (default: false) */
+    pub adopt: Option<Sourced<bool>>,
+    /* Union across files: function -> first file that pinned it */
+    pub pinned_functions: BTreeMap<String, PathBuf>,
+    /* Configuration directory to manage when the gadget has several */
+    pub config: Option<Sourced<String>>,
+    /* Keep the gadget's vendor/product IDs, class and strings (default: true) */
+    pub keep_identity: Option<Sourced<bool>>,
+    /* Intersection across the files that set it, and those files */
+    pub allowed_modes: Option<(BTreeSet<String>, Vec<PathBuf>)>,
+}
+
+impl GadgetDeclaration {
+    pub fn pins(&self) -> BTreeSet<String> {
+        return self.pinned_functions.keys().cloned().collect();
+    }
+}
+
