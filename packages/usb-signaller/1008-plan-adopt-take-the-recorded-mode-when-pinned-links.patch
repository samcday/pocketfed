+
+    /* With ncm.usb0 pinned, charging, developer and tethering all link nothing else */
+    #[test]
+    fn a_pinned_mode_function_is_classified_by_the_recorded_mode() {
+        let none: BTreeSet<&str> = BTreeSet::new();
+        let pins = set(&["ffs.smoo", NCM_FUNCTION]);
+        for mode in [UDCMode::Charging, UDCMode::Developer, UDCMode::Tethering] {
+            assert_eq!(classify(&none, &pins, Some(&mode), false), mode);
+        }
+        /* Nothing recorded: the links decide */
+        assert_eq!(classify(&none, &pins, None, false), UDCMode::Charging);
+        /* Modes an adopted gadget does not support are never taken from the state file */
+        assert_eq!(
+            classify(&none, &pins, Some(&UDCMode::MTP), false),
+            UDCMode::Charging
+        );
+    }
+
+    /* A recorded mode that the links contradict is ignored */
+    #[test]
+    fn a_recorded_mode_the_links_contradict_is_ignored() {
+        let pins = set(&["ffs.smoo"]);
+        let none: BTreeSet<&str> = BTreeSet::new();
+        let ncm: BTreeSet<&str> = [NCM_FUNCTION].into_iter().collect();
+        let mtp: BTreeSet<&str> = [MTP_FUNCTION].into_iter().collect();
+        assert_eq!(
+            classify(&none, &pins, Some(&UDCMode::Developer), false),
+            UDCMode::Charging
+        );
+        assert_eq!(
+            classify(&none, &pins, Some(&UDCMode::Tethering), false),
+            UDCMode::Charging
+        );
+        assert_eq!(
+            classify(&ncm, &pins, Some(&UDCMode::Charging), false),
+            UDCMode::Developer
+        );
+        assert_eq!(
+            classify(&mtp, &pins, Some(&UDCMode::Developer), false),
+            UDCMode::MTP
+        );
     }
