@@ -90,17 +90,36 @@ pub fn mode_service(mode: &UDCMode) -> Option<&'static str> {
 
 /*
  * Mode of an adopted gadget from the functions linked next to its pins.
- * Developer and tethering link the same function: 'tethering' says which,
- * from the state file written by the last switch.
+ * The links alone cannot tell every mode apart: developer and tethering
+ * link the same function, and a pinned mode function, for example
+ * ncm.usb0, stays linked in charging_only too. 'recorded' is the mode the
+ * state file of the last switch records for this gadget and configuration:
+ * it is the mode when the links match its composition. Otherwise the links
+ * decide.
  */
-pub fn classify(functions: &BTreeSet<&str>, tethering: bool, cdrom: bool) -> UDCMode {
+pub fn classify(
+    functions: &BTreeSet<&str>,
+    pins: &BTreeSet<String>,
+    recorded: Option<&UDCMode>,
+    cdrom: bool,
+) -> UDCMode {
+    if let Some(mode) = recorded
+        && let Some(wanted) = mode_functions(mode)
+    {
+        let expected: BTreeSet<&str> = wanted
+            .iter()
+            .copied()
+            .filter(|f| !pins.contains(*f))
+            .collect();
+        if *functions == expected {
+            return mode.clone();
+        }
+    }
+
     let only = |function: &str| functions.len() == 1 && functions.contains(function);
     if functions.is_empty() {
         return UDCMode::Charging;
     } else if only(NCM_FUNCTION) {
-        if tethering {
-            return UDCMode::Tethering;
-        }
         return UDCMode::Developer;
     } else if only(MTP_FUNCTION) {
         return UDCMode::MTP;
