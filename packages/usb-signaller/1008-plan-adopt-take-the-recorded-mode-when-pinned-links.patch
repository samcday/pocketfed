+    const SMOO_NCM_PINNED: &str =
+        "[gadget.smoo]\nadopt = true\npinned_functions = [\"ffs.smoo\", \"ncm.usb0\"]\n";
+
+    /*
+     * With ncm.usb0 pinned, developer mode links nothing next to the pins,
+     * just like charging_only: the state file tells them apart.
+     */
+    #[test]
+    fn a_pinned_ncm_is_classified_from_the_state_file() {
+        let h = Harness::new(true);
+        let mut managed = adopt_with(&h.fs, &h.fixture.sys, SMOO_NCM_PINNED);
+        /* Nothing recorded yet: the links decide */
+        assert_eq!(managed.mode, UDCMode::Charging);
+
+        h.switch(&mut managed, "developer_mode").unwrap();
+        assert_eq!(
+            adopt_with(&h.fs, &h.fixture.sys, SMOO_NCM_PINNED).mode,
+            UDCMode::Developer
+        );
+
+        /* Leaving developer mode stops its service, without touching configfs */
+        h.services.clear();
+        h.fs.clear_ops();
+        assert_eq!(
+            h.switch(&mut managed, "charging_only").unwrap(),
+            UDCMode::Charging
+        );
+        assert_eq!(
+            h.services.calls(),
+            vec!["stop usb-signaller-developer-mode"]
+        );
+        assert!(writes(&h.fs.ops()).is_empty());
+        assert_eq!(h.functions(), vec!["ffs.smoo", "ncm.usb0"]);
+        assert_eq!(
+            adopt_with(&h.fs, &h.fixture.sys, SMOO_NCM_PINNED).mode,
+            UDCMode::Charging
+        );
+    }
+
+    /* The state file only counts for the gadget and configuration it records */
+    #[test]
+    fn a_state_file_for_another_gadget_or_configuration_is_ignored() {
+        let h = Harness::new(true);
+        let managed = adopt_with(&h.fs, &h.fixture.sys, SMOO_NCM_PINNED);
+        for (gadget, config) in [("other", "c.1"), ("smoo", "c.2")] {
+            for mode in [UDCMode::Developer, UDCMode::Tethering] {
+                let stale = Managed {
+                    gadget: gadget.to_string(),
+                    config: config.to_string(),
+                    mode: mode.clone(),
+                    ..managed.clone()
+                };
+                write_state_env(&h.fixture.sys, &h.fs, &stale).unwrap();
+                let context = format!("{gadget}/{config} in {mode:?}");
+                /* ncm.usb0 pinned: the links say charging_only */
+                assert_eq!(
+                    adopt_with(&h.fs, &h.fixture.sys, SMOO_NCM_PINNED).mode,
+                    UDCMode::Charging,
+                    "{context}"
+                );
+                /* ncm.usb0 not pinned: the links say developer_mode */
+                assert_eq!(
+                    adopt(&h.fs, &h.fixture.sys).mode,
+                    UDCMode::Developer,
+                    "{context}"
+                );
+            }
+        }
+    }
+
     #[test]
