+        let s = setup(SMOO, locked);
+        s.core(|core| core.refresh_adoption());
+        assert_eq!(
+            s.core(|core| core.adopted["udc0"].mode.clone()),
+            UDCMode::Developer
+        );
+        assert!(s.core(|core| core.memory_locked));
