+        for udc in discover_udcs(&self.sys) {
+            if self.adopted.contains_key(&udc) {
+                continue;
+            }
+            let bound = UDC::bound_gadget_name(&self.sys, &udc);
+            let port = classify_port(&self.config, &*self.cfs, &self.sys, &udc, bound.as_deref());
+            if let Port::Adopted(managed) = port {
+                if !self.ensure_memory_locked() {
+                    eprintln!(
+                        "❌ Not adopting {}: memory could not be locked; it stays protected",
+                        managed.gadget
+                    );
+                    continue;
+                }
+                println!(
+                    "ℹ️  Adopted gadget {} on UDC {udc} ({}), pins {}, mode {}",
+                    managed.gadget,
+                    managed.config,
