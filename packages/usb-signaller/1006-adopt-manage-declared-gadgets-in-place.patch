+        let sys = &self.sys;
+        let cfs = &*self.cfs;
+        self.adopted.retain(|udc, managed| {
+            let bound = udcs.contains(udc)
+                && UDC::bound_gadget_name(sys, udc).as_deref() == Some(managed.gadget.as_str());
+            let waiting = !bound && cfs.read_udc(&managed.gadget).is_ok_and(|name| name == *udc);
