+
+    /*
+     * After every transaction, however it ended: the gadget is bound (once
+     * its UDC is present), every pin is linked, and while the gadget was
+     * unbound only the window made calls, all of them window operations.
+     */
+    fn assert_invariants(h: &Harness, context: &str) {
+        let ops = h.fs.ops();
+        h.fs.add_udc("udc0");
+        assert!(h.fs.is_bound("smoo"), "{context}: not bound; ops {ops:#?}");
+        assert!(
+            h.functions().contains(&"ffs.smoo".to_string()),
+            "{context}: pin unlinked"
+        );
+        assert!(
+            h.fs.has_function("smoo", "ffs.smoo"),
+            "{context}: pin removed"
+        );
+        for record in &ops {
+            if let FakeOp::Unlink(_, _, link) | FakeOp::Rmdir(_, link) = &record.op {
+                assert_ne!(link, "ffs.smoo", "{context}: touched the pin");
+            }
+            if record.window {
+                assert!(
+                    matches!(
+                        record.op,
+                        FakeOp::OpenUdc(..)
+                            | FakeOp::ReadUdc(..)
+                            | FakeOp::WriteUdc(..)
+                            | FakeOp::Unlink(..)
+                            | FakeOp::Link { .. }
+                            | FakeOp::FfsReady(..)
+                    ),
+                    "{context}: {record:?} in the window"
+                );
+            }
+        }
+        /*
+         * Between the window's unbind and its successful bind, nothing else
+         * ran: no other configfs call and no mode service call (services
+         * are logged in the same numbered log).
+         */
+        let first = ops
+            .iter()
+            .position(|r| r.window && r.op == FakeOp::WriteUdc("smoo".into(), UNBIND.into()));
+        let last = ops.iter().rposition(|r| {
+            r.window && r.errno.is_none() && matches!(&r.op, FakeOp::WriteUdc(_, v) if v != UNBIND)
+        });
+        if let (Some(first), Some(last)) = (first, last) {
+            for record in &ops[first..=last] {
+                assert!(record.window, "{context}: {record:?} ran while unbound");
+            }
+        }
+    }
+
+    /*
+     * Mode services of a transaction that started in 'initial', aimed at
+     * 'target' and left the gadget in 'now':
+     *
+     * - no service starts before the window has ended;
+     * - only the service of the mode the gadget is in afterwards starts, so
+     *   a failed rung never starts the target's service unless the gadget
+     *   ended up in the target mode anyway;
+     * - when no service call failed, exactly that service runs afterwards,
+     *   which after an untouched window means the old one again.
+     */
+    fn assert_services(h: &Harness, context: &str, initial: &UDCMode, now: &UDCMode, ending: &str) {
+        let ops = h.fs.ops();
+        let window_end = ops.iter().rposition(|r| r.window);
+        let expected: BTreeSet<String> = mode_service(now).map(String::from).into_iter().collect();
+        let mut running: BTreeSet<String> = mode_service(initial)
+            .map(String::from)
+            .into_iter()
+            .collect();
+        let mut failed = false;
+        let mut last = None;
+        for (index, record) in ops.iter().enumerate() {
+            let FakeOp::Service(call) = &record.op else {
+                continue;
+            };
+            if record.errno.is_some() {
+                failed = true;
+                continue;
+            }
+            last = Some(call.clone());
+            if let Some(service) = call.strip_prefix("start ") {
+                assert!(
+                    window_end.is_none_or(|end| index > end),
+                    "{context}: {call} before the window ended"
+                );
+                assert_eq!(
+                    Some(service),
+                    mode_service(now),
+                    "{context}: {call}, but the gadget is in {now:?}"
+                );
+                running.insert(service.to_string());
+            } else if let Some(service) = call.strip_prefix("stop ") {
+                running.remove(service);
+            }
+        }
+        if !failed {
+            assert_eq!(running, expected, "{context}: services {ops:#?}");
+        }
+        if ending == "untouched"
+            && let Some(old) = mode_service(initial)
+        {
+            assert_eq!(last, Some(format!("start {old}")), "{context}");
+        }
+    }
+
+    type Fault = (&'static str, fn(&FakeConfigFs, usize));
+
+    fn faults() -> Vec<Fault> {
+        return vec![
+            ("EBUSY", |fs, n| fs.fail_op(n, libc::EBUSY)),
+            ("EINVAL", |fs, n| fs.fail_op(n, libc::EINVAL)),
+            /* Someone else removes ncm.usb0 while the gadget is unbound: our unlink gets ENOENT */
+            ("concurrent unlinker", |fs, n| {
+                fs.before_op(n, |s: &mut FakeState| {
+                    if s.gadgets["smoo"].udc_name.is_none() {
+                        let _ = s.unlink("smoo", "c.1", "ncm.usb0");
+                    }
+                })
+            }),
+            ("EIO", |fs, n| fs.fail_op(n, libc::EIO)),
+            ("concurrent binder", |fs, n| {
+                fs.before_op(n, |s: &mut FakeState| {
+                    let _ = s.bind("smoo", "udc0");
+                })
+            }),
+            ("UDC vanishes", |fs, n| {
+                fs.before_op(n, |s: &mut FakeState| {
+                    if let Some(Some(gadget)) = s.udcs.remove("udc0") {
+                        s.gadgets.get_mut(&gadget).unwrap().bound = false;
+                    }
+                });
+                fs.on_pause(|s: &mut FakeState, pauses| {
+                    if pauses == 3 && !s.udcs.contains_key("udc0") {
+                        s.udcs.insert("udc0".into(), None);
+                    }
+                });
+            }),
+        ];
+    }
+
+    /* Inject every fault before every call of every switch */
+    #[test]
+    fn faults_at_every_op_keep_the_gadget_bound_with_its_pins() {
+        let scenarios: [(bool, &str); 4] = [
+            (true, "charging_only"),
+            (false, "developer_mode"),
+            (false, "tethering_mode"),
+            (true, "developer_mode"),
+        ];
+        let mut runs = 0;
+        let mut endings: BTreeMap<&str, usize> = BTreeMap::new();
+        for (with_ncm, mode) in scenarios {
+            /* Count the calls of a clean run */
+            let h = Harness::new(with_ncm);
+            let mut managed = adopt(&h.fs, &h.fixture.sys);
+            h.fs.clear_ops();
+            h.switch(&mut managed, mode).unwrap();
+            let total = h.fs.ops().len();
+
+            for (name, inject) in faults() {
+                for n in 0..total + 2 {
+                    let h = Harness::new(with_ncm);
+                    let mut managed = adopt(&h.fs, &h.fixture.sys);
+                    let initial = managed.mode.clone();
+                    h.fs.clear_ops();
+                    inject(&h.fs, n);
+                    let result = h.switch(&mut managed, mode);
+                    let context =
+                        format!("{mode} from ncm={with_ncm}, {name} at op {n}: {result:?}");
+                    let ending = match &result {
+                        Ok(_) => "target",
+                        Err(err) if err.to_string().ends_with("(Previous)") => "previous",
+                        Err(err) if err.to_string().ends_with("(PinsOnly)") => "pins only",
+                        Err(err) if err.to_string().ends_with("(RecoveredByOther)") => {
+                            "recovered by other"
+                        }
+                        Err(err) if err.to_string().ends_with("nothing changed") => "untouched",
+                        Err(err) if err.to_string().contains("service failed") => "service failed",
+                        Err(_) => "refused before the window",
+                    };
+                    assert_services(&h, &context, &initial, &managed.mode, ending);
+                    assert_invariants(&h, &context);
+                    *endings.entry(ending).or_default() += 1;
+                    if result.is_ok() {
+                        let expected: Vec<String> = match mode {
+                            "charging_only" => vec!["ffs.smoo".into()],
+                            _ => vec!["ffs.smoo".into(), "ncm.usb0".into()],
+                        };
+                        assert_eq!(h.functions(), expected, "{context}");
+                    }
+                    runs += 1;
+                }
+            }
+        }
+        assert!(runs > 100, "only {runs} runs");
+        /* Every rung of the ladder was reached */
+        for ending in [
+            "target",
+            "previous",
+            "pins only",
+            "recovered by other",
+            "untouched",
+            "service failed",
+            "refused before the window",
+        ] {
+            assert!(
+                endings.contains_key(ending),
+                "never ended {ending}: {endings:?}"
+            );
+        }
+        println!("{runs} runs: {endings:?}");
+    }
+}
