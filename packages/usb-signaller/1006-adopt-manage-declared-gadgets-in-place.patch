+/*
+ * Adopted gadgets: a gadget someone else created and bound (for example an
+ * initramfs serving the root filesystem over FunctionFS), declared with
+ * [gadget.<dir>] adopt = true, is managed in place instead of replaced.
+ * usb-signaller links its own functions next to the pinned ones, and never
+ * unlinks or removes a pin, the gadget or its configuration.
+ *
+ * Adopting performs no bus operation. A mode switch is a transaction:
+ *
+ * 1. prepare, while bound: create function directories, stop the old
+ *    mode's service, open everything the window needs;
+ * 2. the critical window (window.rs): unbind, relink, bind;
+ * 3. finish, while bound again: remove function directories that left,
+ *    record the new state, start the new mode's service.
+ */
+
+use std::collections::{BTreeMap, BTreeSet};
+use std::fs;
+use std::io::Write;
+
+use crate::configfs::ConfigFs;
+use crate::configuration::{Configuration, ForeignGadgets, GadgetDeclaration, is_owned_gadget};
+use crate::plan::{
+    MASS_STORAGE_FUNCTION, MTP_MOUNT, MTP_SERVICE, NCM_FUNCTION, Plan, Snapshot, adopted_mode,
+    classify, is_ffs, mode_functions, mode_service, plan, window_plan,
+};
+use crate::service::ModeServices;
+use crate::sysroot::SysRoot;
+use crate::udc::UDCMode;
+use crate::utils::udcmode_to_string;
+use crate::window::{Rung, WindowThread};
+
+const STATE_GADGET: &str = "USB_SIGNALLER_GADGET";
+const STATE_CONFIG: &str = "USB_SIGNALLER_CONFIG";
+const STATE_MODE: &str = "USB_SIGNALLER_MODE";
+const STATE_NCM_IFNAME: &str = "USB_SIGNALLER_NCM_IFNAME";
+const STATE_CONNECTION_NAME: &str = "USB_SIGNALLER_CONNECTION_NAME";
+const STATE_EPOCH: &str = "USB_SIGNALLER_EPOCH";
+
+/* A gadget usb-signaller manages in place */
+#[derive(Debug, Clone, PartialEq)]
+pub struct Managed {
+    pub udc: String,
+    pub gadget: String,
+    pub config: String,
+    pub pins: BTreeSet<String>,
+    pub allowed_modes: Option<BTreeSet<String>>,
+    pub mode: UDCMode,
+    /* Number of committed switches */
+    pub epoch: u64,
+}
+
+/* What holds a UDC, and what usb-signaller may do with it */
+#[derive(Debug, Clone, PartialEq)]
+pub enum Port {
+    /* Nothing bound */
+    Free,
+    /* usb-signaller-*: replaced as before */
+    Owned {
+        gadget: String,
+    },
+    /* Declared, not adopted: never touched */
+    Declared {
+        gadget: String,
+        pins: BTreeSet<String>,
+    },
+    /* Neither owned nor declared: [main] foreign_gadgets decides */
+    Foreign {
+        gadget: String,
+        policy: ForeignGadgets,
+    },
+    /* Declared with adopt = true and valid: managed in place */
+    Adopted(Managed),
+}
+
+/*
+ * Classify the gadget bound to a UDC. Adoption is validated here, with
+ * fresh reads only: nothing is written.
+ */
+pub fn classify_port(
+    config: &Configuration,
+    cfs: &dyn ConfigFs,
+    sys: &SysRoot,
+    udc: &str,
+    bound: Option<&str>,
+) -> Port {
+    let Some(gadget) = bound else {
+        return Port::Free;
+    };
+    let gadget = gadget.to_string();
+    if is_owned_gadget(&gadget) {
+        return Port::Owned { gadget };
+    }
+    if config.is_broken() {
+        return Port::Foreign {
+            gadget,
+            policy: ForeignGadgets::Preserve,
+        };
+    }
+    let Some(declaration) = config.gadget(&gadget) else {
+        return Port::Foreign {
+            gadget,
+            policy: config.foreign_gadgets(),
+        };
+    };
+    if !declaration.adopt.as_ref().is_some_and(|adopt| adopt.value) {
+        return Port::Declared {
+            gadget,
+            pins: declaration.pins(),
+        };
+    }
+    return match validate(cfs, sys, declaration, &gadget, udc) {
+        Ok(managed) => Port::Adopted(managed),
+        Err(err) => {
+            eprintln!("❌ Not adopting {gadget}: {err}");
+            Port::Declared {
+                gadget,
+                pins: declaration.pins(),
+            }
+        }
+    };
+}
+
+/* Check that a declared gadget can be adopted, and read its current mode */
+pub fn validate(
+    cfs: &dyn ConfigFs,
+    sys: &SysRoot,
+    declaration: &GadgetDeclaration,
+    gadget: &str,
+    udc: &str,
+) -> anyhow::Result<Managed> {
+    let pins = declaration.pins();
+    if pins.is_empty() {
+        return Err(anyhow::anyhow!(
+            "adopt = true needs at least one pinned function"
+        ));
+    }
+    if declaration
+        .keep_identity
+        .as_ref()
+        .is_some_and(|keep| !keep.value)
+    {
+        return Err(anyhow::anyhow!(
+            "keep_identity = false is not supported yet"
+        ));
+    }
+
+    let bound = cfs.read_udc(gadget)?;
+    if bound != udc {
+        return Err(anyhow::anyhow!(
+            "not bound to UDC {udc} (its UDC attribute reads '{bound}')"
+        ));
+    }
+
+    let configs = cfs.configs(gadget)?;
+    let config = match &declaration.config {
+        Some(config) => {
+            if !configs.contains(&config.value) {
+                return Err(anyhow::anyhow!(
+                    "configuration {} does not exist",
+                    config.value
+                ));
+            }
+            config.value.clone()
+        }
+        None if configs.len() == 1 => configs[0].clone(),
+        None => {
+            return Err(anyhow::anyhow!(
+                "it has {} configurations; set config to the one to manage",
+                configs.len()
+            ));
+        }
+    };
+
+    let functions = cfs.functions(gadget)?;
+    for pin in &pins {
+        if !functions.contains(pin) {
+            return Err(anyhow::anyhow!("pinned function {pin} does not exist"));
+        }
+    }
+
+    let snapshot = read_snapshot(cfs, sys, gadget, &config, &pins)?;
+    for pin in &pins {
+        if !snapshot.linked(pin) {
+            return Err(anyhow::anyhow!(
+                "pinned function {pin} is not linked in {gadget}/{config}"
+            ));
+        }
+        if snapshot.ready.get(pin) == Some(&Some(false)) {
+            return Err(anyhow::anyhow!("pinned function {pin} is not ready"));
+        }
+    }
+
+    return Ok(Managed {
+        udc: udc.to_string(),
+        gadget: gadget.to_string(),
+        config,
+        pins,
+        allowed_modes: declaration
+            .allowed_modes
+            .as_ref()
+            .map(|(modes, _)| modes.clone()),
+        mode: snapshot.mode,
+        epoch: 0,
+    });
+}
+
+/* Read an adopted gadget through new handles, and classify its mode */
+pub fn read_snapshot(
+    cfs: &dyn ConfigFs,
+    sys: &SysRoot,
+    gadget: &str,
+    config: &str,
+    pins: &BTreeSet<String>,
+) -> anyhow::Result<Snapshot> {
+    let udc = cfs.read_udc(gadget)?;
+    let links = cfs.links(gadget, config)?;
+    let function_dirs: BTreeSet<String> = cfs.functions(gadget)?.into_iter().collect();
+
+    let mut ready = BTreeMap::new();
+    for (_, function) in links.iter().filter(|(_, f)| is_ffs(f)) {
+        ready.insert(function.clone(), cfs.ffs_ready(gadget, function)?);
+    }
+
+    let others: BTreeSet<&str> = links
+        .iter()
+        .map(|(_, f)| f.as_str())
+        .filter(|f| !pins.contains(*f))
+        .collect();
+    let state = read_state_env(sys);
+    let tethering = state.get(STATE_GADGET) == Some(&sys.gadget(gadget).display().to_string())
+        && state.get(STATE_MODE).map(String::as_str) == Some("tethering_mode");
+    let cdrom = others.contains(MASS_STORAGE_FUNCTION)
+        && cfs
+            .read_attr(gadget, "functions/mass_storage.0/lun.0/cdrom")
+            .is_ok_and(|value| value == "1");
+
+    return Ok(Snapshot {
+        gadget: gadget.to_string(),
+        config: config.to_string(),
+        udc,
+        mode: classify(&others, tethering, cdrom),
+        links,
+        function_dirs,
+        ready,
+    });
+}
+
+/* KEY='value' lines of the state file; missing or unreadable means empty */
+pub fn read_state_env(sys: &SysRoot) -> BTreeMap<String, String> {
+    let mut values = BTreeMap::new();
+    let Ok(contents) = fs::read_to_string(sys.state_env()) else {
+        return values;
+    };
+
+    for line in contents.lines() {
+        let Some((key, value)) = line.split_once('=') else {
+            continue;
+        };
+        values.insert(key.trim().to_string(), shell_unquote(value.trim()));
+    }
+
+    return values;
+}
+
+/* The inverse of shell_quote: 'it'\''s' -> it's */
+fn shell_unquote(value: &str) -> String {
+    let mut out = String::new();
+    let mut quoted = false;
+    let mut escaped = false;
+    for c in value.chars() {
+        if escaped {
+            out.push(c);
+            escaped = false;
+            continue;
+        }
+        match c {
+            '\'' => quoted = !quoted,
+            '\\' if !quoted => escaped = true,
+            _ => out.push(c),
+        }
+    }
+    return out;
+}
+
+fn shell_quote(value: &str) -> String {
+    return format!("'{}'", value.replace('\'', "'\\''"));
+}
+
+/*
+ * Write the state file for the mode scripts: tmp file + rename, so a reader
+ * never sees half of it. It is only a hint: the composition is always read
+ * from configfs again.
+ */
+pub fn write_state_env(sys: &SysRoot, cfs: &dyn ConfigFs, managed: &Managed) -> anyhow::Result<()> {
+    let path = sys.state_env();
+    let directory = path.parent().unwrap();
+    fs::create_dir_all(directory)?;
+
+    let mut lines = vec![
+        (
+            STATE_GADGET,
+            sys.gadget(&managed.gadget).display().to_string(),
+        ),
+        (STATE_CONFIG, managed.config.clone()),
+        (
+            STATE_MODE,
+            udcmode_to_string(managed.mode.clone()).to_string(),
+        ),
+    ];
+    if matches!(managed.mode, UDCMode::Developer | UDCMode::Tethering) {
+        if let Ok(ifname) =
+            cfs.read_attr(&managed.gadget, &format!("functions/{NCM_FUNCTION}/ifname"))
+        {
+            lines.push((STATE_NCM_IFNAME, ifname));
+        }
+        let connection = match managed.mode {
+            UDCMode::Tethering => "Tethering Mode",
+            _ => "Developer Mode",
+        };
+        lines.push((STATE_CONNECTION_NAME, connection.to_string()));
+    }
+    lines.push((STATE_EPOCH, managed.epoch.to_string()));
+
+    let temporary = directory.join(".state.env.tmp");
+    let mut file = fs::File::create(&temporary)?;
+    for (key, value) in lines {
+        writeln!(file, "{key}={}", shell_quote(&value))?;
+    }
+    file.sync_all()?;
+    fs::rename(&temporary, &path)?;
+
+    return Ok(());
+}
+
+/* Remove the state file: the mode scripts then find usb-signaller's own gadgets as before */
+pub fn clear_state_env(sys: &SysRoot) {
+    let _ = fs::remove_file(sys.state_env());
+}
+
+/*
+ * What set_mode(mode) would do on every UDC, from live configfs, without
+ * writing anything or locking memory. The boolean is false when the switch
+ * would be refused.
+ */
+pub fn plan_report(
+    config: &Configuration,
+    cfs: &dyn ConfigFs,
+    sys: &SysRoot,
+    mode: &str,
+) -> (String, bool) {
+    let mut report = String::new();
+    let mut ok = true;
+
+    if config.is_broken() {
+        report.push_str(
+            "Configuration is broken: nothing is adopted and every gadget usb-signaller does not own is preserved\n",
+        );
+    }
+    for udc in crate::udc::discover_udcs(sys) {
+        let bound = crate::udc::UDC::bound_gadget_name(sys, &udc);
+        match classify_port(config, cfs, sys, &udc, bound.as_deref()) {
+            Port::Free => {
+                report.push_str(&format!("{udc}: free\n"));
+            }
+            Port::Owned { gadget } => {
+                report.push_str(&format!("{udc}: {gadget} (owned): replaced for {mode}\n"));
+            }
+            Port::Declared { gadget, .. } => {
+                report.push_str(&format!(
+                    "{udc}: {gadget} (declared): never replaced; {mode} is refused\n"
+                ));
+                ok = false;
+            }
+            Port::Foreign { gadget, policy } => {
+                if policy == ForeignGadgets::Preserve {
+                    report.push_str(&format!(
+                        "{udc}: {gadget} (foreign, preserve): never replaced; {mode} is refused\n"
+                    ));
+                    ok = false;
+                } else {
+                    report.push_str(&format!(
+                        "{udc}: {gadget} (foreign, replace): replaced for {mode}\n"
+                    ));
+                }
+            }
+            Port::Adopted(managed) => {
+                report.push_str(&format!(
+                    "{udc}: {} (adoptable), pins {}\n",
+                    managed.gadget,
+                    managed
+                        .pins
+                        .iter()
+                        .cloned()
+                        .collect::<Vec<String>>()
+                        .join(", ")
+                ));
+                let planned = match adopted_mode(mode) {
+                    None => Err(anyhow::anyhow!(
+                        "{mode} is not supported while gadget {} is adopted",
+                        managed.gadget
+                    )),
+                    Some(target) => {
+                        read_snapshot(cfs, sys, &managed.gadget, &managed.config, &managed.pins)
+                            .and_then(|snapshot| {
+                                plan(
+                                    &snapshot,
+                                    &managed.pins,
+                                    &target,
+                                    managed.allowed_modes.as_ref(),
+                                )
+                            })
+                    }
+                };
+                match planned {
+                    Ok(plan) => report.push_str(&plan.to_string()),
+                    Err(err) => {
+                        report.push_str(&format!("  refused: {err}\n"));
+                        ok = false;
+                    }
+                }
+            }
+        }
+    }
+
+    return (report, ok);
+}
+
+/* What a transaction needs besides the adopted gadget */
+pub struct Context<'a> {
+    pub sys: &'a SysRoot,
+    pub cfs: &'a dyn ConfigFs,
+    pub services: &'a dyn ModeServices,
+    pub window: &'a WindowThread,
+}
+
+impl Context<'_> {
+    fn stop(&self, service: Option<&str>) {
+        if let Some(service) = service
+            && let Err(err) = self.services.stop(service)
+        {
+            eprintln!("⚠️  Failed to stop {service}: {err:?}");
+        }
+    }
+
+    fn start(&self, service: Option<&str>) -> anyhow::Result<()> {
+        if let Some(service) = service {
+            self.services.start(service)?;
+        }
+        return Ok(());
+    }
+
+    /* Record a new mode: epoch and state file */
+    fn commit(&self, managed: &mut Managed, mode: UDCMode) {
+        managed.mode = mode;
+        managed.epoch += 1;
+        if let Err(err) = write_state_env(self.sys, self.cfs, managed) {
+            eprintln!(
+                "⚠️  Failed to write {}: {err:?}",
+                self.sys.state_env().display()
+            );
+        }
+    }
+
+    /* Remove function directories created in prepare; they may be linked, then this fails */
+    fn undo(&self, managed: &Managed, created: &[String]) {
+        for function in created {
+            if let Err(err) = self.cfs.rmdir_function(&managed.gadget, function) {
+                eprintln!(
+                    "⚠️  Failed to remove {}/functions/{function}: {err}",
+                    managed.gadget
+                );
+            }
+        }
+    }
+
+    /* Everything before the unbind; on failure, the bus was never touched */
+    fn prepare(
+        &self,
+        managed: &Managed,
+        plan: &Plan,
+        created: &mut Vec<String>,
+    ) -> anyhow::Result<()> {
+        for function in &plan.create {
+            self.cfs
+                .mkdir_function(&managed.gadget, function)
+                .map_err(|err| {
+                    anyhow::anyhow!("creating {}/functions/{function}: {err}", managed.gadget)
+                })?;
+            created.push(function.clone());
+        }
+
+        /*
+         * Unbinding with any LUN busy on its backing file would wait
+         * forever: eject every LUN, not only lun.0, while still bound.
+         */
+        if plan.forced_eject {
+            let function = format!("functions/{MASS_STORAGE_FUNCTION}");
+            let luns = self
+                .cfs
+                .entries(&managed.gadget, &function)
+                .map_err(|err| {
+                    anyhow::anyhow!("listing the LUNs of {MASS_STORAGE_FUNCTION}: {err}")
+                })?;
+            for lun in luns.iter().filter(|entry| entry.starts_with("lun.")) {
+                self.cfs
+                    .write_attr(
+                        &managed.gadget,
+                        &format!("{function}/{lun}/forced_eject"),
+                        "1",
+                    )
+                    .map_err(|err| {
+                        anyhow::anyhow!("forced_eject of {MASS_STORAGE_FUNCTION}/{lun}: {err}")
+                    })?;
+            }
+        }
+
+        return Ok(());
+    }
+}
+
+/* Whether exactly the pins and the functions of 'target' are linked */
+fn composed(ctx: &Context<'_>, managed: &Managed, target: &UDCMode) -> anyhow::Result<bool> {
+    let linked: BTreeSet<String> = ctx
+        .cfs
+        .links(&managed.gadget, &managed.config)?
+        .into_iter()
+        .map(|(_, function)| function)
+        .collect();
+    let mut expected = managed.pins.clone();
+    expected.extend(
+        mode_functions(target)
+            .unwrap_or_default()
+            .iter()
+            .map(|f| f.to_string()),
+    );
+    return Ok(linked == expected);
+}
+
+/*
+ * Switch an adopted gadget to a mode. Only charging_only, developer_mode
+ * and tethering_mode are supported so far; everything else is refused
+ * before anything is touched.
+ */
+pub async fn set_mode_adopted(
+    ctx: &Context<'_>,
+    managed: &mut Managed,
+    mode: &str,
+) -> anyhow::Result<UDCMode> {
+    let gadget = managed.gadget.clone();
+    let Some(target) = adopted_mode(mode) else {
+        return Err(anyhow::anyhow!(
+            "{mode} is not supported while gadget {gadget} is adopted"
+        ));
+    };
+
+    /* 0. Gate: bound as adopted, read through new handles, nothing written */
+    let snapshot = read_snapshot(ctx.cfs, ctx.sys, &gadget, &managed.config, &managed.pins)?;
+    if snapshot.udc != managed.udc {
+        return Err(anyhow::anyhow!(
+            "adopted gadget {gadget} is not bound to UDC {} (its UDC attribute reads '{}')",
+            managed.udc,
+            snapshot.udc
+        ));
+    }
+    managed.mode = snapshot.mode.clone();
+    let plan = plan(
+        &snapshot,
+        &managed.pins,
+        &target,
+        managed.allowed_modes.as_ref(),
+    )?;
+    print!("ℹ️  Plan for adopted gadget {plan}");
+
+    /* Same composition: no configfs write, no disconnect */
+    if !plan.rebind() {
+        ctx.stop(plan.services.stop);
+        ctx.commit(managed, target.clone());
+        ctx.start(plan.services.start)
+            .map_err(|err| anyhow::anyhow!("{mode} is set but its service failed: {err:?}"))?;
+        return Ok(target);
+    }
+
+    /* 1. Prepare, while bound: the root filesystem is reachable */
+    let mut created = vec![];
+    if let Err(err) = ctx.prepare(managed, &plan, &mut created) {
+        ctx.undo(managed, &created);
+        return Err(err);
+    }
+    ctx.stop(plan.services.stop);
+    let window = window_plan(&snapshot, &plan, &managed.pins, &managed.udc);
+    let io = match ctx.cfs.open_window(&window) {
+        Ok(io) => io,
+        Err(err) => {
+            ctx.undo(managed, &created);
+            let _ = ctx.start(plan.services.stop);
+            return Err(anyhow::anyhow!(
+                "opening {gadget} for the switch failed: {err}"
+            ));
+        }
+    };
+    println!("ℹ️  Rebinding {gadget} on UDC {}", managed.udc);
+    let _ = std::io::stdout().flush();
+
+    /*
+     * 2. The critical window, on the memory-locked window thread. It fails
+     * only when the thread is gone before it started (a panic inside a
+     * window aborts the process): the bus was not touched.
+     */
+    let (outcome, window) = match ctx.window.run(io, window).await {
+        Ok(result) => result,
+        Err(err) => {
+            ctx.undo(managed, &created);
+            let _ = ctx.start(plan.services.stop);
+            return Err(err.context(format!("switching {gadget} to {mode}")));
+        }
+    };
+
+    /* 3. Finish, bound again */
+    println!("ℹ️  {}", outcome.describe(&window));
+    /* Someone else may have changed the links while the gadget was unbound */
+    let mut rung = outcome.rung;
+    if rung == Rung::Target && !composed(ctx, managed, &target).unwrap_or(false) {
+        eprintln!("⚠️  {gadget} was bound, but not with the composition of {mode}");
+        rung = Rung::RecoveredByOther;
+    }
+    match rung {
+        Rung::Target => {
+            /* The MTP function is no longer bound: its daemon may go now */
+            if plan.stop_mtp {
+                ctx.stop(Some(MTP_SERVICE));
+                if let Err(err) = ctx.services.umount_functionfs(MTP_MOUNT) {
+                    eprintln!("⚠️  Failed to unmount {MTP_MOUNT}: {err:?}");
+                }
+            }
+            for function in &plan.destroy {
+                if let Err(err) = ctx.cfs.rmdir_function(&gadget, function) {
+                    eprintln!("⚠️  Failed to remove {gadget}/functions/{function}: {err}");
+                }
+            }
+            ctx.commit(managed, target.clone());
+            ctx.start(plan.services.start).map_err(|err| {
+                anyhow::anyhow!("{gadget} is composed for {mode} but its service failed: {err:?}")
+            })?;
+            return Ok(target);
+        }
+        Rung::Untouched => {
+            ctx.undo(managed, &created);
+            let _ = ctx.start(plan.services.stop);
+            return Err(anyhow::anyhow!(
+                "unbinding {gadget} failed ({}); nothing changed",
+                outcome.cause(&window)
+            ));
+        }
+        Rung::Previous | Rung::PinsOnly | Rung::RecoveredByOther => {
+            ctx.undo(managed, &created);
+            let now = match read_snapshot(ctx.cfs, ctx.sys, &gadget, &managed.config, &managed.pins)
+            {
+                Ok(snapshot) => snapshot.mode,
+                Err(err) => {
+                    eprintln!("⚠️  Cannot read {gadget} after the failed switch: {err:?}");
+                    UDCMode::Unknown
+                }
+            };
+            ctx.commit(managed, now.clone());
+            if let Err(err) = ctx.start(mode_service(&now)) {
+                eprintln!("⚠️  Failed to start the service of {now:?}: {err:?}");
+            }
+            return Err(anyhow::anyhow!(
+                "switching {gadget} to {mode} failed ({}); it is bound in {} ({:?})",
+                outcome.cause(&window),
+                udcmode_to_string(now),
+                outcome.rung
+            ));
+        }
+    }
+}
