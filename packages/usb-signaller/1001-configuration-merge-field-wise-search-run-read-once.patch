+fn search_directories(root: Option<&Path>) -> anyhow::Result<SearchDirectories<'static>> {
+    let directories: SearchDirectories<'static> = SEARCH_DIRECTORIES
+        .iter()
+        .map(|directory| Cow::Borrowed(Path::new(*directory)))
+        .collect();
+
+    return match root {
+        Some(root) => Ok(directories.chroot(root).map_err(|err| {
+            anyhow::anyhow!("invalid configuration root {}: {err}", root.display())
+        })?),
+        None => Ok(directories),
+    };
+}
