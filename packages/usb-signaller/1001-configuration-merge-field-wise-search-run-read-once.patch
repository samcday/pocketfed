+            &format!("{USR_D}/50-vendor.toml"),
+            "[main]\ndefault_mode = \"developer_mode\"\n",
+        );
+        root.write(
+            &format!("{ETC_D}/50-vendor.toml"),
+            "[main]\ndefault_mode = \"mtp_ffs_mode\"\n",
+        );
+        let config = load(&root);
+        assert_eq!(config.default_mode(), Some("mtp_ffs_mode"));
+        assert_eq!(config.files.len(), 1);
+    }
+
+    #[test]
+    fn dev_null_masks_a_dropin() {
+        let root = TempRoot::new("mask");
+        root.write(
+            &format!("{RUN_D}/50-smoo.toml"),
+            "[main]\ndefault_mode = \"developer_mode\"\n",
+        );
+        root.symlink(&format!("{ETC_D}/50-smoo.toml"), Path::new("/dev/null"));
+        let config = load(&root);
+        assert_eq!(&config.state, &ConfigState::Ok);
+        assert_eq!(config.default_mode(), None);
+    }
+
+    #[test]
+    fn later_section_without_key_does_not_reset_it() {
+        let root = TempRoot::new("merge");
+        let vendor = root.write(
+            &format!("{USR_D}/50-vendor.toml"),
+            "[main]\ndefault_mode = \"developer_mode\"\n[mass_storage]\nstorage_path = \"/srv/a.iso\"\n",
+        );
+        root.write(
+            &format!("{ETC_D}/60-admin.toml"),
+            "[main]\n[mass_storage]\n",
+        );
+        let config = load(&root);
+        assert_eq!(config.default_mode(), Some("developer_mode"));
+        assert_eq!(config.default_mode.as_ref().unwrap().source, vendor);
+        assert_eq!(config.storage_path().unwrap(), "/srv/a.iso");
+    }
+
+    #[test]
+    fn run_dropin_is_found_without_var_run() {
+        let root = TempRoot::new("run");
+        let run = root.write(
+            &format!("{RUN_D}/50-smoo.toml"),
+            "[main]\ndefault_mode = \"developer_mode\"\n",
+        );
+        assert!(!root.path.join("var/run").exists());
+        let config = load(&root);
+        assert_eq!(config.default_mode(), Some("developer_mode"));
+        assert_eq!(config.files, vec![run]);
+    }
+
+    #[test]
+    fn unknown_sections_and_main_keys_are_ignored() {
+        let root = TempRoot::new("unknown");
+        root.write(
+            ETC,
+            "[main]\ndefault_mode = \"developer_mode\"\nfuture_key = 1\n[future]\nx = 2\n",
+        );
+        let config = load(&root);
+        assert_eq!(&config.state, &ConfigState::Ok);
+        assert_eq!(config.default_mode(), Some("developer_mode"));
+    }
+
+    #[test]
+    fn parse_error_is_broken_and_drops_every_value() {
+        let root = TempRoot::new("parse-error");
+        root.write(
+            &format!("{USR_D}/50-vendor.toml"),
+            "[main]\ndefault_mode = \"developer_mode\"\n",
+        );
+        let broken = root.write(&format!("{RUN_D}/60-broken.toml"), "[main\n");
+        let config = load(&root);
+        match &config.state {
+            ConfigState::Broken { path, .. } => assert_eq!(path.as_ref(), Some(&broken)),
+            ConfigState::Ok => panic!("expected a broken configuration"),
+        }
+        assert!(config.is_broken());
+        assert_eq!(config.default_mode(), None);
+        assert!(config.render().contains("# state: broken"));
+    }
+
+    #[test]
+    fn invalid_default_mode_is_broken() {
+        let root = TempRoot::new("invalid-mode");
+        root.write(ETC, "[main]\ndefault_mode = \"mtp_mode\"\n");
+        let config = load(&root);
+        assert!(config.is_broken());
+        assert_eq!(config.default_mode(), None);
+    }
+
+    #[test]
+    fn wrong_type_is_broken() {
+        let root = TempRoot::new("wrong-type");
+        root.write(ETC, "[main]\ndefault_mode = 3\n");
+        assert!(load(&root).is_broken());
+    }
+
+    #[test]
+    fn unreadable_dropin_directory_is_broken() {
+        let root = TempRoot::new("enotdir");
+        /* A regular file where the drop-in directory should be gives ENOTDIR */
+        root.write(RUN_D, "not a directory");
+        let config = load(&root);
+        assert!(config.is_broken());
+    }
+
+    #[test]
+    fn render_names_the_source_of_each_key() {
+        let root = TempRoot::new("render");
+        let vendor = root.write(
+            &format!("{USR_D}/50-vendor.toml"),
+            "[main]\ndefault_mode = \"developer_mode\"\n",
+        );
+        let rendered = load(&root).render();
+        assert!(rendered.contains("# state: ok"));
+        assert!(rendered.contains(&format!(
+            "default_mode = \"developer_mode\"    # {}",
+            vendor.display()
+        )));
+        assert!(rendered.contains("# storage_path is not set"));
+    }
 }
