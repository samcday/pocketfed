+/*
+ * Test helper: a throwaway directory tree that acts as a filesystem root.
+ * Only compiled for tests.
+ */
+#[cfg(test)]
+pub mod testing {
+    use std::fs;
+    use std::path::{Path, PathBuf};
+    use std::sync::atomic::{AtomicUsize, Ordering};
+
+    static COUNTER: AtomicUsize = AtomicUsize::new(0);
+
+    pub struct TempRoot {
+        pub path: PathBuf,
+    }
+
+    impl TempRoot {
+        pub fn new(name: &str) -> Self {
+            let path = std::env::temp_dir().join(format!(
+                "usb-signaller-test-{}-{}-{}",
+                std::process::id(),
+                COUNTER.fetch_add(1, Ordering::SeqCst),
+                name
+            ));
+            let _ = fs::remove_dir_all(&path);
+            fs::create_dir_all(&path).unwrap();
+            return Self { path };
+        }
+
+        /* Write <root>/<relative>, creating parent directories */
+        pub fn write(&self, relative: &str, contents: &str) -> PathBuf {
+            let path = self.path.join(relative);
+            fs::create_dir_all(path.parent().unwrap()).unwrap();
+            fs::write(&path, contents).unwrap();
+            return path;
+        }
+
+        /* Create <root>/<relative> as a symlink to 'target' */
+        pub fn symlink(&self, relative: &str, target: &Path) -> PathBuf {
+            let path = self.path.join(relative);
+            fs::create_dir_all(path.parent().unwrap()).unwrap();
+            std::os::unix::fs::symlink(target, &path).unwrap();
+            return path;
+        }
+    }
+
+    impl Drop for TempRoot {
+        fn drop(&mut self) {
+            let _ = fs::remove_dir_all(&self.path);
+        }
+    }
+}
