+        fs.link("a", "c.1", "acm.a").unwrap();
+        fs.add_gadget("b", &["c.1"]);
+        fs.mkdir_function("b", "acm.b").unwrap();
+        fs.link("b", "c.1", "acm.b").unwrap();
+        fs.write_udc("a", "udc0").unwrap();
+        assert_eq!(code(fs.write_udc("b", "udc0")), Some(libc::EBUSY));
+    }
