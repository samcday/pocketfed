+/*
+ * The configfs operations needed to change the composition of a gadget that
+ * stays in use, behind a trait. SysConfigFs talks to the kernel; the test
+ * FakeConfigFs follows the kernel's rules, so the order of operations can be
+ * tested without root or a UDC.
+ *
+ * Errors keep the kernel's errno: callers must tell ENODEV ("already
+ * unbound") from EBUSY ("bind failed", whatever the reason) and EINVAL ("link
+ * refused while bound").
+ */
+
+/* The adopted-gadget transaction that uses this is not part of this change yet */
+#![cfg_attr(not(test), allow(dead_code))]
+
+use std::fs::{self, OpenOptions};
+use std::io;
+use std::os::unix::fs::{FileExt, symlink};
+use std::path::PathBuf;
+
+use crate::sysroot::SysRoot;
+
+const FUNCTIONS_PATH: &str = "functions";
+const CONFIGS_PATH: &str = "configs";
+const UDC_NODE: &str = "UDC";
+const READY_NODE: &str = "ready";
+
+/* Written to a gadget's UDC attribute to unbind it; an empty write never reaches the kernel */
+pub const UNBIND: &str = "\n";
+
+/*
+ * An open configfs attribute. configfs fills the read buffer once per open
+ * file and only refills it after a write through the same file: reading an
+ * attribute twice through one handle returns the first value again. Open a
+ * new handle for every check; keep a handle only to write through it.
+ */
+pub trait Attribute: Send {
+    fn read(&mut self) -> io::Result<String>;
+    fn write(&mut self, value: &str) -> io::Result<()>;
+}
+
+pub trait ConfigFs: Send + Sync {
+    /* Function directories of a gadget, in creation order */
+    fn functions(&self, gadget: &str) -> io::Result<Vec<String>>;
+
+    /* Configuration directories of a gadget, in creation order */
+    fn configs(&self, gadget: &str) -> io::Result<Vec<String>>;
+
+    /* (link name, function) for every function linked into a configuration, in link order */
+    fn links(&self, gadget: &str, config: &str) -> io::Result<Vec<(String, String)>>;
+
+    /* mkdir functions/<function>; allowed while the gadget is bound */
+    fn mkdir_function(&self, gadget: &str, function: &str) -> io::Result<()>;
+
+    /* rmdir functions/<function>; EBUSY while it is linked */
+    fn rmdir_function(&self, gadget: &str, function: &str) -> io::Result<()>;
+
+    /*
+     * Link from_gadget's function into configs/<config>/<link>. EINVAL while
+     * the gadget has a UDC set, or for another gadget's function.
+     */
+    fn link_function(
+        &self,
+        gadget: &str,
+        config: &str,
+        link: &str,
+        from_gadget: &str,
+        function: &str,
+    ) -> io::Result<()>;
+
+    /* Link the gadget's own function, named after the function */
+    fn link(&self, gadget: &str, config: &str, function: &str) -> io::Result<()> {
+        return self.link_function(gadget, config, function, gadget, function);
+    }
+
+    /* Remove configs/<config>/<link>. While the gadget has a UDC set, this unbinds it */
+    fn unlink(&self, gadget: &str, config: &str, link: &str) -> io::Result<()>;
+
+    /* Open the gadget's UDC attribute */
+    fn open_udc(&self, gadget: &str) -> io::Result<Box<dyn Attribute>>;
+
+    /* Read the UDC attribute through a new handle, so the value is current */
+    fn read_udc(&self, gadget: &str) -> io::Result<String> {
+        let mut attribute = self.open_udc(gadget)?;
+        return attribute.read();
+    }
+
+    /*
+     * Bind to a UDC, or unbind with UNBIND. Binding while bound gives EBUSY,
+     * unbinding while unbound ENODEV, and every failed bind EBUSY.
+     */
+    fn write_udc(&self, gadget: &str, value: &str) -> io::Result<()> {
+        let mut attribute = self.open_udc(gadget)?;
+        return attribute.write(value);
+    }
+
+    /*
+     * Current value of functions/<function>/ready for a FunctionFS function:
+     * whether its daemon has written its descriptors. None when the kernel
+     * has no such attribute (before Linux 6.9).
+     */
+    fn ffs_ready(&self, gadget: &str, function: &str) -> io::Result<Option<bool>>;
+
+    /* Write an attribute below the gadget directory, for example functions/mass_storage.0/lun.0/file */
+    fn write_attr(&self, gadget: &str, path: &str, value: &str) -> io::Result<()>;
+}
+
+/* configfs as mounted on the running system (or below a SysRoot) */
+pub struct SysConfigFs {
+    sys: SysRoot,
+}
+
+struct SysAttribute {
+    file: fs::File,
+}
+
+impl Attribute for SysAttribute {
+    fn read(&mut self) -> io::Result<String> {
+        let mut buffer = vec![0u8; 4096];
+        let length = self.file.read_at(&mut buffer, 0)?;
+        return Ok(String::from_utf8_lossy(&buffer[..length])
+            .trim_end()
+            .to_string());
+    }
+
+    fn write(&mut self, value: &str) -> io::Result<()> {
+        let written = self.file.write_at(value.as_bytes(), 0)?;
+        if written != value.len() {
+            return Err(io::Error::new(
+                io::ErrorKind::WriteZero,
+                format!("short write: {written} of {} bytes", value.len()),
+            ));
+        }
+        return Ok(());
+    }
+}
+
+fn names(path: PathBuf) -> io::Result<Vec<String>> {
+    let mut names = vec![];
+
+    /* configfs lists entries in creation order: keep it */
+    for entry in fs::read_dir(path)? {
+        names.push(entry?.file_name().to_string_lossy().to_string());
+    }
+
+    return Ok(names);
+}
+
+impl SysConfigFs {
+    pub fn new(sys: SysRoot) -> Self {
+        return Self { sys };
+    }
+
+    fn function_path(&self, gadget: &str, function: &str) -> PathBuf {
+        return self.sys.gadget(gadget).join(FUNCTIONS_PATH).join(function);
+    }
+
+    fn config_path(&self, gadget: &str, config: &str) -> PathBuf {
+        return self.sys.gadget(gadget).join(CONFIGS_PATH).join(config);
+    }
+}
+
+impl ConfigFs for SysConfigFs {
+    fn functions(&self, gadget: &str) -> io::Result<Vec<String>> {
+        return names(self.sys.gadget(gadget).join(FUNCTIONS_PATH));
+    }
+
+    fn configs(&self, gadget: &str) -> io::Result<Vec<String>> {
+        return names(self.sys.gadget(gadget).join(CONFIGS_PATH));
+    }
+
+    fn links(&self, gadget: &str, config: &str) -> io::Result<Vec<(String, String)>> {
+        let mut links = vec![];
+
+        for entry in fs::read_dir(self.config_path(gadget, config))? {
+            let entry = entry?;
+            if !entry.file_type()?.is_symlink() {
+                continue;
+            }
+            /* Link names may differ from function names: resolve the target */
+            let target = fs::read_link(entry.path())?;
+            let Some(function) = target.file_name() else {
+                continue;
+            };
+            links.push((
+                entry.file_name().to_string_lossy().to_string(),
+                function.to_string_lossy().to_string(),
+            ));
+        }
+
+        return Ok(links);
+    }
+
+    fn mkdir_function(&self, gadget: &str, function: &str) -> io::Result<()> {
+        return fs::create_dir(self.function_path(gadget, function));
+    }
+
+    fn rmdir_function(&self, gadget: &str, function: &str) -> io::Result<()> {
+        return fs::remove_dir(self.function_path(gadget, function));
+    }
+
+    fn link_function(
+        &self,
+        gadget: &str,
+        config: &str,
+        link: &str,
+        from_gadget: &str,
+        function: &str,
+    ) -> io::Result<()> {
+        /* configfs resolves the target path itself: make it absolute */
+        return symlink(
+            self.function_path(from_gadget, function),
+            self.config_path(gadget, config).join(link),
+        );
+    }
+
+    fn unlink(&self, gadget: &str, config: &str, link: &str) -> io::Result<()> {
+        return fs::remove_file(self.config_path(gadget, config).join(link));
+    }
+
+    fn open_udc(&self, gadget: &str) -> io::Result<Box<dyn Attribute>> {
+        let file = OpenOptions::new()
+            .read(true)
+            .write(true)
+            .open(self.sys.gadget(gadget).join(UDC_NODE))?;
+        return Ok(Box::new(SysAttribute { file }));
+    }
+
+    fn ffs_ready(&self, gadget: &str, function: &str) -> io::Result<Option<bool>> {
+        let value = match fs::read_to_string(self.function_path(gadget, function).join(READY_NODE))
+        {
+            Ok(value) => value,
+            Err(err) if err.kind() == io::ErrorKind::NotFound => return Ok(None),
+            Err(err) => return Err(err),
+        };
+
+        return match value.trim() {
+            "1" => Ok(Some(true)),
+            "0" => Ok(Some(false)),
+            other => Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                format!("unexpected ready value '{other}'"),
+            )),
+        };
+    }
+
+    fn write_attr(&self, gadget: &str, path: &str, value: &str) -> io::Result<()> {
+        let file = OpenOptions::new()
+            .write(true)
+            .open(self.sys.gadget(gadget).join(path))?;
+        let mut attribute = SysAttribute { file };
+        return attribute.write(value);
+    }
+}
+
+#[cfg(test)]
+pub mod fake {
+    /*
+     * An in-memory configfs gadget tree that follows the kernel's rules
+     * (drivers/usb/gadget/configfs.c, udc/core.c, function/f_fs.c,
+     * function/f_mass_storage.c and fs/configfs/file.c, Linux 7.3):
+     *
+     * - K1: linking while the gadget has a UDC name set gives EINVAL, also
+     *   when the UDC vanished and the name was kept.
+     * - K2: linking another gadget's function gives EINVAL.
+     * - K3: unlinking while a UDC name is set unbinds the whole gadget first.
+     * - K4: binding while a UDC name is set gives EBUSY, unbinding while none
+     *   is set ENODEV, and a failed bind leaves no UDC name.
+     * - K5: every bind failure is reported as EBUSY.
+     * - K6: a gadget whose UDC vanished keeps its UDC name and is bound again
+     *   when the UDC returns.
+     * - K8: FunctionFS instance names are global; a linked FunctionFS
+     *   function whose daemon is not ready makes the bind fail.
+     * - K10: when a FunctionFS daemon closes while its function is bound, the
+     *   whole gadget is unbound.
+     * - K11: with no_disconnect, that unbind is only deferred to the next bus
+     *   reset, disconnect or SET_CONFIGURATION.
+     * - K12: unbinding while a mass storage LUN is busy with its backing file
+     *   blocks forever (reported as EDEADLK); forced_eject releases it.
+     * - K13: an attribute handle returns its first read again until it is
+     *   written through.
+     *
+     * Plus: rmdir of a linked function gives EBUSY, a configuration without
+     * functions cannot bind, duplicate links give EEXIST.
+     *
+     * Every trait call is logged and numbered from 0, so tests can make call
+     * N fail with an errno (fail_op) or change the state right before it runs
+     * (before_op), for example to simulate a concurrent binder.
+     */
+
+    use std::collections::BTreeMap;
+    use std::io;
+    use std::sync::{Arc, Mutex};
+
+    use super::{Attribute, ConfigFs};
+
+    fn errno(code: i32) -> io::Error {
+        return io::Error::from_raw_os_error(code);
+    }
+
+    #[derive(Debug, Clone, PartialEq)]
+    pub enum FakeOp {
+        Functions(String),
+        Configs(String),
+        Links(String, String),
+        Mkdir(String, String),
+        Rmdir(String, String),
+        Link {
+            gadget: String,
+            config: String,
+            link: String,
+            from_gadget: String,
+            function: String,
+        },
+        Unlink(String, String, String),
+        OpenUdc(String),
+        ReadUdc(String),
+        WriteUdc(String, String),
+        FfsReady(String, String),
+        WriteAttr(String, String, String),
+    }
+
+    #[derive(Debug, Clone, PartialEq)]
+    pub struct FakeRecord {
+        pub op: FakeOp,
+        /* None: success, Some(errno): failure */
+        pub errno: Option<i32>,
+    }
+
+    #[derive(Debug, Clone, Default)]
+    pub struct FakeFunction {
+        pub name: String,
+        /* FunctionFS: the daemon wrote its descriptors */
+        pub ready: bool,
+        /* FunctionFS: the kernel has a 'ready' attribute (6.9+) */
+        pub has_ready_attr: bool,
+        /* FunctionFS with no_disconnect: the daemon closed, the unbind is deferred */
+        pub deactivated: bool,
+        /* Mass storage: the worker is inside a command on the backing file */
+        pub lun_busy: bool,
+    }
+
+    impl FakeFunction {
+        pub fn is_ffs(&self) -> bool {
+            return self.name.starts_with("ffs.");
+        }
+    }
+
+    #[derive(Debug, Clone, Default)]
+    pub struct FakeGadget {
+        pub functions: Vec<FakeFunction>,
+        /* config -> (link name, function) in link order; configs are listed sorted by name */
+        pub configs: BTreeMap<String, Vec<(String, String)>>,
+        /* The UDC attribute: set by a successful bind, kept when the UDC vanishes */
+        pub udc_name: Option<String>,
+        /* Actually bound to a present UDC */
+        pub bound: bool,
+        /* Attributes written with write_attr */
+        pub attrs: BTreeMap<String, String>,
+    }
+
+    impl FakeGadget {
+        fn function(&self, name: &str) -> Option<&FakeFunction> {
+            return self.functions.iter().find(|f| f.name == name);
+        }
+
+        fn function_mut(&mut self, name: &str) -> Option<&mut FakeFunction> {
+            return self.functions.iter_mut().find(|f| f.name == name);
+        }
+
+        pub fn is_linked(&self, function: &str) -> bool {
+            return self
+                .configs
+                .values()
+                .any(|links| links.iter().any(|(_, f)| f == function));
+        }
+
+        fn linked_functions(&self) -> Vec<&FakeFunction> {
+            return self
+                .functions
+                .iter()
+                .filter(|f| self.is_linked(&f.name))
+                .collect();
+        }
+    }
+
+    type Hook = Box<dyn FnMut(&mut FakeState) + Send>;
+
+    #[derive(Default)]
+    pub struct FakeState {
+        pub gadgets: BTreeMap<String, FakeGadget>,
+        /* Present UDCs and the gadget bound to each */
+        pub udcs: BTreeMap<String, Option<String>>,
+        /* An unbind blocked forever (K12) */
+        pub deadlocked: bool,
+        ops: Vec<FakeRecord>,
+        faults: BTreeMap<usize, i32>,
+        hooks: BTreeMap<usize, Hook>,
+    }
+
+    impl FakeState {
+        fn gadget(&self, gadget: &str) -> io::Result<&FakeGadget> {
+            return self.gadgets.get(gadget).ok_or(errno(libc::ENOENT));
+        }
+
+        fn gadget_mut(&mut self, gadget: &str) -> io::Result<&mut FakeGadget> {
+            return self.gadgets.get_mut(gadget).ok_or(errno(libc::ENOENT));
+        }
+
+        /* Number the call, run its hook, and fail it if a fault is planned */
+        fn begin(&mut self, op: &FakeOp) -> io::Result<usize> {
+            let index = self.ops.len();
+            if let Some(mut hook) = self.hooks.remove(&index) {
+                hook(self);
+            }
+            self.ops.push(FakeRecord {
+                op: op.clone(),
+                errno: None,
+            });
+            if let Some(code) = self.faults.remove(&index) {
+                self.ops[index].errno = Some(code);
+                return Err(errno(code));
+            }
+            return Ok(index);
+        }
+
+        fn finish<T>(&mut self, index: usize, result: io::Result<T>) -> io::Result<T> {
+            if let Err(err) = &result {
+                self.ops[index].errno = err.raw_os_error();
+            }
+            return result;
+        }
+
+        fn can_bind(&self, gadget: &str, udc: &str) -> bool {
+            let Ok(g) = self.gadget(gadget) else {
+                return false;
+            };
+            let udc_free = matches!(self.udcs.get(udc), Some(None));
+            let configs_ok = !g.configs.is_empty() && g.configs.values().all(|l| !l.is_empty());
+            let ffs_ready = g.linked_functions().iter().all(|f| !f.is_ffs() || f.ready);
+            return udc_free && configs_ok && ffs_ready;
+        }
+
+        /* Write a UDC name to the gadget's UDC attribute (K4, K5, K8) */
+        pub fn bind(&mut self, gadget: &str, udc: &str) -> io::Result<()> {
+            if self.gadget(gadget)?.udc_name.is_some() {
+                return Err(errno(libc::EBUSY));
+            }
+            if !self.can_bind(gadget, udc) {
+                /* configfs sets match_existing_only: every failure is EBUSY */
+                return Err(errno(libc::EBUSY));
+            }
+            let g = self.gadget_mut(gadget)?;
+            g.udc_name = Some(udc.to_string());
+            g.bound = true;
+            self.udcs.insert(udc.to_string(), Some(gadget.to_string()));
+            return Ok(());
+        }
+
+        /* Write UNBIND to the gadget's UDC attribute (K4, K11, K12) */
+        pub fn unbind(&mut self, gadget: &str) -> io::Result<()> {
+            let g = self.gadget(gadget)?;
+            if g.udc_name.is_none() {
+                return Err(errno(libc::ENODEV));
+            }
+            if g.bound
+                && g.linked_functions()
+                    .iter()
+                    .any(|f| f.name.starts_with("mass_storage.") && f.lun_busy)
+            {
+                /* fsg_unbind waits uninterruptibly for the worker */
+                self.deadlocked = true;
+                return Err(errno(libc::EDEADLK));
+            }
+
+            let g = self.gadget_mut(gadget)?;
+            let udc = g.udc_name.take();
+            let was_bound = g.bound;
+            g.bound = false;
+            /* Disabling a deactivated FunctionFS function resets it, now unbound */
+            let linked: Vec<String> = g
+                .linked_functions()
+                .iter()
+                .map(|f| f.name.clone())
+                .collect();
+            for function in g.functions.iter_mut() {
+                if function.deactivated && linked.contains(&function.name) {
+                    function.deactivated = false;
+                    function.ready = false;
+                }
+            }
+            if was_bound && let Some(udc) = udc {
+                self.udcs.insert(udc, None);
+            }
+            return Ok(());
+        }
+
+        /* unregister_gadget_item: the kernel unbinds the gadget by itself */
+        fn unregister(&mut self, gadget: &str) {
+            let _ = self.unbind(gadget);
+        }
+
+        fn mkdir(&mut self, gadget: &str, function: &str) -> io::Result<()> {
+            if !function.contains('.') {
+                return Err(errno(libc::EINVAL));
+            }
+            if self.gadget(gadget)?.function(function).is_some() {
+                return Err(errno(libc::EEXIST));
+            }
+            /* FunctionFS instance names are global */
+            if function.starts_with("ffs.")
+                && self
+                    .gadgets
+                    .values()
+                    .any(|g| g.function(function).is_some())
+            {
+                return Err(errno(libc::EBUSY));
+            }
+            let ffs = function.starts_with("ffs.");
+            self.gadget_mut(gadget)?.functions.push(FakeFunction {
+                name: function.to_string(),
+                ready: false,
+                has_ready_attr: ffs,
+                deactivated: false,
+                lun_busy: false,
+            });
+            return Ok(());
+        }
+
+        fn rmdir(&mut self, gadget: &str, function: &str) -> io::Result<()> {
+            let g = self.gadget(gadget)?;
+            if g.function(function).is_none() {
+                return Err(errno(libc::ENOENT));
+            }
+            if g.is_linked(function) {
+                return Err(errno(libc::EBUSY));
+            }
+            self.gadget_mut(gadget)?
+                .functions
+                .retain(|f| f.name != function);
+            return Ok(());
+        }
+
+        fn link(
+            &mut self,
+            gadget: &str,
+            config: &str,
+            link: &str,
+            from_gadget: &str,
+            function: &str,
+        ) -> io::Result<()> {
+            let g = self.gadget(gadget)?;
+            let Some(links) = g.configs.get(config) else {
+                return Err(errno(libc::ENOENT));
+            };
+            if links.iter().any(|(name, _)| name == link) {
+                return Err(errno(libc::EEXIST));
+            }
+            /* K1: no link while a UDC name is set */
+            if g.udc_name.is_some() {
+                return Err(errno(libc::EINVAL));
+            }
+            /* K2: only this gadget's own functions */
+            if from_gadget != gadget || g.function(function).is_none() {
+                return Err(errno(libc::EINVAL));
+            }
+            if links.iter().any(|(_, f)| f == function) {
+                return Err(errno(libc::EEXIST));
+            }
+            self.gadget_mut(gadget)?
+                .configs
+                .get_mut(config)
+                .unwrap()
+                .push((link.to_string(), function.to_string()));
+            return Ok(());
+        }
+
+        fn unlink(&mut self, gadget: &str, config: &str, link: &str) -> io::Result<()> {
+            let g = self.gadget(gadget)?;
+            let Some(links) = g.configs.get(config) else {
+                return Err(errno(libc::ENOENT));
+            };
+            if !links.iter().any(|(name, _)| name == link) {
+                return Err(errno(libc::ENOENT));
+            }
+            /* K3: unlinking while a UDC name is set unbinds the gadget */
+            if g.udc_name.is_some() {
+                self.unbind(gadget)?;
+            }
+            self.gadget_mut(gadget)?
+                .configs
+                .get_mut(config)
+                .unwrap()
+                .retain(|(name, _)| name != link);
+            return Ok(());
+        }
+
+        fn write_udc(&mut self, gadget: &str, value: &str) -> io::Result<()> {
+            let name = value.strip_suffix('\n').unwrap_or(value);
+            if name.is_empty() {
+                return self.unbind(gadget);
+            }
+            return self.bind(gadget, name);
+        }
+
+        fn write_attr(&mut self, gadget: &str, path: &str, value: &str) -> io::Result<()> {
+            let parts: Vec<&str> = path.split('/').collect();
+            if parts.first() == Some(&"functions") && parts.len() >= 3 {
+                let function = parts[1];
+                let g = self.gadget_mut(gadget)?;
+                let Some(f) = g.function_mut(function) else {
+                    return Err(errno(libc::ENOENT));
+                };
+                if parts.last() == Some(&"forced_eject") && value.trim() == "1" {
+                    f.lun_busy = false;
+                }
+            }
+            self.gadget_mut(gadget)?
+                .attrs
+                .insert(path.to_string(), value.to_string());
+            return Ok(());
+        }
+    }
+
+    #[derive(Clone, Default)]
+    pub struct FakeConfigFs {
+        state: Arc<Mutex<FakeState>>,
+    }
+
+    struct FakeUdcAttribute {
+        state: Arc<Mutex<FakeState>>,
+        gadget: String,
+        /* K13: filled by the first read, refilled only after a write */
+        buffer: Option<String>,
+    }
+
+    impl Attribute for FakeUdcAttribute {
+        fn read(&mut self) -> io::Result<String> {
+            let mut state = self.state.lock().unwrap();
+            let index = state.begin(&FakeOp::ReadUdc(self.gadget.clone()))?;
+            if self.buffer.is_none() {
+                let value = state
+                    .gadget(&self.gadget)
+                    .map(|g| g.udc_name.clone().unwrap_or_default());
+                match value {
+                    Ok(value) => self.buffer = Some(value),
+                    Err(err) => return state.finish(index, Err(err)),
+                }
+            }
+            return Ok(self.buffer.clone().unwrap());
+        }
+
+        fn write(&mut self, value: &str) -> io::Result<()> {
+            let mut state = self.state.lock().unwrap();
+            let index = state.begin(&FakeOp::WriteUdc(self.gadget.clone(), value.to_string()))?;
+            self.buffer = None;
+            let result = state.write_udc(&self.gadget, value);
+            return state.finish(index, result);
+        }
+    }
+
+    impl FakeConfigFs {
+        pub fn new() -> Self {
+            return Self::default();
+        }
+
+        /* Direct access to the state, not logged */
+        pub fn with_state<T>(&self, f: impl FnOnce(&mut FakeState) -> T) -> T {
+            let mut state = self.state.lock().unwrap();
+            return f(&mut state);
+        }
+
+        pub fn add_gadget(&self, gadget: &str, configs: &[&str]) {
+            self.with_state(|s| {
+                let g = s.gadgets.entry(gadget.to_string()).or_default();
+                for config in configs {
+                    g.configs.entry(config.to_string()).or_default();
+                }
+            });
+        }
+
+        /* A UDC appears; a gadget that kept its name is bound again (K6) */
+        pub fn add_udc(&self, udc: &str) {
+            self.with_state(|s| {
+                s.udcs.insert(udc.to_string(), None);
+                let waiting: Vec<String> = s
+                    .gadgets
+                    .iter()
+                    .filter(|(_, g)| g.udc_name.as_deref() == Some(udc) && !g.bound)
+                    .map(|(name, _)| name.clone())
+                    .collect();
+                for gadget in waiting {
+                    if s.can_bind(&gadget, udc) {
+                        s.gadgets.get_mut(&gadget).unwrap().bound = true;
+                        s.udcs.insert(udc.to_string(), Some(gadget));
+                        break;
+                    }
+                }
+            });
+        }
+
+        /* A UDC vanishes (for example host role): its gadget keeps the UDC name (K6) */
+        pub fn remove_udc(&self, udc: &str) {
+            self.with_state(|s| {
+                if let Some(Some(gadget)) = s.udcs.remove(udc)
+                    && let Some(g) = s.gadgets.get_mut(&gadget)
+                {
+                    g.bound = false;
+                }
+            });
+        }
+
+        pub fn set_ffs_ready(&self, gadget: &str, function: &str, ready: bool) {
+            self.with_state(|s| {
+                s.gadgets
+                    .get_mut(gadget)
+                    .and_then(|g| g.function_mut(function))
+                    .expect("no such function")
+                    .ready = ready;
+            });
+        }
+
+        /* Kernels before 6.9 have no 'ready' attribute */
+        pub fn remove_ready_attr(&self, gadget: &str, function: &str) {
+            self.with_state(|s| {
+                s.gadgets
+                    .get_mut(gadget)
+                    .and_then(|g| g.function_mut(function))
+                    .expect("no such function")
+                    .has_ready_attr = false;
+            });
+        }
+
+        pub fn set_lun_busy(&self, gadget: &str, function: &str, busy: bool) {
+            self.with_state(|s| {
+                s.gadgets
+                    .get_mut(gadget)
+                    .and_then(|g| g.function_mut(function))
+                    .expect("no such function")
+                    .lun_busy = busy;
+            });
+        }
+
+        /* The FunctionFS daemon closes its files (K10) */
+        pub fn ffs_daemon_closed(&self, gadget: &str, function: &str) {
+            self.with_state(|s| {
+                let g = s.gadgets.get_mut(gadget).expect("no such gadget");
+                let bound_function = g.bound && g.is_linked(function);
+                g.function_mut(function).expect("no such function").ready = false;
+                if bound_function {
+                    s.unregister(gadget);
+                }
+            });
+        }
+
+        /* The daemon of a FunctionFS mounted with no_disconnect closes its files (K11) */
+        pub fn ffs_daemon_closed_no_disconnect(&self, gadget: &str, function: &str) {
+            self.with_state(|s| {
+                let g = s.gadgets.get_mut(gadget).expect("no such gadget");
+                g.function_mut(function)
+                    .expect("no such function")
+                    .deactivated = true;
+            });
+        }
+
+        /* Bus reset, disconnect or SET_CONFIGURATION on a UDC (K11) */
+        pub fn bus_reset(&self, udc: &str) {
+            self.with_state(|s| {
+                let Some(Some(gadget)) = s.udcs.get(udc).cloned() else {
+                    return;
+                };
+                let g = s.gadgets.get_mut(&gadget).unwrap();
+                let linked: Vec<String> = g
+                    .linked_functions()
+                    .iter()
+                    .map(|f| f.name.clone())
+                    .collect();
+                let mut reset = false;
+                for function in g.functions.iter_mut() {
+                    if function.deactivated && linked.contains(&function.name) {
+                        function.deactivated = false;
+                        function.ready = false;
+                        reset = true;
+                    }
+                }
+                if reset {
+                    s.unregister(&gadget);
+                }
+            });
+        }
+
+        /* Make trait call number 'index' fail with 'code', without effect */
+        pub fn fail_op(&self, index: usize, code: i32) {
+            self.with_state(|s| {
+                s.faults.insert(index, code);
+            });
+        }
+
+        /* Run 'hook' on the state right before trait call number 'index' */
+        pub fn before_op(&self, index: usize, hook: impl FnMut(&mut FakeState) + Send + 'static) {
+            self.with_state(|s| {
+                s.hooks.insert(index, Box::new(hook));
+            });
+        }
+
+        pub fn ops(&self) -> Vec<FakeRecord> {
+            return self.with_state(|s| s.ops.clone());
+        }
+
+        /* Forget the log, planned faults and hooks, for example after setting up */
+        pub fn clear_ops(&self) {
+            self.with_state(|s| {
+                s.ops.clear();
+                s.faults.clear();
+                s.hooks.clear();
+            });
+        }
+
+        pub fn udc_name(&self, gadget: &str) -> Option<String> {
+            return self.with_state(|s| s.gadgets.get(gadget).and_then(|g| g.udc_name.clone()));
+        }
+
+        pub fn is_bound(&self, gadget: &str) -> bool {
+            return self.with_state(|s| s.gadgets.get(gadget).is_some_and(|g| g.bound));
+        }
+
+        pub fn deadlocked(&self) -> bool {
+            return self.with_state(|s| s.deadlocked);
+        }
+
+        pub fn attr(&self, gadget: &str, path: &str) -> Option<String> {
+            return self.with_state(|s| {
+                s.gadgets
+                    .get(gadget)
+                    .and_then(|g| g.attrs.get(path).cloned())
+            });
+        }
+
+        fn run<T>(
+            &self,
+            op: FakeOp,
+            f: impl FnOnce(&mut FakeState) -> io::Result<T>,
+        ) -> io::Result<T> {
+            let mut state = self.state.lock().unwrap();
+            let index = state.begin(&op)?;
+            let result = f(&mut state);
+            return state.finish(index, result);
+        }
+    }
+
+    impl ConfigFs for FakeConfigFs {
+        fn functions(&self, gadget: &str) -> io::Result<Vec<String>> {
+            return self.run(FakeOp::Functions(gadget.to_string()), |s| {
+                Ok(s.gadget(gadget)?
+                    .functions
+                    .iter()
+                    .map(|f| f.name.clone())
+                    .collect())
+            });
+        }
+
+        fn configs(&self, gadget: &str) -> io::Result<Vec<String>> {
+            return self.run(FakeOp::Configs(gadget.to_string()), |s| {
+                Ok(s.gadget(gadget)?.configs.keys().cloned().collect())
+            });
+        }
+
+        fn links(&self, gadget: &str, config: &str) -> io::Result<Vec<(String, String)>> {
+            return self.run(FakeOp::Links(gadget.to_string(), config.to_string()), |s| {
+                s.gadget(gadget)?
+                    .configs
+                    .get(config)
+                    .cloned()
+                    .ok_or(errno(libc::ENOENT))
+            });
+        }
+
+        fn mkdir_function(&self, gadget: &str, function: &str) -> io::Result<()> {
+            return self.run(
+                FakeOp::Mkdir(gadget.to_string(), function.to_string()),
+                |s| s.mkdir(gadget, function),
+            );
+        }
+
+        fn rmdir_function(&self, gadget: &str, function: &str) -> io::Result<()> {
+            return self.run(
+                FakeOp::Rmdir(gadget.to_string(), function.to_string()),
+                |s| s.rmdir(gadget, function),
+            );
+        }
+
+        fn link_function(
+            &self,
+            gadget: &str,
+            config: &str,
+            link: &str,
+            from_gadget: &str,
+            function: &str,
+        ) -> io::Result<()> {
+            return self.run(
+                FakeOp::Link {
+                    gadget: gadget.to_string(),
+                    config: config.to_string(),
+                    link: link.to_string(),
+                    from_gadget: from_gadget.to_string(),
+                    function: function.to_string(),
+                },
+                |s| s.link(gadget, config, link, from_gadget, function),
+            );
+        }
+
+        fn unlink(&self, gadget: &str, config: &str, link: &str) -> io::Result<()> {
+            return self.run(
+                FakeOp::Unlink(gadget.to_string(), config.to_string(), link.to_string()),
+                |s| s.unlink(gadget, config, link),
+            );
+        }
+
+        fn open_udc(&self, gadget: &str) -> io::Result<Box<dyn Attribute>> {
+            self.run(FakeOp::OpenUdc(gadget.to_string()), |s| {
+                s.gadget(gadget).map(|_| ())
+            })?;
+            return Ok(Box::new(FakeUdcAttribute {
+                state: self.state.clone(),
+                gadget: gadget.to_string(),
+                buffer: None,
+            }));
+        }
+
+        fn ffs_ready(&self, gadget: &str, function: &str) -> io::Result<Option<bool>> {
+            return self.run(
+                FakeOp::FfsReady(gadget.to_string(), function.to_string()),
+                |s| {
+                    let f = s
+                        .gadget(gadget)?
+                        .function(function)
+                        .ok_or(errno(libc::ENOENT))?;
+                    if !f.is_ffs() || !f.has_ready_attr {
+                        return Ok(None);
+                    }
+                    return Ok(Some(f.ready));
+                },
+            );
+        }
+
+        fn write_attr(&self, gadget: &str, path: &str, value: &str) -> io::Result<()> {
+            return self.run(
+                FakeOp::WriteAttr(gadget.to_string(), path.to_string(), value.to_string()),
+                |s| s.write_attr(gadget, path, value),
+            );
+        }
+    }
+}
