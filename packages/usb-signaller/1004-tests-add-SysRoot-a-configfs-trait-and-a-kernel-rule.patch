+ */
+
+use std::path::PathBuf;
+
+const USB_GADGET_PATH: &str = "usb_gadget";
+const CLASS_PATH: &str = "class";
+const DEVICE_TREE_PATH: &str = "device-tree";
+const PROC_SYS_PATH: &str = "sys";
+
+/*
+ * Where the kernel interfaces usb-signaller uses are mounted. Tests point
+ * these at a directory tree instead of the running system.
+ */
+#[derive(Debug, Clone, PartialEq)]
+pub struct SysRoot {
+    /* configfs, normally /sys/kernel/config */
+    pub configfs: PathBuf,
+    /* sysfs, normally /sys */
+    pub sysfs: PathBuf,
+    /* procfs, normally /proc */
+    pub proc: PathBuf,
+}
+
+impl Default for SysRoot {
+    fn default() -> Self {
+        return Self {
+            configfs: PathBuf::from("/sys/kernel/config"),
+            sysfs: PathBuf::from("/sys"),
+            proc: PathBuf::from("/proc"),
+        };
+    }
+}
+
+impl SysRoot {
+    /* The usual layout below another root directory, for example a test fixture */
+    #[cfg(test)]
+    pub fn under(root: &std::path::Path) -> Self {
+        return Self {
+            configfs: root.join("sys/kernel/config"),
+            sysfs: root.join("sys"),
+            proc: root.join("proc"),
+        };
+    }
+
+    /* <configfs>/usb_gadget */
+    pub fn usb_gadget(&self) -> PathBuf {
+        return self.configfs.join(USB_GADGET_PATH);
+    }
+
+    /* <configfs>/usb_gadget/<gadget> */
+    pub fn gadget(&self, gadget: &str) -> PathBuf {
+        return self.usb_gadget().join(gadget);
+    }
+
+    /* <sysfs>/class/<class> */
+    pub fn class(&self, class: &str) -> PathBuf {
+        return self.sysfs.join(CLASS_PATH).join(class);
+    }
+
+    /* <proc>/device-tree */
+    pub fn device_tree(&self) -> PathBuf {
+        return self.proc.join(DEVICE_TREE_PATH);
+    }
+
+    /* <proc>/sys */
+    pub fn proc_sys(&self) -> PathBuf {
+        return self.proc.join(PROC_SYS_PATH);
+    }
+}
+
+/*
+ * Test helper: a sysfs, configfs and procfs tree in a temporary directory.
+ * Plain files and directories cannot enforce configfs rules (see
+ * configfs::fake for that); this is for code that reads the tree.
+ */
+#[cfg(test)]
+pub mod fixture {
+    use super::SysRoot;
+    use crate::configuration::testing::TempRoot;
+    use std::fs;
+
+    pub struct SysFixture {
+        pub root: TempRoot,
+        pub sys: SysRoot,
+    }
+
+    impl SysFixture {
+        pub fn new(name: &str) -> Self {
+            let root = TempRoot::new(name);
+            let sys = SysRoot::under(&root.path);
+            fs::create_dir_all(sys.configfs.join("usb_gadget")).unwrap();
+            let fixture = Self { root, sys };
+            fixture.set_ip_forward(false);
+            return fixture;
+        }
+
+        fn write(&self, relative: &str, contents: &str) {
+            self.root.write(relative, contents);
+        }
+
+        /* /sys/class/udc/<udc> with its state and bound gadget driver ('function') */
+        pub fn add_udc(&self, udc: &str, state: &str, function: Option<&str>) {
+            self.write(&format!("sys/class/udc/{udc}/state"), &format!("{state}\n"));
+            if let Some(function) = function {
+                self.write(
+                    &format!("sys/class/udc/{udc}/function"),
+                    &format!("{function}\n"),
+                );
+            }
+        }
+
+        /*
+         * usb_gadget/<gadget> with IDs, strings (unless 'strings' is false),
+         * the given function directories and configs/c.1 linking 'linked'.
+         */
+        pub fn add_gadget(
+            &self,
+            gadget: &str,
+            udc: &str,
+            strings: bool,
+            functions: &[&str],
+            linked: &[&str],
+        ) {
+            let base = self.sys.gadget(gadget);
+            let relative = format!("sys/kernel/config/usb_gadget/{gadget}");
+            self.write(&format!("{relative}/UDC"), &format!("{udc}\n"));
+            self.write(&format!("{relative}/idVendor"), "0xdead\n");
+            self.write(&format!("{relative}/idProduct"), "0xbeef\n");
+            if strings {
+                self.write(&format!("{relative}/strings/0x409/manufacturer"), "m\n");
+                self.write(&format!("{relative}/strings/0x409/product"), "p\n");
+                self.write(&format!("{relative}/strings/0x409/serialnumber"), "s\n");
+                self.write(
+                    &format!("{relative}/configs/c.1/strings/0x409/configuration"),
+                    "c\n",
+                );
+            }
+            fs::create_dir_all(base.join("configs/c.1")).unwrap();
+            for function in functions {
+                fs::create_dir_all(base.join("functions").join(function)).unwrap();
+            }
+            for function in linked {
+                std::os::unix::fs::symlink(
+                    base.join("functions").join(function),
+                    base.join("configs/c.1").join(function),
+                )
+                .unwrap();
+            }
+        }
+
+        pub fn set_ip_forward(&self, forward: bool) {
+            self.write(
+                "proc/sys/net/ipv4/ip_forward",
+                if forward { "1\n" } else { "0\n" },
+            );
+        }
+
+        pub fn set_compatible(&self, compatible: &str) {
+            self.write("proc/device-tree/compatible", compatible);
+        }
+
+        /* /sys/class/usb_role/<switch>/role */
+        pub fn add_role_switch(&self, switch: &str, role: &str) {
+            self.write(&format!("sys/class/usb_role/{switch}/role"), role);
+        }
+
+        pub fn read(&self, relative: &str) -> String {
+            return fs::read_to_string(self.root.path.join(relative)).unwrap();
+        }
+
+        pub fn exists(&self, relative: &str) -> bool {
+            return self.root.path.join(relative).exists();
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::path::Path;
+
+    #[test]
+    fn default_is_the_running_system() {
+        let sys = SysRoot::default();
+        assert_eq!(
+            sys.gadget("g1"),
+            PathBuf::from("/sys/kernel/config/usb_gadget/g1")
+        );
+        assert_eq!(sys.class("udc"), PathBuf::from("/sys/class/udc"));
+        assert_eq!(sys.device_tree(), PathBuf::from("/proc/device-tree"));
+        assert_eq!(sys.proc_sys(), PathBuf::from("/proc/sys"));
+    }
+
+    #[test]
+    fn under_moves_every_root() {
+        let sys = SysRoot::under(Path::new("/tmp/x"));
+        assert_eq!(sys, SysRoot::under(Path::new("/tmp/x")));
+        assert_eq!(
+            sys.usb_gadget(),
+            PathBuf::from("/tmp/x/sys/kernel/config/usb_gadget")
+        );
+        assert_eq!(
+            sys.class("usb_role"),
+            PathBuf::from("/tmp/x/sys/class/usb_role")
+        );
+        assert_eq!(sys.proc_sys(), PathBuf::from("/tmp/x/proc/sys"));
+    }
+}
