+    #[test]
+    fn host_role_cleanup_only_removes_owned_gadgets() {
+        let fixture = SysFixture::new("urs-host");
+        fixture.add_role_switch("switch0", "device");
+        fixture.add_gadget("smoo", "", true, &["ffs.smoo"], &["ffs.smoo"]);
+        /*
+         * On a plain directory tree removing these fails (their directories
+         * are not empty): the cleanup must carry on and still succeed.
+         */
+        fixture.add_gadget("usb-signaller-developer", "", true, &["ncm.usb0"], &[]);
+        fixture.add_gadget("usb-signaller-mtp", "", true, &["ffs.mtp"], &[]);
+
+        let urs = URS::set_role(&fixture.sys, &URSRole::Host).unwrap();
+        assert_eq!(urs.role, URSRole::Host);
+        assert!(fixture.exists("sys/kernel/config/usb_gadget/smoo/configs/c.1/ffs.smoo"));
+        assert!(fixture.exists("sys/kernel/config/usb_gadget/smoo/functions/ffs.smoo"));
+    }
