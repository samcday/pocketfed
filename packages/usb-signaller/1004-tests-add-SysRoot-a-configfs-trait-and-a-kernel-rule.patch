--- /dev/null
+++ b/src/sysroot.rs
@@ -0,0 +1,224 @@
+/*
+ * usb-signaller: replacement for usb-moded on mainline Linux Mobile devices
+ * Copyright (C) 2026 Dylan Van Assche
