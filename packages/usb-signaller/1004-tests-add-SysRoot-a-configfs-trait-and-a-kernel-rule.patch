+        assert_eq!(code(fs.write_udc("g", "udc0")), Some(libc::EBUSY));
+        fs.set_ffs_ready("g", "ffs.mtp", true);
+        fs.write_udc("g", "udc0").unwrap();
+
+        assert_eq!(fs.ffs_ready("g", "ffs.pin").unwrap(), Some(true));
+        fs.remove_ready_attr("g", "ffs.pin");
+        assert_eq!(fs.ffs_ready("g", "ffs.pin").unwrap(), None);
+    }
+
+    #[test]
+    fn k10_daemon_exit_unbinds_only_a_bound_function() {
+        let fs = bound_gadget();
+        fs.write_udc("g", UNBIND).unwrap();
+        fs.mkdir_function("g", "ffs.mtp").unwrap();
+        fs.set_ffs_ready("g", "ffs.mtp", true);
+        fs.write_udc("g", "udc0").unwrap();
+        /* Not linked: closing is harmless */
+        fs.ffs_daemon_closed("g", "ffs.mtp");
+        assert!(fs.is_bound("g"));
+        /* Linked and bound: the whole gadget goes */
+        fs.ffs_daemon_closed("g", "ffs.pin");
+        assert!(!fs.is_bound("g"));
+        assert_eq!(fs.udc_name("g"), None);
+    }
+
+    #[test]
+    fn k11_no_disconnect_only_defers_the_unbind() {
+        let fs = bound_gadget();
+        fs.ffs_daemon_closed_no_disconnect("g", "ffs.pin");
+        assert!(fs.is_bound("g"));
+        fs.bus_reset("udc0");
+        assert!(!fs.is_bound("g"));
+        assert_eq!(fs.ffs_ready("g", "ffs.pin").unwrap(), Some(false));
+    }
+
+    #[test]
+    fn k12_busy_lun_blocks_unbind_until_forced_eject() {
+        let fs = bound_gadget();
+        fs.write_udc("g", UNBIND).unwrap();
+        fs.mkdir_function("g", "mass_storage.0").unwrap();
+        fs.link("g", "c.1", "mass_storage.0").unwrap();
+        fs.write_udc("g", "udc0").unwrap();
+        fs.set_lun_busy("g", "mass_storage.0", true);
+        assert_eq!(code(fs.write_udc("g", UNBIND)), Some(libc::EDEADLK));
+        assert!(fs.deadlocked());
+
+        let fs = bound_gadget();
+        fs.write_udc("g", UNBIND).unwrap();
+        fs.mkdir_function("g", "mass_storage.0").unwrap();
+        fs.link("g", "c.1", "mass_storage.0").unwrap();
+        fs.write_udc("g", "udc0").unwrap();
+        fs.set_lun_busy("g", "mass_storage.0", true);
+        fs.write_attr("g", "functions/mass_storage.0/lun.0/forced_eject", "1")
+            .unwrap();
+        fs.write_udc("g", UNBIND).unwrap();
+        assert!(!fs.deadlocked());
+        assert_eq!(
+            fs.attr("g", "functions/mass_storage.0/lun.0/forced_eject")
+                .as_deref(),
+            Some("1")
+        );
+    }
+
+    #[test]
+    fn k13_attribute_handle_reads_stale_until_written() {
+        let fs = bound_gadget();
+        let mut handle = fs.open_udc("g").unwrap();
+        assert_eq!(handle.read().unwrap(), "udc0");
+        /* Someone else unbinds: the old handle still says udc0 */
+        fs.write_udc("g", UNBIND).unwrap();
+        assert_eq!(handle.read().unwrap(), "udc0");
+        assert_eq!(fs.read_udc("g").unwrap(), "");
+        /* Writing through the handle refills it */
+        handle.write("udc0").unwrap();
+        assert_eq!(handle.read().unwrap(), "udc0");
+    }
+
+    #[test]
+    fn rmdir_of_a_linked_function_is_ebusy() {
+        let fs = bound_gadget();
+        assert_eq!(code(fs.rmdir_function("g", "ffs.pin")), Some(libc::EBUSY));
+        fs.mkdir_function("g", "ncm.usb0").unwrap();
+        assert_eq!(code(fs.mkdir_function("g", "ncm.usb0")), Some(libc::EEXIST));
+        fs.rmdir_function("g", "ncm.usb0").unwrap();
+        assert_eq!(fs.functions("g").unwrap(), vec!["ffs.pin".to_string()]);
+    }
+
+    #[test]
+    fn links_keep_link_order() {
+        let fs = bound_gadget();
+        fs.write_udc("g", UNBIND).unwrap();
+        fs.mkdir_function("g", "ncm.usb0").unwrap();
+        fs.link_function("g", "c.1", "net", "g", "ncm.usb0")
+            .unwrap();
+        assert_eq!(
+            fs.links("g", "c.1").unwrap(),
+            vec![
+                ("ffs.pin".to_string(), "ffs.pin".to_string()),
+                ("net".to_string(), "ncm.usb0".to_string())
+            ]
+        );
+        assert_eq!(fs.configs("g").unwrap(), vec!["c.1".to_string()]);
+    }
+
+    #[test]
+    fn faults_and_hooks_are_numbered_by_call() {
+        let fs = bound_gadget();
+        /* Call 0 fails without effect */
+        fs.fail_op(0, libc::EIO);
+        assert_eq!(code(fs.write_udc("g", UNBIND)), Some(libc::EIO));
+        assert!(fs.is_bound("g"));
+
+        /* A concurrent binder rebinds the gadget right before call 5 */
+        fs.clear_ops();
+        fs.before_op(5, |state| {
+            state.bind("g", "udc0").unwrap();
+        });
+        fs.write_udc("g", UNBIND).unwrap(); /* 0 open, 1 write */
+        fs.mkdir_function("g", "ncm.usb0").unwrap(); /* 2 */
+        assert_eq!(fs.read_udc("g").unwrap(), ""); /* 3 open, 4 read */
+        assert_eq!(fs.read_udc("g").unwrap(), "udc0"); /* 5 open (hook first), 6 read */
+        assert_eq!(code(fs.link("g", "c.1", "ncm.usb0")), Some(libc::EINVAL)); /* 7 */
+
+        let ops = fs.ops();
+        assert_eq!(ops[1].op, FakeOp::WriteUdc("g".into(), UNBIND.into()));
+        assert_eq!(ops[1].errno, None);
+        assert_eq!(ops.last().unwrap().errno, Some(libc::EINVAL));
+    }
+
+    /* The real implementation, against a plain directory tree */
+    #[test]
+    fn sysconfigfs_on_a_directory_tree() {
+        let root = TempRoot::new("sysconfigfs");
+        root.write("sys/kernel/config/usb_gadget/g/UDC", "udc0\n");
+        root.write("sys/kernel/config/usb_gadget/g/configs/c.1/MaxPower", "500");
+        root.write(
+            "sys/kernel/config/usb_gadget/g/functions/ffs.pin/ready",
+            "1\n",
+        );
+        let sys = SysRoot::under(&root.path);
+        let fs = SysConfigFs::new(sys.clone());
+
+        assert_eq!(fs.read_udc("g").unwrap(), "udc0");
+        assert_eq!(fs.ffs_ready("g", "ffs.pin").unwrap(), Some(true));
+
+        fs.mkdir_function("g", "ncm.usb0").unwrap();
+        assert_eq!(fs.ffs_ready("g", "ncm.usb0").unwrap(), None);
+        assert_eq!(
+            fs.mkdir_function("g", "ncm.usb0").unwrap_err().kind(),
+            io::ErrorKind::AlreadyExists
+        );
+        fs.link_function("g", "c.1", "net", "g", "ncm.usb0")
+            .unwrap();
+        fs.link("g", "c.1", "ffs.pin").unwrap();
+        let mut links = fs.links("g", "c.1").unwrap();
+        links.sort();
+        assert_eq!(
+            links,
+            vec![
+                ("ffs.pin".to_string(), "ffs.pin".to_string()),
+                ("net".to_string(), "ncm.usb0".to_string())
+            ]
+        );
+        /* Targets are absolute */
+        assert_eq!(
+            fs::read_link(sys.gadget("g").join("configs/c.1/net")).unwrap(),
+            sys.gadget("g").join("functions/ncm.usb0")
+        );
+
+        fs.unlink("g", "c.1", "net").unwrap();
+        fs.rmdir_function("g", "ncm.usb0").unwrap();
+        let mut functions = fs.functions("g").unwrap();
+        functions.sort();
+        assert_eq!(functions, vec!["ffs.pin".to_string()]);
+        assert_eq!(fs.configs("g").unwrap(), vec!["c.1".to_string()]);
+
+        fs.write_attr("g", "configs/c.1/MaxPower", "100").unwrap();
+        assert_eq!(
+            fs::read_to_string(sys.gadget("g").join("configs/c.1/MaxPower")).unwrap(),
+            "100"
+        );
+        assert!(fs.write_attr("g", "no/such/attribute", "1").is_err());
+        assert!(fs.read_udc("missing").is_err());
+    }
+}
