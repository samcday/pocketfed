+
+    fn code(result: io::Result<()>) -> Option<i32> {
+        return result.err().and_then(|err| err.raw_os_error());
+    }
+
+    /* Gadget g with config c.1, pin ffs.pin (ready) linked, bound to udc0 */
+    fn bound_gadget() -> FakeConfigFs {
+        let fs = FakeConfigFs::new();
+        fs.add_udc("udc0");
+        fs.add_gadget("g", &["c.1"]);
+        fs.mkdir_function("g", "ffs.pin").unwrap();
+        fs.link("g", "c.1", "ffs.pin").unwrap();
+        fs.set_ffs_ready("g", "ffs.pin", true);
+        fs.write_udc("g", "udc0").unwrap();
+        fs.clear_ops();
+        return fs;
+    }
+
+    #[test]
+    fn k1_link_while_bound_is_einval() {
+        let fs = bound_gadget();
+        fs.mkdir_function("g", "ncm.usb0").unwrap();
+        assert_eq!(code(fs.link("g", "c.1", "ncm.usb0")), Some(libc::EINVAL));
+        assert!(fs.is_bound("g"));
+
+        /* Also when the UDC vanished but its name is kept */
+        fs.remove_udc("udc0");
+        assert_eq!(fs.udc_name("g").as_deref(), Some("udc0"));
+        assert_eq!(code(fs.link("g", "c.1", "ncm.usb0")), Some(libc::EINVAL));
+    }
+
+    #[test]
+    fn k2_link_of_another_gadgets_function_is_einval() {
+        let fs = FakeConfigFs::new();
+        fs.add_gadget("a", &["c.1"]);
+        fs.add_gadget("b", &["c.1"]);
+        fs.mkdir_function("b", "acm.GS0").unwrap();
+        assert_eq!(
+            code(fs.link_function("a", "c.1", "acm.GS0", "b", "acm.GS0")),
+            Some(libc::EINVAL)
+        );
+        fs.link("b", "c.1", "acm.GS0").unwrap();
+        assert_eq!(code(fs.link("b", "c.1", "acm.GS0")), Some(libc::EEXIST));
+    }
+
+    #[test]
+    fn k3_unlink_while_bound_unbinds_the_gadget() {
+        let fs = bound_gadget();
+        fs.write_udc("g", UNBIND).unwrap();
+        fs.mkdir_function("g", "ncm.usb0").unwrap();
+        fs.link("g", "c.1", "ncm.usb0").unwrap();
+        fs.write_udc("g", "udc0").unwrap();
+        fs.unlink("g", "c.1", "ncm.usb0").unwrap();
+        assert!(!fs.is_bound("g"));
+        assert_eq!(fs.udc_name("g"), None);
+        assert_eq!(fs.read_udc("g").unwrap(), "");
+        assert_eq!(code(fs.unlink("g", "c.1", "ncm.usb0")), Some(libc::ENOENT));
+    }
+
+    #[test]
+    fn k4_bind_and_unbind_errors() {
+        let fs = bound_gadget();
+        assert_eq!(code(fs.write_udc("g", "udc0")), Some(libc::EBUSY));
+        fs.write_udc("g", UNBIND).unwrap();
+        assert_eq!(code(fs.write_udc("g", UNBIND)), Some(libc::ENODEV));
+        /* A failed bind leaves the gadget unbound and forgotten */
+        assert_eq!(code(fs.write_udc("g", "udc9")), Some(libc::EBUSY));
+        assert_eq!(fs.udc_name("g"), None);
+        fs.write_udc("g", "udc0\n").unwrap();
+        assert!(fs.is_bound("g"));
+    }
+
+    #[test]
+    fn k5_every_bind_failure_is_ebusy() {
+        let fs = FakeConfigFs::new();
+        fs.add_udc("udc0");
+        /* No configuration */
+        fs.add_gadget("empty", &[]);
+        assert_eq!(code(fs.write_udc("empty", "udc0")), Some(libc::EBUSY));
+        /* A configuration without functions */
+        fs.add_gadget("nofn", &["c.1"]);
