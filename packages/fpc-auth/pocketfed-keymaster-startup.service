[Unit]
Description=Prepare the Sargo Keymaster HMAC agreement
Documentation=file:/usr/share/doc/pocketfed-fpc-auth/README.md
Requires=qsee-supplicant.service qsee-shared-loader@cmnlib64.service qsee-app-loader@fpctzappfingerprint.service
BindsTo=qsee-supplicant.service qsee-app-loader@fpctzappfingerprint.service
After=qsee-supplicant.service qsee-shared-loader@cmnlib64.service qsee-app-loader@fpctzappfingerprint.service
ConditionKernelVersion=>=7.1.2-0.pocketfed.sdm670.11

[Service]
Type=oneshot
RemainAfterExit=yes
Restart=no
User=root
Group=root
ExecStart=/usr/bin/flock --exclusive --nonblock --no-fork /run/pocketfed-keymaster/startup.lock /usr/bin/pocketfed-keymaster-startup --initialize-single-participant
StandardInput=null
StandardOutput=journal
StandardError=journal
RuntimeDirectory=pocketfed-keymaster
RuntimeDirectoryMode=0700
InaccessiblePaths=-/var/lib/pocketfed-fpc-auth -/var/lib/fprint -/var/lib/qsee-supplicant
UMask=0077
LimitCORE=0
TimeoutStartSec=infinity
TimeoutStopSec=infinity
KillMode=control-group
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=/dev/tee0 rw
DeviceAllow=/dev/tee1 rw
DeviceAllow=/dev/tee2 rw
DeviceAllow=/dev/tee3 rw
DeviceAllow=/dev/tee4 rw
DeviceAllow=/dev/tee5 rw
DeviceAllow=/dev/tee6 rw
DeviceAllow=/dev/tee7 rw
DeviceAllow=/dev/tee8 rw
DeviceAllow=/dev/tee9 rw
DeviceAllow=/dev/tee10 rw
DeviceAllow=/dev/tee11 rw
DeviceAllow=/dev/tee12 rw
DeviceAllow=/dev/tee13 rw
DeviceAllow=/dev/tee14 rw
DeviceAllow=/dev/tee15 rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes

# Public TEE attachment only; no privileged loader/listener device access.
# The runtime lock is held until any synchronous secure call returns.
# A valid wrapped-key reply makes repeat startup a check, not a new agreement.
# QSEE wraps that key for the fingerprint TA: its loader must be ready first.
