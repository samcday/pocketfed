@@ -635,10 +653,8 @@ void MainWindow::saveImageAs()
 	if (filename.isEmpty())
 		return;
 
-	QImageWriter writer(filename);
-	writer.setQuality(95);
-	if (!writer.write(image))
-		QMessageBox::warning(this, "Failed to save image", writer.errorString());
+	if (!saveImage(image, filename))
+		QMessageBox::warning(this, "Failed to save image", lastSaveError_);
 }
 
 void MainWindow::captureRaw()
@@ -740,6 +756,20 @@ void MainWindow::processViewfinder(FrameBuffer *buffer)
 
 	/* Render the frame on the viewfinder. */
 	viewfinder_->render(buffer, mappedBuffers_[buffer].get());
+
+	/*
+	 * Optional bounded one-shot save. The Qt viewfinder exposes the last
+	 * rendered frame at full stream resolution through getCurrentImage();
+	 * only after the requested frame count has been rendered do we write it
+	 * once and exit. A failed write exits with a nonzero status.
+	 */
+	if (afterFrames_ && !saved_ && framesCaptured_ >= afterFrames_) {
+		saved_ = true;
+		if (saveImage(viewfinder_->getCurrentImage(), output_))
+			quit();
+		else
+			QCoreApplication::exit(EXIT_FAILURE);
+	}
 }
 
