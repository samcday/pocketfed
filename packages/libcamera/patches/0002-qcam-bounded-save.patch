diff --git a/src/apps/qcam/main.cpp b/src/apps/qcam/main.cpp
index 8c43d43..05ee783 100644
--- a/src/apps/qcam/main.cpp
+++ b/src/apps/qcam/main.cpp
@@ -46,6 +46,12 @@ OptionsParser::Options parseOptions(int argc, char *argv[])
 			 "Set configuration of a camera stream", "stream", true);
 	parser.addOption(OptVerbose, OptionNone,
 			 "Print verbose log messages", "verbose");
+	parser.addOption(OptAfterFrames, OptionInteger,
+			 "Save one image to --output after this many frames, then exit",
+			 "after-frames", ArgumentRequired, "frames");
+	parser.addOption(OptOutput, OptionString,
+			 "Save one image to this file after --after-frames frames, then exit",
+			 "output", ArgumentRequired, "filename");
 
 	OptionsParser::Options options = parser.parse(argc, argv);
 	if (options.isSet(OptHelp))
@@ -67,6 +73,36 @@ int main(int argc, char **argv)
 	if (options.isSet(OptHelp))
 		return 0;
 
+	/*
+	 * The automatic one-shot save is optional. Validate it here, before the
+	 * camera is started, so an invalid request fails without touching the
+	 * hardware. Both options must be given together; neither leaves the
+	 * interactive qcam behaviour unchanged.
+	 */
+	const bool autoSave = options.isSet(OptOutput) || options.isSet(OptAfterFrames);
+	if (options.isSet(OptOutput) != options.isSet(OptAfterFrames)) {
+		qWarning() << "--output and --after-frames must be used together";
+		return EXIT_FAILURE;
+	}
+	if (autoSave) {
+		constexpr int kMaxAutoSaveFrames = 100000;
+		int frames = options[OptAfterFrames].toInteger();
+		if (frames < 1 || frames > kMaxAutoSaveFrames) {
+			qWarning() << "--after-frames must be between 1 and"
+				   << kMaxAutoSaveFrames;
+			return EXIT_FAILURE;
+		}
+		if (options[OptOutput].toString().empty()) {
+			qWarning() << "--output must not be empty";
+			return EXIT_FAILURE;
+		}
+		if (options.isSet(OptRenderer) &&
+		    options[OptRenderer].toString() != "qt") {
+			qWarning() << "Automatic save requires the Qt renderer (-r qt)";
+			return EXIT_FAILURE;
+		}
+	}
+
 	MessageHandler msgHandler(options.isSet(OptVerbose));
 
 	struct sigaction sa = {};
