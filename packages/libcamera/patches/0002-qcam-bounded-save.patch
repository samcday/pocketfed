+bool MainWindow::parseAfterFrames(const QString &text, uint32_t *frames)
+{
+	if (text.isEmpty())
+		return false;
+
+	/*
+	 * Strict ASCII decimal only: reject signs, whitespace, hex, exponents
+	 * and non-ASCII digits before converting. toUInt() then fails on
+	 * overflow instead of wrapping.
+	 */
+	for (QChar c : text) {
+		ushort value = c.unicode();
+		if (value < '0' || value > '9')
+			return false;
+	}
+
+	bool ok = false;
+	unsigned int value = text.toUInt(&ok, 10);
+	if (!ok || value < 1 || value > kMaxAutoSaveFrames)
+		return false;
+
+	*frames = value;
+	return true;
+}
