#!/usr/bin/env bash
# Native, unprivileged libcamera RPM iteration from a verified Fedora SRPM and
# a pinned upstream clone. The clone and compilation stay on the phone; this
# repository carries only the pins, the Fedora packaging identity and checks.
set -euo pipefail

readonly SCRIPT_NAME=${0##*/}
readonly UPSTREAM_COMMIT=191e202178f02430b5942397c70d215cdd2056fa
readonly UPSTREAM_TAG=v0.7.2
readonly BUILD_JOBS=2
readonly IPA_SIGN_MARKER=ipa-sign-install.sh
readonly IPA_RESIGN_GLOB='%{buildroot}/%{_libdir}/libcamera/ipa_*.so'
readonly IPA_RESIGN_GLOB_FIXED='%{buildroot}/%{_libdir}/libcamera/ipa/*.so'
readonly EXACT_REQUIRE='%{name}%{?_isa} = %{version}-%{release}'
readonly SOURCE_ARCHIVE=libcamera-v0.7.2.tar.bz2
readonly RUN_PREFIX=pocketfed-libcamera-native-
readonly EXPECTED_SUBPACKAGES=(
    libcamera
    libcamera-devel
    libcamera-gstreamer
    libcamera-ipa
    libcamera-qcam
    libcamera-tools
    libcamera-v4l2
    python3-libcamera
)

package_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repo_root=$(cd -- "$package_dir/../.." && pwd)

build_root=
srpm=
clone=
patch_dir="$package_dir/patches"
iteration=
check_mode=0

fedora_patches=
task_patches=
rpms_records=
spec_original_sha256=
spec_packaged_sha256=

log() { printf '%s\n' "$*"; }
warn() { printf 'warning: %s\n' "$*" >&2; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }

usage() {
    cat <<EOF
${SCRIPT_NAME}: build versioned native libcamera RPMs from the exact Fedora
source RPM and a pinned upstream clone.

Usage:
  ${SCRIPT_NAME} --build-root DIR --iteration N --srpm SRPM --clone DIR \\
      [--patch-dir DIR] [--check]

Required:
  --build-root DIR   Dedicated absolute build directory under /var/tmp, or a
                     dedicated direct child of /run named
                     ${RUN_PREFIX}<name> (for example
                     /run/${RUN_PREFIX}1). Must be outside the repository.
  --iteration N      Positive integer build iteration. The release becomes
                     4.fc46.native.N so successive builds are distinct.
  --srpm SRPM        Exact Fedora 0.7.2-4 source RPM. Its SHA256 must match
                     sources.sha256 next to this helper.
  --clone DIR        Upstream clone whose HEAD is ${UPSTREAM_COMMIT}
                     (tag ${UPSTREAM_TAG}), worktree clean.

Options:
  --patch-dir DIR    Task patches applied in name order to the clone source
                     before packaging (default: ${patch_dir}). The current candidate
                     adds pinned IMX363 tuning; gain/lens code is unchanged.
  --check            Verify all inputs, the embedded upstream archive, the
                     Fedora spec layout and the build root in temporary scratch,
                     then exit without building.
  -h, --help         Show this help.

The Fedora spec, its downstream patches and the auxiliary sources are taken
unmodified from the verified SRPM, so IPA re-signing, the exact subpackage set
and every version-locked subpackage Requires are preserved.
EOF
}

parse_args() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            --build-root) [[ $# -ge 2 ]] || die '--build-root needs a value'; build_root=$2; shift ;;
            --iteration) [[ $# -ge 2 ]] || die '--iteration needs a value'; iteration=$2; shift ;;
            --srpm) [[ $# -ge 2 ]] || die '--srpm needs a value'; srpm=$2; shift ;;
            --clone) [[ $# -ge 2 ]] || die '--clone needs a value'; clone=$2; shift ;;
            --patch-dir) [[ $# -ge 2 ]] || die '--patch-dir needs a value'; patch_dir=$2; shift ;;
            --check) check_mode=1 ;;
            -h|--help) usage; exit 0 ;;
            *) die "unknown argument: $1 (try --help)" ;;
        esac
        shift
    done
}

require_args() {
    [[ -n $build_root ]] || die '--build-root is required'
    [[ -n $srpm ]] || die '--srpm is required'
    [[ -n $clone ]] || die '--clone is required'
    [[ -n $iteration ]] || die '--iteration is required'
    [[ $iteration =~ ^[1-9][0-9]*$ ]] || die "--iteration must be a positive integer, got '$iteration'"
}

require_aarch64() {
    [[ $(uname -m) == aarch64 ]] || die 'native libcamera builds run on the aarch64 phone'
}

require_unprivileged() {
    [[ $(id -u) -ne 0 ]] || die 'build as an unprivileged user; use root only to install packages'
}

require_tools() {
    local tool missing=()
    for tool in git rpm2cpio cpio rpmbuild rpmspec sha256sum realpath tar bzip2 \
                patch python3; do
        command -v "$tool" >/dev/null 2>&1 || missing+=("$tool")
    done
    (( ${#missing[@]} == 0 )) || die "missing required tool(s): ${missing[*]}"
}

sha256_of() {
    sha256sum -- "$1" | awk '{print $1}'
}

expected_hash_for() {
    local wanted=$1
    local file="$package_dir/sources.sha256"
    [[ -r $file ]] || die "missing $file"
    awk -v name="$wanted" '$2 == name { print $1 }' "$file"
}

verify_file_hash() {
    local path=$1 expected=$2 actual
    [[ -f $path ]] || die "missing file: $path"
    [[ -n $expected ]] || die "no pinned SHA256 for $(basename -- "$path")"
    actual=$(sha256_of "$path")
    [[ $actual == "$expected" ]] || die \
        "SHA256 mismatch for $path: expected $expected, got $actual"
}

verify_clone() {
    local dir=$1 expected_commit=$2 tag=$3 commit
    [[ -e $dir/.git ]] || die "not a git clone: $dir"
    commit=$(git -C "$dir" rev-parse HEAD 2>/dev/null) || die "cannot read clone HEAD"
    [[ $commit == "$expected_commit" ]] || die \
        "clone HEAD is $commit, expected $expected_commit"
    git -C "$dir" rev-parse --verify -q "refs/tags/$tag^{commit}" >/dev/null || \
        die "clone lacks tag $tag"
    [[ $(git -C "$dir" rev-parse "$tag^{commit}") == "$expected_commit" ]] || die \
        "tag $tag does not point at $expected_commit"
    [[ -z $(git -C "$dir" status --porcelain) ]] || die \
        'clone has uncommitted changes; refusing to build from it'
}

validate_build_root_path() {
    local target=$1 canonical base
    [[ -n $target ]] || die 'build root must not be empty'
    [[ $target == /* ]] || die "build root must be an absolute path: $target"
    [[ ! -L $target ]] || die "build root must not be a symlink: $target"
    canonical=$(realpath -m -- "$target") || die "cannot canonicalize build root: $target"
    base=$(basename -- "$canonical")
    [[ -n $base && $base != . && $base != .. ]] || die 'build root must name a dedicated directory'
    case $canonical in
        /var/tmp/*) ;;
        /run/${RUN_PREFIX}*)
            [[ $(dirname -- "$canonical") == /run ]] || die \
                "a /run build root must be a direct child of /run: $canonical"
            ;;
        *) die "build root must be under /var/tmp or a dedicated /run/${RUN_PREFIX}* directory: $canonical" ;;
    esac
    case $canonical in
        "$repo_root"|"$repo_root"/*) die "build root must be outside the repository: $canonical" ;;
    esac
}

verify_spec_properties() {
    local spec=$1 dist=$2 names expected requires
    [[ -f $spec ]] || die "missing spec: $spec"
    grep -qF -- "$IPA_SIGN_MARKER" "$spec" || die \
        "Fedora spec no longer re-signs IPA modules ($IPA_SIGN_MARKER)"
    requires=$(grep -cF -- "$EXACT_REQUIRE" "$spec")
    (( requires >= ${#EXPECTED_SUBPACKAGES[@]} - 1 )) || die \
        "Fedora spec no longer pins every subpackage Requires exactly (found $requires)"
    names=$(rpmspec -q --qf '%{NAME}\n' --define "dist $dist" "$spec" | sort | tr '\n' ' ')
    expected=$(printf '%s\n' "${EXPECTED_SUBPACKAGES[@]}" | sort | tr '\n' ' ')
    [[ $names == "$expected" ]] || die \
        "unexpected subpackage set from spec: $names (expected: $expected)"
}

unpack_srpm() {
    local destination=$1
    mkdir -p "$destination"
    ( cd "$destination" && rpm2cpio "$srpm" | cpio -idm --quiet )
}

verify_fedora_payload() {
    local directory=$1
    [[ -f "$directory/libcamera.spec" ]] || die 'SRPM does not contain libcamera.spec'
    verify_file_hash "$directory/$SOURCE_ARCHIVE" "$(expected_hash_for "$SOURCE_ARCHIVE")"
    verify_spec_properties "$directory/libcamera.spec" "$dist"
}

correct_fedora_spec() {
    local spec=$1
    [[ -f $spec ]] || die "missing spec: $spec"
    spec_original_sha256=$(sha256_of "$spec")
    if ! python3 - "$spec" "$IPA_RESIGN_GLOB" "$IPA_RESIGN_GLOB_FIXED" <<'PY'
import sys

path, old, new = sys.argv[1:4]
with open(path, encoding="utf-8") as handle:
    text = handle.read()
if text.count(old) != 1:
    raise SystemExit(f"expected exactly one {old!r}, found {text.count(old)}")
with open(path, "w", encoding="utf-8") as handle:
    handle.write(text.replace(old, new))
PY
    then
        die "Fedora IPA re-sign glob is not the expected single occurrence ($IPA_RESIGN_GLOB)"
    fi
    spec_packaged_sha256=$(sha256_of "$spec")
    [[ $spec_original_sha256 != "$spec_packaged_sha256" ]] || die \
        "Fedora IPA re-sign glob correction did not change $spec"
    log "corrected the Fedora IPA re-sign glob for the packaged spec"
}

fedora_patch_records() {
    local directory=$1 file
    fedora_patches=
    for file in "$directory"/*.patch; do
        [[ -f $file ]] || continue
        fedora_patches+="$(basename -- "$file") $(sha256_of "$file")"$'\n'
    done
}

prepare_build_root() {
    mkdir -p "$build_root"/rpmbuild/{BUILD,BUILDROOT,RPMS,SOURCES,SPECS,SRPMS}
}

install_fedora_packaging() {
    local directory=$1 file
    cp "$directory/libcamera.spec" "$build_root/rpmbuild/SPECS/"
    for file in "$directory"/*.patch "$directory"/qcam.desktop \
                "$directory"/qcam.metainfo.xml "$directory"/70-libcamera.rules; do
        [[ -f $file ]] || continue
        cp "$file" "$build_root/rpmbuild/SOURCES/"
    done
}

package_source_from_clone() {
    local parent="$build_root/source" prefix="libcamera-${UPSTREAM_TAG}" directory
    rm -rf "$parent"
    mkdir -p "$parent"
    git -C "$clone" archive --format=tar --prefix="$prefix/" "$UPSTREAM_COMMIT" | tar -x -C "$parent"
    directory="$parent/$prefix"
    task_patches=
    if compgen -G "$patch_dir/*.patch" >/dev/null; then
        local patch_file
        for patch_file in "$patch_dir"/*.patch; do
            log "applying task patch $(basename -- "$patch_file")"
            patch -d "$directory" -p1 -s < "$patch_file" || die "failed to apply $patch_file"
            task_patches+="$(basename -- "$patch_file") $(sha256_of "$patch_file")"$'\n'
        done
    else
        log "no task patches; packaging the pinned clone source unchanged"
    fi
    tar -C "$parent" --owner=0 --group=0 -cf - "$prefix" | bzip2 \
        > "$build_root/rpmbuild/SOURCES/$SOURCE_ARCHIVE"
    source_archive_sha256=$(sha256_of "$build_root/rpmbuild/SOURCES/$SOURCE_ARCHIVE")
}

build_rpms() {
    # rpmbuild removes the build tree after packaging by default (--clean),
    # so keep it with --noclean; the Meson objects then survive for later
    # iterations instead of being recompiled from scratch.
    rpmbuild -ba --noclean \
        --define "_topdir $build_root/rpmbuild" \
        --define "dist $dist" \
        --define "_smp_build_ncpus $BUILD_JOBS" \
        --define "_smp_mflags -j$BUILD_JOBS" \
        "$build_root/rpmbuild/SPECS/libcamera.spec"
}

gather_rpms() {
    local rpm
    rpms_records=
    while IFS= read -r rpm; do
        rpms_records+="$rpm $(sha256_of "$rpm")"$'\n'
    done < <(find "$build_root/rpmbuild/RPMS" -type f -name '*.rpm' | sort)
}

write_manifest() {
    local manifest=$1 srpm_name source_expected arch gcc_version meson_version \
        ninja_version rpm_version rpmbuild_version
    srpm_name=$(basename -- "$srpm")
    source_expected=$(expected_hash_for "$SOURCE_ARCHIVE")
    arch=$(uname -m)
    gcc_version=$(gcc --version 2>/dev/null | head -n1 || true)
    meson_version=$(meson --version 2>/dev/null || true)
    ninja_version=$(ninja --version 2>/dev/null || true)
    rpm_version=$(rpm --version 2>/dev/null || true)
    rpmbuild_version=$(rpmbuild --version 2>/dev/null | head -n1 || true)
    export LC_MANIFEST="$manifest" LC_ITERATION="$iteration" LC_DIST="$dist" \
        LC_RELEASE="$release" LC_UPSTREAM_COMMIT="$UPSTREAM_COMMIT" \
        LC_UPSTREAM_TAG="$UPSTREAM_TAG" \
        LC_SRPM_NAME="$srpm_name" LC_SRPM_SHA256="$srpm_sha256" \
        LC_SOURCE_EXPECTED="$source_expected" LC_SOURCE_ACTUAL="$source_archive_sha256" \
        LC_FEDORA_PATCHES="$fedora_patches" LC_TASK_PATCHES="$task_patches" \
        LC_RPMS="$rpms_records" LC_ARCH="$arch" LC_GCC="$gcc_version" \
        LC_SPEC_ORIGINAL="$spec_original_sha256" LC_SPEC_PACKAGED="$spec_packaged_sha256" \
        LC_IPA_GLOB_ORIGINAL="$IPA_RESIGN_GLOB" LC_IPA_GLOB_FIXED="$IPA_RESIGN_GLOB_FIXED" \
        LC_MESON="$meson_version" LC_NINJA="$ninja_version" \
        LC_RPM="$rpm_version" LC_RPMBUILD="$rpmbuild_version"
    python3 - <<'PY'
import json
import os

def records(value):
    rows = []
    for line in value.splitlines():
        if line:
            name, _, digest = line.partition(" ")
            rows.append({"name": name, "sha256": digest})
    return rows

data = {
    "schema_version": 1,
    "iteration": int(os.environ["LC_ITERATION"]),
    "dist": os.environ["LC_DIST"],
    "release": os.environ["LC_RELEASE"],
    "upstream": {"commit": os.environ["LC_UPSTREAM_COMMIT"],
                 "tag": os.environ["LC_UPSTREAM_TAG"]},
    "srpm": {"name": os.environ["LC_SRPM_NAME"], "sha256": os.environ["LC_SRPM_SHA256"]},
    "source_archive": {"expected_sha256": os.environ["LC_SOURCE_EXPECTED"],
                       "regenerated_sha256": os.environ["LC_SOURCE_ACTUAL"]},
    "fedora_patches": records(os.environ["LC_FEDORA_PATCHES"]),
    "task_patches": records(os.environ["LC_TASK_PATCHES"]),
    "fedora_spec": {
        "original_sha256": os.environ["LC_SPEC_ORIGINAL"],
        "packaged_sha256": os.environ["LC_SPEC_PACKAGED"],
        "changes": [{"from": os.environ["LC_IPA_GLOB_ORIGINAL"],
                     "to": os.environ["LC_IPA_GLOB_FIXED"],
                     "reason": "libcamera 0.7.2 installs IPA modules under libcamera/ipa/"}],
    },
    "toolchain": {"arch": os.environ["LC_ARCH"], "gcc": os.environ["LC_GCC"],
                  "meson": os.environ["LC_MESON"], "ninja": os.environ["LC_NINJA"],
                  "rpm": os.environ["LC_RPM"], "rpmbuild": os.environ["LC_RPMBUILD"]},
    "rpms": records(os.environ["LC_RPMS"]),
}
with open(os.environ["LC_MANIFEST"], "w") as handle:
    json.dump(data, handle, indent=2, sort_keys=True)
    handle.write("\n")
PY
}

report_outputs() {
    local rpm
    log "built RPMs for iteration $iteration (release $release):"
    while IFS= read -r rpm; do
        [[ -n $rpm ]] && log "  $rpm"
    done <<<"$rpms_records"
    log "manifest: $build_root/manifest.json"
    log "install the exact matching libcamera, libcamera-ipa, libcamera-tools,"
    log "libcamera-gstreamer and libcamera-qcam RPMs from this iteration together;"
    log "do not use wildcards that can mix iterations."
}

main() {
    parse_args "$@"
    require_args
    require_aarch64
    require_unprivileged
    validate_build_root_path "$build_root"
    require_tools
    dist=".fc46.native.$iteration"
    release="4$dist"
    srpm_sha256=$(sha256_of "$srpm")
    verify_file_hash "$srpm" "$(expected_hash_for "$(basename -- "$srpm")")"
    verify_clone "$clone" "$UPSTREAM_COMMIT" "$UPSTREAM_TAG"

    if (( check_mode )); then
        local scratch
        scratch=$(mktemp -d "${TMPDIR:-/tmp}/pocketfed-libcamera-check.XXXXXX")
        unpack_srpm "$scratch"
        verify_fedora_payload "$scratch"
        correct_fedora_spec "$scratch/libcamera.spec"
        rm -rf "$scratch"
        log "check passed: SRPM, embedded archive, Fedora spec layout and IPA re-sign glob, clone and build root"
        log "release would be $release"
        log "no source was built"
        return 0
    fi

    prepare_build_root
    unpack_srpm "$build_root/fedora"
    verify_fedora_payload "$build_root/fedora"
    install_fedora_packaging "$build_root/fedora"
    correct_fedora_spec "$build_root/rpmbuild/SPECS/libcamera.spec"
    fedora_patch_records "$build_root/fedora"
    rm -rf "$build_root/fedora"
    package_source_from_clone
    log "building libcamera ${UPSTREAM_TAG#v} as $release with $BUILD_JOBS jobs"
    build_rpms
    gather_rpms
    write_manifest "$build_root/manifest.json"
    report_outputs
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
    main "$@"
fi
