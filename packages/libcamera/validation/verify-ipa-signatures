#!/usr/bin/env python3
"""Verify the signature of every IPA module in a single libcamera IPA RPM.

Usage:
    verify-ipa-signatures --rpm libcamera-ipa-<nvr>.rpm --key ipa-pub-key.pem

The RPM payload is decoded from `rpm2cpio` by a bounded newc (070701/070702)
reader that writes only the ten expected aarch64 payload members
`./usr/lib64/libcamera/ipa/<module>.so[.sign]` for the five fixed modules.
No package scriptlet is executed, no other member is written, and any
unexpected `.so` or `.so.sign` under that directory is rejected so extra
IPA code cannot ride along unverified; symlinks, non-regular files and
duplicates are rejected too, and names never become filesystem paths.
`--key` accepts a public key (PEM or DER) or a private key (PEM or DER),
from which only the public key is derived. OpenSSL never
prompts (closed stdin and an explicit empty passphrase) and only a hash of
the public key is reported.

Each module must be present with a matching `.so.sign`, and its bytes must
verify with `openssl dgst -sha256`. A missing module or signature, an
unsafe payload member or a verification failure fails the run; an RPM with
no modules fails. Output is one JSON document on stdout, and the exit
status is 0 only when all modules verify.
"""

import argparse
import hashlib
import json
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

MODULES = (
    "ipa_mali_c55",
    "ipa_rkisp1",
    "ipa_rpi_vc4",
    "ipa_soft_simple",
    "ipa_vimc",
)

PAYLOAD_DIR = "usr/lib64/libcamera/ipa"
IPA_PREFIX = PAYLOAD_DIR + "/"
CPIO_MAGIC = (b"070701", b"070702")
CPIO_HEADER = 110
CPIO_TRAILER = "TRAILER!!!"
COPY_CHUNK = 1024 * 1024
MAX_NAME_BYTES = 4096
MAX_MEMBER_BYTES = 512 * 1024 * 1024
TRAILER_DRAIN_BYTES = 1024 * 1024
OPENSSL_TIMEOUT = 60

KEY_ATTEMPTS = (
    ("private-derived", ("pkey", "-passin", "pass:", "-in", "{key}",
                         "-pubout", "-outform", "DER")),
    ("private-derived", ("pkey", "-passin", "pass:", "-inform", "DER", "-in", "{key}",
                         "-pubout", "-outform", "DER")),
    ("public", ("pkey", "-passin", "pass:", "-pubin", "-in", "{key}",
                "-pubout", "-outform", "DER")),
    ("public", ("pkey", "-passin", "pass:", "-pubin", "-inform", "DER", "-in", "{key}",
                "-pubout", "-outform", "DER")),
)


def sha256_file(path):
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for block in iter(lambda: handle.read(COPY_CHUNK), b""):
            digest.update(block)
    return digest.hexdigest()


def emit(document, code):
    print(json.dumps(document, indent=2, sort_keys=True))
    return code


def error(message):
    return emit({"ok": False, "error": message}, 1)


def wanted_members():
    allowed = {}
    for module in MODULES:
        for suffix in ("", ".sign"):
            allowed[f"{PAYLOAD_DIR}/{module}.so{suffix}"] = f"{module}.so{suffix}"
    return allowed


def read_exact(stream, count):
    chunks = []
    remaining = count
    while remaining:
        chunk = stream.read(remaining)
        if not chunk:
            raise RuntimeError("truncated RPM cpio payload")
        chunks.append(chunk)
        remaining -= len(chunk)
    return b"".join(chunks)


def skip_exact(stream, count):
    remaining = count
    while remaining:
        chunk = stream.read(min(remaining, COPY_CHUNK))
        if not chunk:
            raise RuntimeError("truncated RPM cpio payload")
        remaining -= len(chunk)


def copy_exact(stream, count, handle):
    remaining = count
    while remaining:
        chunk = stream.read(min(remaining, COPY_CHUNK))
        if not chunk:
            raise RuntimeError("truncated RPM cpio payload")
        handle.write(chunk)
        remaining -= len(chunk)


def normalize_member(raw):
    name = raw.split(b"\0", 1)[0].decode("ascii", "replace")
    return name[2:] if name.startswith("./") else name


def read_cpio(stream, payload_dir):
    """Decode a newc cpio stream, writing only the exact expected members."""
    allowed = wanted_members()
    seen = set()
    base = Path(payload_dir) / PAYLOAD_DIR
    while True:
        header = read_exact(stream, CPIO_HEADER)
        if header[:6] not in CPIO_MAGIC:
            raise RuntimeError("unsupported RPM cpio payload format")
        try:
            fields = [int(header[6 + index * 8:14 + index * 8], 16)
                      for index in range(13)]
        except ValueError:
            raise RuntimeError("invalid RPM cpio header")
        mode, size, namesize = fields[1], fields[6], fields[11]
        if not 0 < namesize <= MAX_NAME_BYTES:
            raise RuntimeError("invalid RPM cpio member name size")
        raw_name = read_exact(stream, namesize)
        skip_exact(stream, (-(CPIO_HEADER + namesize)) % 4)
        name = normalize_member(raw_name)
        if name == CPIO_TRAILER:
            skip_exact(stream, min(size, TRAILER_DRAIN_BYTES))
            break
        if size > MAX_MEMBER_BYTES:
            raise RuntimeError(f"oversized RPM cpio member: {name}")
        target = allowed.get(name)
        if target is None:
            if name.startswith(IPA_PREFIX) and name.endswith((".so", ".so.sign")):
                raise RuntimeError(f"unexpected RPM cpio member: {name}")
            skip_exact(stream, size)
        else:
            if mode & 0o170000 != 0o100000:
                raise RuntimeError(f"non-regular RPM cpio member: {name}")
            if target in seen:
                raise RuntimeError(f"duplicate RPM cpio member: {name}")
            seen.add(target)
            base.mkdir(parents=True, exist_ok=True)
            with open(base / target, "wb") as handle:
                copy_exact(stream, size, handle)
        skip_exact(stream, (-size) % 4)


def extract_payload(rpm, payload_dir, rpm2cpio):
    producer = subprocess.Popen([rpm2cpio, str(rpm)], stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE)
    failure = None
    try:
        read_cpio(producer.stdout, payload_dir)
    except RuntimeError as problem:
        failure = problem
    finally:
        producer.stdout.close()
        if producer.poll() is None:
            producer.terminate()
            try:
                producer.wait(timeout=10)
            except subprocess.TimeoutExpired:
                producer.kill()
                producer.wait()
        detail = producer.stderr.read().decode("utf-8", "replace").strip()
        producer.stderr.close()
    if failure is not None:
        raise RuntimeError(f"{failure}: {detail}" if detail else str(failure))


def derive_public_key(key, openssl):
    for kind, template in KEY_ATTEMPTS:
        command = [openssl]
        command += [str(key) if item == "{key}" else item for item in template]
        result = subprocess.run(command, stdin=subprocess.DEVNULL,
                                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                check=False, timeout=OPENSSL_TIMEOUT)
        if result.returncode == 0 and result.stdout:
            return kind, result.stdout
    return None, None


def verify_module(module, payload_dir, public_der, openssl):
    base = Path(payload_dir) / PAYLOAD_DIR
    module_path = base / f"{module}.so"
    signature_path = base / f"{module}.so.sign"
    if not module_path.is_file() or module_path.is_symlink():
        return {"name": module, "status": "missing-module"}
    if not signature_path.is_file() or signature_path.is_symlink():
        return {"name": module, "status": "missing-signature"}
    result = subprocess.run(
        [openssl, "dgst", "-sha256", "-verify", str(public_der),
         "-keyform", "DER", "-signature", str(signature_path), str(module_path)],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL, check=False, timeout=OPENSSL_TIMEOUT)
    return {
        "name": module,
        "path": str(module_path.relative_to(payload_dir)),
        "sha256": sha256_file(module_path),
        "status": "valid" if result.returncode == 0 else "invalid",
    }


def run(rpm, key):
    openssl = shutil.which("openssl")
    rpm2cpio = shutil.which("rpm2cpio")
    for tool, name in ((openssl, "openssl"), (rpm2cpio, "rpm2cpio")):
        if not tool:
            return error(f"required tool not found: {name}")
    if not rpm.is_file():
        return error(f"RPM not found: {rpm}")
    if not key.is_file():
        return error(f"key not found: {key}")

    try:
        kind, public_der = derive_public_key(key, openssl)
    except (OSError, subprocess.SubprocessError) as failure:
        return error(f"openssl key probe failed: {failure}")
    if public_der is None:
        return error("could not read a public or private key from --key")

    try:
        with tempfile.TemporaryDirectory(prefix="verify-ipa-signatures-") as tmp:
            root = Path(tmp)
            key_dir = root / "key"
            payload_dir = root / "payload"
            key_dir.mkdir()
            public_path = key_dir / "public.der"
            public_path.write_bytes(public_der)
            extract_payload(rpm, payload_dir, rpm2cpio)
            modules = [verify_module(module, payload_dir, public_path, openssl)
                       for module in MODULES]
    except RuntimeError as failure:
        return error(str(failure))
    except (OSError, subprocess.SubprocessError) as failure:
        return error(f"verification failed: {failure}")

    failures = [f"{entry['name']}: {entry['status']}"
                for entry in modules if entry["status"] != "valid"]
    document = {
        "ok": not failures,
        "rpm": {"path": str(rpm), "sha256": sha256_file(rpm)},
        "key": {"kind": kind, "sha256": hashlib.sha256(public_der).hexdigest()},
        "modules": modules,
        "failures": failures,
    }
    return emit(document, 0 if not failures else 1)


def main():
    parser = argparse.ArgumentParser(
        description="Verify packaged libcamera IPA module signatures.")
    parser.add_argument("--rpm", required=True, type=Path,
                        help="libcamera IPA RPM to inspect")
    parser.add_argument("--key", required=True, type=Path,
                        help="build public key, or private key to derive it from")
    arguments = parser.parse_args()
    return run(arguments.rpm, arguments.key)


if __name__ == "__main__":
    sys.exit(main())
