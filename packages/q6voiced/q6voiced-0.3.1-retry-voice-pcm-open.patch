 		goto error;
-	}
 
-	printf("PCM devices were opened.\n");
-	return;
+	ret = snd_pcm_open(&v->rx, v->card, SND_PCM_STREAM_PLAYBACK, SND_PCM_NONBLOCK);
+	if (ret < 0)
+		goto error;
+	ret = snd_pcm_set_params(v->rx, SND_PCM_FORMAT_S16_LE,
