 error:
 	if (v->tx) {
@@ -44,6 +58,36 @@ error:
 		snd_pcm_close(v->rx);
 		v->rx = NULL;
 	}
+	return ret;
+}
+
+static void q6voiced_open(struct q6voiced *v)
+{
+	unsigned int attempt;
+	int ret = 0;
+
+	if (v->tx)
+		return; /* Already active */
+
+	/*
+	 * Audio policy may receive the same call state change and enable the
+	 * voice UCM route shortly after us. Retry briefly while that independent
+	 * subscriber makes the hostless voice PCM routable.
+	 */
+	for (attempt = 1; attempt <= PCM_OPEN_RETRY_ATTEMPTS; attempt++) {
+		ret = q6voiced_open_once(v);
+		if (ret == 0) {
+			fprintf(stderr, "PCM devices were opened after %u attempt%s.\n",
+				attempt, attempt == 1 ? "" : "s");
+			return;
+		}
+
+		if (attempt < PCM_OPEN_RETRY_ATTEMPTS)
+			usleep(PCM_OPEN_RETRY_DELAY_US);
+	}
+
+	fprintf(stderr, "Failed to open PCM devices after %u attempts: %s\n",
+		PCM_OPEN_RETRY_ATTEMPTS, snd_strerror(ret));
 }
 
 static void q6voiced_close(struct q6voiced *v)
@@ -55,7 +99,7 @@ static void q6voiced_close(struct q6voiced *v)
 	snd_pcm_close(v->rx);
 	v->rx = v->tx = NULL;
 
-	printf("PCM devices were closed.\n");
+	fprintf(stderr, "PCM devices were closed.\n");
 }
 
