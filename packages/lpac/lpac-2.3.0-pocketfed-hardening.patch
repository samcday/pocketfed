diff --git a/tests/qmi_test.c b/tests/qmi_test.c
new file mode 100644
index 0000000..2ac225a
--- /dev/null
+++ b/tests/qmi_test.c
@@ -0,0 +1,506 @@
+// SPDX-License-Identifier: MIT
+/* Compile the production driver directly against protocol/transport doubles.
+ * No modem, network, subscriber identifiers or privileged operations are used. */
+#include <gio/gio.h>
+#include <string.h>
+#include "../driver/apdu/qmi_common.h"
+#include "../driver/apdu/qmi_qrtr.h"
+
+unsigned qmi_mock_live_messages;
+
+enum ConnectFailure { CONNECT_OK, FAIL_BUS, FAIL_NO_NODE, FAIL_MANY_NODES, FAIL_DEVICE, FAIL_OPEN, FAIL_CLIENT };
+enum Reply { REPLY_OK, REPLY_REJECT, REPLY_NO_EFFECT, REPLY_TIMEOUT, REPLY_MISSING, REPLY_ZERO, REPLY_HIGH_CHANNEL };
+static struct {
+    enum ConnectFailure fail_connect;
+    enum Reply open_reply, close_reply, transmit_reply, switch_reply;
+    gboolean apply_switch, release_failure, close_device_failure, missing_slots;
+    unsigned live_objects, releases, device_closes, channel_opens, channel_closes;
+    unsigned reads, switches, fail_reads, settle_delays, retry_delays;
+    guint8 last_apdu_slot, last_switch_logical;
+    QmiPhysicalSlotStatusSlot slots[3];
+    guint n_slots;
+    GString *events;
+} mock;
+
+static void object_gone(gpointer unused, GObject *object) {
+    (void)unused;
+    (void)object;
+    g_assert_cmpuint(mock.live_objects, >, 0);
+    mock.live_objects--;
+}
+static GObject *new_object(void) {
+    GObject *object = g_object_new(G_TYPE_OBJECT, NULL);
+    mock.live_objects++;
+    g_object_weak_ref(object, object_gone, NULL);
+    return object;
+}
+static void mock_error(GError **error) {
+    g_set_error_literal(error, G_IO_ERROR, G_IO_ERROR_FAILED, "injected transport failure");
+}
+static void check_client(QmiClientUim *client, GMainContext *context) {
+    g_assert_true(G_IS_OBJECT(client));
+    g_assert_null(g_object_get_data(client, "released"));
+    g_assert_nonnull(context);
+}
+static void free_nodes(gpointer nodes) {
+    g_list_free_full(nodes, g_object_unref);
+}
+QrtrBus *qrtr_bus_new_sync(GMainContext *context, GError **error) {
+    g_assert_nonnull(context);
+    if (mock.fail_connect == FAIL_BUS) {
+        mock_error(error);
+        return NULL;
+    }
+    GObject *bus = new_object();
+    GList *nodes = NULL;
+    if (mock.fail_connect != FAIL_NO_NODE)
+        nodes = g_list_append(nodes, new_object());
+    if (mock.fail_connect == FAIL_MANY_NODES)
+        nodes = g_list_append(nodes, new_object());
+    g_object_set_data_full(bus, "nodes", nodes, free_nodes);
+    return bus;
+}
+GList *qrtr_bus_peek_nodes(QrtrBus *bus) { return g_object_get_data(bus, "nodes"); }
+gint qrtr_node_lookup_port(QrtrNode *node, guint32 service) {
+    g_assert_true(G_IS_OBJECT(node));
+    g_assert_cmpuint(service, ==, QMI_SERVICE_UIM);
+    return 7;
+}
+QmiDevice *qmi_device_new_from_node_sync(QrtrNode *node, GMainContext *context, GError **error) {
+    g_assert_true(G_IS_OBJECT(node));
+    g_assert_nonnull(context);
+    if (mock.fail_connect == FAIL_DEVICE) {
+        mock_error(error);
+        return NULL;
+    }
+    return new_object();
+}
+gboolean qmi_device_open_sync(QmiDevice *device, QmiDeviceOpenFlags flags, GMainContext *context, GError **error) {
+    g_assert_true(G_IS_OBJECT(device));
+    g_assert_nonnull(context);
+    g_assert_cmpint(flags, ==, QMI_DEVICE_OPEN_FLAGS_NONE);
+    if (mock.fail_connect == FAIL_OPEN) {
+        mock_error(error);
+        return FALSE;
+    }
+    return TRUE;
+}
+QmiClient *qmi_device_allocate_client_sync(QmiDevice *device, GMainContext *context, GError **error) {
+    g_assert_true(G_IS_OBJECT(device));
+    g_assert_nonnull(context);
+    if (mock.fail_connect == FAIL_CLIENT) {
+        mock_error(error);
+        return NULL;
+    }
+    return new_object();
+}
+gboolean qmi_device_release_client_sync(QmiDevice *device, QmiClient *client, GMainContext *context, GError **error) {
+    g_assert_true(G_IS_OBJECT(device));
+    check_client(client, context);
+    g_object_set_data(client, "released", GINT_TO_POINTER(1));
+    mock.releases++;
+    g_string_append_c(mock.events, 'R');
+    if (mock.release_failure) {
+        mock_error(error);
+        return FALSE;
+    }
+    return TRUE;
+}
+gboolean qmi_device_close_sync(QmiDevice *device, GMainContext *context, GError **error) {
+    g_assert_true(G_IS_OBJECT(device));
+    g_assert_nonnull(context);
+    mock.device_closes++;
+    g_string_append_c(mock.events, 'D');
+    if (mock.close_device_failure) {
+        mock_error(error);
+        return FALSE;
+    }
+    return TRUE;
+}
+
+static MockQmiMessage *reply(enum Reply mode, GError **error) {
+    if (mode == REPLY_TIMEOUT) {
+        g_set_error_literal(error, G_IO_ERROR, G_IO_ERROR_TIMED_OUT, "injected lost reply");
+        return NULL;
+    }
+    MockQmiMessage *message = mock_message_new();
+    if (mode == REPLY_REJECT)
+        message->result = QMI_PROTOCOL_ERROR_NOT_SUPPORTED;
+    if (mode == REPLY_NO_EFFECT)
+        message->result = QMI_PROTOCOL_ERROR_NO_EFFECT;
+    return message;
+}
+QmiMessageUimGetSlotStatusOutput *qmi_client_uim_get_slot_status_sync(QmiClientUim *client,
+                                                                  GMainContext *context, GError **error) {
+    check_client(client, context);
+    mock.reads++;
+    if (mock.fail_reads) {
+        mock.fail_reads--;
+        mock_error(error);
+        return NULL;
+    }
+    MockQmiMessage *output = mock_message_new();
+    output->missing_array = mock.missing_slots;
+    output->array = g_array_sized_new(FALSE, FALSE, sizeof(QmiPhysicalSlotStatusSlot), mock.n_slots);
+    g_array_append_vals(output->array, mock.slots, mock.n_slots);
+    return output;
+}
+QmiMessageUimSwitchSlotOutput *qmi_client_uim_switch_slot_sync(QmiClientUim *client,
+                                                           QmiMessageUimSwitchSlotInput *input,
+                                                           GMainContext *context, GError **error) {
+    check_client(client, context);
+    mock.switches++;
+    mock.last_switch_logical = input->logical;
+    g_assert_cmpuint(input->physical, >, 0);
+    g_assert_cmpuint(input->physical, <=, mock.n_slots);
+    if (mock.apply_switch) {
+        for (guint i = 0; i < mock.n_slots; i++) {
+            if (mock.slots[i].logical_slot == input->logical)
+                mock.slots[i].physical_slot_status = QMI_UIM_SLOT_STATE_INACTIVE;
+        }
+        mock.slots[input->physical - 1].physical_slot_status = QMI_UIM_SLOT_STATE_ACTIVE;
+        mock.slots[input->physical - 1].logical_slot = input->logical;
+    }
+    g_string_append_c(mock.events, 'S');
+    return reply(mock.switch_reply, error);
+}
+QmiMessageUimOpenLogicalChannelOutput *qmi_client_uim_open_logical_channel_sync(QmiClientUim *client,
+                                                                             QmiMessageUimOpenLogicalChannelInput *input,
+                                                                             GMainContext *context, GError **error) {
+    check_client(client, context);
+    mock.channel_opens++;
+    mock.last_apdu_slot = input->slot;
+    MockQmiMessage *output = reply(mock.open_reply, error);
+    if (output) {
+        output->channel = mock.open_reply == REPLY_ZERO ? 0 : 7;
+        if (mock.open_reply == REPLY_HIGH_CHANNEL)
+            output->channel = 20;
+        output->missing_channel = mock.open_reply == REPLY_MISSING;
+    }
+    return output;
+}
+QmiMessageUimLogicalChannelOutput *qmi_client_uim_logical_channel_sync(QmiClientUim *client,
+                                                                   QmiMessageUimLogicalChannelInput *input,
+                                                                   GMainContext *context, GError **error) {
+    check_client(client, context);
+    g_assert_cmpuint(input->channel, ==, 7);
+    g_assert_true(input->terminate_set);
+    g_assert_false(input->terminate);
+    mock.last_apdu_slot = input->slot;
+    mock.channel_closes++;
+    g_string_append_c(mock.events, 'C');
+    return reply(mock.close_reply, error);
+}
+QmiMessageUimSendApduOutput *qmi_client_uim_send_apdu_sync(QmiClientUim *client, QmiMessageUimSendApduInput *input,
+                                                       GMainContext *context, GError **error) {
+    check_client(client, context);
+    g_assert_cmpuint(input->channel, ==, 7);
+    mock.last_apdu_slot = input->slot;
+    MockQmiMessage *output = reply(mock.transmit_reply, error);
+    if (output) {
+        const guint8 data[] = {0x90, 0};
+        output->missing_array = mock.transmit_reply == REPLY_MISSING;
+        output->array = g_array_new(FALSE, FALSE, sizeof(guint8));
+        if (mock.transmit_reply != REPLY_ZERO)
+            g_array_append_vals(output->array, data, sizeof(data));
+    }
+    return output;
+}
+void set_deprecated_env_name(const char *name, const char *old) {
+    if (!getenv(name) && getenv(old))
+        g_setenv(name, getenv(old), TRUE);
+}
+static void mock_usleep(gulong delay) {
+    if (delay == 6 * G_USEC_PER_SEC)
+        mock.settle_delays++;
+    else if (delay == 500000)
+        mock.retry_delays++;
+    else
+        g_assert_not_reached();
+}
+
+/* Keep these includes last: all helper doubles above are typed against the
+ * production declarations; only synchronous wire I/O and delays are replaced. */
+#define g_usleep mock_usleep
+#include "../driver/apdu/qmi_common.c"
+#include "../driver/apdu/qmi_qrtr.c"
+#undef g_usleep
+
+static void reset(void) {
+    g_assert_cmpuint(mock.live_objects, ==, 0);
+    g_assert_cmpuint(qmi_mock_live_messages, ==, 0);
+    if (mock.events)
+        g_string_free(mock.events, TRUE);
+    memset(&mock, 0, sizeof(mock));
+    mock.events = g_string_new(NULL);
+    mock.apply_switch = TRUE;
+    mock.n_slots = 2;
+    mock.slots[0] = (QmiPhysicalSlotStatusSlot){QMI_UIM_PHYSICAL_CARD_STATE_ABSENT, QMI_UIM_SLOT_STATE_ACTIVE, 1};
+    mock.slots[1] = (QmiPhysicalSlotStatusSlot){QMI_UIM_PHYSICAL_CARD_STATE_PRESENT, QMI_UIM_SLOT_STATE_INACTIVE, 255};
+    g_unsetenv(ENV_UIM_SLOT);
+    g_unsetenv(ENV_PHYSICAL_SLOT);
+    g_unsetenv("UIM_SLOT");
+}
+static void start(struct euicc_ctx *ctx, struct euicc_apdu_interface *interface, gboolean mapped) {
+    memset(ctx, 0, sizeof(*ctx));
+    if (mapped)
+        g_setenv(ENV_PHYSICAL_SLOT, "2", TRUE);
+    g_assert_cmpint(driver_apdu_qmi_qrtr.init(interface), ==, 0);
+    ctx->apdu.interface = interface;
+}
+static void finish(struct euicc_ctx *ctx) {
+    /* The fixture owns a mutable interface; euicc exposes it as const. */
+    struct euicc_apdu_interface *interface = (struct euicc_apdu_interface *)ctx->apdu.interface;
+    interface->disconnect(ctx);
+    /* Both disconnect and fini must be idempotent. */
+    interface->disconnect(ctx);
+    driver_apdu_qmi_qrtr.fini(interface);
+    driver_apdu_qmi_qrtr.fini(interface);
+    g_assert_cmpuint(mock.live_objects, ==, 0);
+    g_assert_cmpuint(qmi_mock_live_messages, ==, 0);
+}
+static void test_never_connect(void) {
+    struct euicc_ctx ctx;
+    struct euicc_apdu_interface interface;
+    reset(); start(&ctx, &interface, FALSE); finish(&ctx);
+    g_assert_cmpuint(mock.channel_closes, ==, 0);
+    g_assert_cmpuint(mock.releases, ==, 0);
+}
+static void test_connect_failures(void) {
+    for (int failure = FAIL_BUS; failure <= FAIL_CLIENT; failure++) {
+        struct euicc_ctx ctx;
+        struct euicc_apdu_interface interface;
+        reset(); start(&ctx, &interface, FALSE);
+        mock.fail_connect = failure;
+        g_assert_cmpint(interface.connect(&ctx), ==, -1);
+        finish(&ctx);
+        g_assert_cmpuint(mock.channel_closes, ==, 0);
+        g_assert_cmpuint(mock.releases, ==, 0);
+    }
+}
+static void test_open_failures(void) {
+    const enum Reply failures[] = {REPLY_REJECT, REPLY_TIMEOUT, REPLY_MISSING, REPLY_ZERO, REPLY_HIGH_CHANNEL};
+    for (guint i = 0; i < G_N_ELEMENTS(failures); i++) {
+        struct euicc_ctx ctx;
+        struct euicc_apdu_interface interface;
+        reset(); start(&ctx, &interface, TRUE);
+        mock.open_reply = failures[i];
+        g_assert_cmpint(interface.connect(&ctx), ==, 0);
+        g_assert_cmpint(interface.logic_channel_open(&ctx, (const guint8 *)"aid", 3), ==, -1);
+        finish(&ctx);
+        g_assert_cmpuint(mock.channel_closes, ==, 0);
+        g_assert_cmpuint(mock.switches, ==, 2);
+        g_assert_cmpint(mock.slots[0].physical_slot_status, ==, QMI_UIM_SLOT_STATE_ACTIVE);
+    }
+}
+static void test_close_failures(void) {
+    const enum Reply modes[] = {REPLY_OK, REPLY_REJECT, REPLY_TIMEOUT};
+    for (guint i = 0; i < G_N_ELEMENTS(modes); i++) {
+        struct euicc_ctx ctx;
+        struct euicc_apdu_interface interface;
+        reset(); start(&ctx, &interface, TRUE);
+        mock.close_reply = modes[i];
+        mock.release_failure = TRUE;
+        mock.close_device_failure = TRUE;
+        g_assert_cmpint(interface.connect(&ctx), ==, 0);
+        g_assert_cmpint(interface.logic_channel_open(&ctx, (const guint8 *)"aid", 3), ==, 7);
+        interface.logic_channel_close(&ctx, 7);
+        finish(&ctx);
+        g_assert_cmpuint(mock.channel_closes, ==, 1);
+        g_assert_cmpuint(mock.releases, ==, 1);
+        g_assert_cmpstr(mock.events->str, ==, "SCSRD");
+    }
+}
+static void test_disconnect_closes_channel(void) {
+    struct euicc_ctx ctx;
+    struct euicc_apdu_interface interface;
+    reset(); start(&ctx, &interface, FALSE);
+    g_assert_cmpint(interface.connect(&ctx), ==, 0);
+    g_assert_cmpint(interface.logic_channel_open(&ctx, (const guint8 *)"aid", 3), ==, 7);
+    finish(&ctx);
+    g_assert_cmpstr(mock.events->str, ==, "CRD");
+}
+static void test_transmit(void) {
+    const enum Reply modes[] = {REPLY_OK, REPLY_REJECT, REPLY_TIMEOUT, REPLY_MISSING, REPLY_ZERO};
+    for (guint i = 0; i < G_N_ELEMENTS(modes); i++) {
+        struct euicc_ctx ctx;
+        struct euicc_apdu_interface interface;
+        guint8 *rx = NULL;
+        guint32 rx_len = 999;
+        reset(); start(&ctx, &interface, FALSE);
+        g_assert_cmpint(interface.connect(&ctx), ==, 0);
+        g_assert_cmpint(interface.transmit(&ctx, &rx, &rx_len, (const guint8 *)"apdu", 4), ==, -1);
+        g_assert_null(rx); g_assert_cmpuint(rx_len, ==, 0);
+        g_assert_cmpint(interface.logic_channel_open(&ctx, (const guint8 *)"aid", 3), ==, 7);
+        mock.transmit_reply = modes[i];
+        int result = interface.transmit(&ctx, &rx, &rx_len, (const guint8 *)"apdu", 4);
+        if (modes[i] == REPLY_OK) {
+            g_assert_cmpint(result, ==, 0);
+            g_assert_cmpuint(rx_len, ==, 2);
+            g_assert_cmpuint(rx[0], ==, 0x90);
+            free(rx);
+        } else {
+            g_assert_cmpint(result, ==, -1);
+            g_assert_null(rx); g_assert_cmpuint(rx_len, ==, 0);
+        }
+        finish(&ctx);
+    }
+}
+static void test_mapping_replies(void) {
+    const enum Reply modes[] = {REPLY_OK, REPLY_NO_EFFECT, REPLY_TIMEOUT};
+    for (guint i = 0; i < G_N_ELEMENTS(modes); i++) {
+        struct euicc_ctx ctx;
+        struct euicc_apdu_interface interface;
+        reset(); start(&ctx, &interface, TRUE);
+        mock.switch_reply = modes[i];
+        g_assert_cmpint(interface.connect(&ctx), ==, 0);
+        g_assert_cmpint(interface.logic_channel_open(&ctx, (const guint8 *)"aid", 3), ==, 7);
+        g_assert_cmpuint(mock.last_apdu_slot, ==, 1);
+        finish(&ctx);
+        g_assert_cmpuint(mock.switches, ==, 2);
+        g_assert_cmpuint(mock.settle_delays, ==, 2);
+        g_assert_cmpint(mock.slots[0].physical_slot_status, ==, QMI_UIM_SLOT_STATE_ACTIVE);
+        g_assert_cmpint(mock.slots[1].physical_slot_status, ==, QMI_UIM_SLOT_STATE_INACTIVE);
+    }
+}
+static void test_mapping_no_change(void) {
+    const enum Reply modes[] = {REPLY_OK, REPLY_NO_EFFECT, REPLY_TIMEOUT, REPLY_REJECT};
+    for (guint i = 0; i < G_N_ELEMENTS(modes); i++) {
+        struct euicc_ctx ctx;
+        struct euicc_apdu_interface interface;
+        reset(); start(&ctx, &interface, TRUE);
+        mock.switch_reply = modes[i]; mock.apply_switch = FALSE;
+        g_assert_cmpint(interface.connect(&ctx), ==, -1);
+        finish(&ctx);
+        g_assert_cmpuint(mock.switches, ==, 1);
+        g_assert_cmpint(mock.slots[0].physical_slot_status, ==, QMI_UIM_SLOT_STATE_ACTIVE);
+    }
+}
+static void test_mapping_already_active(void) {
+    struct euicc_ctx ctx;
+    struct euicc_apdu_interface interface;
+    reset(); start(&ctx, &interface, TRUE);
+    mock.slots[0].physical_slot_status = QMI_UIM_SLOT_STATE_INACTIVE;
+    mock.slots[1].physical_slot_status = QMI_UIM_SLOT_STATE_ACTIVE;
+    mock.slots[1].logical_slot = 1;
+    g_assert_cmpint(interface.connect(&ctx), ==, 0);
+    finish(&ctx);
+    g_assert_cmpuint(mock.switches, ==, 0);
+    g_assert_cmpuint(mock.settle_delays, ==, 0);
+}
+static void test_mapping_ambiguous(void) {
+    for (unsigned mode = 0; mode < 7; mode++) {
+        struct euicc_ctx ctx;
+        struct euicc_apdu_interface interface;
+        reset(); start(&ctx, &interface, TRUE);
+        switch (mode) {
+        case 0: mock.n_slots = 1; break;
+        case 1: mock.slots[1].physical_card_status = QMI_UIM_PHYSICAL_CARD_STATE_ABSENT; break;
+        case 2: mock.slots[0].logical_slot = 0; break;
+        case 3: mock.slots[1].physical_slot_status = QMI_UIM_SLOT_STATE_ACTIVE; mock.slots[1].logical_slot = 1; break;
+        case 4: mock.slots[1].physical_slot_status = QMI_UIM_SLOT_STATE_ACTIVE; mock.slots[1].logical_slot = 2; break;
+        case 5: mock.slots[0].logical_slot = 2; break;
+        case 6: mock.missing_slots = TRUE; break;
+        }
+        g_assert_cmpint(interface.connect(&ctx), ==, -1);
+        finish(&ctx);
+        g_assert_cmpuint(mock.switches, ==, 0);
+    }
+}
+static void test_mapping_preserve_other_logical(void) {
+    struct euicc_ctx ctx;
+    struct euicc_apdu_interface interface;
+    reset();
+    g_setenv(ENV_UIM_SLOT, "2", TRUE);
+    start(&ctx, &interface, TRUE);
+    mock.slots[0].logical_slot = 2;
+    mock.n_slots = 3;
+    mock.slots[2] = (QmiPhysicalSlotStatusSlot){QMI_UIM_PHYSICAL_CARD_STATE_PRESENT, QMI_UIM_SLOT_STATE_ACTIVE, 1};
+    g_assert_cmpint(interface.connect(&ctx), ==, 0);
+    g_assert_cmpuint(mock.last_switch_logical, ==, 2);
+    g_assert_cmpint(interface.logic_channel_open(&ctx, (const guint8 *)"aid", 3), ==, 7);
+    g_assert_cmpuint(mock.last_apdu_slot, ==, 2);
+    finish(&ctx);
+    g_assert_cmpuint(mock.slots[0].logical_slot, ==, 2);
+    g_assert_cmpint(mock.slots[2].physical_slot_status, ==, QMI_UIM_SLOT_STATE_ACTIVE);
+    g_assert_cmpuint(mock.slots[2].logical_slot, ==, 1);
+}
+static void test_mapping_external_change(void) {
+    struct euicc_ctx ctx;
+    struct euicc_apdu_interface interface;
+    reset(); start(&ctx, &interface, TRUE);
+    g_assert_cmpint(interface.connect(&ctx), ==, 0);
+    mock.slots[1].logical_slot = 2;
+    interface.disconnect(&ctx);
+    g_assert_true(((struct qmi_data *)interface.userdata)->cleanup_failed);
+    finish(&ctx);
+    g_assert_cmpuint(mock.switches, ==, 1);
+    g_assert_cmpuint(mock.slots[1].logical_slot, ==, 2);
+}
+static void test_mapping_restore_failure(void) {
+    struct euicc_ctx ctx;
+    struct euicc_apdu_interface interface;
+    reset(); start(&ctx, &interface, TRUE);
+    g_assert_cmpint(interface.connect(&ctx), ==, 0);
+    mock.apply_switch = FALSE;
+    interface.disconnect(&ctx);
+    g_assert_true(((struct qmi_data *)interface.userdata)->cleanup_failed);
+    finish(&ctx);
+    g_assert_cmpuint(mock.switches, ==, 2);
+    g_assert_cmpint(mock.slots[1].physical_slot_status, ==, QMI_UIM_SLOT_STATE_ACTIVE);
+}
+static void test_mapping_restore_read_failure(void) {
+    struct euicc_ctx ctx;
+    struct euicc_apdu_interface interface;
+    reset(); start(&ctx, &interface, TRUE);
+    g_assert_cmpint(interface.connect(&ctx), ==, 0);
+    mock.fail_reads = 3;
+    interface.disconnect(&ctx);
+    g_assert_true(((struct qmi_data *)interface.userdata)->cleanup_failed);
+    finish(&ctx);
+    g_assert_cmpuint(mock.switches, ==, 1);
+    g_assert_cmpuint(mock.retry_delays, ==, 2);
+}
+static void test_slot_environment(void) {
+    const char *invalid[] = {"", "0", "256", "-1", "+1", " 1", "1x", "9999999999999999999999999999999"};
+    for (guint i = 0; i < G_N_ELEMENTS(invalid); i++) {
+        struct euicc_apdu_interface interface;
+        reset(); g_setenv(ENV_PHYSICAL_SLOT, invalid[i], TRUE);
+        g_assert_cmpint(driver_apdu_qmi_qrtr.init(&interface), ==, -1);
+        driver_apdu_qmi_qrtr.fini(&interface);
+        reset(); g_setenv(ENV_UIM_SLOT, invalid[i], TRUE);
+        g_assert_cmpint(driver_apdu_qmi_qrtr.init(&interface), ==, -1);
+        driver_apdu_qmi_qrtr.fini(&interface);
+    }
+    struct euicc_ctx ctx;
+    struct euicc_apdu_interface interface;
+    reset(); g_setenv(ENV_UIM_SLOT, "2", TRUE); start(&ctx, &interface, FALSE);
+    g_assert_cmpint(interface.connect(&ctx), ==, 0);
+    g_assert_cmpint(interface.logic_channel_open(&ctx, (const guint8 *)"aid", 3), ==, 7);
+    g_assert_cmpuint(mock.last_apdu_slot, ==, 2);
+    finish(&ctx);
+    g_assert_cmpuint(mock.reads, ==, 0);
+    g_assert_cmpuint(mock.switches, ==, 0);
+}
+int main(int argc, char **argv) {
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/qmi/lifecycle/never-connect", test_never_connect);
+    g_test_add_func("/qmi/lifecycle/connect-failures", test_connect_failures);
+    g_test_add_func("/qmi/lifecycle/open-failures", test_open_failures);
+    g_test_add_func("/qmi/lifecycle/close-failures", test_close_failures);
+    g_test_add_func("/qmi/lifecycle/disconnect-closes-channel", test_disconnect_closes_channel);
+    g_test_add_func("/qmi/lifecycle/transmit", test_transmit);
+    g_test_add_func("/qmi/mapping/replies", test_mapping_replies);
+    g_test_add_func("/qmi/mapping/no-change", test_mapping_no_change);
+    g_test_add_func("/qmi/mapping/already-active", test_mapping_already_active);
+    g_test_add_func("/qmi/mapping/ambiguous", test_mapping_ambiguous);
+    g_test_add_func("/qmi/mapping/preserve-other-logical", test_mapping_preserve_other_logical);
+    g_test_add_func("/qmi/mapping/external-change", test_mapping_external_change);
+    g_test_add_func("/qmi/mapping/restore-failure", test_mapping_restore_failure);
+    g_test_add_func("/qmi/mapping/restore-read-failure", test_mapping_restore_read_failure);
+    g_test_add_func("/qmi/config/environment", test_slot_environment);
+    int result = g_test_run();
+    reset();
+    g_string_free(mock.events, TRUE);
+    return result;
+}

