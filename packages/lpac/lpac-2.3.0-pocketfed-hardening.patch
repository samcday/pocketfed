diff --git a/tests/http_driver_probe.c b/tests/http_driver_probe.c
new file mode 100644
index 0000000..1a62157
--- /dev/null
+++ b/tests/http_driver_probe.c
@@ -0,0 +1,41 @@
+/* Exercise the production driver through its public driver interface. */
+#include <http/curl.h>
+#include <euicc/interface.h>
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+int main(int argc, char **argv) {
+    struct euicc_http_interface interface;
+    const char *headers[] = {"Content-Type: application/json", NULL};
+    const uint8_t request[] = "{\"test\":true}";
+    uint8_t *response = NULL;
+    uint32_t status = UINT32_MAX, length = UINT32_MAX;
+    int result;
+
+    if (argc != 2)
+        return 2;
+    if (driver_http_curl.init(&interface) != 0)
+        return 2;
+    result = interface.transmit(NULL, argv[1], &status, &response, &length,
+                                request, sizeof(request) - 1, headers);
+    driver_http_curl.fini(&interface);
+    if (result < 0) {
+        if (response != NULL || length != 0 || status != 0) {
+            fprintf(stderr, "transport failure did not clear response outputs\n");
+            free(response);
+            return 2;
+        }
+        return 1;
+    }
+    if (status != 200 || length != strlen("{\"test\":\"ok\"}") || response == NULL
+        || memcmp(response, "{\"test\":\"ok\"}", length) != 0) {
+        fprintf(stderr, "unexpected response: status=%u length=%u\n", status, length);
+        free(response);
+        return 2;
+    }
+    free(response);
+    return 0;
+}
diff --git a/tests/http_status.c b/tests/http_status.c
new file mode 100644
index 0000000..c1a6381
--- /dev/null
+++ b/tests/http_status.c
@@ -0,0 +1,82 @@
+/* Production ES9+ parser regression for upstream #444 / 3ff35594ec1506.
+ * Fake HTTP transport only; no network and no APDU operations.
+ */
+#include <euicc/es9p.h>
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static int include_message;
+
+static int fake_transmit(struct euicc_ctx *ctx, const char *url, uint32_t *status,
+                         uint8_t **response, uint32_t *length, const uint8_t *request,
+                         uint32_t request_length, const char **headers) {
+    char value[4096];
+    char json[sizeof(value) * 4 + 512];
+    int size;
+
+    (void)ctx;
+    (void)url;
+    (void)request;
+    (void)request_length;
+    (void)headers;
+    memset(value, 'X', sizeof(value) - 1);
+    value[sizeof(value) - 1] = '\0';
+    size = snprintf(json, sizeof(json),
+                    "{\"header\":{\"functionExecutionStatus\":{\"statusCodeData\":{"
+                    "\"reasonCode\":\"%s\",\"subjectCode\":\"%s\",\"subjectIdentifier\":\"%s\"%s%s%s"
+                    "}}}}", value, value, value,
+                    include_message ? ",\"message\":\"" : "", include_message ? value : "",
+                    include_message ? "\"" : "");
+    if (size < 0 || (size_t)size >= sizeof(json))
+        return -1;
+    *response = malloc(size + 1);
+    if (*response == NULL)
+        return -1;
+    memcpy(*response, json, size + 1);
+    *length = size;
+    *status = 200;
+    return 0;
+}
+
+static int terminated(const char *name, const char *value, size_t size) {
+    if (memchr(value, '\0', size) != NULL)
+        return 1;
+    fprintf(stderr, "%s is not NUL-terminated\n", name);
+    return 0;
+}
+
+int main(void) {
+    struct euicc_http_interface interface = {.transmit = fake_transmit};
+
+    for (include_message = 0; include_message <= 1; ++include_message) {
+        struct euicc_ctx ctx = {0};
+        char *profile = NULL;
+        int result;
+
+        ctx.http.interface = &interface;
+        ctx.http.server_address = "invalid.example";
+        result = es9p_get_bound_profile_package_r(&ctx, &profile, ctx.http.server_address, "test", "test");
+        free(profile);
+        if (result != -1) {
+            fprintf(stderr, "server error unexpectedly succeeded\n");
+            return 1;
+        }
+        if (!terminated("reasonCode", ctx.http.status.reasonCode, sizeof(ctx.http.status.reasonCode))
+            || !terminated("subjectCode", ctx.http.status.subjectCode, sizeof(ctx.http.status.subjectCode))
+            || !terminated("subjectIdentifier", ctx.http.status.subjectIdentifier,
+                           sizeof(ctx.http.status.subjectIdentifier))
+            || !terminated("message", ctx.http.status.message, sizeof(ctx.http.status.message)))
+            return 1;
+        if (strlen(ctx.http.status.reasonCode) != sizeof(ctx.http.status.reasonCode) - 1
+            || strlen(ctx.http.status.subjectCode) != sizeof(ctx.http.status.subjectCode) - 1
+            || strlen(ctx.http.status.subjectIdentifier) != sizeof(ctx.http.status.subjectIdentifier) - 1
+            || (include_message && strlen(ctx.http.status.message) != sizeof(ctx.http.status.message) - 1)) {
+            fprintf(stderr, "server error was not correctly truncated\n");
+            return 1;
+        }
+    }
+    return 0;
+}
diff --git a/tests/http_tls.py b/tests/http_tls.py
new file mode 100644
index 0000000..2586ffd
--- /dev/null
+++ b/tests/http_tls.py
@@ -0,0 +1,165 @@
+#!/usr/bin/env python3
+"""Real curl-driver TLS regressions; ephemeral certificates and loopback only.
+
+Usage: python3 tests/http_tls.py /path/to/http_driver_probe
+Requires only the Python standard library and the OpenSSL CLI. No modem,
+carrier, Internet server, system trust modification, or real activation code.
+"""
+
+import datetime
+import http.server
+import os
+from pathlib import Path
+import ssl
+import subprocess
+import sys
+import tempfile
+import threading
+import unittest
+
+
+PROBE = str(Path(sys.argv.pop(1)).resolve())
+
+
+class TLSRegression(unittest.TestCase):
+    @classmethod
+    def openssl(cls, *arguments):
+        subprocess.run(
+            ["openssl", *map(str, arguments)],
+            cwd=cls.directory,
+            check=True,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+        )
+
+    @classmethod
+    def setUpClass(cls):
+        cls.temporary = tempfile.TemporaryDirectory(prefix="lpac-tls-test-")
+        cls.directory = Path(cls.temporary.name)
+        cls.addClassCleanup(cls.temporary.cleanup)
+        for name in ("trusted", "unknown"):
+            cls.openssl(
+                "req", "-x509", "-newkey", "rsa:2048", "-nodes", "-days", "2",
+                "-subj", f"/CN=lpac-test-{name}-CA", "-keyout", f"{name}.key",
+                "-out", f"{name}.pem", "-addext", "basicConstraints=critical,CA:TRUE",
+                "-addext", "keyUsage=critical,keyCertSign,cRLSign",
+            )
+            (cls.directory / f"{name}.index").touch()
+            (cls.directory / f"{name}.serial").write_text("01\n")
+            (cls.directory / f"{name}.cnf").write_text(
+                "[ca]\ndefault_ca=local\n[local]\n"
+                f"database={name}.index\nserial={name}.serial\n"
+                f"certificate={name}.pem\nprivate_key={name}.key\n"
+                "new_certs_dir=.\ndefault_md=sha256\npolicy=policy\n"
+                "unique_subject=no\n[policy]\ncommonName=supplied\n"
+                "[extensions]\nbasicConstraints=critical,CA:FALSE\n"
+                "keyUsage=critical,digitalSignature,keyEncipherment\n"
+                "extendedKeyUsage=serverAuth\nsubjectAltName=IP:127.0.0.1\n"
+                "[mismatch]\nbasicConstraints=critical,CA:FALSE\n"
+                "keyUsage=critical,digitalSignature,keyEncipherment\n"
+                "extendedKeyUsage=serverAuth\nsubjectAltName=DNS:not-localhost.invalid\n"
+            )
+        now = datetime.datetime.now(datetime.timezone.utc)
+        for name, issuer, extensions, expired in (
+            ("valid", "trusted", "extensions", False),
+            ("untrusted", "unknown", "extensions", False),
+            ("wrong-host", "trusted", "mismatch", False),
+            ("expired", "trusted", "extensions", True),
+        ):
+            cls.openssl(
+                "req", "-new", "-newkey", "rsa:2048", "-nodes",
+                "-subj", f"/CN=lpac-test-{name}", "-keyout", f"{name}.key",
+                "-out", f"{name}.csr",
+            )
+            start = now - datetime.timedelta(days=2)
+            end = now + datetime.timedelta(days=-1 if expired else 1)
+            cls.openssl(
+                "ca", "-batch", "-notext", "-config", f"{issuer}.cnf",
+                "-extensions", extensions, "-in", f"{name}.csr", "-out", f"{name}.pem",
+                "-startdate", start.strftime("%Y%m%d%H%M%SZ"),
+                "-enddate", end.strftime("%Y%m%d%H%M%SZ"),
+            )
+
+    def request(self, certificate, *, expected, ca="trusted.pem", extra_environment=None):
+        requests = []
+
+        class Handler(http.server.BaseHTTPRequestHandler):
+            def do_POST(self):
+                body = self.rfile.read(int(self.headers["Content-Length"]))
+                requests.append(body)
+                response = b'{"test":"ok"}'
+                self.send_response(200)
+                self.send_header("Content-Type", "application/json")
+                self.send_header("Content-Length", str(len(response)))
+                self.end_headers()
+                self.wfile.write(response)
+
+            def log_message(self, *args):
+                pass
+
+        class Server(http.server.ThreadingHTTPServer):
+            def handle_error(self, request, client_address):
+                # A rejected certificate can close TLS before the HTTP handler
+                # receives anything. This is expected in the negative cases.
+                if isinstance(sys.exc_info()[1], (ssl.SSLError, ConnectionError)):
+                    return
+                super().handle_error(request, client_address)
+
+        server = Server(("127.0.0.1", 0), Handler)
+        self.addCleanup(server.server_close)
+        context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
+        context.load_cert_chain(
+            self.directory / f"{certificate}.pem", self.directory / f"{certificate}.key"
+        )
+        server.socket = context.wrap_socket(server.socket, server_side=True)
+        worker = threading.Thread(target=server.serve_forever, daemon=True)
+        worker.start()
+        environment = os.environ.copy()
+        for name in list(environment):
+            if name.lower().endswith("_proxy") or name in (
+                "LPAC_HTTP_CAINFO", "LPAC_HTTP_SSL_VERIFY", "CURL_CA_BUNDLE",
+                "SSL_CERT_FILE", "SSL_CERT_DIR",
+            ):
+                del environment[name]
+        environment["NO_PROXY"] = "*"
+        if ca is not None:
+            environment["LPAC_HTTP_CAINFO"] = str(self.directory / ca) if ca else ""
+        environment.update(extra_environment or {})
+        try:
+            result = subprocess.run(
+                [PROBE, f"https://127.0.0.1:{server.server_port}/test"],
+                env=environment, capture_output=True, text=True, timeout=15,
+            )
+        finally:
+            server.shutdown()
+            worker.join(timeout=5)
+        self.assertEqual(result.returncode, expected, result.stdout + result.stderr)
+        self.assertEqual(requests, [b'{"test":true}'] if expected == 0 else [])
+
+    def test_trusted_ca_and_matching_host_succeeds(self):
+        self.request("valid", expected=0)
+
+    def test_unknown_ca_rejected(self):
+        self.request("untrusted", expected=1)
+
+    def test_hostname_mismatch_rejected(self):
+        self.request("wrong-host", expected=1)
+
+    def test_expired_certificate_rejected(self):
+        self.request("expired", expected=1)
+
+    def test_missing_ca_file_rejected_without_fallback(self):
+        self.request("valid", expected=1, ca="does-not-exist.pem")
+
+    def test_unset_ca_uses_system_trust_and_rejects_test_ca(self):
+        self.request("valid", expected=1, ca=None)
+
+    def test_empty_ca_uses_system_trust_and_rejects_test_ca(self):
+        self.request("valid", expected=1, ca="")
+
+    def test_upstream_insecure_env_cannot_disable_verification(self):
+        self.request("untrusted", expected=1, extra_environment={"LPAC_HTTP_SSL_VERIFY": "0"})
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/inventory_cleanup.c b/tests/inventory_cleanup.c
new file mode 100644
index 0000000..1fac1db
--- /dev/null
+++ b/tests/inventory_cleanup.c
@@ -0,0 +1,198 @@
+/* Actual inventory applets + production ES10 parsers, with a fake APDU card.
+ * Link --wrap=malloc,--wrap=calloc,--wrap=free for allocation fault injection.
+ * No modem, network, profile write, or real identifier is used.
+ */
+#include <applet/chip/info.h>
+#include <applet/profile/list.h>
+#include <euicc/es10b.h>
+#include <euicc/es10c.h>
+#include <main.h>
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+struct euicc_ctx euicc_ctx;
+
+enum scenario { EID_FAILURE, PROFILE_PARTIAL_FAILURE, CHIP_SUCCESS };
+static enum scenario scenario;
+static unsigned command, profile_allocations, profile_frees, rat_frees;
+static unsigned connects, opens, closes, disconnects, transmits, errors, successes;
+static void *profile_node, *rat_node;
+
+void *__real_malloc(size_t size);
+void *__real_calloc(size_t count, size_t size);
+void __real_free(void *pointer);
+
+static int fail_allocation(size_t size) {
+    if (scenario == PROFILE_PARTIAL_FAILURE && command == 0x2D
+        && size == sizeof(struct es10c_profile_info_list)) {
+        ++profile_allocations;
+        return profile_allocations == 2;
+    }
+    return 0;
+}
+
+static void record_allocation(void *pointer, size_t size) {
+    if (scenario == PROFILE_PARTIAL_FAILURE && command == 0x2D
+        && size == sizeof(struct es10c_profile_info_list) && profile_allocations == 1)
+        profile_node = pointer;
+    if (scenario == CHIP_SUCCESS && command == 0x43 && size == sizeof(struct es10b_rat))
+        rat_node = pointer;
+}
+
+void *__wrap_malloc(size_t size) {
+    void *pointer;
+    if (fail_allocation(size))
+        return NULL;
+    pointer = __real_malloc(size);
+    record_allocation(pointer, size);
+    return pointer;
+}
+
+void *__wrap_calloc(size_t count, size_t size) {
+    void *pointer;
+    if (size != 0 && count > SIZE_MAX / size)
+        return NULL;
+    if (fail_allocation(count * size))
+        return NULL;
+    pointer = __real_calloc(count, size);
+    record_allocation(pointer, count * size);
+    return pointer;
+}
+
+void __wrap_free(void *pointer) {
+    if (pointer != NULL && pointer == profile_node) {
+        ++profile_frees;
+        profile_node = NULL;
+    }
+    if (pointer != NULL && pointer == rat_node) {
+        ++rat_frees;
+        rat_node = NULL;
+    }
+    __real_free(pointer);
+}
+
+void jprint_error(const char *function_name, const char *detail) {
+    (void)function_name;
+    (void)detail;
+    ++errors;
+}
+
+void jprint_success(cJSON *data) {
+    ++successes;
+    cJSON_Delete(data);
+}
+
+static int fake_connect(struct euicc_ctx *ctx) {
+    (void)ctx;
+    ++connects;
+    return 0;
+}
+
+static int fake_open(struct euicc_ctx *ctx, const uint8_t *aid, uint8_t aid_length) {
+    (void)ctx;
+    (void)aid;
+    (void)aid_length;
+    ++opens;
+    return 1;
+}
+
+static void fake_close(struct euicc_ctx *ctx, uint8_t channel) {
+    (void)ctx;
+    if (channel == 1)
+        ++closes;
+}
+
+static void fake_disconnect(struct euicc_ctx *ctx) {
+    (void)ctx;
+    ++disconnects;
+}
+
+static int fake_transmit(struct euicc_ctx *ctx, uint8_t **response, uint32_t *response_length,
+                         const uint8_t *request, uint32_t request_length) {
+    static const uint8_t eid[] = {0xBF, 0x3E, 0x12, 0x5A, 0x10,
+                                  0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11,
+                                  0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x90, 0x00};
+    static const uint8_t addresses[] = {0xBF, 0x3C, 0x00, 0x90, 0x00};
+    static const uint8_t rat[] = {0xBF, 0x43, 0x04, 0xA0, 0x02, 0x30, 0x00, 0x90, 0x00};
+    static const uint8_t info[] = {0xBF, 0x22, 0x00, 0x90, 0x00};
+    static const uint8_t profiles[] = {0xBF, 0x2D, 0x06, 0xA0, 0x04, 0xE3, 0x00, 0xE3, 0x00, 0x90, 0x00};
+    const uint8_t *data = NULL;
+    size_t length = 0;
+
+    (void)ctx;
+    ++transmits;
+    *response = NULL;
+    *response_length = 0;
+    if (request_length < 8 || request[1] != 0xE2 || request[5] != 0xBF)
+        return -1;
+    command = request[6];
+    if (scenario == EID_FAILURE)
+        return -1;
+    switch (command) {
+    case 0x3E: data = eid; length = sizeof(eid); break;
+    case 0x3C: data = addresses; length = sizeof(addresses); break;
+    case 0x43: data = rat; length = sizeof(rat); break;
+    case 0x22: data = info; length = sizeof(info); break;
+    case 0x2D: data = profiles; length = sizeof(profiles); break;
+    default: return -1;
+    }
+    *response = malloc(length);
+    if (*response == NULL)
+        return -1;
+    memcpy(*response, data, length);
+    *response_length = length;
+    return 0;
+}
+
+int main(int argc, char **argv) {
+    struct euicc_apdu_interface interface = {
+        .connect = fake_connect, .disconnect = fake_disconnect,
+        .logic_channel_open = fake_open, .logic_channel_close = fake_close,
+        .transmit = fake_transmit,
+    };
+    struct applet_entry *applet = &applet_chip_info;
+    int result;
+
+    if (argc != 2)
+        return 2;
+    if (strcmp(argv[1], "eid-failure") == 0)
+        scenario = EID_FAILURE;
+    else if (strcmp(argv[1], "profile-partial-failure") == 0) {
+        scenario = PROFILE_PARTIAL_FAILURE;
+        applet = &applet_profile_list;
+    } else if (strcmp(argv[1], "chip-success") == 0)
+        scenario = CHIP_SUCCESS;
+    else
+        return 2;
+
+    euicc_ctx.apdu.interface = &interface;
+    if (euicc_init(&euicc_ctx) != 0)
+        return 2;
+    result = applet->main(1, argv);
+    euicc_fini(&euicc_ctx);
+    if (connects != 1 || opens != 1 || closes != 1 || disconnects != 1) {
+        fprintf(stderr, "incorrect channel lifecycle\n");
+        return 1;
+    }
+    if (scenario == CHIP_SUCCESS) {
+        if (result != 0 || errors != 0 || successes != 1 || transmits != 4 || rat_frees != 1) {
+            fprintf(stderr, "chip success cleanup mismatch: result=%d errors=%u successes=%u APDUs=%u RAT frees=%u\n",
+                    result, errors, successes, transmits, rat_frees);
+            return 1;
+        }
+    } else {
+        if (result != -1 || errors != 1 || successes != 0 || transmits != 1) {
+            fprintf(stderr, "inventory failure did not cleanly exit\n");
+            return 1;
+        }
+        if (scenario == PROFILE_PARTIAL_FAILURE && (profile_allocations != 2 || profile_frees != 1)) {
+            fprintf(stderr, "profile fault not exercised: allocations=%u frees=%u\n",
+                    profile_allocations, profile_frees);
+            return 1;
+        }
+    }
+    return 0;
+}
