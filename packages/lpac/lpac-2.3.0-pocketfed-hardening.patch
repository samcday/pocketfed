+// SPDX-License-Identifier: MIT
+/* Minimal libqmi test double. The implementation under test is not copied. */
+#pragma once
+#include <gio/gio.h>
+
+typedef GObject QmiDevice;
+typedef GObject QmiClient;
+typedef GObject QmiClientUim;
+#define QMI_CLIENT(p) ((QmiClient *)(p))
+#define QMI_CLIENT_UIM(p) ((QmiClientUim *)(p))
+#define QMI_SERVICE_UIM 11
+#define QMI_PROTOCOL_ERROR (g_quark_from_static_string("mock-qmi-protocol"))
+#define QMI_PROTOCOL_ERROR_NOT_SUPPORTED 94
+#define QMI_PROTOCOL_ERROR_NO_EFFECT 26
+typedef enum { QMI_DEVICE_OPEN_FLAGS_NONE, QMI_DEVICE_OPEN_FLAGS_PROXY } QmiDeviceOpenFlags;
+typedef enum { QMI_UIM_SLOT_STATE_INACTIVE, QMI_UIM_SLOT_STATE_ACTIVE } QmiUimSlotState;
+typedef enum { QMI_UIM_PHYSICAL_CARD_STATE_ABSENT, QMI_UIM_PHYSICAL_CARD_STATE_PRESENT } QmiUimPhysicalCardState;
+typedef struct {
+    QmiUimPhysicalCardState physical_card_status;
+    QmiUimSlotState physical_slot_status;
+    guint8 logical_slot;
+} QmiPhysicalSlotStatusSlot;
+
+typedef struct {
+    int result;
+    guint8 slot, logical, physical, channel;
+    gboolean missing_channel, missing_array;
+    gboolean terminate_set, terminate;
+    GArray *array;
+} MockQmiMessage;
+
+extern unsigned qmi_mock_live_messages;
+static inline MockQmiMessage *mock_message_new(void) {
+    qmi_mock_live_messages++;
+    return g_new0(MockQmiMessage, 1);
+}
+static inline void mock_message_unref(MockQmiMessage *message) {
+    g_assert_nonnull(message);
+    g_assert_cmpuint(qmi_mock_live_messages, >, 0);
+    qmi_mock_live_messages--;
+    g_clear_pointer(&message->array, g_array_unref);
+    g_free(message);
+}
+static inline gboolean mock_result(MockQmiMessage *message, GError **error) {
+    g_assert_nonnull(message);
+    if (message->result) {
+        g_set_error_literal(error, QMI_PROTOCOL_ERROR, message->result, "mock protocol rejection");
+        return FALSE;
+    }
+    return TRUE;
+}
+static inline gboolean mock_get_array(MockQmiMessage *message, GArray **array, GError **error) {
+    g_assert_nonnull(message);
+    if (message->missing_array) {
+        g_set_error_literal(error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA, "missing array");
+        return FALSE;
+    }
+    *array = message->array;
+    return TRUE;
+}
+static inline gboolean mock_get_channel(MockQmiMessage *message, guint8 *channel, GError **error) {
+    g_assert_nonnull(message);
+    if (message->missing_channel) {
+        g_set_error_literal(error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA, "missing channel");
+        return FALSE;
+    }
+    *channel = message->channel;
+    return TRUE;
+}
+#define MOCK_TYPE(Type) typedef MockQmiMessage Type; G_DEFINE_AUTOPTR_CLEANUP_FUNC(Type, mock_message_unref)
+MOCK_TYPE(QmiMessageUimGetSlotStatusOutput)
+MOCK_TYPE(QmiMessageUimGetCardStatusOutput)
+MOCK_TYPE(QmiMessageUimSwitchSlotInput)
+MOCK_TYPE(QmiMessageUimSwitchSlotOutput)
+MOCK_TYPE(QmiMessageUimOpenLogicalChannelInput)
+MOCK_TYPE(QmiMessageUimOpenLogicalChannelOutput)
+MOCK_TYPE(QmiMessageUimLogicalChannelInput)
+MOCK_TYPE(QmiMessageUimLogicalChannelOutput)
+MOCK_TYPE(QmiMessageUimSendApduInput)
+MOCK_TYPE(QmiMessageUimSendApduOutput)
+#undef MOCK_TYPE
+
+#define MOCK_SET_BYTE(name, field) \
+    static inline gboolean name(MockQmiMessage *message, guint8 value, GError **error) { \
+        (void)error; message->field = value; return TRUE; \
+    }
+#define MOCK_SET_ARRAY(name) \
+    static inline gboolean name(MockQmiMessage *message, GArray *array, GError **error) { \
+        (void)error; message->array = g_array_ref(array); return TRUE; \
+    }
+MOCK_SET_BYTE(qmi_message_uim_switch_slot_input_set_logical_slot, logical)
+MOCK_SET_BYTE(qmi_message_uim_switch_slot_input_set_physical_slot, physical)
+MOCK_SET_BYTE(qmi_message_uim_open_logical_channel_input_set_slot, slot)
+MOCK_SET_BYTE(qmi_message_uim_logical_channel_input_set_slot, slot)
+MOCK_SET_BYTE(qmi_message_uim_logical_channel_input_set_channel_id, channel)
+static inline gboolean qmi_message_uim_logical_channel_input_set_terminate_application(MockQmiMessage *message,
+                                                                                     gboolean value, GError **error) {
+    (void)error;
+    message->terminate_set = TRUE;
+    message->terminate = value;
+    return TRUE;
+}
+MOCK_SET_BYTE(qmi_message_uim_send_apdu_input_set_slot, slot)
+MOCK_SET_BYTE(qmi_message_uim_send_apdu_input_set_channel_id, channel)
+MOCK_SET_ARRAY(qmi_message_uim_open_logical_channel_input_set_aid)
+MOCK_SET_ARRAY(qmi_message_uim_send_apdu_input_set_apdu)
+#undef MOCK_SET_BYTE
+#undef MOCK_SET_ARRAY
+
+#define qmi_message_uim_switch_slot_input_new mock_message_new
+#define qmi_message_uim_open_logical_channel_input_new mock_message_new
+#define qmi_message_uim_logical_channel_input_new mock_message_new
+#define qmi_message_uim_send_apdu_input_new mock_message_new
+#define qmi_message_uim_get_slot_status_output_get_result mock_result
+#define qmi_message_uim_switch_slot_output_get_result mock_result
+#define qmi_message_uim_open_logical_channel_output_get_result mock_result
+#define qmi_message_uim_logical_channel_output_get_result mock_result
+#define qmi_message_uim_send_apdu_output_get_result mock_result
+#define qmi_message_uim_get_slot_status_output_get_physical_slot_status mock_get_array
+#define qmi_message_uim_send_apdu_output_get_apdu_response mock_get_array
+#define qmi_message_uim_open_logical_channel_output_get_channel_id mock_get_channel
