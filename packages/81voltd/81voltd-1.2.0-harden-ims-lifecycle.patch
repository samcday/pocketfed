+#!/usr/bin/python3
+"""Private-bus ModemManager test double; never touches a real modem."""
+import os
+import gi
+gi.require_version('Gio', '2.0')
+from gi.repository import Gio, GLib
+
+NAME = 'org.freedesktop.ModemManager1'
+ROOT = '/org/freedesktop/ModemManager1'
+MODEM = ROOT + '/Modem/0'
+MI = NAME + '.Modem'
+BI = NAME + '.Bearer'
+OM = 'org.freedesktop.DBus.ObjectManager'
+CTRL = 'org.example.TestModem'
+
+XML = '''<node>
+<interface name="org.freedesktop.DBus.ObjectManager">
+ <method name="GetManagedObjects"><arg type="a{oa{sa{sv}}}" direction="out"/></method>
+ <signal name="InterfacesAdded"><arg type="o"/><arg type="a{sa{sv}}"/></signal>
+ <signal name="InterfacesRemoved"><arg type="o"/><arg type="as"/></signal>
+</interface>
+<interface name="org.freedesktop.ModemManager1.Modem">
+ <method name="CreateBearer"><arg type="a{sv}" direction="in"/><arg type="o" direction="out"/></method>
+ <method name="DeleteBearer"><arg type="o" direction="in"/></method>
+ <property name="Ports" type="a(su)" access="read"/>
+ <property name="State" type="i" access="read"/>
+ <property name="Bearers" type="ao" access="read"/>
+</interface>
+<interface name="org.freedesktop.ModemManager1.Bearer">
+ <method name="Connect"/>
+ <method name="Disconnect"/>
+ <property name="Connected" type="b" access="read"/>
+ <property name="Suspended" type="b" access="read"/>
+ <property name="Interface" type="s" access="read"/>
+ <property name="Ip4Config" type="a{sv}" access="read"/>
+ <property name="Ip6Config" type="a{sv}" access="read"/>
+ <property name="Properties" type="a{sv}" access="read"/>
+</interface>
+<interface name="org.example.TestModem">
+ <method name="Configure"><arg type="a{sv}" direction="in"/></method>
+ <method name="SetState"><arg type="i" direction="in"/></method>
+ <method name="CompleteCreate"/>
+ <method name="CompleteConnect"/>
+ <method name="RemoveModem"/>
+ <method name="AddModem"><arg type="i" direction="in"/></method>
+ <method name="Stats"><arg type="a{si}" direction="out"/></method>
+ <method name="StaleAddress"/>
+ <method name="LateConnected"/>
+ <method name="ReleaseName"/>
+ <method name="Quit"/>
+</interface>
+</node>'''
+
+class FakeModem:
+    def __init__(self):
+        self.loop = GLib.MainLoop()
+        self.bus = Gio.DBusConnection.new_for_address_sync(
+            os.environ['DBUS_SYSTEM_BUS_ADDRESS'],
+            Gio.DBusConnectionFlags.AUTHENTICATION_CLIENT | Gio.DBusConnectionFlags.MESSAGE_BUS_CONNECTION,
+            None, None)
+        self.bus.connect('closed', lambda *args: self.loop.quit())
+        self.infos = {item.name: item for item in Gio.DBusNodeInfo.new_for_xml(XML).interfaces}
+        self.objects = {}
+        self.ids = {}
+        self.state = 3
+        self.next_bearer = 0
+        self.config = {'delay-create': False, 'delay-connect': False, 'fail-connect': 0}
+        self.stats = {'create': 0, 'connect': 0, 'disconnect': 0, 'delete': 0, 'up': 0}
+        self.pending_create = []
+        self.pending_connect = []
+        self.register(ROOT, OM, {})
+        self.register(ROOT, CTRL, {})
+        self.add_modem(3)
+        self.bus.call_sync('org.freedesktop.DBus', '/org/freedesktop/DBus',
+                           'org.freedesktop.DBus', 'RequestName', GLib.Variant('(su)', (NAME, 0)),
+                           GLib.VariantType.new('(u)'), Gio.DBusCallFlags.NONE, 5000, None)
+
+    def register(self, path, iface, props):
+        self.objects.setdefault(path, {})[iface] = props
+        self.ids[path, iface] = self.bus.register_object(path, self.infos[iface], self.call, self.get_prop, None)
+
+    def add_modem(self, state):
+        self.state = state
+        props = {'Ports': GLib.Variant('a(su)', [('qrtr0', 6)]),
+                 'State': GLib.Variant('i', state), 'Bearers': GLib.Variant('ao', [])}
+        self.register(MODEM, MI, props)
+        self.bus.emit_signal(None, ROOT, OM, 'InterfacesAdded', GLib.Variant('(oa{sa{sv}})', (MODEM, {MI: props})))
+
+    def get_prop(self, connection, sender, path, iface, name):
+        return self.objects[path][iface][name]
+
+    def change(self, path, iface, changes):
+        self.objects[path][iface].update(changes)
+        self.bus.emit_signal(None, path, 'org.freedesktop.DBus.Properties', 'PropertiesChanged',
+                             GLib.Variant('(sa{sv}as)', (iface, changes, [])))
+
+    def create(self, invocation, requested):
+        path = ROOT + '/Bearer/' + str(self.next_bearer)
+        self.next_bearer += 1
+        props = {'Connected': GLib.Variant('b', False), 'Suspended': GLib.Variant('b', False),
+                 'Interface': GLib.Variant('s', 'test0'), 'Ip4Config': GLib.Variant('a{sv}', {}),
+                 'Ip6Config': GLib.Variant('a{sv}', {}), 'Properties': GLib.Variant('a{sv}', {})}
+        self.register(path, BI, props)
+        if MODEM in self.objects:
+            paths = self.objects[MODEM][MI]['Bearers'].unpack() + [path]
+            self.change(MODEM, MI, {'Bearers': GLib.Variant('ao', paths)})
+        invocation.return_value(GLib.Variant('(o)', (path,)))
+
+    def connect(self, invocation, path):
+        if self.config['fail-connect'] > 0:
+            self.config['fail-connect'] -= 1
+            invocation.return_dbus_error(NAME + '.Error.Core.Cancelled', 'injected transient cancellation')
+            return
+        if path not in self.objects:
+            invocation.return_dbus_error('org.freedesktop.DBus.Error.UnknownObject', 'removed bearer')
+            return
+        self.stats['up'] += 1
+        self.change(path, BI, {'Connected': GLib.Variant('b', True), 'Ip6Config': GLib.Variant('a{sv}', {
+            'method': GLib.Variant('u', 2), 'address': GLib.Variant('s', '2001:db8::42'), 'prefix': GLib.Variant('u', 64)})})
+        invocation.return_value(None)
+
+    def call(self, connection, sender, path, iface, method, parameters, invocation):
+        args = parameters.unpack()
+        try:
+            if iface == OM:
+                invocation.return_value(GLib.Variant('(a{oa{sa{sv}}})', ({p: i for p, i in self.objects.items() if p != ROOT},)))
+                return
+            if iface == CTRL:
+                if method == 'Configure':
+                    self.config.update(args[0])
+                elif method == 'SetState':
+                    self.state = args[0]
+                    self.change(MODEM, MI, {'State': GLib.Variant('i', self.state)})
+                elif method == 'CompleteCreate':
+                    pending, self.pending_create = self.pending_create, []
+                    for call, props in pending:
+                        self.create(call, props)
+                elif method == 'CompleteConnect':
+                    pending, self.pending_connect = self.pending_connect, []
+                    for call, bearer_path in pending:
+                        self.connect(call, bearer_path)
+                elif method == 'RemoveModem':
+                    self.bus.emit_signal(None, ROOT, OM, 'InterfacesRemoved', GLib.Variant('(oas)', (MODEM, [MI])))
+                    self.bus.unregister_object(self.ids.pop((MODEM, MI)))
+                    self.objects.pop(MODEM)
+                elif method == 'AddModem':
+                    self.add_modem(args[0])
+                elif method == 'Stats':
+                    invocation.return_value(GLib.Variant('(a{si})', (self.stats,)))
+                    return
+                elif method in ('StaleAddress', 'LateConnected'):
+                    for bearer_path in list(self.objects):
+                        if BI in self.objects[bearer_path]:
+                            self.change(bearer_path, BI, {'Connected': GLib.Variant('b', method == 'LateConnected'),
+                                'Ip6Config': GLib.Variant('a{sv}', {'method': GLib.Variant('u', 2),
+                                    'address': GLib.Variant('s', '2001:db8::dead'), 'prefix': GLib.Variant('u', 64)})})
+                elif method == 'ReleaseName':
+                    self.bus.call_sync('org.freedesktop.DBus', '/org/freedesktop/DBus',
+                        'org.freedesktop.DBus', 'ReleaseName', GLib.Variant('(s)', (NAME,)),
+                        GLib.VariantType.new('(u)'), Gio.DBusCallFlags.NONE, 5000, None)
+                elif method == 'Quit':
+                    self.loop.quit()
+                invocation.return_value(None)
+                return
+            if iface == MI and method == 'CreateBearer':
+                self.stats['create'] += 1
+                if self.config['delay-create']:
+                    self.pending_create.append((invocation, args[0]))
+                else:
+                    self.create(invocation, args[0])
+                return
+            if iface == MI and method == 'DeleteBearer':
+                self.stats['delete'] += 1
+                target = args[0]
+                if (target, BI) in self.ids:
+                    self.bus.unregister_object(self.ids.pop((target, BI)))
+                    self.objects.pop(target)
+                if MODEM in self.objects:
+                    paths = [p for p in self.objects[MODEM][MI]['Bearers'].unpack() if p != target]
+                    self.change(MODEM, MI, {'Bearers': GLib.Variant('ao', paths)})
+                invocation.return_value(None)
+                return
+            if iface == BI and method == 'Connect':
+                self.stats['connect'] += 1
+                if self.config['delay-connect']:
+                    self.pending_connect.append((invocation, path))
+                else:
+                    self.connect(invocation, path)
+                return
+            if iface == BI and method == 'Disconnect':
+                self.stats['disconnect'] += 1
+                self.change(path, BI, {'Connected': GLib.Variant('b', False), 'Ip6Config': GLib.Variant('a{sv}', {})})
+                invocation.return_value(None)
+                return
+            invocation.return_dbus_error('org.freedesktop.DBus.Error.UnknownMethod', method)
+        except Exception as error:
+            invocation.return_dbus_error('org.example.TestFailure', str(error))
+
+FakeModem().loop.run()
