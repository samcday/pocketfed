+static struct operation *operation_new(QVDConnection *conn, guint kind)
+{
+	struct operation *op = g_new0(struct operation, 1);
+	op->conn = g_object_ref(conn);
+	op->bearer = g_object_ref(conn->bearer);
+	op->owner = g_dbus_proxy_get_name_owner(G_DBUS_PROXY(conn->bearer));
+	op->generation = conn->generation;
+	conn->operation = kind;
+	conn->operation_generation = conn->generation;
+	return op;
+}
+static void operation_free(struct operation *op)
+{
+	g_object_unref(op->conn);
+	g_object_unref(op->bearer);
+	g_free(op->owner);
+	g_free(op);
+}
+static gboolean operation_live(struct operation *op)
+{
+	g_autofree gchar *owner = g_dbus_proxy_get_name_owner(G_DBUS_PROXY(op->bearer));
+	return !op->conn->invalidated && op->conn->bearer == op->bearer &&
+		op->owner && !g_strcmp0(op->owner, owner);
+}
+
+static void fail_connection(QVDConnection *conn, const GError *error)
+{
+	if (!conn->requested)
+		return;
+	conn->requested = FALSE;
+	conn->generation++;
+	clear_timer(&conn->retry_id);
+	clear_timer(&conn->deadline_id);
+	g_signal_emit(conn, conn_signals[CONNECT_ERR], 0, error);
+	/* A timed out D-Bus Connect may still complete. Keep its callback alive;
+	 * it will disconnect the old attempt instead of reviving this request. */
+	if (conn->operation == OP_NONE && conn->bearer && mm_bearer_get_connected(conn->bearer))
+		start_disconnect(conn);
+}
+static gboolean connection_timeout(gpointer data)
+{
+	QVDConnection *conn = data;
+	g_autoptr(GError) error = g_error_new_literal(G_IO_ERROR, G_IO_ERROR_TIMED_OUT,
+		"IMS bearer did not become ready before its deadline");
+	conn->deadline_id = 0;
+	fail_connection(conn, error);
+	return G_SOURCE_REMOVE;
+}
+static gboolean retry_connection(gpointer data)
+{
+	QVDConnection *conn = data;
+	conn->retry_id = 0;
+	drive_connection(conn);
+	return G_SOURCE_REMOVE;
+}
+static gboolean retryable(const GError *error)
+{
+	return g_error_matches(error, MM_CORE_ERROR, MM_CORE_ERROR_CANCELLED) ||
+		g_error_matches(error, MM_CORE_ERROR, MM_CORE_ERROR_IN_PROGRESS) ||
+		g_error_matches(error, MM_CORE_ERROR, MM_CORE_ERROR_WRONG_STATE) ||
+		g_error_matches(error, MM_CORE_ERROR, MM_CORE_ERROR_RETRY) ||
+		g_error_matches(error, G_IO_ERROR, G_IO_ERROR_CANCELLED) ||
+		g_error_matches(error, G_IO_ERROR, G_IO_ERROR_TIMED_OUT) ||
+		g_error_matches(error, G_DBUS_ERROR, G_DBUS_ERROR_NO_REPLY);
+}
+
+static void report_address(QVDConnection *conn, gboolean replay)
+{
+	g_autoptr(MMBearerIpConfig) config = NULL;
+	const gchar *address;
+	if (!conn->requested || conn->invalidated || !conn->bearer ||
+		(conn->operation != OP_NONE && conn->operation_generation != conn->generation))
+		return;
+	config = conn->ip_type == MM_BEARER_IP_FAMILY_IPV4 ?
+		mm_bearer_get_ipv4_config(conn->bearer) : mm_bearer_get_ipv6_config(conn->bearer);
+	address = config && mm_bearer_get_connected(conn->bearer) ? mm_bearer_ip_config_get_address(config) : NULL;
+	if (!address && !conn->addr) return;
+	if (!replay && conn->address_generation == conn->generation && !g_strcmp0(address, conn->addr))
+		return;
+	g_free(conn->addr);
+	conn->addr = g_strdup(address);
+	conn->address_generation = conn->generation;
+	if (address)
+		clear_timer(&conn->deadline_id);
+	g_signal_emit(conn, conn_signals[ADDR_CHANGED], 0, conn->ip_type, address);
+}
+
+static void on_disconnect(GObject *obj, GAsyncResult *res, gpointer data)
+{
+	struct operation *op = data;
+	QVDConnection *conn = op->conn;
+	g_autoptr(GError) error = NULL;
+	mm_bearer_disconnect_finish(MM_BEARER(obj), res, &error);
+	if (operation_live(op)) {
+		conn->operation = OP_NONE;
+		if (error) {
+			g_signal_emit(conn, conn_signals[DISCONNECT_ERR], 0, error);
+			/* Do not launch a new connection on top of an uncertain disconnect. */
+			fail_connection(conn, error);
+		} else {
+			g_clear_pointer(&conn->addr, g_free);
+			drive_connection(conn);
+		}
+	}
+	operation_free(op);
+}
+static void start_disconnect(QVDConnection *conn)
+{
+	if (conn->operation != OP_NONE || !conn->bearer || conn->invalidated)
+		return;
+	mm_bearer_disconnect(conn->bearer, NULL, on_disconnect, operation_new(conn, OP_DISCONNECT));
+}
 static void on_connect(GObject *obj, GAsyncResult *res, gpointer data)
 {
+	struct operation *op = data;
+	QVDConnection *conn = op->conn;
+	g_autoptr(GError) error = NULL;
+	mm_bearer_connect_finish(MM_BEARER(obj), res, &error);
+	if (!operation_live(op))
+		goto done;
+	conn->operation = OP_NONE;
+	if (!conn->requested || op->generation != conn->generation) {
+		/* Stop/new Start while Connect was in flight: drain the old operation
+		 * through Disconnect before attempting the new request. */
+		start_disconnect(conn);
+		goto done;
+	}
+	if (error) {
+		g_message("IMS bearer connection attempt %u failed: %s", conn->attempts, error->message);
+		if (retryable(error) && conn->attempts < QVD_MAX_CONNECT_ATTEMPTS) {
+			conn->retry_id = g_timeout_add_full(G_PRIORITY_DEFAULT,
+				QVD_RETRY_MILLISECONDS * conn->attempts, retry_connection,
+				g_object_ref(conn), g_object_unref);
+		} else {
+			fail_connection(conn, error);
+		}
+	} else {
+		report_address(conn, FALSE);
+	}
+ done:
+	operation_free(op);
+}
+static gboolean modem_ready(QVDConnection *conn)
+{
+	MMModemState state = conn->modem ? mm_modem_get_state(conn->modem) : MM_MODEM_STATE_UNKNOWN;
+	return state == MM_MODEM_STATE_REGISTERED || state == MM_MODEM_STATE_CONNECTING || state == MM_MODEM_STATE_CONNECTED;
+}
+static void drive_connection(QVDConnection *conn)
+{
+	if (!conn->requested || conn->invalidated || !conn->bearer ||
+		conn->operation != OP_NONE || conn->retry_id || !modem_ready(conn))
+		return;
+	if (mm_bearer_get_connected(conn->bearer)) {
+		report_address(conn, FALSE);
+		return;
+	}
+	conn->attempts++;
+	mm_bearer_connect(conn->bearer, NULL, on_connect, operation_new(conn, OP_CONNECT));
+}
+void qvd_connection_connect(QVDConnection *conn)
+{
+	if (conn->invalidated)
+		return;
+	if (!conn->requested) {
+		conn->requested = TRUE;
+		conn->generation++;
+		conn->attempts = 0;
+		conn->deadline_id = g_timeout_add_seconds_full(G_PRIORITY_DEFAULT,
+			QVD_CONNECT_TIMEOUT_SECONDS, connection_timeout, g_object_ref(conn), g_object_unref);
+	}
+	drive_connection(conn);
+}
+void qvd_connection_disconnect(QVDConnection *conn)
+{
+	conn->requested = FALSE;
+	conn->generation++;
+	clear_timer(&conn->retry_id);
+	clear_timer(&conn->deadline_id);
+	start_disconnect(conn);
+}
