+/* Compile production server+message+QMI codec; only QRTR socket transport is wrapped. */
+#define main unused_api_main
+#include "test-lifecycle.c"
+#undef main
+#include <unistd.h>
+#include <sys/socket.h>
+#include "qvd-server.c"
+
+static GPtrArray *packets;
+static int transport_peer = -1;
+int __wrap_qrtr_open(int port)
+{
+    int pair[2];
+    g_assert_cmpint(socketpair(AF_UNIX, SOCK_DGRAM, 0, pair), ==, 0);
+    transport_peer = pair[1];
+    return pair[0];
+}
+int __wrap_qrtr_new_server(int fd, uint32_t service, uint16_t version, uint16_t instance)
+{
+    g_assert_cmpuint(service, ==, 770);
+    return 0;
+}
+int __wrap_qrtr_sendto(int fd, uint32_t node, uint32_t port, const void *data, unsigned int len)
+{
+    g_ptr_array_add(packets, g_bytes_new(data, len));
+    return 0;
+}
+static void inject(QVDServer *server, int msgid, const void *input, struct qmi_elem_info *schema)
+{
+    static guint txn;
+    struct qrtr_packet *packet = g_new0(struct qrtr_packet, 1);
+    packet->data_len = 65536;
+    packet->data = g_malloc(packet->data_len);
+    g_assert_cmpint(qmi_encode_message(packet, QMI_REQUEST, msgid, ++txn, input, schema), >=, 0);
+    process_message(server, qvd_message_new(g_object_ref(server->sock), packet, 0, 78));
+}
+static void start_profile(QVDServer *server, guint32 original, guint32 subscription, guint16 profile)
+{
+    struct imsd_start_connection_req input = {0};
+    strcpy(input.conn_params.apn, "ims");
+    input.conn_params.apn_len = 3;
+    input.conn_params.ip_family = IMSD_AF_IPV6;
+    input.conn_params.profiles_select = IMSD_PROFILES_3GPP;
+    input.conn_params.profile_idx_3gpp = profile;
+    input.conn_params.profile_idx_3gpp2 = 0xffff;
+    input.connection = original;
+    input.subscription = subscription;
+    inject(server, IMSD_START_CONNECTION, &input, imsd_start_connection_req_ei);
+}
+static void start(QVDServer *server, guint32 original, guint32 subscription)
+{
+    start_profile(server, original, subscription, 2);
+}
+static void stop_wire(QVDServer *server, guint8 handle, guint32 subscription)
+{
+    struct imsd_stop_connection_req input = {.connection = handle, .unkecho_01 = subscription};
+    inject(server, IMSD_STOP_CONNECTION, &input, imsd_stop_connection_req_ei);
+}
+static guint wire_count(guint type)
+{
+    guint count = 0;
+    for (guint i = 0; i < packets->len; i++) {
+        gsize len;
+        const guint8 *data = g_bytes_get_data(packets->pdata[i], &len);
+        if (len > 0 && data[0] == type) count++;
+    }
+    return count;
+}
+static void decode_last(guint type, guint message, void *output, struct qmi_elem_info *schema)
+{
+    for (gint i = packets->len - 1; i >= 0; i--) {
+        gsize len;
+        const guint8 *data = g_bytes_get_data(packets->pdata[i], &len);
+        struct qrtr_packet packet = {.data = (void *)data, .data_len = len};
+        guint msgid, txn;
+        g_assert_cmpint(qmi_decode_header(&packet, &msgid), >=, 0);
+        if (data[0] == type && msgid == message) {
+            g_assert_cmpint(qmi_decode_message(output, &txn, &packet, type, message, schema), >=, 0);
+            return;
+        }
+    }
+    g_error("No matching output packet");
+}
+int main(int argc, char **argv)
+{
+    GError *error = NULL;
+    GTestDBus *bus;
+    QVDModem *modem;
+    QVDServer *server;
+    GPid child;
+    gchar *child_argv[] = {QVD_TEST_PYTHON, QVD_TEST_FAKE_MM, NULL};
+    const gchar *scenario = argv[1];
+    struct imsd_start_connection_resp ack = {0};
+    struct imsd_no_op_resp stop_ack = {0};
+    struct imsd_connection_changed_ind indication = {0};
+    g_assert_cmpint(argc, ==, 2);
+    g_test_init(&argc, &argv, NULL);
+    g_log_set_always_fatal(G_LOG_LEVEL_ERROR | G_LOG_LEVEL_CRITICAL);
+    bus = g_test_dbus_new(G_TEST_DBUS_NONE);
+    g_test_dbus_up(bus);
+    g_setenv("DBUS_SYSTEM_BUS_ADDRESS", g_test_dbus_get_bus_address(bus), TRUE);
+    control = g_dbus_connection_new_for_address_sync(g_test_dbus_get_bus_address(bus),
+        G_DBUS_CONNECTION_FLAGS_AUTHENTICATION_CLIENT | G_DBUS_CONNECTION_FLAGS_MESSAGE_BUS_CONNECTION,
+        NULL, NULL, &error);
+    g_assert_no_error(error);
+    g_assert_true(g_spawn_async(NULL, child_argv, NULL, G_SPAWN_DO_NOT_REAP_CHILD, NULL, NULL, &child, &error));
+    g_assert_no_error(error);
+    gboolean owned = FALSE;
+    for (guint i = 0; i < 200 && !owned; i++) {
+        GVariant *reply = g_dbus_connection_call_sync(control, "org.freedesktop.DBus",
+            "/org/freedesktop/DBus", "org.freedesktop.DBus", "NameHasOwner",
+            g_variant_new("(s)", "org.freedesktop.ModemManager1"), NULL,
+            G_DBUS_CALL_FLAGS_NONE, 3000, NULL, &error);
+        g_assert_no_error(error);
+        g_variant_get(reply, "(b)", &owned);
+        g_variant_unref(reply);
+        if (!owned) pump(10);
+    }
+    g_assert_true(owned);
+    if (!g_str_equal(scenario, "wire-ack-stop") && !g_str_equal(scenario, "wire-ambiguous-stop"))
+        cmd("SetState", g_variant_new("(i)", MM_MODEM_STATE_REGISTERED));
+    if (g_str_equal(scenario, "wire-failure"))
+        configure("fail-connect", g_variant_new_int32(100));
+    modem = qvd_modem_new(&error);
+    g_assert_no_error(error);
+    packets = g_ptr_array_new_with_free_func((GDestroyNotify)g_bytes_unref);
+    server = qvd_server_new(modem, &error);
+    g_assert_no_error(error);
+    start(server, 101, 7);
+    g_assert_cmpuint(wire_count(QMI_RESPONSE), ==, 1);
+    g_assert_cmpint(count("create"), ==, 0);
+    decode_last(QMI_RESPONSE, IMSD_START_CONNECTION, &ack, imsd_start_connection_resp_ei);
+    g_assert_cmpuint(ack.res.err_status, ==, 0);
+    g_assert_cmpuint(ack.orig_conn_id, ==, 101);
+    g_assert_cmpuint(ack.subscription, ==, 7);
+    guint8 handle = ack.connection;
+
+    if (g_str_equal(scenario, "wire-ack-stop")) {
+        start(server, 101, 7);
+        decode_last(QMI_RESPONSE, IMSD_START_CONNECTION, &ack, imsd_start_connection_resp_ei);
+        g_assert_cmpuint(ack.connection, ==, handle);
+        pump(100);
+        g_assert_cmpint(count("create"), ==, 0);
+        stop_wire(server, 101, 8);
+        decode_last(QMI_RESPONSE, IMSD_STOP_CONNECTION, &stop_ack, imsd_no_op_resp_ei);
+        g_assert_cmpuint(stop_ack.res.err_status, ==, 1);
+        stop_wire(server, 101, 7);
+        decode_last(QMI_RESPONSE, IMSD_STOP_CONNECTION, &stop_ack, imsd_no_op_resp_ei);
+        g_assert_cmpuint(stop_ack.res.err_status, ==, 0);
+        cmd("SetState", g_variant_new("(i)", MM_MODEM_STATE_REGISTERED));
+        pump(200);
+        g_assert_cmpint(count("create"), ==, 0);
+        g_assert_cmpuint(wire_count(QMI_INDICATION), ==, 0);
+    } else if (g_str_equal(scenario, "wire-ambiguous-stop")) {
+        start_profile(server, handle, 7, 3);
+        decode_last(QMI_RESPONSE, IMSD_START_CONNECTION, &ack, imsd_start_connection_resp_ei);
+        guint8 second_handle = ack.connection;
+        g_assert_cmpuint(second_handle, !=, handle);
+        stop_wire(server, handle, 7);
+        decode_last(QMI_RESPONSE, IMSD_STOP_CONNECTION, &stop_ack, imsd_no_op_resp_ei);
+        g_assert_cmpuint(stop_ack.res.err_status, ==, 1);
+        stop_wire(server, second_handle, 7);
+        decode_last(QMI_RESPONSE, IMSD_STOP_CONNECTION, &stop_ack, imsd_no_op_resp_ei);
+        g_assert_cmpuint(stop_ack.res.err_status, ==, 0);
+        stop_wire(server, 101, 7);
+        decode_last(QMI_RESPONSE, IMSD_STOP_CONNECTION, &stop_ack, imsd_no_op_resp_ei);
+        g_assert_cmpuint(stop_ack.res.err_status, ==, 0);
+        cmd("SetState", g_variant_new("(i)", MM_MODEM_STATE_REGISTERED));
+        pump(200);
+        g_assert_cmpint(count("create"), ==, 0);
+    } else if (g_str_equal(scenario, "wire-ready-retransmit")) {
+        wait_count("up", 1);
+        pump(30);
+        g_assert_cmpuint(wire_count(QMI_INDICATION), ==, 1);
+        decode_last(QMI_INDICATION, IMSD_CONNECTION_CHANGED, &indication, imsd_connection_changed_ind_ei);
+        g_assert_cmpuint(indication.connection, ==, handle);
+        g_assert_cmpuint(indication.orig_conn_id, ==, 101);
+        g_assert_cmpuint(indication.subscription, ==, 7);
+        g_assert_true(indication.ip_addr_valid);
+        for (guint i = 0; i < 3; i++) start(server, 101, 7);
+        cmd("SetState", g_variant_new("(i)", MM_MODEM_STATE_CONNECTED));
+        pump(50);
+        cmd("SetState", g_variant_new("(i)", MM_MODEM_STATE_REGISTERED));
+        pump(50);
+        g_assert_cmpint(count("create"), ==, 1);
+        g_assert_cmpint(count("connect"), ==, 1);
+        g_assert_cmpuint(wire_count(QMI_INDICATION), ==, 1);
+        stop_wire(server, handle, 7);
+        pump(100);
+    } else if (g_str_equal(scenario, "wire-failure")) {
+        wait_count("connect", 3);
+        pump(300);
+        g_assert_cmpuint(wire_count(QMI_INDICATION), ==, 1);
+        decode_last(QMI_INDICATION, IMSD_CONNECTION_CHANGED, &indication, imsd_connection_changed_ind_ei);
+        g_assert_cmpuint(indication.res.err_status, ==, 0);
+        g_assert_cmpuint(indication.res.err_code, ==, 13);
+        g_assert_false(indication.ip_addr_valid);
+        g_assert_cmpuint(indication.orig_conn_id, ==, 101);
+        g_assert_cmpuint(indication.subscription, ==, 7);
+        configure("fail-connect", g_variant_new_int32(0));
+        start(server, 100, 7);
+        decode_last(QMI_RESPONSE, IMSD_START_CONNECTION, &ack, imsd_start_connection_resp_ei);
+        g_assert_cmpuint(ack.connection, !=, handle);
+        wait_count("up", 1);
+        pump(30);
+        gint disconnects = count("disconnect");
+        stop_wire(server, handle, 7);
+        decode_last(QMI_RESPONSE, IMSD_STOP_CONNECTION, &stop_ack, imsd_no_op_resp_ei);
+        g_assert_cmpuint(stop_ack.res.err_status, ==, 1);
+        pump(100);
+        g_assert_cmpint(count("disconnect"), ==, disconnects);
+        stop_wire(server, ack.connection, 7);
+        pump(100);
+    } else {
+        g_error("unknown wire scenario: %s", scenario);
+    }
+    pump(100);
+    g_object_unref(server);
+    g_object_unref(modem);
+    g_ptr_array_unref(packets);
