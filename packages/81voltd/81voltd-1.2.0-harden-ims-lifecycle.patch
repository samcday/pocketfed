+#include <gio/gio.h>
+#include <libmm-glib.h>
+#include "qvd-modem.h"
+#include "qvd-connection.h"
+
+#ifndef QVD_TEST_FAKE_MM
+#define QVD_TEST_FAKE_MM "/tmp/sargo81-tests/fake-mm.py"
+#endif
+#ifndef QVD_TEST_PYTHON
+#define QVD_TEST_PYTHON "/usr/bin/python3"
+#endif
+
+static GDBusConnection *control;
+static guint up_count, down_count, error_count, create_done;
+static gboolean create_success;
+
+static GVariant *command(const gchar *method, GVariant *args)
+{
+    GError *error = NULL;
+    GVariant *reply = g_dbus_connection_call_sync(control, "org.freedesktop.ModemManager1",
+        "/org/freedesktop/ModemManager1", "org.example.TestModem", method, args,
+        NULL, G_DBUS_CALL_FLAGS_NONE, 3000, NULL, &error);
+    g_assert_no_error(error);
+    return reply;
+}
+static void cmd(const gchar *method, GVariant *args)
+{
+    GVariant *reply = command(method, args);
+    g_variant_unref(reply);
+}
+static gint count(const gchar *name)
+{
+    GVariant *reply = command("Stats", NULL);
+    GVariant *dict = g_variant_get_child_value(reply, 0);
+    gint result = -1;
+    g_variant_lookup(dict, name, "i", &result);
+    g_variant_unref(dict);
+    g_variant_unref(reply);
+    return result;
+}
+static void pump(guint milliseconds)
+{
+    gint64 until = g_get_monotonic_time() + milliseconds * 1000;
+    while (g_get_monotonic_time() < until) {
+        while (g_main_context_iteration(NULL, FALSE));
+        g_usleep(1000);
+    }
+}
+static void wait_count(const gchar *name, gint target)
+{
+    for (guint i = 0; i < 500 && count(name) < target; i++)
+        pump(10);
+    g_assert_cmpint(count(name), >=, target);
+}
+static void configure(const gchar *name, GVariant *value)
+{
+    GVariantBuilder builder;
+    g_variant_builder_init(&builder, G_VARIANT_TYPE_VARDICT);
+    g_variant_builder_add(&builder, "{sv}", name, value);
+    cmd("Configure", g_variant_new("(a{sv})", &builder));
+}
+static void address(QVDConnection *conn, gint family, const gchar *addr, gpointer data)
+{
+    if (addr) up_count++;
+    else down_count++;
+}
+static void connect_error(QVDConnection *conn, const GError *error, gpointer data)
+{
+    g_test_message("terminal connection error: %s", error->message);
+    error_count++;
+}
+static void created(GObject *obj, GAsyncResult *result, gpointer data)
+{
+    GError *error = NULL;
+    create_done++;
+    create_success = qvd_modem_get_connection_finish(QVD_MODEM(obj), result, &error);
+    if (error) {
+        g_test_message("creation finished: %s", error->message);
+        g_error_free(error);
+    }
+}
+static QVDConnection *request(QVDModem *modem, GCancellable *cancel)
+{
+    QVDConnection *conn = qvd_modem_get_connection(modem, "ims", MM_BEARER_IP_FAMILY_IPV6,
+        2, cancel, created, NULL);
+    g_assert_nonnull(conn);
+    g_signal_connect(conn, "qvd-address-changed", G_CALLBACK(address), NULL);
+    g_signal_connect(conn, "qvd-connect-error", G_CALLBACK(connect_error), NULL);
+    qvd_connection_connect(conn);
+    return conn;
+}
+static void stop(QVDConnection *conn, GCancellable *cancel)
+{
+    qvd_connection_disconnect(conn);
+    g_cancellable_cancel(cancel);
+}
+
+int main(int argc, char **argv)
+{
+    GError *error = NULL;
+    GTestDBus *bus;
+    QVDModem *modem;
+    QVDConnection *conn;
+    GCancellable *cancel;
+    GPid child;
+    gchar *child_argv[] = {QVD_TEST_PYTHON, QVD_TEST_FAKE_MM, NULL};
+    const gchar *scenario;
+    g_assert_cmpint(argc, ==, 2);
+    scenario = argv[1];
+    g_test_init(&argc, &argv, NULL);
+    g_log_set_always_fatal(G_LOG_LEVEL_ERROR | G_LOG_LEVEL_CRITICAL);
+    bus = g_test_dbus_new(G_TEST_DBUS_NONE);
+    g_test_dbus_up(bus);
+    g_setenv("DBUS_SYSTEM_BUS_ADDRESS", g_test_dbus_get_bus_address(bus), TRUE);
+    control = g_dbus_connection_new_for_address_sync(g_test_dbus_get_bus_address(bus),
+        G_DBUS_CONNECTION_FLAGS_AUTHENTICATION_CLIENT | G_DBUS_CONNECTION_FLAGS_MESSAGE_BUS_CONNECTION,
+        NULL, NULL, &error);
+    g_assert_no_error(error);
+    g_assert_true(g_spawn_async(NULL, child_argv, NULL, G_SPAWN_DO_NOT_REAP_CHILD, NULL, NULL, &child, &error));
+    g_assert_no_error(error);
+    gboolean owned = FALSE;
+    for (guint i = 0; i < 200 && !owned; i++) {
+        GVariant *reply = g_dbus_connection_call_sync(control, "org.freedesktop.DBus",
+            "/org/freedesktop/DBus", "org.freedesktop.DBus", "NameHasOwner",
+            g_variant_new("(s)", "org.freedesktop.ModemManager1"), NULL,
+            G_DBUS_CALL_FLAGS_NONE, 3000, NULL, &error);
+        g_assert_no_error(error);
+        g_variant_get(reply, "(b)", &owned);
+        g_variant_unref(reply);
+        if (!owned) pump(10);
+    }
+    g_assert_true(owned);
+    if (g_str_has_prefix(scenario, "cancel-create") || g_str_equal(scenario, "remove-create") || g_str_equal(scenario, "owner-replacement"))
+        configure("delay-create", g_variant_new_boolean(TRUE));
+    if (g_str_equal(scenario, "cancel-connect") || g_str_equal(scenario, "stale-address"))
+        configure("delay-connect", g_variant_new_boolean(TRUE));
+    if (g_str_equal(scenario, "retired-late-connected"))
+        configure("fail-connect", g_variant_new_int32(1));
+    if (g_str_has_prefix(scenario, "retry"))
+        configure("fail-connect", g_variant_new_int32(g_str_equal(scenario, "retry-success") ? 2 : 100));
+    if (!g_str_equal(scenario, "readiness") && !g_str_has_prefix(scenario, "cancel-ready"))
+        cmd("SetState", g_variant_new("(i)", MM_MODEM_STATE_REGISTERED));
+    if (g_str_equal(scenario, "no-modem"))
+        cmd("RemoveModem", NULL);
+    modem = qvd_modem_new(&error);
+    g_assert_no_error(error);
+    cancel = g_cancellable_new();
+    conn = request(modem, cancel);
+
+    if (g_str_equal(scenario, "readiness") || g_str_equal(scenario, "no-modem")) {
+        pump(150);
+        g_assert_cmpint(count("create"), ==, 0);
+        g_assert_cmpint(count("connect"), ==, 0);
+        cmd(g_str_equal(scenario, "no-modem") ? "AddModem" : "SetState",
+            g_variant_new("(i)", MM_MODEM_STATE_REGISTERED));
+        wait_count("up", 1);
+        pump(30);
+        g_assert_cmpuint(up_count, ==, 1);
+        g_assert_cmpuint(create_done, ==, 1);
+        g_assert_true(create_success);
+    } else if (g_str_equal(scenario, "cancel-ready")) {
+        pump(50);
+        stop(conn, cancel);
+        cmd("SetState", g_variant_new("(i)", MM_MODEM_STATE_REGISTERED));
+        pump(200);
+        g_assert_cmpint(count("create"), ==, 0);
+        g_assert_cmpint(count("connect"), ==, 0);
+        g_assert_cmpuint(up_count, ==, 0);
+    } else if (g_str_equal(scenario, "cancel-create-newstart") || g_str_equal(scenario, "cancel-ready-newstart")) {
+        gboolean ready = g_str_equal(scenario, "cancel-ready-newstart");
+        if (!ready) wait_count("create", 1);
+        stop(conn, cancel);
+        GCancellable *next_cancel = g_cancellable_new();
+        QVDConnection *next = request(modem, next_cancel);
+        if (ready) cmd("SetState", g_variant_new("(i)", MM_MODEM_STATE_REGISTERED));
+        pump(100);
+        if (!ready) cmd("CompleteCreate", NULL);
+        wait_count("up", 1);
+        pump(50);
+        g_assert_cmpuint(up_count, ==, 1);
+        stop(next, next_cancel);
+        pump(50);
+        g_object_unref(next);
+        g_object_unref(next_cancel);
+    } else if (g_str_equal(scenario, "cancel-create")) {
+        wait_count("create", 1);
+        stop(conn, cancel);
+        cmd("CompleteCreate", NULL);
+        pump(300);
+        g_assert_cmpint(count("connect"), ==, 0);
+        g_assert_cmpint(count("delete"), ==, 1);
+        g_assert_cmpuint(up_count, ==, 0);
+    } else if (g_str_equal(scenario, "stale-address")) {
+        wait_count("connect", 1);
+        cmd("StaleAddress", NULL);
+        pump(100);
+        g_assert_cmpuint(up_count, ==, 0);
+        cmd("CompleteConnect", NULL);
+        wait_count("up", 1);
+        pump(50);
+        g_assert_cmpuint(up_count, ==, 1);
+    } else if (g_str_equal(scenario, "cancel-connect")) {
+        wait_count("connect", 1);
+        stop(conn, cancel);
+        cmd("CompleteConnect", NULL);
+        pump(300);
+        g_assert_cmpint(count("connect"), ==, 1);
+        g_assert_cmpint(count("disconnect"), >=, 1);
+        g_assert_cmpuint(up_count, ==, 0);
+    } else if (g_str_equal(scenario, "retired-late-connected")) {
+        wait_count("connect", 1);
+        pump(20);
+        stop(conn, cancel);
+        pump(50);
+        gint disconnected = count("disconnect");
+        cmd("LateConnected", NULL);
+        pump(200);
+        g_assert_cmpint(count("disconnect"), >, disconnected);
+        g_assert_cmpint(count("connect"), ==, 1);
+        g_assert_cmpuint(up_count, ==, 0);
+    } else if (g_str_equal(scenario, "retry-success")) {
+        wait_count("up", 1);
+        pump(200);
+        g_assert_cmpint(count("connect"), ==, 3);
+        g_assert_cmpuint(up_count, ==, 1);
+        g_assert_cmpuint(error_count, ==, 0);
+    } else if (g_str_equal(scenario, "retry-exhausted")) {
+        wait_count("connect", 3);
+        pump(500);
+        g_assert_cmpint(count("connect"), ==, 3);
+        g_assert_cmpuint(error_count, ==, 1);
+        g_assert_cmpuint(up_count, ==, 0);
+    } else if (g_str_equal(scenario, "retry-stop")) {
+        wait_count("connect", 1);
+        stop(conn, cancel);
+        pump(500);
+        g_assert_cmpint(count("connect"), ==, 1);
+        g_assert_cmpuint(up_count, ==, 0);
+    } else if (g_str_equal(scenario, "owner-replacement")) {
+        wait_count("create", 1);
+        GVariant *owner_reply = g_dbus_connection_call_sync(control, "org.freedesktop.DBus",
+            "/org/freedesktop/DBus", "org.freedesktop.DBus", "GetNameOwner",
+            g_variant_new("(s)", "org.freedesktop.ModemManager1"), NULL,
+            G_DBUS_CALL_FLAGS_NONE, 3000, NULL, &error);
+        g_assert_no_error(error);
+        gchar *old_owner = NULL;
+        g_variant_get(owner_reply, "(s)", &old_owner);
+        g_variant_unref(owner_reply);
+        cmd("ReleaseName", NULL);
+        pump(100);
+        GPid replacement;
+        g_assert_true(g_spawn_async(NULL, child_argv, NULL, G_SPAWN_DO_NOT_REAP_CHILD, NULL, NULL, &replacement, &error));
+        g_assert_no_error(error);
+        gboolean appeared = FALSE;
+        for (guint i = 0; i < 200 && !appeared; i++) {
+            GVariant *reply = g_dbus_connection_call_sync(control, "org.freedesktop.DBus",
+                "/org/freedesktop/DBus", "org.freedesktop.DBus", "NameHasOwner",
+                g_variant_new("(s)", "org.freedesktop.ModemManager1"), NULL,
+                G_DBUS_CALL_FLAGS_NONE, 3000, NULL, &error);
+            g_assert_no_error(error);
+            g_variant_get(reply, "(b)", &appeared);
+            g_variant_unref(reply);
+            if (!appeared) pump(10);
+        }
+        g_assert_true(appeared);
+        cmd("SetState", g_variant_new("(i)", MM_MODEM_STATE_REGISTERED));
+        pump(100);
+        GCancellable *next_cancel = g_cancellable_new();
+        QVDConnection *next = request(modem, next_cancel);
+        wait_count("up", 1);
+        pump(50);
+        /* Both instances allocated Bearer/0. Deliver the OLD owner's reply
+         * only after the NEW owner has connected that same public path. */
+        GVariant *late = g_dbus_connection_call_sync(control, old_owner,
+            "/org/freedesktop/ModemManager1", "org.example.TestModem", "CompleteCreate",
+            NULL, NULL, G_DBUS_CALL_FLAGS_NONE, 3000, NULL, &error);
+        g_assert_no_error(error);
+        g_variant_unref(late);
+        pump(200);
+        g_assert_cmpint(count("create"), ==, 1);
+        g_assert_cmpint(count("connect"), ==, 1);
+        g_assert_cmpint(count("delete"), ==, 0);
+        g_assert_cmpint(count("disconnect"), ==, 0);
+        g_assert_cmpuint(up_count, ==, 1);
+        stop(next, next_cancel);
+        pump(50);
+        g_object_unref(next);
+        g_object_unref(next_cancel);
+        late = g_dbus_connection_call_sync(control, old_owner,
+            "/org/freedesktop/ModemManager1", "org.example.TestModem", "Quit",
+            NULL, NULL, G_DBUS_CALL_FLAGS_NONE, 3000, NULL, &error);
+        g_assert_no_error(error);
+        g_variant_unref(late);
+        g_free(old_owner);
+        g_spawn_close_pid(replacement);
+    } else if (g_str_equal(scenario, "remove-create")) {
+        wait_count("create", 1);
+        cmd("RemoveModem", NULL);
+        pump(100);
+        cmd("AddModem", g_variant_new("(i)", MM_MODEM_STATE_REGISTERED));
+        cmd("CompleteCreate", NULL);
+        pump(300);
+        g_assert_cmpint(count("connect"), ==, 0);
+        g_assert_cmpuint(up_count, ==, 0);
+    } else {
+        g_error("unknown scenario: %s", scenario);
+    }
+    stop(conn, cancel);
+    pump(50);
+    g_object_unref(conn);
+    g_object_unref(cancel);
+    g_object_unref(modem);
+    pump(50);
+    cmd("Quit", NULL);
+    g_object_unref(control);
+    g_spawn_close_pid(child);
+    g_test_dbus_down(bus);
+    g_object_unref(bus);
+    g_print("PASS: %s\n", scenario);
+    return 0;
+}
