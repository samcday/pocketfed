+    g_assert_cmpuint (fixture->osk->swipe_points->len, >, 1);
+    g_assert_false (pos_osk_widget_swipe_in_progress (fixture->osk));
+    g_assert_cmpuint (g_variant_n_children (fixture->keys), ==, 26);
+    for (guint i = 0; i < 26; i++) {
