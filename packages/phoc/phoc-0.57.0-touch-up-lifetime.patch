From: Sam Day <me@samcday.com>
Subject: [PATCH] cursor: Look up touch point after dispatching release gestures

A touch-end gesture callback can cancel the client's touch sequence and
free its wlroots touch points. Do not retain a point across gesture
handling: look it up afterwards so a cancelled sequence returns before
reading the freed point's surface.

Add a real client regression covering normal release, cancellation during
release, and cancellation before release. Check client events and cleanup,
including an unrelated release while a touch remains active.

Related: https://gitlab.gnome.org/World/Phosh/phoc/-/issues/408
---
diff --git a/src/cursor.c b/src/cursor.c
--- a/src/cursor.c
+++ b/src/cursor.c
@@ -1600,7 +1600,7 @@
 phoc_cursor_handle_touch_up (PhocCursor                *self,
                              struct wlr_touch_up_event *event)
 {
-  struct wlr_touch_point *point = wlr_seat_touch_get_point (self->seat->seat, event->touch_id);
+  struct wlr_touch_point *point;
   PhocTouchPoint *touch_point;
   PhocCursorPrivate *priv = phoc_cursor_get_instance_private (self);
 
@@ -1618,7 +1618,8 @@
   if (self->seat->touch_id == event->touch_id)
     self->seat->touch_id = -1;
 
-  /* If the gesture got canceled don't notify any clients */
+  /* Gesture handlers can cancel the touch and destroy the seat's touch point. */
+  point = wlr_seat_touch_get_point (self->seat->seat, event->touch_id);
   if (!point)
     return;
 
diff --git a/tests/meson.build b/tests/meson.build
--- a/tests/meson.build
+++ b/tests/meson.build
@@ -36,6 +36,7 @@
 tests = [
   'client',
   'color-rect',
+  'cursor',
   'keybindings',
   'layer-shell',
   'layer-shell-effects',
diff --git a/tests/test-cursor.c b/tests/test-cursor.c
new file mode 100644
--- /dev/null
+++ b/tests/test-cursor.c
@@ -0,0 +1,275 @@
+/*
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#include "cursor.h"
+#include "gesture-drag.h"
+#include "testlib-layer-shell.h"
+
+#include <wlr/interfaces/wlr_touch.h>
+
+#define TOUCH_ID 1
+
+typedef enum {
+  TOUCH_UP_NORMAL,
+  TOUCH_UP_CANCEL_ON_END,
+  TOUCH_UP_CANCEL_BEFORE_END,
+} TouchUpMode;
+
+
+typedef struct {
+  TouchUpMode mode;
+  PhocSeat *seat;
+  struct wlr_touch device;
+  struct wl_seat *client_seat;
+  guint down_count;
+  guint up_count;
+  guint cancel_count;
+  guint gesture_end_count;
+  gint done;
+} TouchUpTest;
+
+
+static void
+on_touch_down (void *data, struct wl_touch *touch, uint32_t serial, uint32_t time,
+               struct wl_surface *surface, int32_t id, wl_fixed_t x, wl_fixed_t y)
+{
+  TouchUpTest *test = data;
+
+  g_assert_cmpint (id, ==, TOUCH_ID);
+  test->down_count++;
+}
+
+
+static void
+on_touch_up (void *data, struct wl_touch *touch, uint32_t serial, uint32_t time, int32_t id)
+{
+  TouchUpTest *test = data;
+
+  g_assert_cmpint (id, ==, TOUCH_ID);
+  test->up_count++;
+}
+
+
+static void
+on_touch_motion (void *data, struct wl_touch *touch, uint32_t time, int32_t id,
+                 wl_fixed_t x, wl_fixed_t y)
+{
+  g_assert_not_reached ();
+}
+
+
+static void
+on_touch_frame (void *data, struct wl_touch *touch)
+{
+}
+
+
+static void
+on_touch_cancel (void *data, struct wl_touch *touch)
+{
+  TouchUpTest *test = data;
+
+  test->cancel_count++;
+}
+
+
+static const struct wl_touch_listener touch_listener = {
+  .down = on_touch_down,
+  .up = on_touch_up,
+  .motion = on_touch_motion,
+  .frame = on_touch_frame,
+  .cancel = on_touch_cancel,
+};
+
+
+static void
+on_seat_capabilities (void *data, struct wl_seat *seat, uint32_t capabilities)
+{
+}
+
+
+static const struct wl_seat_listener seat_listener = {
+  .capabilities = on_seat_capabilities,
+};
+
+
+static void
+on_registry_global (void *data, struct wl_registry *registry, uint32_t name,
+                     const char *interface, uint32_t version)
+{
+  TouchUpTest *test = data;
+
+  if (g_str_equal (interface, wl_seat_interface.name)) {
+    test->client_seat = wl_registry_bind (registry, name, &wl_seat_interface, 1);
+    wl_seat_add_listener (test->client_seat, &seat_listener, test);
+  }
+}
+
+
+static void
+on_registry_global_remove (void *data, struct wl_registry *registry, uint32_t name)
+{
+}
+
+
+static const struct wl_registry_listener registry_listener = {
+  .global = on_registry_global,
+  .global_remove = on_registry_global_remove,
+};
+
+
+static void
+cancel_touch (TouchUpTest *test)
+{
+  struct wlr_touch_point *point = wlr_seat_touch_get_point (test->seat->seat, TOUCH_ID);
+
+  g_assert_nonnull (point);
+  wlr_seat_touch_notify_cancel (test->seat->seat, point->client);
+  g_assert_null (wlr_seat_touch_get_point (test->seat->seat, TOUCH_ID));
+}
+
+
+static void
+on_gesture_end (PhocGesture *gesture, PhocEventSequence *sequence, TouchUpTest *test)
+{
+  test->gesture_end_count++;
+
+  /* Like the shell's swipe handler, cancel synchronously during TOUCH_END. */
+  if (test->mode == TOUCH_UP_CANCEL_ON_END)
+    cancel_touch (test);
+}
+
+
+static gboolean
+inject_touch (gpointer data)
+{
+  TouchUpTest *test = data;
+  PhocCursor *cursor = phoc_seat_get_cursor (test->seat);
+  struct wlr_touch_down_event down = {
+    .touch = &test->device,
+    .time_msec = 100,
+    .touch_id = TOUCH_ID,
+    .x = 0.5,
+    .y = 0.5,
+  };
+  struct wlr_touch_up_event up = {
+    .touch = &test->device,
+    .time_msec = 110,
+    .touch_id = TOUCH_ID,
+  };
+
+  phoc_cursor_handle_touch_down (cursor, &down);
+  g_assert_nonnull (wlr_seat_touch_get_point (test->seat->seat, TOUCH_ID));
+  g_assert_cmpuint (g_hash_table_size (phoc_cursor_get_touch_points (cursor)), ==, 1);
+  g_assert_cmpint (test->seat->touch_id, ==, TOUCH_ID);
+
+  /* An unknown release must leave the active touch intact. */
+  up.touch_id = TOUCH_ID + 1;
+  phoc_cursor_handle_touch_up (cursor, &up);
+  g_assert_nonnull (wlr_seat_touch_get_point (test->seat->seat, TOUCH_ID));
+  g_assert_cmpint (test->seat->touch_id, ==, TOUCH_ID);
+  g_assert_cmpuint (test->gesture_end_count, ==, 0);
+
+  if (test->mode == TOUCH_UP_CANCEL_BEFORE_END)
+    cancel_touch (test);
+
+  up.touch_id = TOUCH_ID;
+  phoc_cursor_handle_touch_up (cursor, &up);
+  g_assert_null (wlr_seat_touch_get_point (test->seat->seat, TOUCH_ID));
+  g_assert_cmpuint (g_hash_table_size (phoc_cursor_get_touch_points (cursor)), ==, 0);
+  g_assert_cmpint (test->seat->touch_id, ==, -1);
+  g_assert_cmpuint (test->gesture_end_count, ==, 1);
+
+  wlr_touch_finish (&test->device);
+  g_atomic_int_set (&test->done, TRUE);
+  return G_SOURCE_REMOVE;
+}
+
+
+static gboolean
+prepare_touch (PhocServer *server, gpointer data)
+{
+  TouchUpTest *test = data;
+  g_autoptr (PhocGestureDrag) gesture = phoc_gesture_drag_new ();
+  static const struct wlr_touch_impl touch_impl = { .name = "test-touch" };
+
+  test->seat = phoc_input_get_seat (phoc_server_get_input (server), "seat0");
+  wlr_touch_init (&test->device, &touch_impl, "test-touch");
+  phoc_seat_add_device (test->seat, &test->device.base);
+  g_signal_connect (gesture, "end", G_CALLBACK (on_gesture_end), test);
+  phoc_cursor_add_gesture (phoc_seat_get_cursor (test->seat), PHOC_GESTURE (gesture));
+
+  return TRUE;
+}
+
+
+static gboolean
+run_touch_client (PhocTestClientGlobals *globals, gpointer data)
+{
+  TouchUpTest *test = data;
+  PhocTestLayerSurface *surface;
+  struct wl_registry *registry;
+  struct wl_touch *touch;
+
+  registry = wl_display_get_registry (globals->display);
+  wl_registry_add_listener (registry, &registry_listener, test);
+  wl_display_roundtrip (globals->display);
+  g_assert_nonnull (test->client_seat);
+  touch = wl_seat_get_touch (test->client_seat);
+  wl_touch_add_listener (touch, &touch_listener, test);
+
+  surface = phoc_test_layer_surface_new (globals, 200, 200, 0xFF00FF00,
+                                          ZWLR_LAYER_SURFACE_V1_ANCHOR_TOP |
+                                          ZWLR_LAYER_SURFACE_V1_ANCHOR_LEFT, 0);
+  wl_display_roundtrip (globals->display);
+
+  g_idle_add (inject_touch, test);
+  while (!g_atomic_int_get (&test->done))
+    g_assert_cmpint (wl_display_roundtrip (globals->display), >=, 0);
+  /* Receive all events queued by the server callback. */
+  wl_display_roundtrip (globals->display);
+
+  g_assert_cmpuint (test->down_count, ==, 1);
+  g_assert_cmpuint (test->up_count, ==, test->mode == TOUCH_UP_NORMAL ? 1 : 0);
+  g_assert_cmpuint (test->cancel_count, ==, test->mode == TOUCH_UP_NORMAL ? 0 : 1);
+
+  phoc_test_layer_surface_free (surface);
+  wl_touch_destroy (touch);
+  wl_seat_destroy (test->client_seat);
+  wl_registry_destroy (registry);
+  return TRUE;
+}
+
+
+static void
+test_touch_up (PhocTestFixture *fixture, gconstpointer data)
+{
+  TouchUpTest test = { .mode = GPOINTER_TO_INT (data) };
+  PhocTestClientIface iface = {
+    .server_prepare = prepare_touch,
+    .client_run = run_touch_client,
+    .output_config = { .width = 200, .height = 200, .scale = 1.0 },
+  };
+
+  phoc_test_client_run (TEST_PHOC_CLIENT_TIMEOUT, &iface, &test);
+}
+
+
+int
+main (int argc, char *argv[])
+{
+  g_test_init (&argc, &argv, NULL);
+
+  g_test_add ("/phoc/cursor/touch-up/normal", PhocTestFixture,
+               GINT_TO_POINTER (TOUCH_UP_NORMAL),
+               phoc_test_setup, test_touch_up, phoc_test_teardown);
+  g_test_add ("/phoc/cursor/touch-up/cancel-on-end", PhocTestFixture,
+               GINT_TO_POINTER (TOUCH_UP_CANCEL_ON_END),
+               phoc_test_setup, test_touch_up, phoc_test_teardown);
+  g_test_add ("/phoc/cursor/touch-up/cancel-before-end", PhocTestFixture,
+               GINT_TO_POINTER (TOUCH_UP_CANCEL_BEFORE_END),
+               phoc_test_setup, test_touch_up, phoc_test_teardown);
+
+  return g_test_run ();
+}
