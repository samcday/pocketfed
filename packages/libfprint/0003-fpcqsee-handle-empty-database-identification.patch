 static void
+empty_database (void)
+{
+  memset (&state, 0, sizeof state);
+  state.empty_database = TRUE; state.identify_command = -208;
+  FpDevice *device = new_device ();
+  g_autoptr(GPtrArray) gallery = g_ptr_array_new_with_free_func (g_object_unref);
+  g_autoptr(GError) error = NULL;
+  FpPrint *matched = NULL, *scanned = NULL;
+  g_assert_true (fp_device_identify_sync (device, gallery, NULL, NULL, NULL, &matched, &scanned, &error));
+  g_assert_no_error (error); g_assert_null (matched); g_assert_null (scanned);
+  g_assert_cmpuint (state.identifies, ==, 0);
+  g_assert_cmpuint (state.waits, ==, 0);
+  state.list_command = -208;
+  g_assert_false (fp_device_identify_sync (device, gallery, NULL, NULL, NULL, &matched, &scanned, &error));
+  g_assert_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_GENERAL);
+  g_assert_cmpuint (state.identifies, ==, 0);
+  g_assert_null (matched); g_assert_null (scanned);
+  close_device (device);
+}
