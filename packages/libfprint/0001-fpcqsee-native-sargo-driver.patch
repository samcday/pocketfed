diff --git a/tests/fpc-auth-client.c b/tests/fpc-auth-client.c
new file mode 100644
index 0000000..06f2db5
--- /dev/null
+++ b/tests/fpc-auth-client.c
@@ -0,0 +1,172 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Synthetic broker fixtures only. This test never opens a device or real
+ * socket, and no test token reaches a trusted application or fprintd. */
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+#include "drivers/fpcqsee/auth-client.h"
+#include "drivers/fpcqsee/protocol.h"
+#include <errno.h>
+#include <poll.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+static struct fpc_auth_response response;
+static struct fpc_auth_request received;
+static size_t sent, read_bytes;
+static guint32 peer_uid;
+static gboolean unavailable, timeout, truncated, closed;
+static gint64 clock_us;
+
+int __wrap_socket (int domain, int type, int protocol);
+int __wrap_connect (int fd, const struct sockaddr *address, socklen_t len);
+int __wrap_getsockopt (int fd, int level, int option, void *value, socklen_t *len);
+int __wrap_poll (struct pollfd *fds, nfds_t count, int millis);
+ssize_t __wrap_send (int fd, const void *data, size_t len, int flags);
+ssize_t __wrap_recv (int fd, void *data, size_t len, int flags);
+int __wrap_close (int fd);
+gint64 __wrap_g_get_monotonic_time (void);
+
+int __wrap_socket (int domain, int type, int protocol)
+{
+  g_assert_cmpint (domain, ==, AF_UNIX);
+  g_assert_cmpint (type, ==, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC);
+  g_assert_cmpint (protocol, ==, 0);
+  return 71;
+}
+int __wrap_connect (int fd, const struct sockaddr *address, socklen_t len)
+{
+  const struct sockaddr_un *un = (const void *) address;
+  g_assert_cmpint (fd, ==, 71);
+  g_assert_cmpint (len, ==, sizeof *un);
+  g_assert_cmpstr (un->sun_path, ==, FPC_AUTH_SOCKET_PATH);
+  if (unavailable) { errno = ENOENT; return -1; }
+  errno = EINPROGRESS;
+  return -1;
+}
+int __wrap_getsockopt (int fd, int level, int option, void *value, socklen_t *len)
+{
+  g_assert_cmpint (fd, ==, 71);
+  g_assert_cmpint (level, ==, SOL_SOCKET);
+  if (option == SO_ERROR)
+    { g_assert_cmpint (*len, ==, sizeof (int)); *(int *) value = 0; }
+  else
+    {
+      struct ucred *cred = value;
+      g_assert_cmpint (option, ==, SO_PEERCRED);
+      g_assert_cmpint (*len, ==, sizeof *cred);
+      *cred = (struct ucred) { .uid = peer_uid };
+    }
+  return 0;
+}
+int __wrap_poll (struct pollfd *fds, nfds_t count, int millis)
+{
+  g_assert_cmpint (count, ==, 1);
+  g_assert_cmpint (fds[0].fd, ==, 71);
+  if (timeout) { clock_us += millis * 1000; return 0; }
+  fds[0].revents = fds[0].events;
+  return 1;
+}
+ssize_t __wrap_send (int fd, const void *data, size_t len, int flags)
+{
+  g_assert_cmpint (fd, ==, 71);
+  g_assert_cmpint (flags, ==, MSG_NOSIGNAL);
+  g_assert_cmpuint (sent + len, ==, sizeof received);
+  len = MIN (len, 5);
+  memcpy ((guint8 *) &received + sent, data, len);
+  sent += len;
+  return len;
+}
+ssize_t __wrap_recv (int fd, void *data, size_t len, int flags)
+{
+  g_assert_cmpint (fd, ==, 71);
+  g_assert_cmpint (flags, ==, 0);
+  if (truncated && read_bytes >= 13) return 0;
+  g_assert_cmpuint (read_bytes + len, ==, sizeof response);
+  len = MIN (len, 13);
+  memcpy (data, (guint8 *) &response + read_bytes, len);
+  read_bytes += len;
+  return len;
+}
+int __wrap_close (int fd) { g_assert_cmpint (fd, ==, 71); closed = TRUE; return 0; }
+gint64 __wrap_g_get_monotonic_time (void) { return clock_us; }
+
+static void
+reset (void)
+{
+  memset (&response, 0, sizeof response);
+  memset (&received, 0, sizeof received);
+  /* Deliberately synthetic signature: only transport framing is under test. */
+  memset (response.token + 37, 0x55, 32);
+  fpc_put_le64 (response.token + 1, UINT64_C (0x0123456789abcdef));
+  sent = read_bytes = 0;
+  peer_uid = 0;
+  clock_us = 0;
+  unavailable = timeout = truncated = closed = FALSE;
+}
+
+static void
+expect_failure (GCancellable *cancel, GIOErrorEnum code)
+{
+  guint8 hat[FPC_HAT_SIZE];
+  g_autoptr(GError) error = NULL;
+  memset (hat, 0xaa, sizeof hat);
+  g_assert_false (fpc_auth_client_get_token (1000, UINT64_C (0x0123456789abcdef),
+                                             hat, cancel, &error));
+  g_assert_error (error, G_IO_ERROR, code);
+  for (size_t i = 0; i < sizeof hat; i++) g_assert_cmpuint (hat[i], ==, 0);
+}
+
+static void
+wire (void)
+{
+  guint8 hat[FPC_HAT_SIZE];
+  g_autoptr(GError) error = NULL;
+  static const guint8 expected[20] = {
+    'F', 'P', 'C', 'A', 1, 0, 0, 0, 0xe8, 3, 0, 0,
+    0xef, 0xcd, 0xab, 0x89, 0x67, 0x45, 0x23, 1,
+  };
+  reset ();
+  g_assert_true (fpc_auth_client_get_token (1000, UINT64_C (0x0123456789abcdef), hat, NULL, &error));
+  g_assert_no_error (error);
+  g_assert_cmpmem (&received, sizeof received, expected, sizeof expected);
+  g_assert_cmpmem (hat, sizeof hat, response.token, sizeof response.token);
+  g_assert_true (closed);
+}
+
+static void
+reject (void)
+{
+  reset (); unavailable = TRUE;
+  expect_failure (NULL, G_IO_ERROR_NOT_FOUND);
+  g_assert_true (closed);
+  reset (); peer_uid = 1000;
+  expect_failure (NULL, G_IO_ERROR_PERMISSION_DENIED);
+  g_assert_cmpuint (sent, ==, 0);
+  reset (); response.token[0] = 1;
+  expect_failure (NULL, G_IO_ERROR_INVALID_DATA);
+  reset (); response.token[1] ^= 1;
+  expect_failure (NULL, G_IO_ERROR_INVALID_DATA);
+  reset (); fpc_put_le32 (response.status_le, (guint32) -EACCES);
+  expect_failure (NULL, G_IO_ERROR_PERMISSION_DENIED);
+  reset (); truncated = TRUE;
+  expect_failure (NULL, G_IO_ERROR_FAILED);
+  reset (); timeout = TRUE;
+  expect_failure (NULL, G_IO_ERROR_TIMED_OUT);
+  g_assert_cmpint (clock_us, <=, FPC_AUTH_TIMEOUT_MS * 1000);
+  reset ();
+  g_autoptr(GCancellable) cancel = g_cancellable_new ();
+  g_cancellable_cancel (cancel);
+  expect_failure (cancel, G_IO_ERROR_CANCELLED);
+  g_assert_cmpuint (sent, ==, 0);
+}
+
+int main (int argc, char **argv)
+{
+  g_test_init (&argc, &argv, NULL);
+  g_test_add_func ("/fpc-auth/wire-and-partial-io", wire);
+  g_test_add_func ("/fpc-auth/reject-invalid-untrusted-timeout-cancel", reject);
+  return g_test_run ();
+}
diff --git a/tests/fpc-driver.c b/tests/fpc-driver.c
new file mode 100644
index 0000000..529e84e
--- /dev/null
+++ b/tests/fpc-driver.c
@@ -0,0 +1,259 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Isolated libfprint API tests using injected protocol and compile-time renamed
+ * test-only sensor / broker boundaries. No real device, credential, token, or
+ * daemon is accessed, including under LTO. Production objects are unchanged. */
+#define FP_COMPONENT "fpcqsee-test"
+#include "drivers_api.h"
+#include "drivers/fpcqsee/fpc-qsee.h"
+#include "drivers/fpcqsee/auth-client.h"
+#include <errno.h>
+#include <string.h>
+
+struct fixture {
+  guint32 identify_id, decision;
+  gint identify_transport, identify_outer, identify_command, capture_status;
+  gboolean broker_missing, store_failure;
+  guint samples, begins, finishes, stores, calls, wakes, waits;
+  guint sensor_commands[64], sensor_count;
+  GCancellable *cancel_during_identify;
+};
+static struct fixture state;
+
+int fpc_sensor_open (struct fpc_sensor_device *sensor, const char *path)
+{ (void) sensor; (void) path; g_assert_not_reached (); return -ENODEV; }
+void fpc_sensor_close (struct fpc_sensor_device *sensor)
+{ g_assert_cmpint (sensor->fd, ==, -1); }
+int fpc_sensor_reset (struct fpc_sensor_device *sensor)
+{ (void) sensor; g_assert_not_reached (); return -ENODEV; }
+int fpc_sensor_wakeup (struct fpc_sensor_device *sensor, bool enable)
+{ (void) sensor; (void) enable; state.wakes++; return 0; }
+int fpc_sensor_wait_high (struct fpc_sensor_device *sensor, int timeout_ms, int cancel_fd)
+{ (void) sensor; (void) timeout_ms; (void) cancel_fd; state.waits++; return 1; }
+int fpc_qsee_open (struct fpc_qsee_session *session, const char *app_name)
+{ (void) session; (void) app_name; g_assert_not_reached (); return -ENODEV; }
+void fpc_qsee_close (struct fpc_qsee_session *session)
+{ g_assert_cmpint (session->fd, ==, -1); session->opened = FALSE; }
+int fpc_qsee_command (void *context, void *command, size_t command_len, int32_t *outer_status)
+{
+  (void) context; (void) command; (void) command_len; (void) outer_status;
+  g_assert_not_reached (); return -ENODEV;
+}
+int fpc_qsee_exchange (struct fpc_qsee_session *session, const void *request, size_t request_len,
+                       void *response, size_t response_len, void *auxiliary,
+                       size_t auxiliary_len, uint32_t pointer_offset)
+{
+  (void) session; (void) request; (void) request_len; (void) response; (void) response_len;
+  (void) auxiliary; (void) auxiliary_len; (void) pointer_offset;
+  g_assert_not_reached (); return -ENODEV;
+}
+gboolean fpc_auth_client_get_token (guint32 uid, guint64 challenge, guint8 hat[69],
+                                   GCancellable *cancel, GError **error)
+{
+  (void) uid; (void) cancel;
+  memset (hat, 0, 69);
+  if (state.broker_missing)
+    { g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_NOT_FOUND, "Synthetic broker absent"); return FALSE; }
+  /* Test-only framing fixture. The injected TA below does no cryptography. */
+  fpc_put_le64 (hat + 1, challenge);
+  return TRUE;
+}
+
+static int
+exchange (void *ctx, void *aux, size_t len, int32_t *outer)
+{
+  struct fixture *s = ctx;
+  guint8 *b = aux;
+  guint target = fpc_get_le32 (b), command = fpc_get_le32 (b + 4);
+  g_assert_cmpuint (len, >=, 12);
+  s->calls++;
+  *outer = 0;
+  fpc_put_le32 (b + 8, 0);
+  if (target == FPC_TARGET_SENSOR)
+    {
+      g_assert_cmpuint (s->sensor_count, <, G_N_ELEMENTS (s->sensor_commands));
+      s->sensor_commands[s->sensor_count++] = command;
+      if (command == FPC_SENSOR_QUALIFY_CAPTURE) fpc_put_le32 (b + 8, s->capture_status);
+    }
+  else if (target == FPC_TARGET_AUTH)
+    {
+      if (command == FPC_AUTH_GET_ENROL_CHALLENGE) fpc_put_le64 (b + 16, 100);
+      if (command == FPC_AUTH_CHECK_ENROL_TIMEOUT) fpc_put_le32 (b + 20, 0);
+    }
+  else if (target == FPC_TARGET_BIO)
+    {
+      switch (command)
+        {
+        case FPC_BIO_IDENTIFY:
+          if (s->cancel_during_identify) g_cancellable_cancel (s->cancel_during_identify);
+          *outer = s->identify_outer;
+          fpc_put_le32 (b + 8, s->identify_command);
+          fpc_put_le32 (b + 12, s->identify_id);
+          fpc_put_le32 (b + 28, s->decision);
+          return s->identify_transport;
+        case FPC_BIO_GET_TEMPLATE_IDS:
+          fpc_put_le32 (b + 12, 1);
+          fpc_put_le32 (b + 16, 42);
+          break;
+        case FPC_BIO_BEGIN_ENROL: s->begins++; break;
+        case FPC_BIO_ENROL:
+          if (!s->samples++) { fpc_put_le32 (b + 8, 0x10f); fpc_put_le32 (b + 12, 1); }
+          else fpc_put_le32 (b + 12, 0);
+          break;
+        case FPC_BIO_END_ENROL: s->finishes++; fpc_put_le32 (b + 12, 99); break;
+        default: break;
+        }
+    }
+  else if (target == FPC_TARGET_FS && command == 12)
+    { s->stores++; if (s->store_failure) fpc_put_le32 (b + 8, (guint32) -206); }
+  return 0;
+}
+
+static void fake_open (FpDevice *device) { fpi_device_open_complete (device, NULL); }
+static void fake_close (FpDevice *device) { fpi_device_close_complete (device, NULL); }
+
+static FpDevice *
+new_device (void)
+{
+  g_autoptr(GError) error = NULL;
+  FpiDeviceFpcQsee *self = g_object_new (fpi_device_fpcqsee_get_type (), NULL);
+  FpDeviceClass *klass = FP_DEVICE_GET_CLASS (self);
+  /* Keep real action workers, replace only hardware opening in this process. */
+  klass->open = fake_open;
+  klass->close = fake_close;
+  self->protocol = (struct fpc_protocol) { &state, exchange };
+  self->qsee.opened = TRUE;
+  g_assert_true (fp_device_open_sync (FP_DEVICE (self), NULL, &error));
+  g_assert_no_error (error);
+  return FP_DEVICE (self);
+}
+
+static FpPrint *
+make_print (FpDevice *device, guint profile, guint group, guint id)
+{
+  FpPrint *print = g_object_ref_sink (fp_print_new (device));
+  fpi_print_set_type (print, FPI_PRINT_RAW);
+  fpi_print_set_device_stored (print, TRUE);
+  g_object_set (print, "fpi-data", g_variant_new ("(uuu)", profile, group, id), NULL);
+  return print;
+}
+
+static void
+close_device (FpDevice *device)
+{
+  g_autoptr(GError) error = NULL;
+  g_assert_true (fp_device_close_sync (device, NULL, &error));
+  g_assert_no_error (error);
+  FPI_DEVICE_FPCQSEE (device)->qsee.opened = FALSE;
+  g_object_unref (device);
+}
+
+static void
+verify_gallery (void)
+{
+  memset (&state, 0, sizeof state);
+  state.identify_id = 42; state.decision = 1;
+  FpDevice *device = new_device ();
+  g_autoptr(FpPrint) wanted = make_print (device, 1, 1, 42);
+  g_autoptr(FpPrint) other = make_print (device, 1, 1, 43);
+  g_autoptr(GError) error = NULL;
+  gboolean matched = FALSE;
+  g_assert_true (fp_device_verify_sync (device, wanted, NULL, NULL, NULL, &matched, NULL, &error));
+  g_assert_no_error (error); g_assert_true (matched);
+  g_assert_cmpuint (state.wakes, ==, 2);
+  g_assert_cmpuint (state.waits, ==, 2);
+  static const guint sequence[] = {2, 1, 3, 4, 5};
+  g_assert_cmpmem (state.sensor_commands, sizeof sequence, sequence, sizeof sequence);
+  g_assert_true (fp_device_verify_sync (device, other, NULL, NULL, NULL, &matched, NULL, &error));
+  g_assert_no_error (error); g_assert_false (matched);
+  state.decision = 0;
+  g_assert_true (fp_device_verify_sync (device, wanted, NULL, NULL, NULL, &matched, NULL, &error));
+  g_assert_no_error (error); g_assert_false (matched);
+  state.decision = 1; state.identify_id = 0;
+  g_assert_true (fp_device_verify_sync (device, wanted, NULL, NULL, NULL, &matched, NULL, &error));
+  g_assert_no_error (error); g_assert_false (matched);
+  state.identify_id = 42; state.identify_transport = -EIO;
+  g_assert_false (fp_device_verify_sync (device, wanted, NULL, NULL, NULL, &matched, NULL, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_FAILED); g_clear_error (&error);
+  g_assert_false (matched);
+  state.identify_transport = 0; state.identify_outer = -201;
+  g_assert_false (fp_device_verify_sync (device, wanted, NULL, NULL, NULL, &matched, NULL, &error));
+  g_assert_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_GENERAL); g_clear_error (&error);
+  state.identify_outer = 0; state.capture_status = 0x105;
+  g_assert_false (fp_device_verify_sync (device, wanted, NULL, NULL, NULL, &matched, NULL, &error));
+  g_assert_error (error, FP_DEVICE_RETRY, FP_DEVICE_RETRY_TOO_FAST);
+  close_device (device);
+}
+
+static void
+identify_gallery (void)
+{
+  memset (&state, 0, sizeof state);
+  state.identify_id = 42; state.decision = 1;
+  FpDevice *device = new_device ();
+  g_autoptr(GPtrArray) gallery = g_ptr_array_new_with_free_func (g_object_unref);
+  g_autoptr(GError) error = NULL;
+  FpPrint *matched = NULL, *scanned = NULL;
+  g_ptr_array_add (gallery, make_print (device, 1, 1, 43));
+  g_assert_true (fp_device_identify_sync (device, gallery, NULL, NULL, NULL, &matched, &scanned, &error));
+  g_assert_no_error (error); g_assert_null (matched); g_assert_null (scanned);
+  g_ptr_array_add (gallery, make_print (device, 1, 1, 42));
+  g_assert_true (fp_device_identify_sync (device, gallery, NULL, NULL, NULL, &matched, &scanned, &error));
+  g_assert_no_error (error); g_assert_true (matched == g_ptr_array_index (gallery, 1));
+  g_assert_nonnull (scanned);
+  g_clear_object (&matched); g_clear_object (&scanned);
+  close_device (device);
+}
+
+static void
+enrollment_failures (void)
+{
+  memset (&state, 0, sizeof state);
+  state.broker_missing = TRUE;
+  FpDevice *device = new_device ();
+  g_autoptr(FpPrint) print = g_object_ref_sink (fp_print_new (device));
+  g_autoptr(GError) error = NULL;
+  fp_print_set_username (print, "root");
+  FpPrint *enrolled = fp_device_enroll_sync (device, print, NULL, NULL, NULL, &error);
+  g_assert_null (enrolled);
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_NOT_FOUND); g_clear_error (&error);
+  g_assert_cmpuint (state.begins, ==, 0);
+  g_assert_cmpuint (state.finishes, ==, 0);
+  g_assert_cmpuint (state.stores, ==, 0);
+  state.broker_missing = FALSE; state.store_failure = TRUE;
+  enrolled = fp_device_enroll_sync (device, print, NULL, NULL, NULL, &error);
+  g_assert_null (enrolled);
+  g_assert_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_GENERAL);
+  g_assert_cmpuint (state.samples, ==, 2);
+  g_assert_cmpuint (state.finishes, ==, 1);
+  g_assert_cmpuint (state.stores, ==, 1);
+  close_device (device);
+}
+
+static void
+cancel_match_race (void)
+{
+  memset (&state, 0, sizeof state);
+  state.identify_id = 42; state.decision = 1;
+  FpDevice *device = new_device ();
+  g_autoptr(FpPrint) wanted = make_print (device, 1, 1, 42);
+  g_autoptr(GCancellable) cancel = g_cancellable_new ();
+  g_autoptr(GError) error = NULL;
+  gboolean matched = TRUE;
+  FpPrint *scan = NULL;
+  state.cancel_during_identify = cancel;
+  g_assert_false (fp_device_verify_sync (device, wanted, cancel, NULL, NULL, &matched, &scan, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_CANCELLED);
+  g_assert_false (matched);
+  g_assert_null (scan);
+  close_device (device);
+}
+
+int main (int argc, char **argv)
+{
+  g_test_init (&argc, &argv, NULL);
+  g_test_add_func ("/fpc-driver/verify-capture-order-and-rejection", verify_gallery);
+  g_test_add_func ("/fpc-driver/identify-gallery-bound", identify_gallery);
+  g_test_add_func ("/fpc-driver/enroll-needs-broker-and-persistence", enrollment_failures);
+  g_test_add_func ("/fpc-driver/cancellation-wins-match-race", cancel_match_race);
+  return g_test_run ();
+}
