diff --git a/libfprint/drivers/fpcqsee/fpc-qsee.c b/libfprint/drivers/fpcqsee/fpc-qsee.c
new file mode 100644
index 0000000..ce202ea
--- /dev/null
+++ b/libfprint/drivers/fpcqsee/fpc-qsee.c
@@ -0,0 +1,772 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+#define FP_COMPONENT "fpcqsee"
+#include "drivers_api.h"
+#include "fpc-qsee.h"
+#include "auth-client.h"
+#include <errno.h>
+#include <dirent.h>
+#include <fcntl.h>
+#include <pwd.h>
+#include <string.h>
+#include <sys/file.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+/* Compatibility profile: Sargo SP2A.220505.008; see README.md. */
+#define PROFILE 1u
+#define LINUX_GROUP 1u
+#define DATABASE_PATH "pocketfed/fpc-sargo-v1.db"
+#define STATE_DIRECTORY "/var/lib/fprint/fpc-qsee"
+#define ENROLL_PROGRESS_STAGES 100
+
+enum operation { OP_OPEN, OP_CLOSE, OP_LIST, OP_DELETE, OP_CLEAR, OP_ENROLL,
+                 OP_VERIFY, OP_IDENTIFY };
+struct work {
+  enum operation operation;
+  guint32 finger;
+  gchar *username;
+  guint generation;
+  GMainContext *context;
+};
+struct result { guint32 ids[FPC_MAX_TEMPLATES], count, finger; gboolean matched; };
+struct progress {
+  FpiDeviceFpcQsee *self;
+  guint generation;
+  FpFingerStatusFlags status;
+  gint completed;
+  GError *retry;
+};
+
+G_DEFINE_TYPE (FpiDeviceFpcQsee, fpi_device_fpcqsee, FP_TYPE_DEVICE)
+
+static const FpIdEntry id_table[] = {
+  { .udev_types = FPI_DEVICE_UDEV_SUBTYPE_MISC,
+    .misc_name = "fpc1020", .misc_compatible = "google,sargo-fingerprint",
+    .driver_data = PROFILE },
+  { .udev_types = 0 }
+};
+
+static gboolean
+system_result (int rc, const char *operation, GError **error)
+{
+  if (rc >= 0) return TRUE;
+  g_set_error (error, G_IO_ERROR, g_io_error_from_errno (-rc),
+               "%s: %s", operation, g_strerror (-rc));
+  return FALSE;
+}
+
+static gboolean
+command_result (struct fpc_result r, const char *operation, GError **error)
+{
+  if (!system_result (r.transport, operation, error)) return FALSE;
+  if (!r.outer && !r.command) return TRUE;
+  g_set_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_GENERAL,
+               "%s failed (dispatcher %d, command %d)", operation, r.outer, r.command);
+  return FALSE;
+}
+
+static gboolean
+cancelled (GCancellable *cancel, GError **error)
+{
+  return g_cancellable_set_error_if_cancelled (cancel, error);
+}
+
+static void
+idle_sensor (FpiDeviceFpcQsee *self)
+{
+  if (self->qsee.opened) fpc_sensor (&self->protocol, FPC_SENSOR_DEEP_SLEEP, NULL);
+  if (self->sensor.fd >= 0) fpc_sensor_wakeup (&self->sensor, false);
+}
+
+static void
+release_device (FpiDeviceFpcQsee *self)
+{
+  idle_sensor (self);
+  fpc_qsee_close (&self->qsee);
+  fpc_sensor_close (&self->sensor);
+  if (self->lock_fd >= 0) close (self->lock_fd);
+  if (self->state_fd >= 0) close (self->state_fd);
+  self->lock_fd = self->state_fd = -1;
+  self->database_ready = FALSE;
+}
+
+static gboolean
+open_state (FpiDeviceFpcQsee *self, GError **error)
+{
+  struct stat st;
+  if (g_mkdir_with_parents (STATE_DIRECTORY, 0700))
+    return system_result (-errno, "Creating fingerprint state directory", error);
+  self->state_fd = open (STATE_DIRECTORY, O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+  if (self->state_fd < 0)
+    return system_result (-errno, "Opening fingerprint state directory", error);
+  if (fstat (self->state_fd, &st))
+    return system_result (-errno, "Checking fingerprint state directory", error);
+  if (st.st_uid != 0 || (st.st_mode & 0077))
+    { g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED,
+                           "Fingerprint state directory must be root-owned mode0700"); return FALSE; }
+  self->lock_fd = openat (self->state_fd, "device.lock", O_RDWR | O_CREAT | O_CLOEXEC | O_NOFOLLOW, 0600);
+  if (self->lock_fd < 0)
+    return system_result (-errno, "Opening fingerprint device lock", error);
+  if (fstat (self->lock_fd, &st))
+    return system_result (-errno, "Checking fingerprint device lock", error);
+  if (!S_ISREG (st.st_mode) || st.st_uid != 0 || (st.st_mode & 0077) || st.st_nlink != 1)
+    { g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED,
+                           "Fingerprint lock has unsafe ownership or permissions"); return FALSE; }
+  if (flock (self->lock_fd, LOCK_EX | LOCK_NB))
+    { g_set_error_literal (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_BUSY,
+                           "Another client owns the FPC trusted application"); return FALSE; }
+  return TRUE;
+}
+
+static gboolean
+set_group (FpiDeviceFpcQsee *self, GError **error)
+{
+  guint32 group = LINUX_GROUP;
+  return command_result (fpc_bio (&self->protocol, FPC_BIO_SET_ACTIVE_SET, &group),
+                          "Selecting Linux fingerprint group", error);
+}
+
+static gboolean
+store_database (FpiDeviceFpcQsee *self, GError **error)
+{
+  if (!command_result (fpc_database_file (&self->protocol, true, DATABASE_PATH),
+                        "Saving fingerprint database", error))
+    { self->database_ready = FALSE; return FALSE; }
+  return TRUE;
+}
+
+static gboolean
+storage_namespace_empty (GError **error)
+{
+  /* This fixed namespace is part of the packaging contract. Until this TA's
+   * FTS pathname expansion has been observed, checking only the apparent
+   * database filename would not prove that an old encrypted object is absent.
+   */
+  int fd = open ("/var/lib/qsee-supplicant", O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+  struct stat st;
+  DIR *directory;
+  gboolean empty = TRUE;
+  if (fd < 0) return system_result (-errno, "Checking QSEE storage namespace", error);
+  if (fstat (fd, &st))
+    { int saved = errno; close (fd); return system_result (-saved, "Checking QSEE storage namespace", error); }
+  if (st.st_uid != 0 || (st.st_mode & 0077))
+    { close (fd); g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED,
+                                       "QSEE storage namespace must be root-owned mode0700"); return FALSE; }
+  directory = fdopendir (fd);
+  if (!directory)
+    { int saved = errno; close (fd); return system_result (-saved, "Reading QSEE storage directory", error); }
+  errno = 0;
+  for (struct dirent *entry = readdir (directory); entry; entry = readdir (directory))
+    if (strcmp (entry->d_name, ".") && strcmp (entry->d_name, "..")) { empty = FALSE; break; }
+  int saved = errno;
+  closedir (directory);
+  if (saved) return system_result (-saved, "Reading QSEE storage directory", error);
+  if (!empty)
+    g_set_error_literal (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_DATA_INVALID,
+                          "Refusing fingerprint initialization: the QSEE storage namespace is not empty");
+  return empty;
+}
+
+static gboolean
+load_database (FpiDeviceFpcQsee *self, gboolean first_open, GError **error)
+{
+  struct fpc_result r = fpc_database_file (&self->protocol, false, DATABASE_PATH);
+  self->database_ready = FALSE;
+  if (!fpc_result_ok (r))
+    {
+      struct stat marker;
+      /* The TA conflates all open failures as +208. Never automatically
+       * replace a database because a listener/permission failure looks absent.
+       * An administrator must explicitly authorize first initialization.
+       */
+      if (!first_open || r.transport || r.outer || r.command != 208 ||
+          fstatat (self->state_fd, "initialize-empty", &marker, AT_SYMLINK_NOFOLLOW) ||
+          !S_ISREG (marker.st_mode) || marker.st_uid != 0 ||
+          (marker.st_mode & 0077) || marker.st_size || marker.st_nlink != 1)
+        {
+          if (first_open && !r.transport && !r.outer && r.command == 208)
+            g_set_error_literal (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_DATA_INVALID,
+                                  "Linux fingerprint database could not be opened; initial setup requires explicit database initialization");
+          else command_result (r, "Loading fingerprint database", error);
+          return FALSE;
+        }
+      if (!storage_namespace_empty (error)) return FALSE;
+      /* Consume before modifying the TA database, including across a crash. */
+      if (unlinkat (self->state_fd, "initialize-empty", 0) || fsync (self->state_fd))
+        return system_result (-errno, "Consuming fingerprint initialization marker", error);
+      if (!command_result (fpc_bio (&self->protocol, FPC_BIO_LOAD_EMPTY_DB, NULL),
+                            "Creating Linux fingerprint database", error) ||
+          !set_group (self, error) || !store_database (self, error)) return FALSE;
+    }
+  if (!set_group (self, error)) return FALSE;
+  self->database_ready = TRUE;
+  return TRUE;
+}
+
+static gboolean
+import_auth_key (FpiDeviceFpcQsee *self, GError **error)
+{
+  struct fpc_qsee_session keymaster = { .fd = -1 };
+  guint8 request[64], response[960] = {0};
+  const void *blob;
+  size_t size;
+  gboolean ok = FALSE;
+  int rc = fpc_qsee_open (&keymaster, FPC_KEYMASTER_APP_NAME);
+  if (!system_result (rc, "Opening resident Keymaster", error)) goto out;
+  fpc_keymaster_key_request (request);
+  rc = fpc_qsee_exchange (&keymaster, request, sizeof request, response,
+                           sizeof response, NULL, 0, 0);
+  if (!system_result (rc, "Obtaining wrapped fingerprint authentication key", error)) goto out;
+  rc = fpc_keymaster_key_response (response, sizeof response, &blob, &size);
+  if (!system_result (rc, "Checking wrapped authentication key response", error)) goto out;
+  ok = command_result (fpc_auth_import_key (&self->protocol, blob, size),
+                        "Importing fingerprint authentication key", error);
+out:
+  fpc_qsee_close (&keymaster);
+  explicit_bzero (response, sizeof response);
+  explicit_bzero (request, sizeof request);
+  return ok;
+}
+
+static gboolean
+progress_in_main (gpointer data)
+{
+  struct progress *p = data;
+  if (p->generation == p->self->generation)
+    {
+      fpi_device_report_finger_status (FP_DEVICE (p->self), p->status);
+      if (p->completed >= 0 || p->retry)
+        fpi_device_enroll_progress (FP_DEVICE (p->self), MAX (p->completed, 0),
+                                    NULL, g_steal_pointer (&p->retry));
+    }
+  return G_SOURCE_REMOVE;
+}
+
+static void
+free_progress (gpointer data)
+{
+  struct progress *p = data;
+  g_clear_error (&p->retry);
+  g_object_unref (p->self);
+  g_free (p);
+}
+
+static void
+queue_progress (FpiDeviceFpcQsee *self, struct work *work,
+                FpFingerStatusFlags status, gint completed, GError *retry)
+{
+  struct progress *p = g_new0 (struct progress, 1);
+  GSource *source = g_idle_source_new ();
+  p->self = g_object_ref (self);
+  p->generation = work->generation;
+  p->status = status;
+  p->completed = completed;
+  p->retry = retry;
+  g_source_set_priority (source, G_PRIORITY_DEFAULT);
+  g_source_set_callback (source, progress_in_main, p, free_progress);
+  g_source_attach (source, work->context);
+  g_source_unref (source);
+}
+
+static gboolean
+wait_high (FpiDeviceFpcQsee *self, gint64 deadline, GCancellable *cancel, GError **error)
+{
+  while (g_get_monotonic_time () < deadline)
+    {
+      if (cancelled (cancel, error)) return FALSE;
+      int rc = fpc_sensor_wait_high (&self->sensor, 100, -1);
+      if (!system_result (rc, "Waiting for fingerprint sensor", error)) return FALSE;
+      if (rc) return TRUE;
+    }
+  g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_TIMED_OUT, "Fingerprint operation timed out");
+  return FALSE;
+}
+
+/* Returns a positive sample-quality status, zero for a qualified image, or -1
+ * with GError. Match and enrollment decisions always require a later TA call.
+ */
+static gint
+capture (FpiDeviceFpcQsee *self, struct work *work, gint64 deadline,
+         GCancellable *cancel, GError **error)
+{
+  guint quick_retries = 0;
+  if (cancelled (cancel, error) ||
+      !system_result (fpc_sensor_wakeup (&self->sensor, true), "Enabling fingerprint wake", error)) return -1;
+  queue_progress (self, work, FP_FINGER_STATUS_NEEDED, -1, NULL);
+  if (!command_result (fpc_sensor (&self->protocol, FPC_SENSOR_FINGER_LOST_WAKEUP_SETUP, NULL),
+                        "Arming finger release", error) ||
+      !wait_high (self, deadline, cancel, error)) goto fail;
+  /* Stock uses this to clear/check the release state and ignores its boolean. */
+  struct fpc_result lost = fpc_sensor (&self->protocol, FPC_SENSOR_CHECK_FINGER_LOST, NULL);
+  if (lost.transport || lost.outer || lost.command < 0 || lost.command > 1)
+    { command_result (lost, "Checking finger release", error); goto fail; }
+  for (;;)
+    {
+      gint64 start = g_get_monotonic_time ();
+      if (cancelled (cancel, error) ||
+          !command_result (fpc_sensor (&self->protocol, FPC_SENSOR_WAKEUP_SETUP, NULL),
+                            "Arming fingerprint capture", error) ||
+          !wait_high (self, deadline, cancel, error)) goto fail;
+      queue_progress (self, work, FP_FINGER_STATUS_PRESENT, -1, NULL);
+      if (cancelled (cancel, error)) goto fail;
+      struct fpc_result r = fpc_sensor (&self->protocol, FPC_SENSOR_QUALIFY_CAPTURE, NULL);
+      if (r.transport || r.outer || r.command < 0)
+        { command_result (r, "Capturing fingerprint", error); goto fail; }
+      if (g_get_monotonic_time () - start > 500 * 1000) quick_retries = 0;
+      if (r.command == 0x107 && quick_retries++ < 3) continue;
+      if (!system_result (fpc_sensor_wakeup (&self->sensor, false), "Disabling fingerprint wake", error)) goto fail;
+      if (r.command) idle_sensor (self);
+      return r.command;
+    }
+fail:
+  idle_sensor (self);
+  return -1;
+}
+
+static GError *
+sample_retry (gint status)
+{
+  if (status == 0x105) return fpi_device_retry_new (FP_DEVICE_RETRY_TOO_FAST);
+  if (status == 0x114) return fpi_device_retry_new_msg (FP_DEVICE_RETRY_REMOVE_FINGER, "Clean the fingerprint sensor and try again");
+  return fpi_device_retry_new (FP_DEVICE_RETRY_GENERAL);
+}
+
+static gboolean
+resolve_uid (const gchar *name, guint32 *uid, GError **error)
+{
+  struct passwd pwd, *found = NULL;
+  gchar *buffer = NULL;
+  int rc = ERANGE;
+  if (!name || !*name)
+    { g_set_error_literal (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_DATA_INVALID,
+                           "Fingerprint enrollment requires a Unix username"); return FALSE; }
+  for (gsize size = 1024; size <= 1024 * 1024; size *= 2)
+    {
+      buffer = g_realloc (buffer, size);
+      rc = getpwnam_r (name, &pwd, buffer, size, &found);
+      if (rc != ERANGE) break;
+    }
+  if (rc || !found || (guint64) pwd.pw_uid >= G_MAXUINT32)
+    { g_set_error_literal (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_DATA_INVALID,
+                           "Fingerprint enrollment username has no valid Unix uid"); g_free (buffer); return FALSE; }
+  *uid = pwd.pw_uid;
+  g_free (buffer);
+  return TRUE;
+}
+
+static gboolean
+authorize_enrollment (FpiDeviceFpcQsee *self, struct work *work,
+                     GCancellable *cancel, GError **error)
+{
+  guint32 uid;
+  guint64 challenge = 0;
+  guint8 hat[FPC_HAT_SIZE] = {0};
+  gboolean ok = FALSE;
+  if (!resolve_uid (work->username, &uid, error) ||
+      !command_result (fpc_auth_challenge (&self->protocol, true, &challenge),
+                        "Requesting enrollment challenge", error) ||
+      !fpc_auth_client_get_token (uid, challenge, hat, cancel, error)) goto out;
+  ok = command_result (fpc_auth_authorize_enrol (&self->protocol, hat),
+                        "Authorizing fingerprint enrollment", error);
+out:
+  explicit_bzero (hat, sizeof hat);
+  return ok;
+}
+
+static gboolean
+interactive (FpiDeviceFpcQsee *self, struct work *work, struct result *result,
+             GCancellable *cancel, GError **error)
+{
+  gboolean enrolling = work->operation == OP_ENROLL, ok = FALSE;
+  gint64 deadline = g_get_monotonic_time () + (enrolling ? 120 : 30) * G_TIME_SPAN_SECOND;
+  guint32 baseline = 0;
+  gint completed = 0;
+  if (enrolling)
+    {
+      guint32 ids[FPC_MAX_TEMPLATES], count;
+      if (!command_result (fpc_get_template_ids (&self->protocol, ids, &count),
+                            "Checking fingerprint capacity", error)) goto out;
+      if (count == FPC_MAX_TEMPLATES)
+        { g_set_error_literal (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_DATA_FULL,
+                               "Fingerprint database is full"); goto out; }
+      if (!authorize_enrollment (self, work, cancel, error) ||
+          cancelled (cancel, error) ||
+          !command_result (fpc_auth_enrol_timeout (&self->protocol, 120, true),
+                            "Starting fingerprint enrollment timeout", error) ||
+          !command_result (fpc_bio (&self->protocol, FPC_BIO_BEGIN_ENROL, NULL),
+                            "Starting fingerprint enrollment", error)) goto out;
+    }
+  else
+    {
+      guint64 challenge = 0;
+      if (!command_result (fpc_auth_challenge (&self->protocol, false, &challenge),
+                            "Starting fingerprint authentication", error)) goto out;
+    }
+  for (;;)
+    {
+      gint quality = capture (self, work, deadline, cancel, error);
+      if (quality < 0) goto out;
+      if (quality)
+        {
+          if (enrolling)
+            { if (quality != 0x108) queue_progress (self, work, FP_FINGER_STATUS_NONE, completed, sample_retry (quality)); continue; }
+          g_propagate_error (error, sample_retry (quality));
+          goto out;
+        }
+      if (cancelled (cancel, error)) goto out;
+      if (!enrolling)
+        {
+          struct fpc_identify_result identified = fpc_identify (&self->protocol);
+          if (identified.result.transport || identified.result.outer || identified.result.command < 0)
+            { command_result (identified.result, "Matching fingerprint", error); goto out; }
+          if (identified.result.command)
+            { g_propagate_error (error, sample_retry (identified.result.command)); goto out; }
+          result->matched = fpc_identify_matched (&identified);
+          result->finger = result->matched ? identified.template_id : 0;
+          /* Only the main-context callback can bind this result to the gallery.
+           * Do not modify templates based on an out-of-gallery match here. */
+          ok = TRUE;
+          goto out;
+        }
+      guint32 remaining = 0;
+      struct fpc_result r = fpc_bio (&self->protocol, FPC_BIO_ENROL, &remaining);
+      if (r.transport || r.outer || r.command < 0)
+        { command_result (r, "Processing enrollment sample", error); goto out; }
+      if (!command_result (fpc_auth_enrol_timeout (&self->protocol, 120, false),
+                            "Checking fingerprint enrollment timeout", error)) goto out;
+      if (!r.command)
+        {
+          guint32 id = 0;
+          if (cancelled (cancel, error) ||
+              !command_result (fpc_bio (&self->protocol, FPC_BIO_END_ENROL, &id),
+                                "Completing fingerprint enrollment", error)) goto out;
+          if (!id)
+            { g_set_error_literal (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_DATA_INVALID,
+                                   "Fingerprint trusted app returned an empty enrollment ID"); goto out; }
+          if (!store_database (self, error)) goto out;
+          result->finger = id;
+          ok = TRUE;
+          goto out;
+        }
+      if (r.command == 0x10f || r.command == 0x113)
+        {
+          if (remaining > 10000)
+            { g_set_error_literal (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_DATA_INVALID,
+                                   "Fingerprint enrollment progress is out of range"); goto out; }
+          if (!baseline) baseline = remaining + 1;
+          if (remaining < baseline)
+            completed = MAX (completed, MIN (99, (gint) ((baseline - remaining) * 100 / baseline)));
+          queue_progress (self, work, FP_FINGER_STATUS_PRESENT, completed, NULL);
+        }
+      else if (r.command == 0x112 || r.command == 0x114)
+        queue_progress (self, work, FP_FINGER_STATUS_PRESENT, completed, sample_retry (r.command));
+      else
+        { command_result (r, "Processing enrollment sample", error); goto out; }
+    }
+out:
+  idle_sensor (self);
+  return ok;
+}
+
+static void
+worker (GTask *task, gpointer object, gpointer data, GCancellable *cancel)
+{
+  FpiDeviceFpcQsee *self = object;
+  struct work *work = data;
+  g_autoptr(GError) error = NULL;
+  struct result *result = g_new0 (struct result, 1);
+  gboolean success = FALSE;
+  if (work->operation != OP_CLOSE && cancelled (cancel, &error)) goto out;
+  if (work->operation == OP_OPEN)
+    {
+      const gchar *path = fpi_device_get_udev_data (FP_DEVICE (self), FPI_DEVICE_UDEV_SUBTYPE_MISC);
+      if (!open_state (self, &error) ||
+          !system_result (fpc_sensor_open (&self->sensor, path), "Opening FPC sensor", &error) ||
+          !system_result (fpc_qsee_open (&self->qsee, FPC_QSEE_APP_NAME), "Opening FPC trusted application", &error) ||
+          !system_result (fpc_sensor_reset (&self->sensor), "Resetting FPC sensor", &error) ||
+          !command_result (fpc_sensor (&self->protocol, FPC_SENSOR_INIT, NULL), "Initializing FPC sensor", &error) ||
+          !command_result (fpc_sensor (&self->protocol, FPC_SENSOR_DEEP_SLEEP, NULL), "Putting FPC sensor to sleep", &error) ||
+          !import_auth_key (self, &error) || !load_database (self, TRUE, &error)) goto out;
+      success = TRUE;
+      goto out;
+    }
+  if (work->operation == OP_CLOSE)
+    { release_device (self); success = TRUE; goto out; }
+  /* Reload before every operation. This discards partial enrollment state and
+   * stops a failed persist from becoming an accepted in-memory enrollment. */
+  if (!load_database (self, FALSE, &error)) goto out;
+  if (work->operation == OP_ENROLL || work->operation == OP_VERIFY || work->operation == OP_IDENTIFY)
+    { success = interactive (self, work, result, cancel, &error); goto out; }
+  if (!command_result (fpc_get_template_ids (&self->protocol, result->ids, &result->count),
+                        "Listing fingerprint database", &error)) goto out;
+  if (work->operation == OP_LIST) { success = TRUE; goto out; }
+  if (work->operation == OP_DELETE)
+    {
+      gboolean found = FALSE;
+      for (guint i = 0; i < result->count; i++) found |= result->ids[i] == work->finger;
+      if (!found)
+        { g_set_error_literal (&error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_DATA_NOT_FOUND,
+                               "Fingerprint is no longer in the device database"); goto out; }
+      if (cancelled (cancel, &error) ||
+          !command_result (fpc_bio (&self->protocol, FPC_BIO_DELETE_TEMPLATE, &work->finger),
+                            "Deleting fingerprint", &error)) goto out;
+    }
+  else if (work->operation == OP_CLEAR)
+    {
+      for (guint i = 0; i < result->count; i++)
+        if (cancelled (cancel, &error) ||
+            !command_result (fpc_bio (&self->protocol, FPC_BIO_DELETE_TEMPLATE, &result->ids[i]),
+                              "Clearing fingerprint database", &error)) goto out;
+    }
+  else g_assert_not_reached ();
+  success = store_database (self, &error);
+out:
+  if (!success && work->operation == OP_OPEN) release_device (self);
+  if (success) g_task_return_pointer (task, result, g_free);
+  else
+    {
+      g_free (result);
+      if (!error) error = fpi_device_error_new (FP_DEVICE_ERROR_GENERAL);
+      g_task_return_error (task, g_steal_pointer (&error));
+    }
+}
+
+static gboolean
+parse_print (FpDevice *device, FpPrint *print, guint32 *id)
+{
+  g_autoptr(GVariant) data = NULL;
+  guint32 profile, group;
+  if (!print || g_strcmp0 (fp_print_get_driver (print), FP_COMPONENT) ||
+      g_strcmp0 (fp_print_get_device_id (print), fp_device_get_device_id (device))) return FALSE;
+  g_object_get (print, "fpi-data", &data, NULL);
+  if (!data || !g_variant_is_of_type (data, G_VARIANT_TYPE ("(uuu)"))) return FALSE;
+  g_variant_get (data, "(uuu)", &profile, &group, id);
+  return profile == PROFILE && group == LINUX_GROUP && *id != 0;
+}
+
+static void
+set_print_data (FpPrint *print, guint32 id)
+{
+  fpi_print_set_type (print, FPI_PRINT_RAW);
+  fpi_print_set_device_stored (print, TRUE);
+  g_object_set (print, "fpi-data", g_variant_new ("(uuu)", PROFILE, LINUX_GROUP, id), NULL);
+}
+
+static FpPrint *
+new_print (FpiDeviceFpcQsee *self, guint32 id)
+{
+  FpPrint *print = g_object_ref_sink (fp_print_new (FP_DEVICE (self)));
+  set_print_data (print, id);
+  return print;
+}
+
+static void
+done (GObject *object, GAsyncResult *async, gpointer unused)
+{
+  FpiDeviceFpcQsee *self = FPI_DEVICE_FPCQSEE (object);
+  FpDevice *device = FP_DEVICE (self);
+  struct work *work = g_task_get_task_data (G_TASK (async));
+  g_autoptr(GError) error = NULL;
+  g_autofree struct result *result = g_task_propagate_pointer (G_TASK (async), &error);
+  (void) unused;
+  /* A cancellation can race the synchronous TA match or its queued completion.
+   * It must win over authentication success. Enrollment differs only after a
+   * successful persistent commit, so fprintd can retain its enrollment metadata.
+   */
+  if ((work->operation == OP_VERIFY || work->operation == OP_IDENTIFY) &&
+      g_cancellable_is_cancelled (g_task_get_cancellable (G_TASK (async))))
+    {
+      g_clear_pointer (&result, g_free);
+      g_clear_error (&error);
+      g_cancellable_set_error_if_cancelled (g_task_get_cancellable (G_TASK (async)), &error);
+    }
+  self->generation++; /* Ignore any queued progress after this completion. */
+  if (work->operation == OP_OPEN) { fpi_device_open_complete (device, g_steal_pointer (&error)); return; }
+  if (work->operation == OP_CLOSE) { fpi_device_close_complete (device, g_steal_pointer (&error)); return; }
+  fpi_device_report_finger_status (device, FP_FINGER_STATUS_NONE);
+  switch (work->operation)
+    {
+    case OP_LIST:
+      {
+        GPtrArray *prints = NULL;
+        if (result)
+          {
+            prints = g_ptr_array_new_with_free_func (g_object_unref);
+            for (guint i = 0; i < result->count; i++)
+              {
+                if (!result->ids[i])
+                  { g_clear_pointer (&prints, g_ptr_array_unref); error = fpi_device_error_new (FP_DEVICE_ERROR_DATA_INVALID); break; }
+                g_ptr_array_add (prints, new_print (self, result->ids[i]));
+              }
+          }
+        fpi_device_list_complete (device, prints, g_steal_pointer (&error));
+        break;
+      }
+    case OP_DELETE: fpi_device_delete_complete (device, g_steal_pointer (&error)); break;
+    case OP_CLEAR: fpi_device_clear_storage_complete (device, g_steal_pointer (&error)); break;
+    case OP_ENROLL:
+      {
+        FpPrint *print = NULL;
+        if (result)
+          {
+            fpi_device_get_enroll_data (device, &print);
+            set_print_data (print, result->finger);
+            fpi_device_enroll_progress (device, ENROLL_PROGRESS_STAGES, NULL, NULL);
+            g_object_ref (print);
+          }
+        fpi_device_enroll_complete (device, print, g_steal_pointer (&error));
+        break;
+      }
+    case OP_VERIFY:
+    case OP_IDENTIFY:
+      {
+        FpPrint *match = NULL;
+        g_autoptr(FpPrint) scan = NULL;
+        if (result && result->matched)
+          {
+            guint32 id;
+            if (work->operation == OP_VERIFY)
+              {
+                FpPrint *wanted = NULL;
+                fpi_device_get_verify_data (device, &wanted);
+                if (parse_print (device, wanted, &id) && id == result->finger) match = wanted;
+              }
+            else
+              {
+                GPtrArray *gallery = NULL;
+                fpi_device_get_identify_data (device, &gallery);
+                for (guint i = 0; gallery && i < gallery->len; i++)
+                  if (parse_print (device, g_ptr_array_index (gallery, i), &id) && id == result->finger)
+                    { match = g_ptr_array_index (gallery, i); break; }
+              }
+            if (match) scan = new_print (self, result->finger);
+          }
+        if (work->operation == OP_VERIFY)
+          {
+            if (result || (error && error->domain == FP_DEVICE_RETRY))
+              fpi_device_verify_report (device, error ? FPI_MATCH_ERROR : match ? FPI_MATCH_SUCCESS : FPI_MATCH_FAIL,
+                                         scan, g_steal_pointer (&error));
+            fpi_device_verify_complete (device, g_steal_pointer (&error));
+          }
+        else
+          {
+            if (result || (error && error->domain == FP_DEVICE_RETRY))
+              fpi_device_identify_report (device, match, scan, g_steal_pointer (&error));
+            fpi_device_identify_complete (device, g_steal_pointer (&error));
+          }
+        break;
+      }
+    case OP_OPEN:
+    case OP_CLOSE:
+    default: g_assert_not_reached ();
+    }
+}
+
+static void
+free_work (gpointer data)
+{
+  struct work *work = data;
+  g_free (work->username);
+  g_main_context_unref (work->context);
+  g_free (work);
+}
+
+static void
+start (FpDevice *device, enum operation operation, guint32 id, const gchar *username)
+{
+  FpiDeviceFpcQsee *self = FPI_DEVICE_FPCQSEE (device);
+  GCancellable *cancel = operation == OP_OPEN || operation == OP_CLOSE ? NULL : fpi_device_get_cancellable (device);
+  g_autoptr(GTask) task = g_task_new (self, cancel, done, NULL);
+  struct work *work = g_new0 (struct work, 1);
+  work->operation = operation;
+  work->finger = id;
+  work->username = g_strdup (username);
+  work->generation = ++self->generation;
+  work->context = g_main_context_ref_thread_default ();
+  g_task_set_task_data (task, work, free_work);
+  /* Cancellation is resolved by the worker before mutations. A cancellation
+   * after a successful persist must not discard the enrollment result. */
+  g_task_set_check_cancellable (task, FALSE);
+  g_task_run_in_thread (task, worker);
+}
+
+static void fpc_open (FpDevice *d) { start (d, OP_OPEN, 0, NULL); }
+static void fpc_close (FpDevice *d) { start (d, OP_CLOSE, 0, NULL); }
+static void fpc_list (FpDevice *d) { start (d, OP_LIST, 0, NULL); }
+static void fpc_clear (FpDevice *d) { start (d, OP_CLEAR, 0, NULL); }
+static void fpc_identify_action (FpDevice *d) { start (d, OP_IDENTIFY, 0, NULL); }
+static void fpc_cancel (FpDevice *d) { (void) d; /* Worker checks cancellable; no concurrent TA calls. */ }
+static void fpc_probe (FpDevice *d) { fpi_device_probe_complete (d, "sargo-fpc-sp2a-v1", NULL, NULL); }
+
+static void
+fpc_enroll_action (FpDevice *d)
+{
+  FpPrint *print = NULL;
+  fpi_device_get_enroll_data (d, &print);
+  start (d, OP_ENROLL, 0, fp_print_get_username (print));
+}
+
+static void
+fpc_verify_action (FpDevice *d)
+{
+  FpPrint *print = NULL;
+  guint32 id;
+  fpi_device_get_verify_data (d, &print);
+  if (!parse_print (d, print, &id))
+    { fpi_device_verify_complete (d, fpi_device_error_new (FP_DEVICE_ERROR_DATA_INVALID)); return; }
+  start (d, OP_VERIFY, id, NULL);
+}
+
+static void
+fpc_delete_action (FpDevice *d)
+{
+  FpPrint *print = NULL;
+  guint32 id;
+  fpi_device_get_delete_data (d, &print);
+  if (!parse_print (d, print, &id))
+    { fpi_device_delete_complete (d, fpi_device_error_new (FP_DEVICE_ERROR_DATA_INVALID)); return; }
+  start (d, OP_DELETE, id, NULL);
+}
+
+static void
+fpi_device_fpcqsee_init (FpiDeviceFpcQsee *self)
+{
+  self->sensor.fd = self->qsee.fd = self->state_fd = self->lock_fd = -1;
+  self->protocol = (struct fpc_protocol) { &self->qsee, fpc_qsee_command };
+}
+
+static void
+fpi_device_fpcqsee_finalize (GObject *object)
+{
+  release_device (FPI_DEVICE_FPCQSEE (object));
+  G_OBJECT_CLASS (fpi_device_fpcqsee_parent_class)->finalize (object);
+}
+
+static void
+fpi_device_fpcqsee_class_init (FpiDeviceFpcQseeClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+  FpDeviceClass *device_class = FP_DEVICE_CLASS (klass);
+  object_class->finalize = fpi_device_fpcqsee_finalize;
+  device_class->id = FP_COMPONENT;
+  device_class->full_name = "Pixel 3a FPC QSEE fingerprint sensor";
+  device_class->type = FP_DEVICE_TYPE_UDEV;
+  device_class->id_table = id_table;
+  device_class->scan_type = FP_SCAN_TYPE_PRESS;
+  device_class->nr_enroll_stages = ENROLL_PROGRESS_STAGES;
+  device_class->temp_hot_seconds = -1;
+  device_class->probe = fpc_probe;
+  device_class->open = fpc_open;
+  device_class->close = fpc_close;
+  device_class->list = fpc_list;
+  device_class->delete = fpc_delete_action;
+  device_class->clear_storage = fpc_clear;
+  device_class->enroll = fpc_enroll_action;
+  device_class->verify = fpc_verify_action;
+  device_class->identify = fpc_identify_action;
+  device_class->cancel = fpc_cancel;
+  fpi_device_class_auto_initialize_features (device_class);
+}
