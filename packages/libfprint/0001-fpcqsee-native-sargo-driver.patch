diff --git a/libfprint/drivers/fpcqsee/README.md b/libfprint/drivers/fpcqsee/README.md
new file mode 100644
index 0000000..7724864
--- /dev/null
+++ b/libfprint/drivers/fpcqsee/README.md
@@ -0,0 +1,91 @@
+# Sargo FPC QSEE driver
+
+This experimental driver targets the Pixel 3a, compatible
+`google,sargo-fingerprint`, misc device `fpc1020`, and the stock FPC trusted
+application from Android SP2A.220505.008. Other firmware is not a verified
+protocol profile. Source-only implementation: proprietary firmware, signing
+keys, Android credentials and biometric templates are not distributed here.
+
+It uses the legacy QSEECOM TEE backend, the native FPC reset/IRQ misc interface,
+and the machine-wide QSEE listener/app-loader services. It does not execute the
+Android HAL. Its sensor capture sequence and biometric command formats were
+recovered from the exact Sargo FPC HAL/TA; the detailed description and hashes
+are in the PocketFed package's `protocol.md`.
+
+## Implemented behavior
+
+- Initialization, sensor reset, trusted-app session and wrapped Keymaster key
+  import; explicit sleep on cleanup and serialized device ownership.
+- Finger release/contact arming, IRQ waits and TA-qualified capture, with
+  cancellation checks between commands. An IRQ never establishes a match.
+- Enrollment through a separate root-owned authorization broker, TA sample
+  processing and finalization. Progress is normalized to100 stages from the
+  observed remaining-sample count; it does not assume a fixed number of touches.
+  Completion requires a nonzero template ID and a successful database save.
+- Verify/identify accept only actual TA matches whose profile, database group,
+  template ID, driver and device ID correspond to a requested print. A match
+  outside the caller's gallery is returned as a nonmatch without exposing it.
+- List, individual deletion, and clear-by-enumeration. ID0 never means delete
+  all. No partial-operation state is accepted without persistence: each action
+  reloads the saved database.
+
+The driver uses one dedicated Linux group1 and database name
+`pocketfed/fpc-sargo-v1.db`. The TA stores a separate secure user ID per template.
+Raw print identity is `(profile, group, ID)`; existing libfprint username
+metadata is resolved to a Unix uid when requesting enrollment authorization.
+The normal fprintd policy controls whose print gallery an action may use.
+
+## Enrollment authorization
+
+`auth-broker.h` defines one request per stream connection to
+`/run/pocketfed-fpc-auth/token.sock`. The client checks `SO_PEERCRED.uid == 0`,
+allows at most five seconds for the complete exchange, supports cancellation,
+and checks the returned token version and challenge before forwarding it. The
+TA independently checks its signature and enrollment authorization. There is
+no fabricated-token or missing-broker success path. All sensitive buffers are
+wiped after use; tokens and wrapped keys are never logged.
+
+The broker must produce genuine Gatekeeper authorization for a Linux-owned
+credential. The driver does not collect a PIN in GNOME Settings. Broker wire
+framing is implemented; successful end-to-end Sargo credential provisioning is
+a separate dependency and must be validated before claiming working enrollment.
+
+## Storage initialization and ownership
+
+The packaging contract uses qsee-supplicant's default state root
+`/var/lib/qsee-supplicant`, root-owned mode0700. Overriding that daemon setting
+requires coordinating this driver. FS/GPFS confine storage to that namespace.
+The driver itself keeps a root-owned0700 control directory at
+`/var/lib/fprint/fpc-qsee` and holds `device.lock` for its open lifetime. Other
+native FPC clients must honor the same lock; the TA state is shared across
+sessions and independent clients must not concurrently modify it.
+
+The TA conflates missing files and other open failures as status208. Therefore
+ordinary load errors never create an empty database. First initialization needs
+an explicit root-owned, empty, mode0600 `initialize-empty` marker in the control
+directory **and** an entirely empty QSEE state directory. The marker is consumed
+and its directory synced before creating any database. Existing QSEE contents
+block this path even when the marker exists. Until the TA's FTS filename
+expansion is observed, a narrower apparent-file existence check is insufficient.
+The package never creates this marker automatically and never deletes existing
+QSEE state to make initialization pass.
+
+## Validation and remaining work
+
+The driver compiles on ARM64. Isolated tests exercise the real libfprint verify,
+identify and enrollment APIs using test-only protocol/sensor/broker substitutes:
+capture ordering, gallery binding, transport/TA failure rejection, unavailable
+authorization and failed persistence. Socket-boundary tests cover exact bytes,
+partial transfers, untrusted peers, malformed responses, deadlines and cancel.
+Those tests never touch hardware or send synthetic tokens to a TA.
+
+Live sensor initialization, signed enrollment, wrong-finger rejection, saved
+templates across reboot, cancellation during a real QSEE invoke, template
+adaptation and desktop integration remain to be tested. The synchronous kernel
+invoke currently has no userspace cancellation mechanism while inside SCM.
+The conservative initialization policy may require a refined, verified FTS
+namespace mapping on a phone that already uses other QSEE storage.
+
+The base tree is Wrobelda's public `goodix-qsee` branch, providing misc-device
+enumeration and the QSEECOM backend conventions. This FPC command implementation
+is independent of the Goodix command protocol and token fallback.
diff --git a/libfprint/drivers/fpcqsee/auth-broker.h b/libfprint/drivers/fpcqsee/auth-broker.h
new file mode 100644
index 0000000..8cf31db
--- /dev/null
+++ b/libfprint/drivers/fpcqsee/auth-broker.h
@@ -0,0 +1,30 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef FPC_AUTH_BROKER_H
+#define FPC_AUTH_BROKER_H
+#include <stdint.h>
+
+#define FPC_AUTH_SOCKET_PATH "/run/pocketfed-fpc-auth/token.sock"
+#define FPC_AUTH_MAGIC "FPCA"
+#define FPC_AUTH_VERSION 1u
+#define FPC_AUTH_TIMEOUT_MS 5000u
+#define FPC_AUTH_TOKEN_SIZE 69u
+
+/* One request/response per SOCK_STREAM connection, no native struct padding.
+ * All integer arrays encode little endian. Only uid0 peers are accepted by
+ * the client; the broker must restrict the socket to authorized root clients.
+ * status is signed errno-style: zero success, nonzero failure. A failed
+ * response must contain zero token bytes. Tokens and messages are never logged.
+ */
+struct fpc_auth_request {
+    uint8_t magic[4];
+    uint8_t version_le[4];
+    uint8_t uid_le[4];
+    uint8_t challenge_le[8];
+};
+struct fpc_auth_response {
+    uint8_t status_le[4];
+    uint8_t token[FPC_AUTH_TOKEN_SIZE];
+};
+_Static_assert(sizeof(struct fpc_auth_request) == 20, "FPC auth request ABI");
+_Static_assert(sizeof(struct fpc_auth_response) == 73, "FPC auth response ABI");
+#endif
diff --git a/libfprint/drivers/fpcqsee/auth-client.c b/libfprint/drivers/fpcqsee/auth-client.c
new file mode 100644
index 0000000..7abb9d3
--- /dev/null
+++ b/libfprint/drivers/fpcqsee/auth-client.c
@@ -0,0 +1,110 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+#include "auth-client.h"
+#include "protocol.h"
+#include <errno.h>
+#include <poll.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+static gboolean
+wait_ready (int fd, short events, gint64 deadline, GCancellable *cancel, GError **error)
+{
+  struct pollfd p = { .fd = fd, .events = events };
+  for (;;)
+    {
+      gint64 remaining = (deadline - g_get_monotonic_time ()) / 1000;
+      if (g_cancellable_set_error_if_cancelled (cancel, error)) return FALSE;
+      if (remaining <= 0)
+        { g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_TIMED_OUT,
+                               "Fingerprint authorization broker timed out"); return FALSE; }
+      int n = poll (&p, 1, MIN (remaining, 100));
+      if (n > 0 && (p.revents & events)) return TRUE;
+      if (n > 0 && (p.revents & (POLLERR | POLLHUP | POLLNVAL)))
+        { errno = ECONNRESET; break; }
+      if (n < 0 && errno != EINTR) break;
+    }
+  g_set_error (error, G_IO_ERROR, g_io_error_from_errno (errno),
+               "Fingerprint authorization connection: %s", g_strerror (errno));
+  return FALSE;
+}
+
+static gboolean
+transfer (int fd, void *buffer, size_t size, gboolean sending,
+          gint64 deadline, GCancellable *cancel, GError **error)
+{
+  guint8 *p = buffer;
+  while (size)
+    {
+      if (!wait_ready (fd, sending ? POLLOUT : POLLIN, deadline, cancel, error)) return FALSE;
+      ssize_t n = sending ? send (fd, p, size, MSG_NOSIGNAL) : recv (fd, p, size, 0);
+      if (n < 0 && (errno == EINTR || errno == EAGAIN)) continue;
+      if (n <= 0)
+        { g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_FAILED,
+                               "Fingerprint authorization response was incomplete"); return FALSE; }
+      p += n;
+      size -= n;
+    }
+  return TRUE;
+}
+
+gboolean
+fpc_auth_client_get_token (guint32 uid, guint64 challenge, guint8 hat[FPC_AUTH_TOKEN_SIZE],
+                           GCancellable *cancel, GError **error)
+{
+  struct sockaddr_un address = { .sun_family = AF_UNIX, .sun_path = FPC_AUTH_SOCKET_PATH };
+  struct fpc_auth_request request = {0};
+  struct fpc_auth_response response = {0};
+  struct ucred peer;
+  socklen_t peer_size = sizeof peer;
+  gint64 deadline = g_get_monotonic_time () + FPC_AUTH_TIMEOUT_MS * 1000;
+  gboolean ok = FALSE;
+  int fd = -1, socket_error;
+  socklen_t error_size = sizeof socket_error;
+
+  memset (hat, 0, FPC_AUTH_TOKEN_SIZE);
+  if (!challenge)
+    { g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                           "Fingerprint enrollment challenge is zero"); goto out; }
+  if (g_cancellable_set_error_if_cancelled (cancel, error)) goto out;
+  fd = socket (AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC | SOCK_NONBLOCK, 0);
+  if (fd < 0) goto unavailable;
+  if (connect (fd, (struct sockaddr *) &address, sizeof address) && errno != EINPROGRESS)
+    goto unavailable;
+  if (!wait_ready (fd, POLLOUT, deadline, cancel, error)) goto out;
+  if (getsockopt (fd, SOL_SOCKET, SO_ERROR, &socket_error, &error_size)) goto unavailable;
+  if (socket_error) { errno = socket_error; goto unavailable; }
+  if (getsockopt (fd, SOL_SOCKET, SO_PEERCRED, &peer, &peer_size)) goto unavailable;
+  if (peer_size != sizeof peer || peer.uid != 0)
+    { g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED,
+                           "Fingerprint authorization broker is not owned by root"); goto out; }
+  memcpy (request.magic, FPC_AUTH_MAGIC, sizeof request.magic);
+  fpc_put_le32 (request.version_le, FPC_AUTH_VERSION);
+  fpc_put_le32 (request.uid_le, uid);
+  fpc_put_le64 (request.challenge_le, challenge);
+  if (!transfer (fd, &request, sizeof request, TRUE, deadline, cancel, error) ||
+      !transfer (fd, &response, sizeof response, FALSE, deadline, cancel, error)) goto out;
+  if (fpc_get_le32 (response.status_le))
+    { g_set_error (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED,
+                   "Fingerprint authorization broker refused enrollment (status %d)",
+                   (gint32) fpc_get_le32 (response.status_le)); goto out; }
+  if (response.token[0] || fpc_get_le64 (response.token + 1) != challenge)
+    { g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                           "Fingerprint authorization token has the wrong version or challenge"); goto out; }
+  memcpy (hat, response.token, FPC_AUTH_TOKEN_SIZE);
+  ok = TRUE;
+  goto out;
+unavailable:
+  g_set_error (error, G_IO_ERROR, g_io_error_from_errno (errno),
+               "Fingerprint enrollment needs the authorization broker at %s: %s",
+               FPC_AUTH_SOCKET_PATH, g_strerror (errno));
+out:
+  if (fd >= 0) close (fd);
+  explicit_bzero (&request, sizeof request);
+  explicit_bzero (&response, sizeof response);
+  return ok;
+}
