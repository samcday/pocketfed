+) -> (Box<dyn DictionaryBackend>, Option<Box<dyn SpellChecker>>, Option<Box<dyn Predictor>>) {
+    eprintln!("warning: patricia feature not enabled");
+    (Box::new(FileDictionaryBackend::new()), None, None)
+}
