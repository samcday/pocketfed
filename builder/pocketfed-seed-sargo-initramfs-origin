#!/usr/bin/env bash
set -euo pipefail

program=${0##*/}
initramfs_args='--hostonly;--hostonly-mode=strict;--no-hostonly-cmdline;--no-hostonly-default-device;'

die() {
    printf '%s: %s\n' "$program" "$*" >&2
    exit 1
}

(( $# == 1 )) || die 'usage: pocketfed-seed-sargo-initramfs-origin DEPLOYMENT.origin'

origin=$1
[[ -f "$origin" && ! -L "$origin" ]] ||
    die "deployment origin is not a regular file: $origin"

section=
rpmostree_sections=0
regenerate_values=0
args_values=0
while IFS= read -r line || [[ -n "$line" ]]; do
    line=${line%$'\r'}
    if [[ "$line" =~ ^[[:space:]]*\[([^][]+)\][[:space:]]*$ ]]; then
        section=${BASH_REMATCH[1]}
        if [[ "$section" == rpmostree ]]; then
            ((rpmostree_sections += 1))
        fi
        continue
    fi

    [[ "$section" == rpmostree ]] || continue
    case "$line" in
        regenerate-initramfs=*)
            ((regenerate_values += 1))
            [[ "$line" == 'regenerate-initramfs=true' ]] ||
                die 'deployment origin has an incompatible regenerate-initramfs value'
            ;;
        initramfs-args=*)
            ((args_values += 1))
            [[ "$line" == "initramfs-args=$initramfs_args" ]] ||
                die 'deployment origin has incompatible initramfs arguments'
            ;;
    esac
done <"$origin"

if (( rpmostree_sections == 0 )); then
    # rpm-ostree 2026.2 inserts --no-hostonly when the base commit carries no
    # initramfs arguments. Deployment-origin arguments are appended later, so
    # this explicit --hostonly both wins that fallback and persists on updates.
    printf '\n[rpmostree]\nregenerate-initramfs=true\ninitramfs-args=%s\n' \
        "$initramfs_args" >>"$origin"
elif (( rpmostree_sections != 1 || regenerate_values != 1 || args_values != 1 )); then
    die 'deployment origin has an incomplete or duplicate [rpmostree] initramfs policy'
fi
