ARG BASE_IMAGE=ghcr.io/samcday/pocketfed-base:rawhide

FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.title="PocketFed Phosh"
LABEL org.opencontainers.image.description="PocketFed Phosh desktop layer"

COPY phosh/samcday-pocketfed.repo /etc/yum.repos.d/

# Flatpak 1.19.0 can lose SpawnStarted while nested sandbox PID metadata is
# still being written. Keep the tested portal fix in the image until Fedora
# carries it; packaging and regression checks live in packages/flatpak/.
# Phosh must also carry the rejected-PIN retry fix from packages/phosh/;
# install matching libphosh so consumers use the same authentication code.
RUN --mount=type=cache,id=pocketfed-phosh-arm64-dnf,target=/var/cache,sharing=locked \
    set -eux; \
    flatpak_version='1.19.0-3.1.pocketfed.fc46'; \
    phosh_version='0.57.0-1.1.pocketfed.fc46'; \
    dnf install -y \
        --allow-vendor-change \
        --refresh \
        --from-repo='copr:copr.fedorainfracloud.org:samcday:pocketfed' \
        --setopt=install_weak_deps=False \
        --setopt=keepcache=True \
        "flatpak-$flatpak_version" \
        "flatpak-libs-$flatpak_version" \
        "flatpak-session-helper-$flatpak_version" \
        "phosh-$phosh_version" \
        "libphosh-$phosh_version"; \
    dnf install -y --setopt=install_weak_deps=False --setopt=keepcache=True \
        calls \
        chatty \
        default-fonts-core-emoji \
        epiphany \
        feedbackd \
        glib-networking \
        gnome-calculator \
        gnome-calendar \
        gnome-clocks \
        gnome-console \
        gnome-contacts \
        gnome-control-center \
        gnome-keyring \
        gnome-keyring-pam \
        gnome-maps \
        gnome-photos \
        gnome-software \
        libcanberra-backend-pulse \
        nautilus \
        phoc \
        phosh \
        phosh-first-boot \
        phosh-mobile-settings \
        phosh-tour \
        phrog \
        pinentry-gnome3 \
        showtime \
        stevia \
        upower \
        xdg-desktop-portal \
        xdg-desktop-portal-gtk \
        xdg-user-dirs-gtk; \
    for package in flatpak flatpak-libs flatpak-session-helper; do \
        test "$(rpm -q --qf '%{VERSION}-%{RELEASE}\n' "$package")" = "$flatpak_version"; \
    done; \
    for package in phosh libphosh; do \
        test "$(rpm -q --qf '%{VERSION}-%{RELEASE}\n' "$package")" = "$phosh_version"; \
    done; \
    test "$(rpm -q --whatprovides phosh-pam-retry-fix --qf '%{NAME}\n')" = phosh; \
    test -x /usr/libexec/flatpak-portal; \
    grep -Fxq 'ExecStart=/usr/libexec/flatpak-portal' \
        /usr/lib/systemd/user/flatpak-portal.service

COPY phosh/pocketfed-phrog-tmpfiles.conf /usr/lib/tmpfiles.d/
COPY phosh/pocketfed-first-boot /usr/libexec/
COPY phosh/90_pocketfed-first-boot.gschema.override /usr/share/glib-2.0/schemas/
COPY phosh/50-pocketfed-first-boot.conf /usr/lib/systemd/system/phrog.service.d/

# Fedora's phosh PAM service currently authenticates with pam_unix directly.
# Delegate to authselect's stack so the lock screen also accepts homed users.
COPY phosh/pam.d/phosh /etc/pam.d/phosh

RUN set -eux; \
    chmod 0755 /usr/libexec/pocketfed-first-boot; \
    glib-compile-schemas --strict /usr/share/glib-2.0/schemas; \
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/pocketfed-phrog-tmpfiles.conf; \
    test -f /usr/lib64/libcanberra-0.30/libcanberra-pulse.so; \
    test -d /var/lib/greetd/.config/dconf; \
    test "$(stat -c '%U:%G:%a' /var/lib/greetd/.config/dconf)" = greetd:greetd:700; \
    authselect enable-feature with-systemd-homed; \
    systemctl enable systemd-homed.service; \
    systemctl --global enable phosh-first-boot-importer.service; \
    systemctl enable phrog.service; \
    bootc container lint --no-truncate
