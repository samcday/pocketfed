#!/usr/bin/python3
# SPDX-License-Identifier: MIT
# Drive one GPIO line low for <ms> milliseconds, then high, then release.
# usage: gpio-pulse <chip-label-substring> <offset> <ms>
import ctypes, fcntl, os, sys, time
g = {}
exec(open(os.path.join(os.path.dirname(os.path.abspath(__file__)), "gpio-state")).read().split("def main")[0], g)
sub, off, ms = sys.argv[1], int(sys.argv[2]), float(sys.argv[3])
dev, label, _ = g["find_chip"](sub)
if not dev:
    print(f"gpio-pulse: no chip {sub!r}"); sys.exit(1)
OUTPUT = 8
with open(dev, "rb") as f:
    req = g["LineRequest"](); req.offsets[0] = off; req.num_lines = 1
    req.consumer = b"hwe-pulse"; req.config.flags = OUTPUT
    req.config.num_attrs = 1
    req.config.attrs[0].attr.id = 2  # GPIO_V2_LINE_ATTR_ID_OUTPUT_VALUES
    req.config.attrs[0].attr.value = 1  # start high
    req.config.attrs[0].mask = 1
    fcntl.ioctl(f, g["GET_LINE"], req)
SET_VALUES = (3 << 30) | (16 << 16) | (0xB4 << 8) | 0x0F
lv = g["LineValues"](); lv.mask = 1; lv.bits = 0
fcntl.ioctl(req.fd, SET_VALUES, lv)
time.sleep(ms / 1000.0)
lv.bits = 1
fcntl.ioctl(req.fd, SET_VALUES, lv)
os.close(req.fd)
print(f"pulsed line {off} low for {ms} ms, left high")
