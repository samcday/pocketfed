[Unit]
Description=Premouth experimental ABL framebuffer dissolve
Documentation=file:/usr/share/doc/premouth/README.md
DefaultDependencies=no
After=systemd-remount-fs.service
Before=plymouth-start.service systemd-udev-trigger.service systemd-modules-load.service dracut-pre-udev.service systemd-vconsole-setup.service
Conflicts=shutdown.target
Before=shutdown.target
IgnoreOnIsolate=yes
# Only meaningful inside an initramfs and only when not explicitly disabled.
ConditionPathExists=/etc/initrd-release
ConditionKernelCommandLine=!rd.premouth=0
# Display takeover is single-shot per boot. The initrd switch-root transaction
# can pull this unit again after a failed first attempt, which races Plymouth
# for DRM master and overwrites the first capture. A burst of 1 with an
# infinite interval makes the failed activation terminal; a manual retry
# requires `systemctl reset-failed premouth.service` first.
StartLimitIntervalSec=infinity
StartLimitBurst=1

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/libexec/premouth run --duration 5 --socket /run/premouth/handoff.sock --stats /run/premouth/stats.txt
TimeoutStartSec=10
TimeoutStopSec=10
KillSignal=SIGTERM
StandardOutput=null
StandardError=kmsg
Restart=no
# Optional runtime errors (missing or invalid SimpleDRM/DT data) finish with
# READY emitted and exit status 1; only this packaged optional service accepts
# that as success. Bad CLI configuration still exits 2 and fails.
SuccessExitStatus=1
# Keep a successfully completed notify handoff active so this boot cannot pull
# a second capture; Restart=no already blocks automatic reruns.
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
