+    */
+   if (v->type == MESA_SHADER_FRAGMENT) {
+      OUT_PKT3(ring, CP_EVENT_WRITE, 1);
+      OUT_RING(ring, HLSQ_FLUSH);
+   }
+
    OUT_PKT3(ring, CP_LOAD_STATE, 2);
