+/* Would ir3_emit_fs_consts() emit an indirect (buffer backed) upload? */
+static bool
+b14_fs_indirect(struct fd_context *ctx, const struct ir3_shader_variant *fp)
+{
+   const struct ir3_const_state *cs = ir3_const_state(fp);
+   const struct ir3_ubo_analysis_state *st = &cs->ubo_state;
+   struct fd_constbuf_stateobj *constbuf = &ctx->constbuf[MESA_SHADER_FRAGMENT];
+
+   if (!(ctx->dirty_shader[MESA_SHADER_FRAGMENT] & FD_DIRTY_SHADER_CONST))
+      return false;
+
+   for (unsigned i = 0; i < st->num_enabled; i++) {
+      unsigned ubo = st->range[i].ubo.block;
+      if (!(constbuf->enabled_mask & (1u << ubo)) ||
+          ubo == cs->consts_ubo.idx)
+         continue;
+      if (16 * fp->constlen <= st->range[i].offset)
+         continue;
+      if (!constbuf->cb[ubo].user_buffer)
+         return true;
+   }
+   return false;
+}
