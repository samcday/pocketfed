diff --color -ruN pristine/mesa-26.2.2/src/gallium/drivers/freedreno/freedreno_b14.h w/mesa-26.2.2/src/gallium/drivers/freedreno/freedreno_b14.h
--- a/src/gallium/drivers/freedreno/freedreno_b14.h
+++ b/src/gallium/drivers/freedreno/freedreno_b14.h
@@ -0,0 +1,88 @@
+/*
+ * B14 diagnostic knobs for the A306 indirect-constant hang (pocketfed#80).
+ *
+ * NOT FOR UPSTREAM.  Selected at runtime with FD3_B14, a comma separated
+ * list of <elem>[+<elem>...]@<pos> tokens and plain flags:
+ *
+ *   elements: wfi inv hlsq uche cf ts ib presv dummy restore epi(=hlsq+wfi+ts)
+ *             rpkt (restore packets, no re-emission) dirty (re-emit all state,
+ *             or only FD3_B14_DIRTY / FD3_B14_SDIRTY hex masks when set)
+ *             rg_pvt rg_tpl rg_unk rg_misc rregs(=all four): restore's
+ *             register groups (S/A positions only)
+ *   positions:
+ *     S  start of draw state, only draws whose FS emits an indirect
+ *        CP_LOAD_STATE of constants
+ *     A  start of every draw state
+ *     L  immediately before every FS indirect constant load
+ *     V  immediately before every VS indirect constant load
+ *     E  immediately after every draw packet
+ *     F  before the FS constant uploads of draws whose FS loads indirectly
+ *     M  immediately after every VS indirect constant load
+ *   flags: flushclear clearnoconst clearind vscache fscache vsdirect fsdirect
+ *     vsdirect/fsdirect upload that stage's buffer-backed constants inline
+ *     vscache/fscache force that stage's instructions into CACHE mode
+ *
+ * With FD3_B14 unset the emitted command stream is unchanged.
+ */
+
+#ifndef FREEDRENO_B14_H_
+#define FREEDRENO_B14_H_
+
+#include <stdbool.h>
+#include <stdint.h>
+
+enum fd_b14_elem {
+   B14_WFI = 1u << 0,
+   B14_INV = 1u << 1,
+   B14_HLSQ = 1u << 2,
+   B14_UCHE = 1u << 3,
+   B14_CF = 1u << 4,
+   B14_TS = 1u << 5,
+   B14_IB = 1u << 6,
+   B14_PRESV = 1u << 7,
+   B14_DUMMY = 1u << 8,
+   B14_RESTORE = 1u << 9,
+   B14_RPKT = 1u << 10,
+   B14_DIRTY = 1u << 11,
+   B14_RG_PVT = 1u << 12,
+   B14_RG_TPL = 1u << 13,
+   B14_RG_UNK = 1u << 14,
+   B14_RG_MISC = 1u << 15,
+};
+
+#define B14_RG_ALL (B14_RG_PVT | B14_RG_TPL | B14_RG_UNK | B14_RG_MISC)
+
+#define B14_DRAW_PRE (B14_RESTORE | B14_RPKT | B14_DIRTY)
+
+enum fd_b14_pos {
+   B14_POS_S,
+   B14_POS_A,
+   B14_POS_L,
+   B14_POS_V,
+   B14_POS_E,
+   B14_POS_F,
+   B14_POS_M,
+   B14_POS_COUNT,
+};
+
+struct fd_b14 {
+   uint32_t pos[B14_POS_COUNT];
+   bool flush_clear;
+   bool clear_noconst;
+   bool clear_indirect;
+   bool vs_cache;
+   bool fs_cache;
+   bool vs_direct;
+   bool fs_direct;
+   bool any;
+   bool dirty_masked;
+   uint32_t dirty_mask;
+   uint32_t sdirty_mask;
+   unsigned count[B14_POS_COUNT];
+   unsigned clears;
+};
+
+extern struct fd_b14 fd_b14;
+extern bool fd_b14_in_clear;
+
+#endif /* FREEDRENO_B14_H_ */
