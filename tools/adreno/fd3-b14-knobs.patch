+#include "freedreno_b14.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "util/u_inlines.h"
+
+/* B14 diagnostic knobs, see freedreno_b14.h.  NOT FOR UPSTREAM. */
+struct fd_b14 fd_b14;
+bool fd_b14_in_clear;
+
+static void
+fd_b14_report(void)
+{
+   fprintf(stderr,
+           "FD3B14 counts S=%u A=%u L=%u V=%u E=%u F=%u M=%u clears=%u\n",
+           fd_b14.count[B14_POS_S], fd_b14.count[B14_POS_A],
+           fd_b14.count[B14_POS_L], fd_b14.count[B14_POS_V],
+           fd_b14.count[B14_POS_E], fd_b14.count[B14_POS_F],
+           fd_b14.count[B14_POS_M], fd_b14.clears);
+}
+
+static uint32_t
+fd_b14_elem(const char *name, size_t len)
+{
+   static const struct {
+      const char *name;
+      uint32_t bits;
+   } elems[] = {
+      {"wfi", B14_WFI},     {"inv", B14_INV},         {"hlsq", B14_HLSQ},
+      {"uche", B14_UCHE},   {"cf", B14_CF},           {"ts", B14_TS},
+      {"ib", B14_IB},       {"presv", B14_PRESV},     {"dummy", B14_DUMMY},
+      {"restore", B14_RESTORE}, {"rpkt", B14_RPKT},  {"dirty", B14_DIRTY},
+      {"rg_pvt", B14_RG_PVT},   {"rg_tpl", B14_RG_TPL}, {"rg_unk", B14_RG_UNK},
+      {"rg_misc", B14_RG_MISC}, {"rregs", B14_RG_ALL},
+      {"epi", B14_HLSQ | B14_WFI | B14_TS},
+   };
+   for (unsigned i = 0; i < ARRAY_SIZE(elems); i++) {
+      if (strlen(elems[i].name) == len && !strncmp(name, elems[i].name, len))
+         return elems[i].bits;
+   }
+   fprintf(stderr, "FD3B14 unknown element '%.*s'\n", (int)len, name);
+   abort();
+}
+
+static void __attribute__((constructor))
+fd_b14_init(void)
+{
+   const char *env = getenv("FD3_B14");
+   if (!env || !*env)
+      return;
+
+   char *copy = strdup(env), *save = NULL;
+   for (char *tok = strtok_r(copy, ",", &save); tok;
+        tok = strtok_r(NULL, ",", &save)) {
+      if (!strcmp(tok, "flushclear")) {
+         fd_b14.flush_clear = true;
+         continue;
+      }
+      if (!strcmp(tok, "clearnoconst")) {
+         fd_b14.clear_noconst = true;
+         continue;
+      }
+      if (!strcmp(tok, "clearind")) {
+         fd_b14.clear_indirect = true;
+         continue;
+      }
+      if (!strcmp(tok, "vscache")) {
+         fd_b14.vs_cache = true;
+         continue;
+      }
+      if (!strcmp(tok, "fscache")) {
+         fd_b14.fs_cache = true;
+         continue;
+      }
+      if (!strcmp(tok, "vsdirect")) {
+         fd_b14.vs_direct = true;
+         continue;
+      }
+      if (!strcmp(tok, "fsdirect")) {
+         fd_b14.fs_direct = true;
+         continue;
+      }
+      char *at = strchr(tok, '@');
+      if (!at || strlen(at) != 2) {
+         fprintf(stderr, "FD3B14 bad token '%s'\n", tok);
+         abort();
+      }
+      static const char positions[] = "SALVEFM";
+      const char *p = strchr(positions, at[1]);
+      if (!p) {
+         fprintf(stderr, "FD3B14 bad position in '%s'\n", tok);
+         abort();
+      }
+      uint32_t bits = 0;
+      for (char *e = tok; e < at;) {
+         char *plus = memchr(e, '+', at - e);
+         char *end = plus ? plus : at;
+         bits |= fd_b14_elem(e, end - e);
+         e = plus ? plus + 1 : at;
+      }
+      fd_b14.pos[p - positions] |= bits;
+   }
+   free(copy);
+
+   const char *dm = getenv("FD3_B14_DIRTY"), *sm = getenv("FD3_B14_SDIRTY");
+   if ((dm && *dm) || (sm && *sm)) {
+      fd_b14.dirty_masked = true;
+      fd_b14.dirty_mask = dm ? strtoul(dm, NULL, 16) : 0;
+      fd_b14.sdirty_mask = sm ? strtoul(sm, NULL, 16) : 0;
+      fprintf(stderr, "FD3B14 dirty_mask=%#x sdirty_mask=%#x\n",
+              fd_b14.dirty_mask, fd_b14.sdirty_mask);
+   }
+
+   fd_b14.any = true;
+   fprintf(stderr,
+           "FD3B14 knobs=%s S=%#x A=%#x L=%#x V=%#x E=%#x F=%#x M=%#x "
+           "flushclear=%d clearnoconst=%d clearind=%d vscache=%d fscache=%d "
+           "vsdirect=%d fsdirect=%d\n",
+           env, fd_b14.pos[B14_POS_S], fd_b14.pos[B14_POS_A],
+           fd_b14.pos[B14_POS_L], fd_b14.pos[B14_POS_V],
+           fd_b14.pos[B14_POS_E], fd_b14.pos[B14_POS_F],
+           fd_b14.pos[B14_POS_M], fd_b14.flush_clear, fd_b14.clear_noconst,
+           fd_b14.clear_indirect, fd_b14.vs_cache, fd_b14.fs_cache,
+           fd_b14.vs_direct, fd_b14.fs_direct);
+   atexit(fd_b14_report);
+}
